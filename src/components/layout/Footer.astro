---
import { SITE } from "../../lib/seo";
import { offices } from "../../data/site-content";

interface Props {
  marqueeText?: string;
  marqueeTheme?: "light" | "dark";
}

const { marqueeText = "Product Development that Sparks Innovation", marqueeTheme = "light" } = Astro.props;

/** Footer social icons. Each `icon` is the inner markup of a 24x24 SVG; `outline` icons are drawn with a stroke instead of a fill. */
const socialLinks = [
  {
    label: "Instagram",
    href: SITE.social.instagram,
    size: 16,
    outline: true,
    icon: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  },
  {
    label: "X (Twitter)",
    href: SITE.social.twitter,
    size: 14,
    outline: false,
    icon: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  },
  {
    label: "LinkedIn",
    href: SITE.social.linkedin,
    size: 15,
    outline: false,
    icon: '<path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14zM8.27 18.5V10.13H5.5V18.5h2.77zm-1.39-9.52a1.61 1.61 0 100-3.21 1.61 1.61 0 000 3.21zM18.5 18.5v-4.59c0-2.46-1.31-3.6-3.06-3.6-1.41 0-2.04.77-2.39 1.32V10.13h-2.78V18.5h2.78v-4.55c0-.25.02-.5.09-.68.2-.5.66-1.02 1.43-1.02 1 0 1.41.77 1.41 1.9V18.5h2.52z"/>',
  },
  {
    label: "YouTube",
    href: SITE.social.youtube,
    size: 17,
    outline: false,
    icon: '<path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2 31.4 31.4 0 000 12a31.4 31.4 0 00.5 5.8 3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1A31.4 31.4 0 0024 12a31.4 31.4 0 00-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/>',
  },
  {
    label: "GitHub",
    href: SITE.social.github,
    size: 16,
    outline: false,
    icon: '<path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.338c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z"/>',
  },
];

const expertise = [
  { label: "Advanced Blockchain Development",  href: "/blockchain-development-services" },
  { label: "Innovative Web & Mobile Development", href: "/innovative-web-and-mobile-solutions" },
  { label: "Product Discovery",                href: "/product-discovery" },
  { label: "IT Staff Augmentation",            href: "/staff-augmentation" },
  { label: "BlockAudit: Blockchain Security",  href: "/blockaudit-smart-contract-and-blockchain-security" },
];

const about = [
  { label: "About us",              href: "/about-us" },
  { label: "Our work",              href: "/our-work" },
  { label: "Learn",                 href: "/blog" },
  { label: "Careers",               href: "/careers" },
  { label: "Events calendar",       href: "/events-calendar" },
  { label: "SpaceDev in the media", href: "/spacedev-in-the-media" },
  { label: "Newsletter",            href: "/newsletter" },
  { label: "FAQs",                  href: "/faqs" },
];
---

<div class={`py-6 overflow-hidden ${marqueeTheme === "dark" ? "bg-sd-dark border-t border-white/10" : "bg-sd-light border-t border-sd-gray-border"}`} aria-label={marqueeText}>
  <div class="sd-marquee-wrapper">
    <div class="sd-marquee flex items-center whitespace-nowrap" style="animation-duration: 25s">
      {/* First item: real HTML text, indexable and readable */}
      <span class="text-5xl md:text-7xl lg:text-8xl font-display font-semibold tracking-tight mr-20"
            style="background: linear-gradient(90deg, #673ae4 0%, #44cdf3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        {marqueeText} &nbsp;
      </span>
      {/* Visual duplicates for the scroll loop — hidden from assistive tech */}
      {[...Array(3)].map(() => (
        <span class="text-5xl md:text-7xl lg:text-8xl font-display font-semibold tracking-tight mr-20"
              aria-hidden="true"
              style="background: linear-gradient(90deg, #673ae4 0%, #44cdf3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          {marqueeText} &nbsp;
        </span>
      ))}
    </div>
  </div>
</div>

<footer class="bg-sd-dark text-white">

  <!-- ── Top tagline bar ─────────────────────────────────────────── -->
  <div class="mx-auto max-w-[1440px] px-6 md:px-10 pt-20 pb-14 border-b border-white/10">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-8">
      <p class="font-body font-normal text-white max-w-3xl" style="font-size:clamp(24px,3.5vw,48px);line-height:1.2">
        SpaceDev is a blockchain and software development partner helping companies
        build, audit, and scale secure Web3 products for real-world use cases.
      </p>
      <div class="shrink-0 self-start md:self-auto">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-7 py-3 rounded-full border border-white/60 text-white font-body font-normal hover:bg-white hover:text-sd-dark transition-colors whitespace-nowrap"
          style="font-size:16px;line-height:1.5"
        >
          Get in touch
        </a>
      </div>
    </div>
  </div>

  <!-- ── 4-column links grid ────────────────────────────────────── -->
  <div class="mx-auto max-w-[1440px] px-6 md:px-10 pt-14 pb-16">
    <div class="grid gap-12 sm:grid-cols-2 md:grid-cols-4">

      <!-- Our Hubs -->
      <div>
        <h3 class="font-body font-normal text-white mb-6" style="font-size:18px;line-height:1.3">Our Hubs</h3>
        <ul class="space-y-5">
          {offices.map((h) => (
            <li>
              <p class="font-body font-normal text-white" style="font-size:15px;line-height:1.4">
                {h.country} - {h.address}
              </p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Our Expertise -->
      <div>
        <h3 class="font-body font-normal text-white mb-6" style="font-size:18px;line-height:1.3">Our Expertise</h3>
        <ul class="space-y-4">
          {expertise.map((s) => (
            <li>
              <a
                href={s.href}
                class="font-body font-normal text-white/70 hover:text-white transition-colors"
                style="font-size:15px;line-height:1.4"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h3 class="font-body font-normal text-white mb-6" style="font-size:18px;line-height:1.3">About</h3>
        <ul class="space-y-4">
          {about.map((s) => (
            <li>
              <a
                href={s.href}
                class="font-body font-normal text-white/70 hover:text-white transition-colors"
                style="font-size:15px;line-height:1.4"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact us -->
      <div>
        <h3 class="font-body font-normal text-white mb-6" style="font-size:18px;line-height:1.3">Contact us</h3>
        <ul class="space-y-4">
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="font-body font-normal text-white/70 hover:text-white transition-colors"
              style="font-size:15px;line-height:1.4"
            >
              {SITE.email}
            </a>
          </li>

          <li>
            <p class="font-body font-normal text-white/70" style="font-size:15px;line-height:1.4">
              Join us:<br/>
              <a href="mailto:people@spacedev.io" class="hover:text-white transition-colors">
                people@spacedev.io
              </a>
            </p>
          </li>
        </ul>

        <!-- Certifications -->
        <div class="mt-8 flex items-center gap-4">
          <a href="https://www.iso.org/es/norma/27001" target="_blank" rel="noopener noreferrer">
            <img
              src="/images/icons/iso-logo.png"
              alt="logo de iso 27001:2022"
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
              class="h-[110px] w-auto opacity-80"
            />
          </a>
          <img
            src="/images/icons/soc2.png"
            alt="SOC 2 certified"
            width="768"
            height="640"
            loading="lazy"
            decoding="async"
            class="h-[110px] w-auto opacity-80"
          />
        </div>
      </div>

    </div>

    <!-- ── Bottom bar: logo + socials ──────────────────────────── -->
    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

      <!-- Wordmark + legal links -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
        <a href="/" aria-label="SpaceDev home">
          <img
            src="/images/logo/spacedev-wordmark.webp"
            alt="SpaceDev"
            width="246"
            height="69"
            loading="lazy"
            decoding="async"
            class="h-6 w-auto"
          />
        </a>
        <div class="flex items-center gap-4">
          <a href="/terms-and-conditions" class="text-xs text-white/50 hover:text-white transition-colors">Terms & Conditions</a>
          <span class="text-white/20 text-xs">·</span>
          <a href="/privacy-policy" class="text-xs text-white/50 hover:text-white transition-colors">Privacy Policy</a>
        </div>
      </div>

      <!-- Social icon circles -->
      <ul class="flex items-center gap-3" aria-label="Social media">
        {socialLinks.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="inline-flex w-10 h-10 items-center justify-center rounded-full border border-white/40 text-white hover:border-white hover:bg-white/10 transition-colors"
            >
              <svg
                width={social.size}
                height={social.size}
                viewBox="0 0 24 24"
                fill={social.outline ? "none" : "currentColor"}
                stroke={social.outline ? "currentColor" : undefined}
                stroke-width={social.outline ? "1.8" : undefined}
                aria-hidden="true"
                set:html={social.icon}
              />
            </a>
          </li>
        ))}
      </ul>

    </div>
  </div>

</footer>
