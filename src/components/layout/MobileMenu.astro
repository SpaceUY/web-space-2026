---
interface NavItem { label: string; href: string }
interface Props {
  blockchainItems: NavItem[];
  otherExpertise: NavItem[];
  industries: NavItem[];
  about: NavItem[];
}
const { blockchainItems, otherExpertise, industries, about } = Astro.props;
---

<div
  id="mobile-menu"
  style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; background: #141414; opacity: 0; transition: opacity 0.25s ease; overflow-y: auto;"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
>
  <div class="flex items-center justify-between h-[72px] px-6 border-b border-white/5">
    <a href="/" class="flex items-center" aria-label="SpaceDev home">
      <img src="/images/logo/spacedev-wordmark.png" alt="SpaceDev" width="123" height="24" class="w-[123px] h-auto" />
    </a>
    <button
      type="button"
      class="inline-flex items-center justify-center w-10 h-10 text-white"
      aria-label="Close menu"
      data-mobile-menu-close
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <nav class="px-6 py-8" aria-label="Mobile">

    <!-- Our Expertise accordion -->
    <details class="border-b border-white/10 py-4">
      <summary class="flex items-center justify-between cursor-pointer text-lg text-white">
        Our Expertise
        <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <div class="mt-4 pl-2">
        <!-- Blockchain section -->
        <a href="/blockchain-development-services" class="flex items-center justify-between py-2 text-white text-base font-medium">
          Blockchain Development
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <ul class="pl-3 mb-3 space-y-1">
          {blockchainItems.map((item) => (
            <li><a href={item.href} class="block py-1.5 text-sd-text-muted hover:text-white text-sm">{item.label}</a></li>
          ))}
        </ul>
        <div class="border-t border-white/10 my-3"></div>
        <!-- Other services -->
        <ul class="space-y-2">
          {otherExpertise.map((item) => (
            <li><a href={item.href} class="block py-2 text-sd-text-muted hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </details>

    <!-- Industries accordion -->
    <details class="border-b border-white/10 py-4">
      <summary class="flex items-center justify-between cursor-pointer text-lg text-white">
        Industries
        <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <ul class="mt-4 space-y-3 pl-2">
        {industries.map((item) => (
          <li><a href={item.href} class="block py-2 text-sd-text-muted hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </details>

    <a href="/our-work" class="block border-b border-white/10 py-5 text-lg text-white">Our Work</a>

    <!-- About accordion -->
    <details class="border-b border-white/10 py-4">
      <summary class="flex items-center justify-between cursor-pointer text-lg text-white">
        About
        <svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <ul class="mt-4 space-y-3 pl-2">
        {about.map((item) => (
          <li><a href={item.href} class="block py-2 text-sd-text-muted hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </details>

    <a href="/blog" class="block border-b border-white/10 py-5 text-lg text-white">Learn</a>

    <a
      href="/contact"
      class="mt-8 inline-flex w-full items-center justify-center px-5 py-3.5 rounded-full bg-sd-purple text-white text-base font-medium"
    >
      Get in touch
    </a>
  </nav>
</div>
