---
import MobileMenu from "./MobileMenu.astro";

const blockchainItems = [
  { label: "Smart Contract Development",  href: "/blockchain-development-services/smart-contract-development" },
  { label: "Asset Tokenization",          href: "/blockchain-development-services/asset-tokenization" },
  { label: "dApp Development",            href: "/blockchain-development-services/dapp-development" },
  { label: "Decentralized Identity",      href: "/blockchain-development-services/decentralized-identity" },
  { label: "Blockchain for Banks",        href: "/blockchain-development-services/blockchain-for-banks" },
  { label: "Blockchain Partner",          href: "/blockchain-development-services/blockchain-partner" },
  { label: "Layer-1 Development",         href: "/blockchain-development-services/layer-1-blockchain-development" },
];

const otherExpertise = [
  { label: "Innovative Web & Mobile",     href: "/innovative-web-and-mobile-solutions" },
  { label: "IT Staff Augmentation",       href: "/staff-augmentation" },
  { label: "Agentic AI Development",      href: "/agentic-ai-development" },
  { label: "Product Discovery",           href: "/product-discovery" },
  { label: "BlockAudit: Blockchain Security", href: "/blockaudit-smart-contract-and-blockchain-security" },
];

const industries = [
  { label: "Energy",                   href: "/blockchain-development-services/industry/energy" },
  { label: "Finance & Fintech",        href: "/blockchain-development-services/industry/finance-and-fintech" },
  { label: "Healthcare",               href: "/blockchain-development-services/industry/healthcare" },
  { label: "Real Estate",              href: "/blockchain-development-services/industry/real-estate" },
  { label: "Supply Chain & Logistics", href: "/blockchain-development-services/industry/supply-chain-and-logistics" },
  { label: "Web3 Compliance",          href: "/blockchain-development-services/industry/compliance-web3" },
];

const about = [
  { label: "About Us",           href: "/about-us" },
  { label: "FAQs",               href: "/faqs" },
  { label: "Events Calendar",    href: "/events-calendar" },
  { label: "Space in the Media", href: "/spacedev-in-the-media" },
  { label: "Careers",            href: "/careers" },
];
---

<header id="site-header" class="sticky top-0 z-50 bg-sd-dark/95 backdrop-blur-md border-b border-white/10 transition-transform duration-300">
  <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>

  <div class="mx-auto max-w-[1440px] px-6 md:px-10 h-[72px] flex items-center justify-between gap-8">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="SpaceDev home">
      <img
        src="/images/logo/spacedev-wordmark.png"
        alt="SpaceDev"
        width="123"
        height="24"
        class="w-[123px] h-auto"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden md:flex items-center" aria-label="Primary">
      <div class="rounded-full px-2 flex items-center gap-1" style="background: rgba(240,240,240,0.92); border: 1px solid rgba(200,200,200,0.5);">

        <!-- Our Expertise -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-5 py-[4px] text-[20px] font-normal text-sd-text-dark group-hover:bg-sd-purple group-hover:text-white transition-colors rounded-full" aria-haspopup="true" aria-expanded="false">
            Our Expertise
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-sd-purple-mid rounded-xl p-3 min-w-[340px] shadow-xl">
              <!-- Blockchain section -->
              <a href="/blockchain-development-services" class="flex items-center justify-between px-4 py-2 rounded-lg text-white hover:bg-white/10 transition-colors text-[15px] font-medium mb-1">
                Blockchain Development
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <ul class="pl-3 mb-2">
                {blockchainItems.map((item) => (
                  <li>
                    <a href={item.href} class="block px-3 py-1.5 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-colors text-[14px] whitespace-nowrap">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
              <div class="border-t border-white/10 my-2"></div>
              <!-- Other services -->
              <ul>
                {otherExpertise.map((item) => (
                  <li>
                    <a href={item.href} class="block px-4 py-2 rounded-lg text-white hover:bg-white/10 transition-colors text-[15px] whitespace-nowrap">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Industries -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-5 py-[4px] text-[20px] font-normal text-sd-text-dark group-hover:bg-sd-purple group-hover:text-white transition-colors rounded-full" aria-haspopup="true" aria-expanded="false">
            Industries
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <ul class="bg-sd-purple-mid rounded-xl p-2 min-w-[240px] shadow-xl">
              {industries.map((item) => (
                <li>
                  <a href={item.href} class="block px-4 py-2 rounded-lg text-white hover:bg-white/10 transition-colors text-[16px] py-[6px]">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href="/our-work" class="px-5 py-[4px] text-[20px] font-normal text-sd-text-dark hover:text-sd-purple transition-colors rounded-full">Our Work</a>

        <!-- About -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-5 py-[4px] text-[20px] font-normal text-sd-text-dark group-hover:bg-sd-purple group-hover:text-white transition-colors rounded-full" aria-haspopup="true" aria-expanded="false">
            About
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <ul class="bg-sd-purple-mid rounded-xl p-2 min-w-[220px] shadow-xl">
              {about.map((item) => (
                <li>
                  <a href={item.href} class="block px-4 py-2 rounded-lg text-white hover:bg-white/10 transition-colors text-[16px] py-[6px]">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href="/blog" class="px-5 py-[4px] text-[20px] font-normal text-sd-text-dark hover:text-sd-purple transition-colors rounded-full">Learn</a>
      </div>
    </nav>

    <div class="hidden md:block">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-white/30 text-white text-sm font-medium bg-transparent hover:bg-white/10 transition-colors"
      >
        Get in touch
      </a>
    </div>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 text-white"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-mobile-menu-toggle
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

</header>
<MobileMenu blockchainItems={blockchainItems} otherExpertise={otherExpertise} industries={industries} about={about} />

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-mobile-menu-close]");

  function openMenu() {
    if (!menu || !toggle) return;
    menu.style.display = "block";
    requestAnimationFrame(() => { menu.style.opacity = "1"; });
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    header?.style.setProperty("transform", "translateY(0)");
  }
  function closeMenu() {
    if (!menu || !toggle) return;
    menu.style.opacity = "0";
    setTimeout(() => { menu.style.display = "none"; }, 250);
    toggle.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.classList.contains("hidden")) closeMenu();
  });

  const header = document.getElementById("site-header");
  let lastY = 0;
  const THRESHOLD = 80;

  window.addEventListener("scroll", () => {
    if (menu && menu.style.display === "block") return;
    const currentY = window.scrollY;
    if (currentY <= THRESHOLD) {
      header?.style.setProperty("transform", "translateY(0)");
    } else if (currentY > lastY) {
      header?.style.setProperty("transform", "translateY(-100%)");
    } else {
      header?.style.setProperty("transform", "translateY(0)");
    }
    lastY = currentY;
  }, { passive: true });
</script>
