---
import MobileMenu from "./MobileMenu.astro";

const expertise = [
  { label: "Advanced Blockchain Development",     href: "/blockchain-development-services" },
  { label: "Innovative Web & Mobile Development", href: "/innovative-web-and-mobile-solutions" },
  { label: "IT Staff Augmentation",               href: "/staff-augmentation" },
  { label: "Product Discovery",                   href: "/product-discovery" },
  { label: "BlockAudit: Blockchain Security",     href: "/blockaudit-smart-contract-and-blockchain-security" },
];

const explore = [
  { label: "Blog", href: "/blog" },
  { label: "FAQs", href: "/faqs" },
  { label: "Events Calendar", href: "/events-calendar" },
  { label: "Newsletter", href: "/newsletter" },
  { label: "Digital Library", href: "/digital-library" },
];
---

<header id="site-header" class="sticky top-0 z-50 bg-sd-dark/80 backdrop-blur-md border-b border-white/5 transition-transform duration-300">
  <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>

  <div class="mx-auto max-w-[1440px] px-6 md:px-10 h-[72px] flex items-center justify-between gap-8">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="SpaceDev home">
      <img
        src="/images/logo/spacedev-wordmark.png"
        alt="SpaceDev"
        width="123"
        height="24"
        class="w-[123px] h-auto"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden md:flex items-center" aria-label="Primary">
      <div class="rounded-full px-2 flex items-center gap-1" style="background: rgba(240,240,240,0.92); border: 1px solid rgba(200,200,200,0.5);">
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-5 py-2.5 text-[20px] font-normal text-sd-text-dark group-hover:bg-sd-purple group-hover:text-white transition-colors rounded-full" aria-haspopup="true" aria-expanded="false">
            Our Expertise
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <ul class="bg-sd-purple-mid rounded-xl p-2 min-w-[320px] shadow-xl">
              {expertise.map((item) => (
                <li>
                  <a href={item.href} class="block px-4 py-2.5 rounded-lg text-white hover:bg-white/10 transition-colors text-[20px] whitespace-nowrap">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a href="/our-work" class="px-5 py-2.5 text-[20px] font-normal text-sd-text-dark hover:text-sd-purple transition-colors rounded-full">Our Work</a>
        <a href="/careers" class="px-5 py-2.5 text-[20px] font-normal text-sd-text-dark hover:text-sd-purple transition-colors rounded-full">Careers</a>
        <a href="/about-us" class="px-5 py-2.5 text-[20px] font-normal text-sd-text-dark hover:text-sd-purple transition-colors rounded-full">About</a>

        <div class="relative group">
          <button class="flex items-center gap-1.5 px-5 py-2.5 text-[20px] font-normal text-sd-text-dark group-hover:bg-sd-purple group-hover:text-white transition-colors rounded-full" aria-haspopup="true" aria-expanded="false">
            Explore
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <ul class="bg-sd-purple-mid rounded-xl p-2 min-w-[220px] shadow-xl">
              {explore.map((item) => (
                <li>
                  <a href={item.href} class="block px-4 py-2.5 rounded-lg text-white hover:bg-white/10 transition-colors text-[20px]">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </nav>

    <div class="hidden md:block">
      <a
        href="/contact"
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-white/30 text-white text-sm font-medium bg-transparent hover:bg-white/10 transition-colors"
      >
        Get in touch
      </a>
    </div>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center w-10 h-10 text-white"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-mobile-menu-toggle
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <MobileMenu expertise={expertise} explore={explore} />
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-menu-toggle]");
  const menu = document.getElementById("mobile-menu");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-mobile-menu-close]");

  function openMenu() {
    if (!menu || !toggle) return;
    menu.classList.remove("hidden");
    requestAnimationFrame(() => menu.classList.add("opacity-100"));
    toggle.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }
  function closeMenu() {
    if (!menu || !toggle) return;
    menu.classList.add("hidden");
    menu.classList.remove("opacity-100");
    toggle.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.classList.contains("hidden")) closeMenu();
  });

  // Hide on scroll down, show on scroll up
  const header = document.getElementById("site-header");
  let lastY = 0;
  const THRESHOLD = 80; // px past the top before hide/show kicks in

  window.addEventListener("scroll", () => {
    const currentY = window.scrollY;
    if (currentY <= THRESHOLD) {
      // Always show at the very top
      header?.style.setProperty("transform", "translateY(0)");
    } else if (currentY > lastY) {
      // Scrolling down — hide
      header?.style.setProperty("transform", "translateY(-100%)");
    } else {
      // Scrolling up — show
      header?.style.setProperty("transform", "translateY(0)");
    }
    lastY = currentY;
  }, { passive: true });
</script>
