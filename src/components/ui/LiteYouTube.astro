---
import { youtubeThumbnailUrl } from "../../data/videos";

/**
 * YouTube embed that loads nothing from YouTube until someone presses play.
 *
 * The stock iframe pulls several hundred KB of player JavaScript on every page
 * view, whether or not the video is watched. This shows the thumbnail instead
 * and swaps in a youtube-nocookie iframe on click. The iframe host has to stay
 * listed in the frame-src of the Content-Security-Policy in vercel.json.
 */
interface Props {
  youtubeId: string;
  title: string;
  /** Eager-load the thumbnail when the player sits above the fold. */
  eager?: boolean;
  class?: string;
}

const { youtubeId, title, eager = false, class: className = "" } = Astro.props;
const fallbackThumbnail = youtubeThumbnailUrl(youtubeId, "hqdefault");
---

<div class={`relative aspect-video overflow-hidden rounded-2xl bg-sd-dark ${className}`}>
  <button
    type="button"
    class="sd-lite-yt group absolute inset-0 h-full w-full cursor-pointer"
    data-youtube-id={youtubeId}
    data-title={title}
    aria-label={`Play video: ${title}`}
  >
    <img
      src={youtubeThumbnailUrl(youtubeId)}
      onerror={`this.onerror=null;this.src='${fallbackThumbnail}'`}
      alt=""
      width="1280"
      height="720"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
    />
    <span
      class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white transition-colors duration-200 group-hover:bg-red-600"
      aria-hidden="true"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="ml-1"><path d="M8 5v14l11-7z" /></svg>
    </span>
  </button>
</div>

<script is:inline>
  // Inline on purpose (see the sdTrack note in CLAUDE.md): a bundled script
  // shared by the blog and /videos would add a network round trip. The flag
  // keeps a page with several players to a single listener.
  if (!window.__sdLiteYouTube) {
    window.__sdLiteYouTube = true;
    document.addEventListener("click", (event) => {
      const button = event.target instanceof Element ? event.target.closest(".sd-lite-yt") : null;
      if (!button) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${button.dataset.youtubeId}?autoplay=1&rel=0`;
      iframe.title = button.dataset.title || "YouTube video";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 h-full w-full";
      button.replaceWith(iframe);
    });
  }
</script>
