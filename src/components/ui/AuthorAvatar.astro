---
import type { Author } from "../../data/authors";

interface Props {
  author: Author;
  size?: "sm" | "md" | "lg" | "xl";
  showName?: boolean;
  showRole?: boolean;
  tone?: "dark" | "light";
  class?: string;
  /** Override the name's text size class for this instance only, without affecting the shared size presets. */
  nameClass?: string;
  /** Override the role's text size class for this instance only, without affecting the shared size presets. */
  roleClass?: string;
  /** Override the avatar's wrapper size class (width/height) for this instance only, without affecting the shared size presets. */
  avatarClass?: string;
}

const { author, size = "md", showName = true, showRole = false, tone = "dark", class: className = "", nameClass, roleClass, avatarClass } = Astro.props;

const sizes = {
  sm: { wrapper: "w-8 h-8",   px: 64,  text: "text-xs",  name: "text-xs",  role: "text-[10px]" },
  md: { wrapper: "w-10 h-10", px: 80,  text: "text-sm",  name: "text-sm",  role: "text-xs" },
  lg: { wrapper: "w-14 h-14", px: 112, text: "text-lg",  name: "text-base", role: "text-sm" },
  xl: { wrapper: "w-16 h-16", px: 128, text: "text-xl",  name: "text-sm",  role: "text-xs" },
};
const s = sizes[size];
---

<div class={`flex items-center gap-3 ${className}`.trim()}>
  {author.avatar ? (
    <img
      src={author.avatar}
      alt={`${author.name} portrait`}
      width={s.px}
      height={s.px}
      loading="lazy"
      class={`${avatarClass ?? s.wrapper} rounded-full object-cover object-top shrink-0 border border-white/10`}
    />
  ) : (
    <div
      class={`${avatarClass ?? s.wrapper} rounded-full bg-gradient-to-br ${author.avatarGradient} flex items-center justify-center font-display font-semibold text-white shrink-0`}
      aria-hidden="true"
    >
      <span class={s.text}>{author.initials}</span>
    </div>
  )}
  {showName && (
    <div class="leading-tight">
      <p class={`${nameClass ?? s.name} ${tone === "light" ? "text-sd-text-dark" : "text-white"}`}>{author.name}</p>
      {showRole && <p class={`${roleClass ?? s.role} ${tone === "light" ? "text-sd-text-gray" : "text-sd-text-muted"}`}>{author.role}</p>}
    </div>
  )}
</div>
