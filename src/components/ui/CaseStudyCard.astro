---
import type { CaseStudy } from "../../data/case-studies";

interface Props {
  caseStudy: CaseStudy;
  /** Full-width editorial card (every 4th in the rhythm) */
  featured?: boolean;
  class?: string;
}

const { caseStudy, featured = false, class: className = "" } = Astro.props;

const accentGradients: Record<NonNullable<CaseStudy["accent"]>, string> = {
  purple: "from-sd-purple to-sd-purple-2",
  cyan:   "from-sd-purple-300 to-sd-purple",
  green:  "from-sd-green to-sd-purple-300",
  mixed:  "from-sd-purple via-sd-purple-400 to-sd-green",
};

const gradient = accentGradients[caseStudy.accent ?? "purple"];
---

{featured ? (

  <!-- ── FEATURED — horizontal, image left + dark panel right ── -->
  <!-- group on the <a> so child group-hover: classes react to card hover -->
  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`group sm:col-span-2 md:col-span-3 grid grid-cols-1 sm:grid-cols-[3fr_2fr] overflow-hidden rounded-2xl ${className}`.trim()}
    data-category={caseStudy.category}
    data-animate
  >
    <!-- Image -->
    <div class="relative aspect-[4/3] sm:aspect-auto overflow-hidden">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      ) : (
        <div class={`absolute inset-0 bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- Dark content panel -->
    <div class="bg-[#141414] p-8 sm:p-10 flex flex-col justify-between min-h-[280px] sm:min-h-[380px]">
      <!-- Category + service tags -->
      <div class="flex flex-wrap gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white/10 text-[10px] uppercase tracking-wider text-white/60 border border-white/10">
          {caseStudy.category}
        </span>
        {caseStudy.services?.slice(0, 2).map((s) => (
          <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white/[0.05] text-[10px] text-white/50 border border-white/10">
            {s}
          </span>
        ))}
      </div>

      <!-- Name + tagline + button -->
      <div>
        {caseStudy.highlight && (
          <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-sd-purple/20 text-[10px] text-sd-purple-300 border border-sd-purple/30 mb-4 w-fit block">
            {caseStudy.highlight}
          </span>
        )}
        <h3 class="text-2xl sm:text-3xl text-white font-display font-semibold leading-tight mb-3">
          {caseStudy.name}
        </h3>
        <p class="text-sm text-white/50 leading-relaxed mb-6">{caseStudy.tagline}</p>

        <!-- Button reacts to the whole card hover via group-hover: -->
        <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-white/10 text-sm text-white border border-white/15 group-hover:bg-sd-purple group-hover:border-sd-purple transition-all duration-200">
          View case study
          <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>
  </a>

) : (

  <!-- ── REGULAR card — Articulate style: no box, content below image ── -->
  <!-- group on <a> so button reacts to hovering anywhere on the card -->
  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`group block cursor-pointer ${className}`.trim()}
    data-category={caseStudy.category}
    data-animate
  >
    <!-- Image — rounded, zooms on card hover -->
    <div class="overflow-hidden rounded-2xl mb-6 aspect-[4/3]">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- Content below image — always visible -->
    <h3 class="text-xl font-display font-semibold text-sd-text-dark leading-snug mb-4">
      {caseStudy.name}
    </h3>
    <p class="text-sm text-sd-text-gray leading-relaxed mb-5 line-clamp-2">
      {caseStudy.tagline}
    </p>

    <!-- Button — color changes on whole-card hover (group-hover:) -->
    <span class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-sd-text-dark text-white text-sm font-medium group-hover:bg-sd-purple transition-colors duration-200">
      View case study
      <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </a>

)}
