---
import type { CaseStudy } from "../../data/case-studies";

interface Props {
  caseStudy: CaseStudy;
  featured?: boolean;
  dark?: boolean;
  class?: string;
}

const { caseStudy, featured = false, dark = false, class: className = "" } = Astro.props;

const accentGradients: Record<NonNullable<CaseStudy["accent"]>, string> = {
  purple: "from-sd-purple to-sd-purple-2",
  cyan:   "from-sd-purple-300 to-sd-purple",
  green:  "from-sd-green to-sd-purple-300",
  mixed:  "from-sd-purple via-sd-purple-400 to-sd-green",
};

const gradient = accentGradients[caseStudy.accent ?? "purple"];

// Pills: group-hover so all light up together with the card hover
const tagBase    = "inline-flex items-center px-2.5 py-1 rounded-md text-[10px] border transition-all duration-200 cursor-default";
const tagCategory = dark
  ? `${tagBase} bg-white/10 text-white/60 border-white/10 group-hover:border-sd-purple group-hover:text-sd-purple-300 group-hover:font-semibold`
  : `${tagBase} bg-sd-light-2 text-sd-text-gray border-sd-gray-border group-hover:border-sd-purple group-hover:text-sd-purple group-hover:font-semibold`;
const tagService = dark
  ? `${tagBase} bg-white/[0.05] text-white/50 border-white/10 group-hover:border-sd-purple group-hover:text-sd-purple-300 group-hover:font-semibold`
  : `${tagBase} bg-sd-light-2 text-sd-text-gray border-sd-gray-border group-hover:border-sd-purple group-hover:text-sd-purple group-hover:font-semibold`;

// Card shell — subtle white bg with border, slightly off the page bg
const cardShell = dark
  ? "bg-white/[0.04] border border-white/10"
  : "bg-white border border-sd-gray-border";

const textTitle = dark ? "text-white"    : "text-sd-text-dark";
const textBody  = dark ? "text-white/55" : "text-sd-text-gray";
const textLink  = dark
  ? "text-white/60 group-hover:text-sd-purple-300"
  : "text-sd-text-gray group-hover:text-sd-purple";
---

{featured ? (

  <!--
    ── FEATURED — image LEFT, content RIGHT
       overflow-hidden on the <a> clips image corners into card shape.
  -->
  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`group col-span-2 flex items-stretch h-full rounded-xl overflow-hidden cursor-pointer ${cardShell} ${className}`.trim()}
    data-category={caseStudy.industry ?? caseStudy.category}
    data-animate
  >
    <!-- LEFT: image — fills full row height via items-stretch -->
    <div class="w-[52%] shrink-0">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover object-top transition-transform duration-[1400ms] ease-out group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- RIGHT: content — padding, pills close to name, tagline fills space -->
    <div class="flex flex-col flex-1 p-7">
      <!-- Pills — directly above name, small gap -->
      <div class="flex flex-wrap gap-2 mb-2.5">
        <span class={`${tagCategory} uppercase tracking-wider`}>
          {caseStudy.category}
        </span>
        {caseStudy.services?.slice(0, 3).map((s) => (
          <span class={tagService}>{s}</span>
        ))}
      </div>

      <!-- Name — right below pills -->
      <h3 class={`text-xl font-display font-semibold leading-snug mb-3 ${textTitle}`}>
        {caseStudy.name}
      </h3>

      <!-- Tagline — flex-1 pushes link to bottom -->
      <p class={`flex-1 text-sm leading-relaxed line-clamp-3 ${textBody}`}>
        {caseStudy.tagline}
      </p>

      <!-- Link — anchored to bottom -->
      <span class={`mt-5 inline-flex items-center gap-1.5 text-sm transition-all duration-200 group-hover:font-semibold ${textLink}`}>
        View case study
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </a>

) : (

  <!--
    ── REGULAR — image top (fixed height), content below with padding.
       overflow-hidden on the <a> clips image top corners.
  -->
  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`group flex flex-col h-full rounded-xl overflow-hidden cursor-pointer ${cardShell} ${className}`.trim()}
    data-category={caseStudy.industry ?? caseStudy.category}
    data-animate
  >
    <!-- Image -->
    <div class="shrink-0 h-[224px]">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover object-top transition-transform duration-1000 ease-out group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- Content with padding -->
    <div class="flex flex-col flex-1 p-5">
      <!-- Pills — close to name -->
      <div class="flex flex-wrap gap-2 mb-2.5">
        <span class={`${tagCategory} uppercase tracking-wider`}>
          {caseStudy.category}
        </span>
        {caseStudy.services?.slice(0, 2).map((s) => (
          <span class={tagService}>{s}</span>
        ))}
      </div>

      <!-- Name -->
      <h3 class={`text-xl font-display font-semibold leading-snug mb-3 ${textTitle}`}>
        {caseStudy.name}
      </h3>

      <!-- Tagline — flex-1 pushes link to bottom -->
      <p class={`flex-1 text-sm leading-relaxed line-clamp-2 ${textBody}`}>
        {caseStudy.tagline}
      </p>

      <!-- Link -->
      <span class={`mt-4 inline-flex items-center gap-1.5 text-sm transition-all duration-200 group-hover:font-semibold ${textLink}`}>
        View case study
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </a>

)}
