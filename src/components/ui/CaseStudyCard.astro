---
import type { CaseStudy } from "../../data/case-studies";

interface Props {
  caseStudy: CaseStudy;
  /** Wide card spanning 2 columns */
  featured?: boolean;
  /** Dark page background — adjusts text colors */
  dark?: boolean;
  class?: string;
}

const { caseStudy, featured = false, dark = false, class: className = "" } = Astro.props;

const accentGradients: Record<NonNullable<CaseStudy["accent"]>, string> = {
  purple: "from-sd-purple to-sd-purple-2",
  cyan:   "from-sd-purple-300 to-sd-purple",
  green:  "from-sd-green to-sd-purple-300",
  mixed:  "from-sd-purple via-sd-purple-400 to-sd-green",
};

const gradient = accentGradients[caseStudy.accent ?? "purple"];

// Pills — hover turns text bold + purple (same feel as "View case study")
const tagCategory = dark
  ? "bg-white/10 text-white/60 border-white/10 hover:border-sd-purple hover:text-sd-purple-300 hover:font-semibold"
  : "bg-sd-light-3 text-sd-text-gray border-sd-gray-border hover:border-sd-purple hover:text-sd-purple hover:font-semibold";
const tagService = dark
  ? "bg-white/[0.05] text-white/50 border-white/10 hover:border-sd-purple hover:text-sd-purple-300 hover:font-semibold"
  : "bg-white text-sd-text-gray border-sd-gray-border hover:border-sd-purple hover:text-sd-purple hover:font-semibold";

const textTitle = dark ? "text-white"    : "text-sd-text-dark";
const textBody  = dark ? "text-white/55" : "text-sd-text-gray";
const textLink  = dark
  ? "text-white/60 group-hover:text-sd-purple-300"
  : "text-sd-text-gray group-hover:text-sd-purple";
---

{featured ? (

  <!--
    ── FEATURED — 2-col wide card
       Image uses a fixed pixel height (same as regular) so both card types
       occupy the same vertical space in the row.
  -->
  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`group col-span-2 flex flex-col h-full cursor-pointer ${className}`.trim()}
    data-category={caseStudy.industry ?? caseStudy.category}
    data-animate
  >
    <!-- Fixed-height image — same h-[224px] as regular card -->
    <div class="shrink-0 overflow-hidden rounded-xl mb-5 h-[224px]">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- Content grows to fill remaining cell height -->
    <div class="flex flex-col flex-1">
      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-4">
        <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[10px] uppercase tracking-wider border transition-all duration-150 cursor-default ${tagCategory}`}>
          {caseStudy.category}
        </span>
        {caseStudy.services?.slice(0, 3).map((s) => (
          <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[10px] border transition-all duration-150 cursor-default ${tagService}`}>
            {s}
          </span>
        ))}
      </div>

      <!-- Name — same size as regular to keep row heights equal -->
      <h3 class={`text-xl font-display font-semibold leading-snug mb-3 ${textTitle}`}>
        {caseStudy.name}
      </h3>

      <!-- Tagline — flex-1 pushes link to bottom -->
      <p class={`flex-1 text-sm leading-relaxed mb-5 line-clamp-2 ${textBody}`}>
        {caseStudy.tagline}
      </p>

      <!-- Link — always at the bottom -->
      <span class={`inline-flex items-center gap-1.5 text-sm transition-all duration-200 group-hover:font-semibold ${textLink}`}>
        View case study
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </a>

) : (

  <!--
    ── REGULAR card — same fixed image height as featured.
  -->
  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`group flex flex-col h-full cursor-pointer ${className}`.trim()}
    data-category={caseStudy.industry ?? caseStudy.category}
    data-animate
  >
    <!-- Fixed-height image -->
    <div class="shrink-0 overflow-hidden rounded-xl mb-5 h-[224px]">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- Content grows to fill remaining cell height -->
    <div class="flex flex-col flex-1">
      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-3">
        <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[10px] uppercase tracking-wider border transition-all duration-150 cursor-default ${tagCategory}`}>
          {caseStudy.category}
        </span>
        {caseStudy.services?.slice(0, 2).map((s) => (
          <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-[10px] border transition-all duration-150 cursor-default ${tagService}`}>
            {s}
          </span>
        ))}
      </div>

      <!-- Name -->
      <h3 class={`text-xl font-display font-semibold leading-snug mb-3 ${textTitle}`}>
        {caseStudy.name}
      </h3>

      <!-- Tagline — flex-1 pushes link to bottom -->
      <p class={`flex-1 text-sm leading-relaxed mb-4 line-clamp-2 ${textBody}`}>
        {caseStudy.tagline}
      </p>

      <!-- Link — always at the bottom -->
      <span class={`inline-flex items-center gap-1.5 text-sm transition-all duration-200 group-hover:font-semibold ${textLink}`}>
        View case study
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="opacity-0 group-hover:opacity-100 transition-opacity duration-200">
          <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </a>

)}
