---
import type { CaseStudy } from "../../data/case-studies";

interface Props {
  caseStudy: CaseStudy;
  class?: string;
}

const { caseStudy, class: className = "" } = Astro.props;

const accentGradients: Record<NonNullable<CaseStudy["accent"]>, string> = {
  purple: "from-sd-purple to-sd-purple-2",
  cyan:   "from-sd-purple-300 to-sd-purple",
  green:  "from-sd-green to-sd-purple-300",
  mixed:  "from-sd-purple via-sd-purple-400 to-sd-green",
};

const gradient = accentGradients[caseStudy.accent ?? "purple"];
---

<a
  href={`/case-study/${caseStudy.slug}`}
  class={`group relative block rounded-2xl overflow-hidden bg-sd-light-2 transition-all duration-300 hover:-translate-y-1 hover:shadow-md ${className}`.trim()}
  data-category={caseStudy.category}
  data-animate
>
  <div class={`relative aspect-[4/3] ${caseStudy.image ? '' : `bg-gradient-to-br ${gradient}`} overflow-hidden`}>
    {caseStudy.image && (
      <img
        src={caseStudy.image}
        alt={caseStudy.name}
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    )}
    {!caseStudy.image && (
      <div class="absolute inset-0 opacity-30 mix-blend-overlay" style="background-image: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.4), transparent 60%);"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
    <span class="absolute top-4 left-4 inline-flex items-center px-2.5 py-1 rounded-full bg-black/40 backdrop-blur-md text-[10px] uppercase tracking-wider text-white border border-white/20">
      {caseStudy.category}
    </span>
  </div>
  <div class="p-6">
    <h3 class="text-xl text-sd-text-dark">{caseStudy.name}</h3>
    <p class="mt-2 text-sm text-sd-text-gray leading-relaxed">{caseStudy.tagline}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-sd-purple group-hover:gap-3 transition-all underline underline-offset-4 decoration-sd-purple/40 group-hover:decoration-sd-purple">
      Read case study
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</a>
