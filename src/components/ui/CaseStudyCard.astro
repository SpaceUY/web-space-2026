---
import type { CaseStudy } from "../../data/case-studies";

interface Props {
  caseStudy: CaseStudy;
  featured?: boolean;
  dark?: boolean;
  class?: string;
}

const { caseStudy, featured = false, dark = false, class: className = "" } = Astro.props;

const accentGradients: Record<NonNullable<CaseStudy["accent"]>, string> = {
  purple: "from-sd-purple to-sd-purple-2",
  cyan:   "from-sd-purple-300 to-sd-purple",
  green:  "from-sd-green to-sd-purple-300",
  mixed:  "from-sd-purple via-sd-purple-400 to-sd-green",
};

const gradient = accentGradients[caseStudy.accent ?? "purple"];

// Pills — static
const tagBase     = "inline-flex items-center px-2.5 py-1 rounded-md text-[10px] border";
const tagCategory = dark
  ? `${tagBase} bg-white/10 text-white/60 border-white/10`
  : `${tagBase} bg-sd-light-2 text-sd-text-gray border-sd-gray-border`;
const tagService = dark
  ? `${tagBase} bg-white/[0.05] text-white/50 border-white/10`
  : `${tagBase} bg-sd-light-2 text-sd-text-gray border-sd-gray-border`;

// group on <a> so bar + image react to card hover
const cardShell = dark
  ? "group bg-white/[0.04]"
  : "group bg-sd-light-2";

const textTitle = dark ? "text-white"    : "text-sd-text-dark";
const textBody  = dark ? "text-white/55" : "text-sd-text-gray";
// same color as description by default, turns purple on card hover
const textLink  = dark
  ? "text-white/55 group-hover:text-sd-purple-300"
  : "text-sd-text-gray group-hover:text-sd-purple";
---

{featured ? (

  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`relative col-span-2 flex items-stretch h-full rounded-xl overflow-hidden ${cardShell} ${className}`.trim()}
    data-category={caseStudy.industry ?? caseStudy.category}
    data-animate
  >
    <!-- LEFT: image — zoom on card hover -->
    <div class="w-[52%] shrink-0 overflow-hidden">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- RIGHT: content — relative so the bar anchors here (starts at image boundary) -->
    <div class="relative flex flex-col flex-1 p-7">
      <div class="flex flex-wrap gap-2 mb-2.5">
        <span class={`${tagCategory} uppercase tracking-wider`}>{caseStudy.category}</span>
        {caseStudy.services?.slice(0, 3).map((s) => (
          <span class={tagService}>{s}</span>
        ))}
      </div>

      <h3 class={`text-xl font-display font-semibold leading-snug mb-3 ${textTitle}`}>
        {caseStudy.name}
      </h3>

      <p class={`flex-1 text-sm leading-relaxed line-clamp-3 ${textBody}`}>
        {caseStudy.tagline}
      </p>

      <span class={`mt-4 inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-200 ${textLink}`}>
        View case study
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>

      <!-- Bar anchored inside content panel — starts at image boundary -->
      <div
        class="absolute bottom-0 left-0 h-[3px] w-full origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-[600ms] ease-linear"
        style="background: #673ae4;"
        aria-hidden="true"
      ></div>
    </div>
  </a>

) : (

  <a
    href={`/case-study/${caseStudy.slug}`}
    class={`relative flex flex-col h-full rounded-xl overflow-hidden ${cardShell} ${className}`.trim()}
    data-category={caseStudy.industry ?? caseStudy.category}
    data-animate
  >
    <!-- Image — zoom on card hover -->
    <div class="shrink-0 h-[224px] overflow-hidden">
      {caseStudy.image ? (
        <img
          src={caseStudy.image}
          alt={caseStudy.name}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
        />
      ) : (
        <div class={`w-full h-full bg-gradient-to-br ${gradient}`}></div>
      )}
    </div>

    <!-- Content -->
    <div class="flex flex-col flex-1 p-5">
      <div class="flex flex-wrap gap-2 mb-2.5">
        <span class={`${tagCategory} uppercase tracking-wider`}>{caseStudy.category}</span>
        {caseStudy.services?.slice(0, 2).map((s) => (
          <span class={tagService}>{s}</span>
        ))}
      </div>

      <h3 class={`text-xl font-display font-semibold leading-snug mb-3 ${textTitle}`}>
        {caseStudy.name}
      </h3>

      <p class={`flex-1 text-sm leading-relaxed line-clamp-2 ${textBody}`}>
        {caseStudy.tagline}
      </p>

      <span class={`mt-4 inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-200 ${textLink}`}>
        View case study
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>

    <!-- Progress bar: scaleX 0→1 on group hover, origin-left -->
    <div
      class="absolute bottom-0 left-0 h-[3px] w-full origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-[600ms] ease-linear"
      style="background: #673ae4;"
      aria-hidden="true"
    ></div>
  </a>

)}
