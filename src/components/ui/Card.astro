---
type Variant = "dark" | "darker" | "light" | "outline" | "gradient-border";
type ElementTag = "div" | "article" | "section" | "li";

interface Props {
  variant?: Variant;
  href?: string;
  as?: ElementTag;
  class?: string;
  hover?: boolean;
}

const {
  variant = "dark",
  href,
  as = "div",
  class: className = "",
  hover = true,
}: Props = Astro.props;

const base = "block rounded-2xl p-6 md:p-8 transition-all duration-300";

const variants: Record<Variant, string> = {
  dark: "bg-sd-dark-2 border border-white/5",
  darker: "bg-sd-navy border border-white/5",
  light: "bg-sd-light-3 text-sd-text-dark border border-sd-gray-border",
  outline: "border border-white/10",
  "gradient-border":
    "relative bg-sd-dark-2 border border-transparent [background:linear-gradient(var(--sd-dark-2),var(--sd-dark-2))_padding-box,linear-gradient(135deg,var(--sd-purple),var(--sd-cyan))_border-box]",
};

const hoverFx = hover
  ? "hover:-translate-y-1 hover:shadow-[0_20px_40px_-12px_rgba(103,58,228,0.25)]"
  : "";

const classes = `${base} ${variants[variant]} ${hoverFx} ${className}`.trim();
const Tag = href ? "a" : as;
---

<Tag class={classes} {...(href ? { href } : {})}>
  <slot />
</Tag>
