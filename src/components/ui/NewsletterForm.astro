---
// Submits to /api/subscribe → Brevo API (server-side, API key never exposed)
interface Props {
  /** compact: horizontal inline layout (email + button side by side) */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<form id="nl-form" novalidate class={compact ? "nl-compact" : ""}>
  {!compact && (
    <div class="nl-field">
      <label for="nl-email">Email address <span class="required">*</span></label>
    </div>
  )}
  <div class={compact ? "nl-inline" : "nl-field"}>
    <input id="nl-email" name="email" type="email" autocomplete="email" required placeholder={compact ? "Subscribe to our newsletter" : "your@email.com"} class={compact ? "nl-input-compact" : ""} />
    {compact && (
      <button type="submit" id="nl-submit" class="nl-btn-compact">
        <span id="nl-btn-label">Sign up!</span>
        <svg id="nl-spinner" class="nl-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5" stroke-dasharray="31.4" stroke-dashoffset="10" stroke-linecap="round"/>
        </svg>
      </button>
    )}
  </div>

  <p id="nl-error" class="nl-error" aria-live="polite" hidden>
    Something went wrong. Please try again or email us at info@spacedev.io.
  </p>

  {!compact && (
    <button type="submit" id="nl-submit">
      <span id="nl-btn-label">Subscribe</span>
      <svg id="nl-spinner" class="nl-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="display:none">
        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2.5" stroke-dasharray="31.4" stroke-dashoffset="10" stroke-linecap="round"/>
      </svg>
    </button>
  )}
</form>

<div id="nl-success" hidden class="nl-success">
  <svg width="36" height="36" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="19" stroke="#673ae4" stroke-width="2"/>
    <path d="M12 20l6 6 10-12" stroke="#673ae4" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <div>
    <p class="nl-success-title">You're in!</p>
    <p class="nl-success-sub">Next issue lands in your inbox soon.</p>
  </div>
</div>

<style>
  form { display: flex; flex-direction: column; gap: 1.25rem; }

  /* ── Compact inline layout ── */
  form.nl-compact { flex-direction: column; gap: 0; }
  .nl-inline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nl-input-compact {
    flex: 1;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.25) !important;
    border-radius: 9999px !important;
    padding: 0.6rem 1.25rem !important;
    color: #fff;
    font-size: 14px;
    font-family: var(--font-body, sans-serif);
    outline: none;
    transition: border-color 0.2s;
  }
  .nl-input-compact::placeholder { color: rgba(255,255,255,0.35); }
  .nl-input-compact:focus { border-color: rgba(255,255,255,0.6) !important; }
  button.nl-btn-compact,
  button[type="submit"].nl-btn-compact {
    flex-shrink: 0;
    width: auto !important;
    padding: 0.6rem 1.25rem !important;
    border-radius: 9999px !important;
    background: #fff !important;
    color: #141414 !important;
    font-size: 14px !important;
    font-family: var(--font-body, sans-serif);
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  button.nl-btn-compact:hover { background: #e8e8e8 !important; }
  button.nl-btn-compact:disabled { opacity: 0.6; cursor: not-allowed; }

  .nl-field { display: flex; flex-direction: column; gap: 0.5rem; }

  label {
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    font-family: var(--font-body, sans-serif);
  }
  .required { color: #673ae4; }

  input {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    font-size: 15px;
    font-family: var(--font-body, sans-serif);
    padding: 0.5rem 0;
    outline: none;
    width: 100%;
    transition: border-color 0.2s;
  }
  input::placeholder { color: rgba(255,255,255,0.25); }
  input:focus { border-color: #673ae4; }

  button[type="submit"] {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem;
    border-radius: 9999px;
    background: #673ae4;
    color: #fff;
    font-size: 15px;
    font-family: var(--font-body, sans-serif);
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  button[type="submit"]:hover { background: #4a397c; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(103,58,228,0.35); }
  button[type="submit"]:disabled { opacity: 0.6; cursor: not-allowed; }

  .nl-spinner { animation: spin 0.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .nl-error {
    font-size: 13px;
    color: #f87171;
    padding: 0.6rem 0.9rem;
    background: rgba(248,113,113,0.08);
    border-radius: 8px;
    border: 1px solid rgba(248,113,113,0.2);
  }

  .nl-success {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0;
  }
  .nl-success-title { color: #fff; font-weight: 500; font-size: 15px; }
  .nl-success-sub   { color: rgba(255,255,255,0.5); font-size: 13px; margin-top: 2px; }
</style>

<script>
  const form    = document.getElementById("nl-form") as HTMLFormElement;
  const success = document.getElementById("nl-success");
  const errorEl = document.getElementById("nl-error");
  const btn     = document.getElementById("nl-submit") as HTMLButtonElement;
  const label   = document.getElementById("nl-btn-label");
  const spinner = document.getElementById("nl-spinner");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    btn.disabled = true;
    label!.textContent = "Subscribing...";
    (spinner as HTMLElement).style.display = "block";
    errorEl!.hidden = true;

    const email = (document.getElementById("nl-email") as HTMLInputElement).value;

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });

      if (!res.ok) throw new Error();

      (window as any).sdTrack?.("newsletter_signup");

      form.hidden = true;
      success!.hidden = false;
    } catch {
      errorEl!.hidden = false;
      btn.disabled = false;
      label!.textContent = "Subscribe";
      (spinner as HTMLElement).style.display = "none";
    }
  });
</script>
