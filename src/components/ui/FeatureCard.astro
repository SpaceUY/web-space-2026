---
/**
 * FeatureCard
 * A dark (or light) info card with an optional icon bubble on top.
 *
 * Props:
 *   title        — card heading
 *   description  — body text
 *   icon?        — icon name (see ICONS map below). Omit for icon-less variant.
 *   tone?        — "dark" (default) | "light"
 *   class?       — extra classes forwarded to the root element
 */

interface Props {
  title: string;
  description: string;
  /** Icon name: lock | eye | bolt | shield | tag | chain | check | star | rocket | code | globe | users | settings | heart | clock | chart */
  icon?: string;
  /** Step number to render in the bubble instead of an icon */
  number?: string;
  tone?: "dark" | "light";
  class?: string;
}

const { title, description, icon, number, tone = "dark", class: className = "" } = Astro.props;

const isDark = tone === "dark";
const cardCls = isDark
  ? "border-white/10 bg-sd-dark-2 hover:border-sd-purple/40"
  : "border-sd-gray-border bg-white hover:border-sd-purple/40";
const titleCls = isDark ? "text-white"       : "text-sd-text-dark";
const descCls  = isDark ? "text-sd-text-muted" : "text-sd-text-gray";

/* ── SVG paths per icon name ─────────────────────────── */
const ICONS: Record<string, string> = {
  lock:     `<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>`,
  eye:      `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>`,
  bolt:     `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
  shield:   `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  tag:      `<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>`,
  chain:    `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>`,
  check:    `<polyline points="20 6 9 17 4 12"/>`,
  star:     `<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>`,
  rocket:   `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/>`,
  code:     `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  globe:    `<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>`,
  users:    `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  settings: `<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>`,
  heart:    `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
  clock:    `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
  chart:    `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`,
};

const svgContent = icon ? (ICONS[icon] ?? "") : "";
---

<div
  class={`rounded-2xl border p-6 transition-colors ${cardCls} ${className}`}
  data-animate
>
  {number ? (
    <div class={`mb-5 inline-flex items-center justify-center w-12 h-12 rounded-full shrink-0 ${isDark ? "bg-sd-purple/40" : "bg-sd-purple/20"}`}>
      <span class={`font-display text-lg ${isDark ? "text-sd-purple-300" : "text-sd-purple"}`} aria-hidden="true">{number}</span>
    </div>
  ) : icon && svgContent ? (
    <div class="mb-5 inline-flex items-center justify-center w-12 h-12 rounded-full bg-sd-purple/20 shrink-0">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#a78bfa"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={svgContent}
      />
    </div>
  ) : null}
  <h3 class={`${(number || icon) ? "text-lg" : "text-base font-medium"} ${titleCls} mb-3`}>{title}</h3>
  <p class={`text-sm ${descCls} leading-relaxed`}>{description}</p>
</div>
