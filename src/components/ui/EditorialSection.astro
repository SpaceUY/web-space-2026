---
/**
 * EditorialSection
 * A two-column image + text section — image flips side via `imagePosition`.
 *
 * Props:
 *   image          — image src path
 *   imageAlt?      — alt text (default "")
 *   imagePosition? — "left" (default) | "right"
 *   eyebrow?       — small uppercase label above the heading
 *   heading        — section heading (rendered as h2)
 *   body?          — paragraph text. Pass a slot for richer content instead.
 *   tone?          — "dark" (default) | "light"
 *   border?        — show top border (default true)
 *   class?         — extra classes on the outer <section>
 */

interface Props {
  image: string;
  imageAlt?: string;
  imagePosition?: "left" | "right";
  eyebrow?: string;
  heading: string;
  body?: string;
  tone?: "dark" | "light";
  border?: boolean;
  class?: string;
}

const {
  image,
  imageAlt = "",
  imagePosition = "left",
  eyebrow,
  heading,
  body,
  tone = "dark",
  border = true,
  class: className = "",
} = Astro.props;

const isDark = tone === "dark";

const sectionBg   = isDark ? "bg-sd-dark"                : "bg-sd-light";
const borderCls   = border ? (isDark ? "border-t border-white/5" : "border-t border-sd-gray-border") : "";
const eyebrowCls  = isDark ? "text-sd-purple-300"         : "text-sd-purple";
const headingCls  = isDark ? "text-white"                 : "text-sd-text-dark";
const bodyCls     = isDark ? "text-sd-text-muted"         : "text-sd-text-gray";

const imageFirst  = imagePosition === "left";
---

<section class={`${sectionBg} py-16 ${borderCls} ${className}`.trim()}>
  <div class="mx-auto max-w-[1100px] px-6 md:px-10 grid gap-10 md:grid-cols-2 items-center">

    {imageFirst ? (
      <>
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          class="w-full h-auto max-h-72 object-contain"
        />
        <div>
          {eyebrow && (
            <p class={`text-xs uppercase tracking-[0.2em] ${eyebrowCls} mb-4`}>{eyebrow}</p>
          )}
          <h2 class={`text-2xl md:text-3xl ${headingCls} font-display leading-tight`}>{heading}</h2>
          {body && <p class={`mt-4 text-sm ${bodyCls} leading-relaxed`}>{body}</p>}
          <slot />
        </div>
      </>
    ) : (
      <>
        <div>
          {eyebrow && (
            <p class={`text-xs uppercase tracking-[0.2em] ${eyebrowCls} mb-4`}>{eyebrow}</p>
          )}
          <h2 class={`text-2xl md:text-3xl ${headingCls} font-display leading-tight`}>{heading}</h2>
          {body && <p class={`mt-4 text-sm ${bodyCls} leading-relaxed`}>{body}</p>}
          <slot />
        </div>
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          class="w-full h-auto max-h-72 object-contain"
        />
      </>
    )}

  </div>
</section>
