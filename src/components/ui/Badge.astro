---
type Tone = "neutral" | "purple" | "cyan" | "green" | "outline";

interface Props {
  tone?: Tone;
  withDot?: boolean;
  class?: string;
}

const { tone = "neutral", withDot = false, class: className = "" } = Astro.props;

const tones: Record<Tone, string> = {
  neutral: "bg-white/10 text-sd-text-muted",
  purple: "bg-sd-purple/15 text-sd-purple-3",
  cyan: "bg-sd-cyan/15 text-sd-cyan",
  green: "bg-sd-green/15 text-sd-green",
  outline: "border border-white/20 text-white",
};

const dotColors: Record<Tone, string> = {
  neutral: "bg-sd-text-muted",
  purple: "bg-sd-purple",
  cyan: "bg-sd-cyan",
  green: "bg-sd-green",
  outline: "bg-white",
};
---

<span
  class={`inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs uppercase tracking-wider font-medium ${tones[tone]} ${className}`.trim()}
>
  {withDot && <span class={`w-1.5 h-1.5 rounded-full ${dotColors[tone]}`} />}
  <slot />
</span>
