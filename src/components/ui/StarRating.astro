---
interface Props {
  value: number;
  max?: number;
  size?: "sm" | "md" | "lg";
  label?: string;
  class?: string;
}

const { value, max = 5, size = "md", label, class: className = "" } = Astro.props;

const sizes = { sm: 14, md: 18, lg: 24 } as const;
const px = sizes[size];

const stars = Array.from({ length: max }, (_, i) => {
  const fill = Math.max(0, Math.min(1, value - i));
  return fill;
});

const accessibleLabel = label ?? `${value} out of ${max} stars`;
---

<div
  class={`inline-flex items-center gap-1 ${className}`.trim()}
  role="img"
  aria-label={accessibleLabel}
>
  {stars.map((fill) => (
    <svg width={px} height={px} viewBox="0 0 24 24" aria-hidden="true">
      <defs>
        <linearGradient id={`star-${Math.random().toString(36).slice(2, 8)}`} x1="0" x2="1">
          <stop offset={`${fill * 100}%`} stop-color="#FFB800" />
          <stop offset={`${fill * 100}%`} stop-color="rgba(255,255,255,0.15)" />
        </linearGradient>
      </defs>
      <path
        d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
        fill={fill === 1 ? "#FFB800" : fill === 0 ? "rgba(255,255,255,0.15)" : "url(#star-grad)"}
      />
    </svg>
  ))}
</div>
