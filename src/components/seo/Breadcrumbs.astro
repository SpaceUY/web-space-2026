---
import { SITE } from "../../lib/seo";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  /** When true, render visible breadcrumbs (in addition to JSON-LD) */
  visible?: boolean;
  class?: string;
}

const { items, visible = false, class: className = "" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((c, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    name: c.label,
    ...(c.href ? { item: c.href.startsWith("http") ? c.href : `${SITE.url}${c.href}` } : {}),
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{visible && (
  <nav
    class={`inline-flex items-center gap-0 rounded-full border border-white/15 bg-white/8 px-4 py-2 backdrop-blur-sm ${className}`.trim()}
    aria-label="Breadcrumb"
  >
    <ol class="flex flex-wrap items-center gap-0">
      {items.map((c, idx) => (
        <li class="inline-flex items-center">
          {idx > 0 && (
            <svg class="mx-2 opacity-30" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M4 2l4 4-4 4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
          {c.href && idx < items.length - 1 ? (
            <a
              href={c.href}
              class="text-xs font-ui uppercase tracking-widest text-white/50 hover:text-white/80 transition-colors"
            >{c.label}</a>
          ) : (
            <span class="text-xs font-ui uppercase tracking-widest text-white">{c.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
