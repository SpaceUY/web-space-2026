---
/**
 * Brand v2 header, after Voiceflow's navbar:
 * - at the top, a transparent full-width bar: logo left, links centred,
 *   actions right, lying on whatever the page starts with (white text over
 *   a dark hero, dark text over a light one, picked from what is behind);
 * - once the page scrolls, the whole bar condenses into one narrower,
 *   centred, frosted bar that floats over the content;
 * - hovering an entry with a menu opens one wide panel under the bar, its
 *   height gliding between menus while the page behind softens with a blur.
 * Below 1000px it shows the logo and a menu button that opens the existing
 * mobile menu.
 */
import {
  aboutNavItems,
  blockchainNavItems,
  industryNavItems,
  navFeatures,
  navTopItems,
  otherExpertiseNavItems,
  type NavItem,
  type NavMenuId,
} from "../../data/navigation";
import V2Arrow from "./V2Arrow.astro";

interface MenuColumn {
  title: string;
  href?: string;
  items: NavItem[];
  twoColumns?: boolean;
}

const menus: Record<NavMenuId, MenuColumn[]> = {
  expertise: [
    { title: "Blockchain Development", href: "/blockchain-development-services", items: blockchainNavItems },
    { title: "Services", items: otherExpertiseNavItems },
  ],
  industries: [{ title: "Industries", items: industryNavItems, twoColumns: true }],
  about: [{ title: "About", items: aboutNavItems }],
};
const menuIds = Object.keys(menus) as NavMenuId[];
const MEETING_URL = "https://meetings.hubspot.com/federico-sendra/meet-space";
---

<header class="v2-nav" data-v2-nav data-theme="dark">
  <a href="#main-content" class="sr-only focus:not-sr-only">Skip to main content</a>
  <div class="v2-nav__scrim" aria-hidden="true"></div>

  <div class="v2-nav__frame">
    <div class="v2-nav__bar">
      <a href="/" class="v2-nav__logo" aria-label="SpaceDev home">
        <img src="/images/brand/v2/logo-violeta.webp" alt="" width="345" height="96" class="v2-nav__logo-img v2-nav__logo-img--on-light" />
        <img src="/images/brand/v2/logo-blanco.webp" alt="" width="345" height="96" class="v2-nav__logo-img v2-nav__logo-img--on-dark" />
      </a>

      <nav class="v2-nav__links" aria-label="Primary">
        {navTopItems.map((item) =>
          item.menu ? (
            <button type="button" class="v2-nav__link" data-menu-trigger={item.menu} aria-expanded="false" aria-controls={`v2-menu-${item.menu}`}>
              {item.label}
              <svg class="v2-nav__chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          ) : (
            <a href={item.href} class="v2-nav__link" data-menu-plain>{item.label}</a>
          )
        )}
      </nav>

      <div class="v2-nav__actions">
        <a href={MEETING_URL} target="_blank" rel="noopener noreferrer" class="v2-nav__link v2-nav__secondary">Book a call</a>
        <a href="/contact" class="v2-nav__button">Get in touch</a>
        <button type="button" class="v2-nav__burger" data-v2-burger aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M3 7h16M3 15h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      </div>
    </div>

    <div class="v2-nav__panel">
      <div class="v2-nav__card" data-panel-card>
        {menuIds.map((id) => {
          const feature = navFeatures[id];
          return (
            <div class="v2-nav__menu" id={`v2-menu-${id}`} data-menu={id}>
              <div class="v2-nav__cols">
                {menus[id].map((column) => (
                  <div class:list={["v2-nav__col", { "v2-nav__col--wide": column.twoColumns }]}>
                    <p class="v2-nav__col-title">
                      {column.href ? <a href={column.href} class="v2-nav__col-link">{column.title} <V2Arrow size={11} /></a> : column.title}
                    </p>
                    <ul class:list={["v2-nav__list", { "v2-nav__list--two": column.twoColumns }]}>
                      {column.items.map((entry) => (
                        <li>
                          <a href={entry.href} class="v2-nav__item">
                            <span>{entry.label}</span>
                            <V2Arrow size={12} />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <a
                href={feature.href}
                class="v2-nav__feature"
                {...(feature.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <img src={feature.image} alt="" loading="lazy" decoding="async" class="v2-nav__feature-img" />
                <span class="v2-nav__feature-eyebrow">{feature.eyebrow}</span>
                <span class="v2-nav__feature-title">{feature.title}</span>
                <span class="v2-nav__feature-arrow"><V2Arrow diagonal={feature.external} /></span>
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-v2-nav]");
  const card = header?.querySelector<HTMLElement>("[data-panel-card]");

  if (header && card) {
    const triggers = Array.from(header.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"));
    const menus = Array.from(header.querySelectorAll<HTMLElement>("[data-menu]"));
    const plainLinks = Array.from(header.querySelectorAll<HTMLElement>("[data-menu-plain]"));
    let openId: string | null = null;
    let closeTimer = 0;

    function open(id: string): void {
      window.clearTimeout(closeTimer);
      if (openId === id) return;
      openId = id;
      header!.dataset.open = id;
      menus.forEach((menu) => menu.toggleAttribute("data-active", menu.dataset.menu === id));
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(trigger.dataset.menuTrigger === id)));
      const active = menus.find((menu) => menu.dataset.menu === id);
      if (active) card!.style.height = `${active.offsetHeight}px`;
      document.body.classList.add("v2-nav-open");
    }

    function close(): void {
      window.clearTimeout(closeTimer);
      if (!openId) return;
      openId = null;
      delete header!.dataset.open;
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
      document.body.classList.remove("v2-nav-open");
    }

    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(close, 140);
    };

    triggers.forEach((trigger) => {
      const id = trigger.dataset.menuTrigger ?? "";
      trigger.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") open(id);
      });
      trigger.addEventListener("click", () => (openId === id ? close() : open(id)));
    });
    plainLinks.forEach((link) => link.addEventListener("pointerenter", scheduleClose));
    header.addEventListener("pointerleave", scheduleClose);
    card.addEventListener("pointerenter", () => window.clearTimeout(closeTimer));
    header.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !header.contains(next)) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !openId) return;
      const trigger = triggers.find((candidate) => candidate.dataset.menuTrigger === openId);
      close();
      trigger?.focus();
    });

    /* Tone of whatever sits behind the bar: the first ancestor under its
       centre with an opaque background decides; sections can force it with
       data-nav-theme. Only matters at the top, before the bar turns to glass. */
    const themeBehind = (): "dark" | "light" => {
      const stack = document.elementsFromPoint(window.innerWidth / 2, 36);
      let node: Element | null = stack.find((element) => !header!.contains(element)) ?? null;
      while (node && node !== document.documentElement) {
        const forced = node.getAttribute("data-nav-theme");
        if (forced === "dark" || forced === "light") return forced;
        const match = getComputedStyle(node).backgroundColor.match(/rgba?\(([^)]+)\)/);
        if (match) {
          const [r, g, b, a = "1"] = match[1].split(",").map((part) => part.trim());
          if (Number(a) > 0.5) return (0.2126 * Number(r) + 0.7152 * Number(g) + 0.0722 * Number(b)) / 255 < 0.55 ? "dark" : "light";
        }
        node = node.parentElement;
      }
      return "light";
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      if (document.documentElement.getAttribute("data-brand") !== "v2") return;
      header!.toggleAttribute("data-scrolled", window.scrollY > 24);
      header!.dataset.theme = themeBehind();
    };
    window.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }, { passive: true });
    window.addEventListener("resize", update);
    new MutationObserver(update).observe(document.documentElement, { attributes: true, attributeFilter: ["data-brand"] });
    update();

    /* Mobile: reuse the existing full-screen menu. Its close button is wired
       by the v1 header script. */
    const burger = header.querySelector<HTMLButtonElement>("[data-v2-burger]");
    const mobileMenu = document.getElementById("mobile-menu");
    burger?.addEventListener("click", () => {
      if (!mobileMenu) return;
      mobileMenu.style.display = "block";
      requestAnimationFrame(() => {
        mobileMenu.style.opacity = "1";
      });
      burger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    });
  }
</script>

<style>
  .v2-nav {
    --bar-width: 1440px;
    --bar-height: 72px;
    position: sticky;
    top: 0;
    z-index: 60;
    height: 72px;
    color: var(--v2-ink);
    font-family: "Open Sans", Arial, sans-serif;
  }
  .v2-nav[data-scrolled] {
    --bar-width: 1120px;
    --bar-height: 56px;
  }
  /* Over a dark hero, before the bar turns to glass: light text and logo. */
  .v2-nav[data-theme="dark"]:not([data-scrolled]):not([data-open]) { color: #ffffff; }

  .v2-nav__scrim {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: rgba(20, 19, 19, 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--v2-ease);
  }
  .v2-nav[data-open] .v2-nav__scrim { opacity: 1; }

  .v2-nav__frame {
    padding-inline: var(--v2-gutter);
    transition: padding 0.45s var(--v2-ease);
  }
  .v2-nav[data-scrolled] .v2-nav__frame { padding-top: 10px; }

  .v2-nav__bar {
    position: relative;
    max-width: var(--bar-width);
    height: var(--bar-height);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    border: 1px solid transparent;
    background: transparent;
    transition:
      max-width 0.5s var(--v2-ease),
      height 0.45s var(--v2-ease),
      padding 0.45s var(--v2-ease),
      background-color 0.35s var(--v2-ease),
      border-color 0.35s var(--v2-ease),
      box-shadow 0.35s var(--v2-ease);
  }
  /* Scrolled: one condensed, frosted bar floating over the page. */
  .v2-nav[data-scrolled] .v2-nav__bar,
  .v2-nav[data-open] .v2-nav__bar {
    padding-inline: 18px 8px;
    background: rgba(249, 249, 249, 0.72);
    border-color: rgba(20, 19, 19, 0.08);
    box-shadow: 0 10px 30px -12px rgba(20, 19, 19, 0.25);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
  }
  .v2-nav[data-open] .v2-nav__bar { background: #ffffff; }

  .v2-nav__logo { justify-self: start; display: inline-flex; }
  .v2-nav__logo-img { height: 26px; width: auto; transition: height 0.45s var(--v2-ease); }
  .v2-nav__logo-img--on-dark { display: none; }
  .v2-nav[data-theme="dark"]:not([data-scrolled]):not([data-open]) .v2-nav__logo-img--on-dark { display: block; }
  .v2-nav[data-theme="dark"]:not([data-scrolled]):not([data-open]) .v2-nav__logo-img--on-light { display: none; }
  .v2-nav[data-scrolled] .v2-nav__logo-img { height: 22px; }

  .v2-nav__links { display: flex; align-items: center; gap: 4px; }
  .v2-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding-inline: 12px;
    font-size: 15px;
    font-weight: 500;
    color: #5f5b58;
    transition: color 0.2s var(--v2-ease);
  }
  .v2-nav__link:hover,
  .v2-nav__link[aria-expanded="true"] { color: var(--v2-ink); }
  .v2-nav[data-theme="dark"]:not([data-scrolled]):not([data-open]) .v2-nav__link { color: rgba(255, 255, 255, 0.72); }
  .v2-nav[data-theme="dark"]:not([data-scrolled]):not([data-open]) .v2-nav__link:hover { color: #ffffff; }
  .v2-nav__chevron { transition: transform 0.35s var(--v2-ease); }
  .v2-nav__link[aria-expanded="true"] .v2-nav__chevron { transform: rotate(180deg); }

  .v2-nav__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .v2-nav__button {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding-inline: 18px;
    background: var(--v2-violet-mid);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    transition: background-color 0.2s var(--v2-ease), height 0.45s var(--v2-ease);
  }
  .v2-nav__button:hover { background: var(--v2-violet); }
  .v2-nav[data-scrolled] .v2-nav__button { height: 38px; }

  .v2-nav__burger {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  /* Mega panel, aligned to the bar */
  .v2-nav__panel {
    position: relative;
    max-width: var(--bar-width);
    margin: 8px auto 0;
    pointer-events: none;
    transition: max-width 0.5s var(--v2-ease);
  }
  .v2-nav__card {
    position: relative;
    height: 0;
    overflow: hidden;
    background: #ffffff;
    color: var(--v2-ink);
    box-shadow: 0 30px 60px -20px rgba(20, 19, 19, 0.25), 0 0 0 1px rgba(20, 19, 19, 0.06);
    opacity: 0;
    transform: translateY(-8px);
    transition:
      height 0.45s var(--v2-ease),
      opacity 0.25s var(--v2-ease),
      transform 0.45s var(--v2-ease);
  }
  .v2-nav[data-open] .v2-nav__card {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .v2-nav__menu {
    position: absolute;
    inset: 0 0 auto 0;
    display: grid;
    grid-template-columns: 1fr minmax(260px, 30%);
    gap: 32px;
    padding: 32px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.3s var(--v2-ease), transform 0.4s var(--v2-ease), visibility 0s linear 0.3s;
  }
  .v2-nav__menu[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0.06s, 0.06s, 0s;
  }
  .v2-nav__cols {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 32px;
  }
  .v2-nav__col--wide { grid-column: span 2; }
  .v2-nav__col-title {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v2-ink-2);
  }
  .v2-nav__col-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--v2-violet-mid);
  }
  .v2-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--v2-line);
  }
  .v2-nav__list--two {
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
  }
  .v2-nav__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--v2-line);
    font-size: 15px;
    font-weight: 500;
    color: var(--v2-ink);
    transition: color 0.25s var(--v2-ease), padding 0.35s var(--v2-ease);
  }
  .v2-nav__item :global(svg) {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s var(--v2-ease), transform 0.35s var(--v2-ease);
    color: var(--v2-violet-mid);
  }
  .v2-nav__item:hover { color: var(--v2-violet-mid); padding-left: 6px; }
  .v2-nav__item:hover :global(svg) { opacity: 1; transform: none; }

  .v2-nav__feature {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    min-height: 280px;
    padding: 22px;
    overflow: hidden;
    color: #ffffff;
    background: var(--sd-brand-apertura);
  }
  .v2-nav__feature-img {
    position: absolute;
    top: 10px;
    right: -6%;
    width: 78%;
    height: auto;
    transition: transform 0.8s var(--v2-ease);
  }
  .v2-nav__feature:hover .v2-nav__feature-img { transform: translateY(-6px) scale(1.03); }
  .v2-nav__feature-eyebrow { position: relative; font-size: 13px; font-weight: 600; color: rgba(255, 255, 255, 0.75); }
  .v2-nav__feature-title {
    position: relative;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }
  .v2-nav__feature-arrow {
    position: absolute;
    top: 18px;
    left: 18px;
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
  }

  @media (max-width: 999px) {
    .v2-nav__links,
    .v2-nav__secondary,
    .v2-nav__button,
    .v2-nav__panel { display: none; }
    .v2-nav__bar { grid-template-columns: 1fr auto; }
    .v2-nav__burger { display: inline-flex; }
  }
</style>
