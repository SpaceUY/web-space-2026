---
/** Arrow used by v2 buttons and links. `diagonal` points up-right for external links. */
interface Props {
  diagonal?: boolean;
  size?: number;
}
const { diagonal = false, size = 14 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 14 14" fill="none" aria-hidden="true">
  {diagonal
    ? <path d="M3 11L11 3M11 3H5M11 3v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    : <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
