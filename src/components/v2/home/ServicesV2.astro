---
/**
 * Brand v2 services: one wide card per service, its copy on the left and its
 * own orbital scene on the right (canvas 2D, see src/lib/v2/orbits.ts), so a
 * service and its animation always arrive together. On desktop the cards
 * stack as you scroll: each one sticks a little lower than the last and the
 * next slides up over it, which is the hand-off from one service to the
 * next. Each scene only animates while its card is on screen.
 */
import V2Button from "../V2Button.astro";
import V2Arrow from "../V2Arrow.astro";
import { homeServices, homeServiceOrbits } from "../../../data/home";
---

<section class="v2-section v2-container services" id="services">
  <div class="v2-head">
    <h2 class="v2-display-l">Our Web2 and Web3 Development Services</h2>
    <p class="v2-lead">
      We build the infrastructure that decentralized products run on. Whether you need a full-stack dApp, a custom blockchain protocol, or a secure smart contract system, our teams work across EVM-compatible chains (Ethereum and networks that share its Ethereum Virtual Machine), Solana, and Layer 2 networks.
    </p>
  </div>

  <div class="services__stack">
    {homeServices.map((service, index) => (
      <article class="services__card" style={`--i: ${index}`}>
        <div class="services__copy">
          <h3 class="v2-display-m">{service.title}</h3>
          <p class="v2-body mt-4">{service.desc}</p>
          <a href={service.href} class="v2-link inline-flex items-center gap-2 mt-8">Explore <V2Arrow size={12} /></a>
        </div>
        <div class="services__visual">
          <canvas class="services__canvas" data-orbit={homeServiceOrbits[service.href]} aria-hidden="true"></canvas>
        </div>
      </article>
    ))}
  </div>

  <div class="v2-actions">
    <p class="v2-body">Reach out and we'll find the right services, tailored just for you.</p>
    <V2Button href="/contact">Get in touch</V2Button>
  </div>
</section>

<script>
  import { OrbitScene, type OrbitId } from "../../../lib/v2/orbits";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLCanvasElement>("canvas[data-orbit]").forEach((canvas) => {
    const scene = new OrbitScene(canvas, [canvas.dataset.orbit as OrbitId], reduced);
    scene.show(0);
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? scene.start() : scene.stop())).observe(canvas);
  });
</script>

<style>
  .services__stack {
    display: grid;
    gap: 24px;
  }
  .services__card {
    position: sticky;
    top: calc(96px + var(--i) * 16px);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    min-height: 440px;
    background: #ffffff;
    border: 1px solid var(--v2-line);
    box-shadow: 0 -12px 32px -24px rgba(20, 19, 19, 0.25);
  }
  .services__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 3.5vw, 56px);
    border-right: 1px solid var(--v2-line);
  }
  .services__visual {
    position: relative;
    min-height: 100%;
    background: var(--v2-canvas);
  }
  .services__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 999px) {
    .services__card {
      position: relative;
      top: auto;
      grid-template-columns: 1fr;
      min-height: 0;
      box-shadow: none;
    }
    .services__visual { order: -1; height: 260px; min-height: 0; }
    .services__copy { border-right: 0; border-top: 1px solid var(--v2-line); }
  }
</style>
