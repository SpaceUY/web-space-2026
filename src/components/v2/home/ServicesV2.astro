---
/**
 * Brand v2 services: the copy scrolls on the left while one sticky canvas on
 * the right shows the orbital scene of the service being read (canvas 2D,
 * see src/lib/v2/orbits.ts), drawn straight on the page with no box. The
 * service in focus is at full ink and the others recede, so the motion
 * follows the reading instead of competing with it.
 */
import V2Button from "../V2Button.astro";
import V2Arrow from "../V2Arrow.astro";
import { homeServices, homeServiceOrbits } from "../../../data/home";

const scenes = homeServices.map((service) => homeServiceOrbits[service.href]);
---

<section class="v2-section v2-container services" id="services">
  <div class="v2-head">
    <h2 class="v2-display-l">Our Web2 and Web3 Development Services</h2>
    <p class="v2-lead">
      We build the infrastructure that decentralized products run on. Whether you need a full-stack dApp, a custom blockchain protocol, or a secure smart contract system, our teams work across EVM-compatible chains (Ethereum and networks that share its Ethereum Virtual Machine), Solana, and Layer 2 networks.
    </p>
  </div>

  <div class="services__grid">
    <div class="services__list">
      {homeServices.map((service, index) => (
        <article class="services__item" data-service-item={index}>
          <h3 class="v2-display-m">{service.title}</h3>
          <p class="v2-body mt-4">{service.desc}</p>
          <a href={service.href} class="v2-link inline-flex items-center gap-2 mt-6">Explore <V2Arrow size={12} /></a>
        </article>
      ))}
    </div>

    <div class="services__stage">
      <div class="services__sticky">
        <canvas class="services__canvas" data-services-canvas data-scenes={scenes.join(",")} aria-hidden="true"></canvas>
        <ol class="services__progress" aria-hidden="true">
          {homeServices.map((_, index) => <li data-service-dot={index}></li>)}
        </ol>
      </div>
    </div>
  </div>

  <div class="v2-actions">
    <p class="v2-body">Reach out and we'll find the right services, tailored just for you.</p>
    <V2Button href="/contact">Get in touch</V2Button>
  </div>
</section>

<script>
  import { OrbitScene, type OrbitId } from "../../../lib/v2/orbits";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-services-canvas]");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-service-item]"));
  const dots = Array.from(document.querySelectorAll<HTMLElement>("[data-service-dot]"));
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const scene = canvas ? new OrbitScene(canvas, (canvas.dataset.scenes ?? "").split(",") as OrbitId[], reduced) : null;

  const setActive = (index: number) => {
    items.forEach((item, i) => item.toggleAttribute("data-active", i === index));
    dots.forEach((dot, i) => dot.toggleAttribute("data-active", i === index));
    scene?.show(index);
  };
  setActive(0);

  /* The item crossing the middle of the viewport is the one being read. */
  const readingObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(Number((entry.target as HTMLElement).dataset.serviceItem));
      });
    },
    { rootMargin: "-40% 0px -55% 0px" }
  );
  items.forEach((item) => readingObserver.observe(item));

  /* Animate only while the canvas is on screen. */
  if (canvas && scene) {
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? scene.start() : scene.stop())).observe(canvas);
  }
</script>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
  }
  .services__list { grid-column: 1 / span 5; }
  .services__item {
    min-height: 44vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 36px;
    border-top: 1px solid var(--v2-line);
    opacity: 0.32;
    transition: opacity 0.5s var(--v2-ease);
  }
  .services__item:first-child { border-top: 0; }
  .services__item[data-active] { opacity: 1; }

  .services__stage { grid-column: 7 / span 6; }
  .services__sticky {
    position: sticky;
    top: calc(50vh - min(42vw, 600px) / 2 + 28px);
    aspect-ratio: 1;
    max-height: 600px;
  }
  .services__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .services__progress {
    position: absolute;
    right: 4px;
    bottom: 12px;
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services__progress li {
    width: 18px;
    height: 2px;
    background: var(--v2-line);
    transition: background-color 0.4s var(--v2-ease), width 0.4s var(--v2-ease);
  }
  .services__progress li[data-active] {
    width: 36px;
    background: var(--v2-violet-mid);
  }

  @media (max-width: 999px) {
    .services__grid { grid-template-columns: 1fr; gap: 0; }
    .services__list,
    .services__stage { grid-column: auto; }
    .services__stage { order: -1; position: sticky; top: 64px; z-index: 1; background: var(--v2-canvas); }
    .services__sticky { position: relative; top: auto; width: min(100%, 40vh); margin-inline: auto; }
    .services__item { min-height: 46vh; }
  }
</style>
