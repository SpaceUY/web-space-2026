---
/**
 * Brand v2 home hero, in three variants to compare (lab only, picked with
 * ?hero=a|b|c or the A/B/C control in the corner, remembered per tab):
 * - A "Horizon": the planet horizon described below;
 * - B "Orbit": a large orbital system on the right, in the same thin-line
 *   language as the services, drawn on its own canvas;
 * - C "Eclipse": a dark disc with a lit rim and a slowly turning corona;
 * - D "Dot sphere" (default): the top of a sphere drawn in rings of dots,
 *   seen from slightly above, turning slowly; brighter spiral arms are
 *   part of the sphere so the rotation reads.
 * Copy and layout are shared and centred in all four.
 *
 * Variant A: a planet horizon at the bottom of a dark stage, its
 * atmosphere breathing and a highlight gliding along the rim, under a field
 * of stars that drift and answer the pointer with a little parallax. The
 * planet and its glow are CSS; stars and the rim highlight share one canvas
 * drawn over the planet (stars inside the disc are skipped), so nothing large
 * is repainted by CSS each frame. It pauses when off screen or in a
 * background tab, and stands still with reduced motion.
 *
 * The headline keeps the live rotating word with the same animation as the
 * live home: the word slides up and the next one takes its place. All
 * slides ship in the HTML and only the track moves (transform), so the h1
 * (the LCP element) never repaints new text; the last slide repeats the
 * first so the loop snaps back without a visible rewind. Only the first
 * slide is exposed to assistive tech.
 */
import V2Button from "../V2Button.astro";
import { clientLogosWhite } from "../../../data/home";

const MEETING_URL = "https://meetings.hubspot.com/federico-sendra/meet-space";
const rotatorWords = ["Flexible", "Reliable", "Fast"];
---

<section class="hero" data-nav-theme="dark" data-variant="d" data-v2-hero>
  <script is:inline>
    (function () {
      var hero = document.currentScript.parentElement;
      var fromUrl = new URLSearchParams(location.search).get("hero");
      var stored = null;
      try { stored = sessionStorage.getItem("sd-hero-variant"); } catch (error) { stored = null; }
      var ok = function (value) { return value === "a" || value === "b" || value === "c" || value === "d"; };
      hero.setAttribute("data-variant", ok(fromUrl) ? fromUrl : ok(stored) ? stored : "d");
    })();
  </script>
  <div class="v2-stage hero__stage v2-on-dark">
    <canvas class="hero__stars" data-v2-stars aria-hidden="true"></canvas>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__planet" aria-hidden="true" data-v2-planet></div>
    <canvas class="hero__orbits" data-v2-hero-orbits aria-hidden="true"></canvas>
    <canvas class="hero__dots" data-v2-hero-dots aria-hidden="true"></canvas>
    <div class="hero__eclipse" aria-hidden="true">
      <span class="hero__corona"></span>
      <span class="hero__disc"></span>
    </div>

    <div class="hero__picker" role="group" aria-label="Variante del hero (Brand Lab)">
      {["a", "b", "c", "d"].map((variant) => (
        <button type="button" data-hero-pick={variant}>{variant.toUpperCase()}</button>
      ))}
    </div>

    <div class="v2-container hero__content">
      <h1 class="hero__title">
        <span class="v2-display-xl hero__headline">
          Finally: Your <span class="hero__rotator"><span class="hero__rotator-track" data-v2-rotator>{[...rotatorWords, rotatorWords[0]].map((word, index) => (
            <span aria-hidden={index > 0 ? "true" : undefined}>{word}</span>
          ))}</span></span><br />Tech Partner.
        </span>
        <span class="hero__kicker">Blockchain Development Company & Web3 Software Partner</span>
      </h1>
      <p class="v2-lead hero__lead">
        SpaceDev builds custom <strong>Web3</strong> and <strong>blockchain</strong> solutions, from <strong>dApps</strong> and <strong>smart contracts</strong> to <strong>DeFi</strong> and token infrastructure, for startups, fintechs and enterprises that need a technical partner with real depth.
      </p>
      <div class="hero__actions">
        <V2Button href="/contact" tone="light">Get in touch</V2Button>
        <a href={MEETING_URL} target="_blank" rel="noopener noreferrer" class="v2-link">Book a call</a>
      </div>
    </div>

    <div class="v2-container hero__logos">
      <p class="v2-label">Trusted by</p>
      <div class="sd-marquee-wrapper hero__marquee">
        <div class="sd-marquee">
          {[0, 1].map((copy) => (
            <div class="sd-marquee-set" aria-hidden={copy === 1 ? "true" : undefined}>
              {clientLogosWhite.map((logo) => (
                <img
                  src={logo.src}
                  alt={copy === 0 ? logo.alt : ""}
                  loading="lazy"
                  width={Math.round(22 * (logo.scale ?? 1) * logo.ratio)}
                  height={Math.round(22 * (logo.scale ?? 1))}
                  style={`height:${22 * (logo.scale ?? 1)}px`}
                  class="w-auto shrink-0 object-contain"
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* Rotating word, same timing and easing as the live home. */
  const track = document.querySelector<HTMLElement>("[data-v2-rotator]");
  if (track && !reduced) {
    const slides = track.children.length - 1;
    let index = 0;
    window.setInterval(() => {
      index += 1;
      track.classList.add("is-animating");
      track.style.transform = `translateY(-${index * 1.05}em)`;
      if (index === slides) {
        window.setTimeout(() => {
          track.classList.remove("is-animating");
          index = 0;
          track.style.transform = "translateY(0)";
        }, 430);
      }
    }, 2400);
  }

  /* Variant picker (lab only). */
  const hero = document.querySelector<HTMLElement>("[data-v2-hero]");
  const pickers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hero-pick]"));
  const paintPicker = () => pickers.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.heroPick === hero?.dataset.variant)));
  pickers.forEach((button) =>
    button.addEventListener("click", () => {
      if (!hero) return;
      hero.dataset.variant = button.dataset.heroPick ?? "a";
      try { sessionStorage.setItem("sd-hero-variant", hero.dataset.variant); } catch { /* the choice still applies to this page */ }
      const url = new URL(location.href);
      url.searchParams.set("hero", hero.dataset.variant);
      history.replaceState(null, "", url);
      paintPicker();
      window.dispatchEvent(new Event("v2-hero-variant"));
    })
  );
  paintPicker();

  /* Variant B: orbital system in thin light lines on the dark stage. */
  const orbitCanvas = document.querySelector<HTMLCanvasElement>("[data-v2-hero-orbits]");
  const orbitContext = orbitCanvas?.getContext("2d");
  if (orbitCanvas && orbitContext && hero) {
    const TAU = Math.PI * 2;
    let width = 0;
    let height = 0;
    let visible = true;
    const fit = () => {
      const ratio = Math.min(2, window.devicePixelRatio || 1);
      width = orbitCanvas.clientWidth;
      height = orbitCanvas.clientHeight;
      orbitCanvas.width = Math.round(width * ratio);
      orbitCanvas.height = Math.round(height * ratio);
      orbitContext.setTransform(ratio, 0, 0, ratio, 0, 0);
    };
    const orbits = [
      { rx: 0.62, ry: 0.2, tilt: -0.32, speed: 0.22, nodes: 3 },
      { rx: 0.9, ry: 0.3, tilt: 0.18, speed: -0.14, nodes: 2 },
      { rx: 1.18, ry: 0.42, tilt: -0.08, speed: 0.09, nodes: 4 },
    ];
    const drawOrbits = (now: number) => {
      const g = orbitContext;
      const t = reduced ? 6 : now / 1000;
      g.clearRect(0, 0, width, height);
      const r = Math.min(width * 0.42, height * 0.62);
      g.save();
      g.translate(width * 0.55, height * 0.5);
      const core = g.createRadialGradient(0, 0, 0, 0, 0, r * 0.35);
      core.addColorStop(0, "rgba(200, 181, 255, 0.55)");
      core.addColorStop(0.25, "rgba(142, 110, 236, 0.22)");
      core.addColorStop(1, "rgba(91, 55, 198, 0)");
      g.fillStyle = core;
      g.beginPath();
      g.arc(0, 0, r * 0.35, 0, TAU);
      g.fill();
      g.fillStyle = "#e4dbff";
      g.beginPath();
      g.arc(0, 0, 3.5, 0, TAU);
      g.fill();
      orbits.forEach((orbit) => {
        const rx = r * orbit.rx;
        const ry = r * orbit.ry;
        g.save();
        g.rotate(orbit.tilt);
        const steps = 120;
        g.lineWidth = 1;
        for (let i = 0; i < steps; i += 1) {
          const a0 = (i / steps) * TAU;
          const a1 = ((i + 1) / steps) * TAU;
          const depth = (Math.sin((a0 + a1) / 2) + 1) / 2;
          g.strokeStyle = `rgba(228, 219, 255, ${0.06 + 0.22 * depth})`;
          g.beginPath();
          g.moveTo(Math.cos(a0) * rx, Math.sin(a0) * ry);
          g.lineTo(Math.cos(a1) * rx, Math.sin(a1) * ry);
          g.stroke();
        }
        for (let n = 0; n < orbit.nodes; n += 1) {
          const angle = t * orbit.speed + (n / orbit.nodes) * TAU + orbit.rx;
          const direction = Math.sign(orbit.speed) || 1;
          for (let i = 0; i < 20; i += 1) {
            const b0 = angle - direction * 0.035 * i;
            const b1 = angle - direction * 0.035 * (i + 1);
            g.strokeStyle = `rgba(200, 181, 255, ${0.5 * (1 - i / 20)})`;
            g.lineWidth = 1.4 * (1 - i / 20) + 0.2;
            g.beginPath();
            g.moveTo(Math.cos(b0) * rx, Math.sin(b0) * ry);
            g.lineTo(Math.cos(b1) * rx, Math.sin(b1) * ry);
            g.stroke();
          }
          const depth = (Math.sin(angle) + 1) / 2;
          g.fillStyle = n === 0 ? "#ffffff" : `rgba(200, 181, 255, ${0.45 + 0.55 * depth})`;
          g.beginPath();
          g.arc(Math.cos(angle) * rx, Math.sin(angle) * ry, (n === 0 ? 3.2 : 2.4) * (0.75 + 0.5 * depth), 0, TAU);
          g.fill();
        }
        g.restore();
      });
      g.restore();
    };
    const loop = (now: number) => {
      if (visible && !document.hidden && hero.dataset.variant === "b") drawOrbits(now);
      if (!reduced) requestAnimationFrame(loop);
    };
    fit();
    window.addEventListener("resize", fit);
    window.addEventListener("v2-hero-variant", () => {
      fit();
      drawOrbits(performance.now());
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(orbitCanvas);
    if (reduced) drawOrbits(performance.now());
    else requestAnimationFrame(loop);
  }

  /* Variant D: the top of a sphere in rings of dots, turning slowly. */
  const dotsCanvas = document.querySelector<HTMLCanvasElement>("[data-v2-hero-dots]");
  const dotsContext = dotsCanvas?.getContext("2d");
  if (dotsCanvas && dotsContext && hero) {
    const TAU = Math.PI * 2;
    let width = 0;
    let height = 0;
    let visible = true;
    let rings: Array<{ theta: number; count: number }> = [];
    const fit = () => {
      const ratio = Math.min(2, window.devicePixelRatio || 1);
      width = dotsCanvas.clientWidth;
      height = dotsCanvas.clientHeight;
      dotsCanvas.width = Math.round(width * ratio);
      dotsCanvas.height = Math.round(height * ratio);
      dotsContext.setTransform(ratio, 0, 0, ratio, 0, 0);
      const small = width < 1000;
      const ringCount = small ? 38 : 54;
      const widest = small ? 130 : 210;
      rings = Array.from({ length: ringCount }, (_, i) => {
        const theta = 1.32 * ((i + 1) / ringCount) ** 1.12;
        return { theta, count: Math.max(8, Math.round(Math.sin(theta) * widest)) };
      });
    };
    const drawDots = (now: number) => {
      const g = dotsContext;
      const t = reduced ? 3 : now / 1000;
      g.clearRect(0, 0, width, height);
      const radius = Math.max(width * 0.62, 560);
      const pitch = 0.42;
      const cosPitch = Math.cos(pitch);
      const sinPitch = Math.sin(pitch);
      const distance = radius * 3;
      const horizon = radius / 3;
      const poleScale = distance / (distance - radius * sinPitch);
      const cx = width / 2;
      const cy = height * 0.74 + radius * cosPitch * poleScale;
      const spin = t * 0.12;
      for (const ring of rings) {
        const sinTheta = Math.sin(ring.theta);
        const cosTheta = Math.cos(ring.theta);
        for (let k = 0; k < ring.count; k += 1) {
          const phi = (k / ring.count) * TAU + spin;
          const x = radius * sinTheta * Math.cos(phi);
          const y = radius * cosTheta;
          const z = radius * sinTheta * Math.sin(phi);
          const y2 = y * cosPitch - z * sinPitch;
          const z2 = y * sinPitch + z * cosPitch;
          if (z2 < horizon) continue;
          const scale = distance / (distance - z2);
          const sx = cx + x * scale;
          const sy = cy - y2 * scale;
          if (sy < 0 || sy > height || sx < -4 || sx > width + 4) continue;
          const facing = (z2 - horizon) / (radius - horizon);
          const arms = 0.5 + 0.5 * Math.cos(4 * (phi - spin) + 9 * ring.theta);
          const alpha = (0.28 + 0.72 * arms) * (0.35 + 0.65 * facing);
          const size = 1.1 * scale;
          g.fillStyle = `rgba(228, 219, 255, ${alpha.toFixed(3)})`;
          g.fillRect(sx - size / 2, sy - size / 2, size, size);
        }
      }
    };
    const loop = (now: number) => {
      if (visible && !document.hidden && hero.dataset.variant === "d") drawDots(now);
      if (!reduced) requestAnimationFrame(loop);
    };
    fit();
    window.addEventListener("resize", fit);
    window.addEventListener("v2-hero-variant", () => {
      fit();
      drawDots(performance.now());
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(dotsCanvas);
    if (reduced) drawDots(performance.now());
    else requestAnimationFrame(loop);
  }

  /* Star field */
  const canvas = document.querySelector<HTMLCanvasElement>("[data-v2-stars]");
  const context = canvas?.getContext("2d");
  if (canvas && context) {
    interface Star { x: number; y: number; depth: number; size: number; phase: number; speed: number }
    interface Streak { x: number; y: number; life: number }
    let width = 0;
    let height = 0;
    let stars: Star[] = [];
    let streak: Streak | null = null;
    let nextStreak = performance.now() + 4000;
    const pointer = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5 };
    let visible = true;
    let last = performance.now();
    const planetElement = document.querySelector<HTMLElement>("[data-v2-planet]");
    const planet = { x: 0, y: 0, r: 0 };

    function resize(): void {
      const ratio = Math.min(2, window.devicePixelRatio || 1);
      width = canvas!.clientWidth;
      height = canvas!.clientHeight;
      canvas!.width = Math.round(width * ratio);
      canvas!.height = Math.round(height * ratio);
      context!.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (planetElement) {
        const box = planetElement.getBoundingClientRect();
        const frame = canvas!.getBoundingClientRect();
        planet.r = box.width / 2;
        planet.x = box.left - frame.left + planet.r;
        planet.y = box.top - frame.top + planet.r;
      }
      /* About 220 stars on a desktop hero and 70 on a phone: enough for the
         field to read, half the work of the first version. */
      const density = width < 1000 ? 5200 : 6000;
      const count = Math.min(240, Math.round((width * height) / density));
      stars = Array.from({ length: count }, () => {
        const depth = Math.random() ** 1.6;
        return {
          x: Math.random() * width,
          y: Math.random() * height,
          depth,
          size: 0.4 + depth * 1.3,
          phase: Math.random() * Math.PI * 2,
          speed: 0.4 + Math.random() * 1.2,
        };
      });
    }

    function draw(now: number): void {
      const delta = Math.min(64, now - last);
      last = now;
      pointer.x += (pointer.tx - pointer.x) * 0.05;
      pointer.y += (pointer.ty - pointer.y) * 0.05;
      context!.clearRect(0, 0, width, height);
      for (const star of stars) {
        if (!reduced) star.x += star.depth * 0.012 * delta;
        if (star.x > width + 4) star.x = -4;
        const offsetX = (pointer.x - 0.5) * star.depth * -28;
        const offsetY = (pointer.y - 0.5) * star.depth * -16;
        if (planet.r && Math.hypot(star.x + offsetX - planet.x, star.y + offsetY - planet.y) < planet.r + 2) continue;
        const twinkle = reduced ? 1 : 0.65 + 0.35 * Math.sin(now * 0.001 * star.speed + star.phase);
        context!.globalAlpha = (0.25 + 0.75 * star.depth) * twinkle;
        context!.fillStyle = star.depth > 0.7 ? "#e4dbff" : "#ffffff";
        context!.beginPath();
        context!.arc(star.x + offsetX, star.y + offsetY, star.size, 0, Math.PI * 2);
        context!.fill();
      }
      if (planet.r) drawRim(now);
      if (!reduced) {
        if (!streak && now > nextStreak) {
          streak = { x: width * (0.15 + Math.random() * 0.6), y: height * (0.05 + Math.random() * 0.25), life: 0 };
        }
        if (streak) {
          streak.life += delta / 1000;
          const travel = streak.life * 520;
          const headX = streak.x + travel;
          const headY = streak.y + travel * 0.32;
          const gradient = context!.createLinearGradient(headX - 140, headY - 45, headX, headY);
          gradient.addColorStop(0, "rgba(228, 219, 255, 0)");
          gradient.addColorStop(1, "rgba(228, 219, 255, 0.9)");
          context!.globalAlpha = Math.max(0, 1 - streak.life / 0.9);
          context!.strokeStyle = gradient;
          context!.lineWidth = 1.2;
          context!.beginPath();
          context!.moveTo(headX - 140, headY - 45);
          context!.lineTo(headX, headY);
          context!.stroke();
          if (streak.life > 0.9) {
            streak = null;
            nextStreak = now + 6000 + Math.random() * 6000;
          }
        }
      }
      context!.globalAlpha = 1;
    }

    /* Highlight gliding along the horizon, back and forth around the top. */
    function drawRim(now: number): void {
      const swing = reduced ? 0 : Math.sin((now / 11000) * Math.PI) * 0.32;
      const angle = -Math.PI / 2 + swing;
      const spread = 0.09;
      const glow = context!.createConicGradient(angle - spread, planet.x, planet.y);
      glow.addColorStop(0, "rgba(200, 181, 255, 0)");
      glow.addColorStop(spread / (Math.PI * 2), "rgba(255, 255, 255, 0.95)");
      glow.addColorStop((spread * 2) / (Math.PI * 2), "rgba(200, 181, 255, 0)");
      glow.addColorStop(1, "rgba(200, 181, 255, 0)");
      context!.save();
      context!.globalAlpha = 1;
      context!.strokeStyle = glow;
      context!.lineWidth = 2;
      context!.shadowColor = "rgba(200, 181, 255, 0.95)";
      context!.shadowBlur = 16;
      context!.beginPath();
      context!.arc(planet.x, planet.y, planet.r, angle - spread, angle + spread);
      context!.stroke();
      context!.restore();
    }

    function loop(now: number): void {
      if (visible && !document.hidden && hero?.dataset.variant !== "d") draw(now);
      if (!reduced) requestAnimationFrame(loop);
    }

    resize();
    window.addEventListener("resize", resize);
    window.addEventListener("v2-hero-variant", resize);
    canvas.parentElement?.addEventListener("pointermove", (event) => {
      const rect = canvas.getBoundingClientRect();
      pointer.tx = (event.clientX - rect.left) / rect.width;
      pointer.ty = (event.clientY - rect.top) / rect.height;
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      last = performance.now();
    }).observe(canvas);
    if (reduced) draw(performance.now());
    else requestAnimationFrame(loop);
  }
</script>

<style>
  /* The hero runs under the transparent navbar, so there is no light band
     between the top of the page and the dark stage. */
  .hero { margin-top: -72px; }
  .hero__stage {
    color: #ffffff;
    margin-inline: 0;
    border-radius: 0;
    min-height: clamp(720px, 100svh, 1000px);
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #0f0e12 0%, #141313 30%, #2c2a2f 58%, #3b2b5c 78%, #503498 100%);
  }
  .hero__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  /* Light pooling above the horizon. */
  .hero__glow {
    position: absolute;
    left: 50%;
    bottom: 18%;
    width: 120%;
    height: 60%;
    transform: translateX(-50%);
    z-index: -3;
    background: radial-gradient(50% 50% at 50% 100%, rgba(142, 110, 236, 0.55) 0%, rgba(91, 55, 198, 0.22) 45%, transparent 75%);
    animation: hero-breathe 8s ease-in-out infinite alternate;
  }

  /* The planet: a huge disc whose top edge is the horizon. */
  .hero__planet {
    position: absolute;
    left: 50%;
    top: 74%;
    width: max(2200px, 170vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    z-index: -2;
    background: radial-gradient(60% 8% at 50% 0%, #2c2a2f 0%, #141313 60%, #0c0b0e 100%), #0c0b0e;
    box-shadow:
      0 -1px 0 0 rgba(228, 219, 255, 0.7),
      0 -10px 40px 0 rgba(200, 181, 255, 0.45),
      0 -40px 140px 10px rgba(142, 110, 236, 0.4);
  }
  @keyframes hero-breathe {
    from { opacity: 0.7; transform: translateX(-50%) scaleY(0.94); }
    to { opacity: 1; transform: translateX(-50%) scaleY(1.04); }
  }

  .hero__content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(150px, 18vh, 210px);
  }
  .hero__title { margin: 0; }

  .hero__rotator {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    height: 1.05em;
    line-height: 1.05;
    color: var(--v2-lilac);
  }
  .hero__rotator-track {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    will-change: transform;
  }
  .hero__rotator-track > span {
    height: 1.05em;
    line-height: 1.05;
  }
  .hero__rotator-track.is-animating {
    transition: transform 0.42s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .hero__headline { display: block; }
  .hero__kicker {
    display: block;
    margin-top: 22px;
    font-family: var(--font-body);
    font-size: clamp(15px, 1.05vw, 17px);
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.66);
  }
  .hero__lead {
    max-width: 58ch;
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.72);
  }
  .hero__lead strong { color: #ffffff; font-weight: 700; }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 34px;
  }

  /* ── Variants ─────────────────────────────────── */
  .hero__orbits,
  .hero__eclipse { display: none; }
  .hero[data-variant="b"] .hero__planet,
  .hero[data-variant="b"] .hero__glow,
  .hero[data-variant="c"] .hero__planet,
  .hero[data-variant="c"] .hero__glow { display: none; }
