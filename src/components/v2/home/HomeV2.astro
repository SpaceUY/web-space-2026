---
/**
 * Brand v2 home (experiment). Same copy, links and data as the live home,
 * laid out with the v2 system: a hero stage, numbered sections, hairlines
 * instead of boxes, and motion only where it helps reading or exploring
 * (scroll-filled statement, sticky service index, navbar panel).
 */
import V2Label from "../V2Label.astro";
import V2Button from "../V2Button.astro";
import V2Arrow from "../V2Arrow.astro";
import V2ScrollFill from "../V2ScrollFill.astro";
import AuthorAvatar from "../../ui/AuthorAvatar.astro";
import { homeFaqs } from "../../../data/site-content";
import { featuredCaseStudies } from "../../../data/case-studies";
import { getAuthor } from "../../../data/authors";
import {
  clientLogosWhite,
  homeAwards,
  homeCommunities,
  homeEngagementModels,
  homeIndustries,
  homeReasons,
  homeServiceArt,
  homeServices,
  homeTakeaways,
  homeTestimonials,
} from "../../../data/home";
import type { CollectionEntry } from "astro:content";

interface Props {
  recentPosts: CollectionEntry<"blog">[];
}

const { recentPosts } = Astro.props;

const MEETING_URL = "https://meetings.hubspot.com/federico-sendra/meet-space";
const rotatorWords = ["Flexible", "Reliable", "Fast"];
const featured = featuredCaseStudies.slice(0, 3);
const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const pad = (value: number) => String(value).padStart(2, "0");
---

<div class="v2-page v2-home">
  <!-- 01 HERO -->
  <section class="v2-hero" data-nav-theme="dark">
    <div class="v2-stage v2-stage--hero v2-on-dark v2-hero__stage">
      <div class="v2-container v2-hero__grid">
        <h1 class="v2-hero__title">
          <span class="v2-display-xl block">
            Finally: Your <span class="v2-rotator"><span class="v2-rotator__track" data-v2-rotator>{[...rotatorWords, rotatorWords[0]].map((word, index) => <span aria-hidden={index > 0 ? "true" : undefined}>{word}</span>)}</span></span>
            Tech Partner.
          </span>
          <span class="v2-hero__kicker">Blockchain Development Company & Web3 Software Partner</span>
        </h1>
        <div class="v2-hero__aside">
          <img
            src="/images/brand/v2/astronauta_laptop_violeta.webp"
            alt=""
            width="1000"
            height="764"
            fetchpriority="high"
            class="v2-hero__art"
          />
          <p class="v2-caption v2-lead">
            SpaceDev builds custom <strong>Web3</strong> and <strong>blockchain</strong> solutions, from <strong>dApps</strong> and <strong>smart contracts</strong> to <strong>DeFi</strong> and token infrastructure, for startups, fintechs and enterprises that need a technical partner with real depth.
          </p>
          <div class="v2-hero__actions">
            <V2Button href="/contact" tone="light">Get in touch</V2Button>
            <a href={MEETING_URL} target="_blank" rel="noopener noreferrer" class="v2-link">Book a call</a>
          </div>
        </div>
      </div>
      <div class="v2-container v2-hero__logos">
        <p class="v2-label">Trusted by</p>
        <div class="sd-marquee-wrapper v2-hero__marquee">
          <div class="sd-marquee">
            {[0, 1].map((copy) => (
              <div class="sd-marquee-set" aria-hidden={copy === 1 ? "true" : undefined}>
                {clientLogosWhite.map((logo) => (
                  <img
                    src={logo.src}
                    alt={copy === 0 ? logo.alt : ""}
                    loading="lazy"
                    width={Math.round(24 * (logo.scale ?? 1) * logo.ratio)}
                    height={Math.round(24 * (logo.scale ?? 1))}
                    style={`height:${24 * (logo.scale ?? 1)}px`}
                    class="w-auto shrink-0 object-contain opacity-80"
                  />
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KEY TAKEAWAYS -->
  <section class="v2-container v2-takeaways">
    <h2 class="v2-label">Key Takeaways</h2>
    <ul class="v2-takeaways__list">
      {homeTakeaways.map((item) => (
        <li class="v2-takeaways__item">
          <strong>{item.label}</strong> {item.link && <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="v2-link">{item.link.text}</a>}{item.text}
        </li>
      ))}
    </ul>
  </section>

  <!-- STATEMENT -->
  <section class="v2-section v2-container">
    <V2ScrollFill
      as="p"
      class="v2-display-l v2-statement"
      text="Take your business to new heights quickly. Let us handle the technology."
    />
  </section>

  <!-- 02 SERVICES: sticky index on the left, one panel per service on the right (Joby) -->
  <section class="v2-section v2-container v2-services" id="services">
    <div class="v2-services__index">
      <div class="v2-services__sticky">
        <V2Label index="02">Services</V2Label>
        <h2 class="v2-display-l mt-6">Our Web2 and Web3 Development Services</h2>
        <p class="v2-body mt-6 max-w-[46ch]">
          We build the infrastructure that decentralized products run on. Whether you need a full-stack dApp, a custom blockchain protocol, or a secure smart contract system, our teams work across EVM-compatible chains (Ethereum and networks that share its Ethereum Virtual Machine), Solana, and Layer 2 networks.
        </p>
        <ol class="v2-services__nav" aria-label="Services">
          {homeServices.map((service, index) => (
            <li>
              <a href={`#service-${index + 1}`} class="v2-services__nav-item" data-service-link={index}>
                <span class="v2-services__nav-n">{pad(index + 1)}</span>
                <span>{service.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="v2-body mt-10">Reach out and we'll find the right services, tailored just for you.</p>
        <div class="mt-5"><V2Button href="/contact">Get in touch</V2Button></div>
      </div>
    </div>
    <div class="v2-services__panels">
      {homeServices.map((service, index) => (
        <article class="v2-services__panel" id={`service-${index + 1}`} data-service-panel={index}>
          <a href={service.href} class="v2-services__figure" tabindex="-1" aria-hidden="true">
            <img src={homeServiceArt[service.href]} alt="" loading="lazy" decoding="async" class="v2-services__art" />
            <span class="v2-services__figure-n">{pad(index + 1)} / {pad(homeServices.length)}</span>
          </a>
          <h3 class="v2-display-m mt-8">{service.title}</h3>
          <p class="v2-body mt-4 max-w-[52ch]">{service.desc}</p>
          <a href={service.href} class="v2-link inline-flex items-center gap-2 mt-6">Explore <V2Arrow size={12} /></a>
        </article>
      ))}
    </div>
  </section>

  <!-- 03 WHY SPACEDEV -->
  <section class="v2-section v2-container" id="why">
    <div class="v2-split">
      <div>
        <V2Label index="03">Why SpaceDev</V2Label>
        <h2 class="v2-display-l mt-6 max-w-[18ch]">Why Partner with a Blockchain Development Company Like SpaceDev</h2>
      </div>
      <p class="v2-lead v2-split__aside">
        There are many development agencies. Fewer have deep blockchain engineering depth. Even fewer combine that with Web2 product experience, a security practice, and a track record across 200+ projects in DeFi, NFT infrastructure, fintech, and enterprise blockchain.
      </p>
    </div>
    <div class="v2-reasons">
      {homeReasons.map((reason) => (
        <div class="v2-reasons__item">
          <p class="v2-reasons__n">{reason.n}</p>
          <h3 class="v2-display-s">{reason.title}</h3>
          <p class="v2-body mt-3">{reason.desc}</p>
        </div>
      ))}
    </div>
    <div class="mt-12"><V2Button href="/contact">Partner with us</V2Button></div>
  </section>

  <!-- 04 INDUSTRIES: an index, not a card wall -->
  <section class="v2-section v2-container" id="industries">
    <V2Label index="04">Industries</V2Label>
    <h2 class="v2-display-l mt-6 max-w-[20ch]">Blockchain Development for Fintech, DeFi & Web3 Startups</h2>
    <ul class="v2-index mt-14">
      {homeIndustries.map((industry, index) => {
        const summary = industry.desc.split("\n")[0];
        const inner = (
          <>
            <span class="v2-index__n">{pad(index + 1)}</span>
            <span class="v2-index__name">{industry.name}</span>
            <span class="v2-index__desc">{summary}</span>
            <span class="v2-index__arrow">{industry.linked !== false && <V2Arrow />}</span>
          </>
        );
        return (
          <li>
            {industry.linked === false ? (
              <div class="v2-index__row">{inner}</div>
            ) : (
              <a href={`/blockchain-development-services/industry/${industry.slug}`} class="v2-index__row v2-index__row--link">{inner}</a>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <!-- 05 WORK -->
  <section class="v2-section v2-container" id="work">
    <div class="v2-split">
      <div>
        <V2Label index="05">Work</V2Label>
        <h2 class="v2-display-l mt-6 max-w-[16ch]">Web3 and Web2 Development Case Studies</h2>
      </div>
      <p class="v2-lead v2-split__aside">
        Every product tells a story: one of collaboration, innovation, and measurable results. SpaceDev not only delivers projects; we support businesses' growth with the kind of technology that earns trust, scales with users, and stands the test of time.
      </p>
    </div>
    <div class="v2-work">
      {featured.map((study, index) => (
        <a href={`/our-work/${study.slug}`} class:list={["v2-work__card", { "v2-work__card--lead": index === 0 }]}>
          <div class="v2-work__media">
            {study.image && <img src={study.image} alt={study.name} loading="lazy" decoding="async" class="v2-work__img" />}
          </div>
          <div class="v2-work__caption">
            <p class="v2-label">{study.category}{study.industry ? ` / ${study.industry}` : ""}</p>
            <h3 class="v2-display-s mt-3">{study.name}</h3>
            <p class="v2-body mt-2">{study.tagline}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
      <V2Button href="/our-work">See all work</V2Button>
      <p class="v2-body">
        Eager to create your own success story? <a href={MEETING_URL} target="_blank" rel="noopener noreferrer" class="v2-link">Book a call</a>.
      </p>
    </div>
  </section>

  <!-- 06 ENGAGEMENT MODELS: dark stage -->
  <section class="v2-engage" id="engagement" data-nav-theme="dark">
    <div class="v2-stage v2-stage--dark v2-on-dark">
      <div class="v2-container v2-section">
        <V2Label index="06">Engagement</V2Label>
        <h2 class="v2-display-l mt-6 max-w-[18ch]">There are two ways to work with us.<br />Pick what suits you!</h2>
        <div class="v2-engage__models">
          {homeEngagementModels.map((model) => (
            <div class="v2-engage__model">
              <h3 class="v2-display-m">{model.title}</h3>
              <p class="v2-body mt-3 max-w-[40ch]">{model.subtitle}</p>
              <ol class="v2-engage__steps">
                {model.steps.map((step, index) => (
                  <li><span class="v2-engage__n">{pad(index + 1)}</span>{step}</li>
                ))}
              </ol>
              <p class="v2-body text-sm">{model.note}</p>
            </div>
          ))}
        </div>
        <div class="v2-engage__cta">
          <div>
            <p class="v2-display-s">Still not sure which option you need?</p>
            <p class="v2-body mt-2">No worries, we're here to help you find the best fit!</p>
          </div>
          <V2Button href="/contact" tone="light">Get in touch</V2Button>
        </div>
      </div>
      <img src="/images/brand/v2/luna_violeta.webp" alt="" loading="lazy" decoding="async" class="v2-engage__moon" />
    </div>
  </section>

  <!-- 07 TESTIMONIALS: hairline columns -->
  <section class="v2-section v2-container" id="clients">
    <div class="v2-split">
      <div>
        <V2Label index="07">Clients</V2Label>
        <h2 class="v2-display-l mt-6 max-w-[18ch]">Over <span class="v2-accent">50 perfect 5-star ratings</span> from happy customers</h2>
      </div>
      <p class="v2-lead v2-split__aside">
        Clients choose SpaceDev for reliability, communication, and technical depth, and stay for the results. Every partnership reflects our belief that success is built on trust, collaboration, and a shared vision.
      </p>
    </div>
    <div class="v2-columns mt-16">
      {homeTestimonials.map((review) => (
        <a href={review.href} target="_blank" rel="noopener noreferrer" class="v2-columns__item v2-quote">
          <div class="v2-quote__head">
            <img src="/images/Clutch-sm.svg" alt="Clutch" width="71" height="80" class="h-6 w-auto" />
            <span class="v2-quote__rating">5.0 <span aria-hidden="true">★★★★★</span></span>
          </div>
          <blockquote class="v2-quote__text">{review.quote}</blockquote>
          <div class="v2-quote__meta">
            <p class="v2-quote__company">{review.company}</p>
            <p>{review.location}</p>
            <p>{review.period}</p>
          </div>
        </a>
      ))}
    </div>
    <a href="https://clutch.co/profile/spacedev" target="_blank" rel="noopener noreferrer" class="v2-link inline-flex items-center gap-2 mt-10">See our Clutch profile <V2Arrow size={12} diagonal /></a>
  </section>

  <!-- 08 RECOGNITION -->
  <section class="v2-section--tight v2-container" id="recognition">
    <div class="v2-split">
      <div>
        <V2Label index="08">Recognition</V2Label>
        <h2 class="v2-display-m mt-6">Highly reviewed by</h2>
      </div>
      <p class="v2-body v2-split__aside">AWS lists us as a Partner and Marketplace seller, Forbes named us to its Technology Council, and Clutch, GoodFirms, and Upwork have each recognized us among the top blockchain development companies.</p>
    </div>
    <div class="v2-tiles v2-tiles--awards mt-12">
      {homeAwards.map((badge) => (
        <a href={badge.href} target="_blank" rel="noopener noreferrer" class="v2-tiles__tile">
          <img src={badge.src} alt={badge.alt} loading="lazy" width={badge.w} height={badge.h} class:list={["v2-tiles__img", { "v2-tiles__img--compact": badge.compact }]} />
        </a>
      ))}
    </div>
    <h2 class="v2-label mt-20">We support</h2>
    <div class="v2-tiles v2-tiles--community mt-6">
      {homeCommunities.map((community) => (
        <a href={community.href} target="_blank" rel="noopener noreferrer" class="v2-tiles__tile">
          <img src={community.src} alt={community.alt} loading="lazy" width={community.w} height={community.h} class="v2-tiles__img v2-tiles__img--compact" />
        </a>
      ))}
    </div>
  </section>

  <!-- 09 FAQ -->
  <section class="v2-section v2-container v2-faq" id="faq">
    <div class="v2-faq__head">
      <V2Label index="09">FAQ</V2Label>
      <h2 class="v2-display-l mt-6">Frequently Asked Questions</h2>
    </div>
    <div class="v2-faq__list">
      {homeFaqs.map((faq) => (
        <details class="v2-faq__item">
          <summary class="v2-faq__q">
            <span>{faq.question}</span>
            <span class="v2-faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="v2-body v2-faq__a">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 10 BLOG: hairline columns, date first (Joby news) -->
  <section class="v2-section v2-container" id="blog">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <V2Label index="10">Blog</V2Label>
        <h2 class="v2-display-m mt-6 max-w-[22ch]">Check out some related articles from our blog!</h2>
      </div>
      <V2Button href="/blog" size="sm">View all posts</V2Button>
    </div>
    <div class="v2-columns v2-columns--3 mt-14">
      {recentPosts.map((post) => {
        const author = getAuthor(post.data.author);
        return (
          <article class="v2-columns__item v2-post">
            <p class="v2-label">
              <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
              <span aria-hidden="true">/</span>
              <span>{post.data.readTime} min read</span>
            </p>
            <a href={`/blog/${post.id}`} class="v2-post__link">
              <h3 class="v2-display-s mt-4">{post.data.title}</h3>
              <div class="v2-post__media">
                {post.data.cover && <img src={post.data.cover} alt={post.data.title} loading="lazy" decoding="async" width="1280" height="800" class="v2-post__img" />}
              </div>
            </a>
            {author && (
              <a href={`/author/${author.slug}`} class="inline-flex mt-5">
                <AuthorAvatar author={author} size="sm" showRole tone="light" />
              </a>
            )}
          </article>
        );
      })}
    </div>
  </section>

  <!-- 11 FINAL CTA: apertura stage -->
  <section class="v2-final" id="next-step" data-nav-theme="dark">
    <div class="v2-stage v2-stage--apertura v2-on-dark v2-final__stage">
      <div class="v2-container v2-final__content">
        <V2Label index="11">Next step</V2Label>
        <h2 class="v2-display-xl mt-6 max-w-[14ch]">Ready to build the future with SpaceDev?</h2>
        <div class="v2-final__copy">
          <p class="v2-lead">Your next big idea deserves a partner who understands both innovation and execution.</p>
          <p class="v2-lead">SpaceDev combines web3 development services, blockchain expertise, and global engineering talent to help you move from vision to reality with speed and precision.</p>
          <p class="v2-lead">Let's turn your concept into a product that scales, engages, and endures.</p>
        </div>
        <div class="mt-10"><V2Button href={MEETING_URL} tone="light" external>Schedule a call</V2Button></div>
      </div>
      <img src="/images/brand/v2/apreton_violeta.webp" alt="" loading="lazy" decoding="async" class="v2-final__art" />
    </div>
  </section>
</div>

<script>
  /* Rotating word in the hero: all slides are in the HTML and only the track
     moves, so the h1 (the LCP element) never repaints new text. */
  const track = document.querySelector<HTMLElement>("[data-v2-rotator]");
  if (track && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const slides = track.children.length - 1;
    let index = 0;
    window.setInterval(() => {
      index += 1;
      track.classList.add("is-animating");
      track.style.transform = `translateY(-${index * 1.02}em)`;
      if (index === slides) {
        window.setTimeout(() => {
          track.classList.remove("is-animating");
          index = 0;
          track.style.transform = "translateY(0)";
        }, 520);
      }
    }, 2600);
  }

  /* Sticky service index: the panel crossing the middle of the viewport is
     the active one (Joby). */
  const links = Array.from(document.querySelectorAll<HTMLElement>("[data-service-link]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-service-panel]"));
  if (links.length && panels.length) {
    const setActive = (active: string) => {
      links.forEach((link) => link.toggleAttribute("data-active", link.dataset.serviceLink === active));
      panels.forEach((panel) => panel.toggleAttribute("data-active", panel.dataset.servicePanel === active));
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive((entry.target as HTMLElement).dataset.servicePanel ?? "0");
        });
      },
      { rootMargin: "-45% 0px -50% 0px" }
    );
    panels.forEach((panel) => observer.observe(panel));
    setActive("0");
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .v2-hero {
    margin-top: -72px;
    padding-top: 12px;
  }
  .v2-hero__stage {
    min-height: calc(100svh - 24px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 140px;
  }
  .v2-hero__stage {
    background:
      radial-gradient(60% 50% at 82% 38%, rgba(139, 133, 219, 0.45) 0%, transparent 70%),
      linear-gradient(180deg, #2c2a2f 0%, #3b2b5c 45%, #503498 100%);
  }
  .v2-hero__art {
    display: block;
    width: min(100%, 460px);
    height: auto;
    margin: 0 0 clamp(24px, 3vw, 40px) auto;
    animation: v2-drift 9s ease-in-out infinite alternate;
  }
  @keyframes v2-drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(-10px, -18px, 0) rotate(-2deg); }
  }
  .v2-hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
    align-items: end;
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  .v2-hero__title { grid-column: 1 / span 8; margin: 0; }
  .v2-hero__kicker {
    display: block;
    margin-top: 28px;
    font-family: var(--font-body);
    font-size: clamp(16px, 1.3vw, 20px);
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.72);
  }
  .v2-hero__aside { grid-column: 9 / span 4; }
  .v2-hero__aside strong { color: #ffffff; font-weight: 700; }
  .v2-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }
  .v2-hero__logos {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-block: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .v2-hero__logos .v2-label { flex-shrink: 0; }
  .v2-hero__marquee { flex: 1; min-width: 0; }
  .v2-hero__marquee .sd-marquee,
  .v2-hero__marquee .sd-marquee-set { gap: 2.75rem; }
  .v2-hero__marquee .sd-marquee { animation-duration: 40s; }

  /* The rotating word sits on its own line: three even lines read as one
     deliberate headline instead of a wrap that moves with the word. */
  .v2-rotator {
    display: block;
    overflow: hidden;
    height: 1.02em;
    line-height: 1.02;
    color: var(--v2-lilac);
  }
  .v2-rotator__track { display: flex; flex-direction: column; }
  .v2-rotator__track > span { height: 1.02em; line-height: 1.02; }
  .v2-rotator__track.is-animating { transition: transform 0.5s var(--v2-ease); }

  /* ── Takeaways ───────────────────────────────────── */
  .v2-takeaways { padding-block: 56px 24px; }
  .v2-takeaways__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--v2-line);
  }
  .v2-takeaways__item {
    padding: 22px 24px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--v2-ink-2);
  }
