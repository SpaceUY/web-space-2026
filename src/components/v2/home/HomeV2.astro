---
/**
 * Brand v2 home (experiment). Same copy, links and data as the live home,
 * laid out with the v2 system: a hero stage, numbered sections, hairlines
 * instead of boxes, and motion only where it helps reading or exploring
 * (scroll-filled statement, sticky service index, navbar panel).
 */
import V2Button from "../V2Button.astro";
import V2Arrow from "../V2Arrow.astro";
import V2ScrollFill from "../V2ScrollFill.astro";
import HeroSpaceV2 from "./HeroSpaceV2.astro";
import ServicesV2 from "./ServicesV2.astro";
import AuthorAvatar from "../../ui/AuthorAvatar.astro";
import CaseStudyCard from "../../ui/CaseStudyCard.astro";
import { homeFaqs } from "../../../data/site-content";
import { featuredCaseStudies } from "../../../data/case-studies";
import { getAuthor } from "../../../data/authors";
import {
  homeAwards,
  homeCommunities,
  homeEngagementModels,
  homeIndustries,
  homeReasons,
  homeTakeaways,
  homeTestimonials,
} from "../../../data/home";
import type { CollectionEntry } from "astro:content";

interface Props {
  recentPosts: CollectionEntry<"blog">[];
}

const { recentPosts } = Astro.props;

const MEETING_URL = "https://meetings.hubspot.com/federico-sendra/meet-space";
const featured = featuredCaseStudies.slice(0, 3);
const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const pad = (value: number) => String(value).padStart(2, "0");
---

<div class="v2-page v2-home">
  <!-- 01 HERO -->
  <HeroSpaceV2 />

  <!-- KEY TAKEAWAYS -->
  <section class="v2-container v2-takeaways">
    <h2 class="v2-label">Key Takeaways</h2>
    <ul class="v2-takeaways__list">
      {homeTakeaways.map((item) => (
        <li class="v2-takeaways__item">
          <strong>{item.label}</strong> {item.link && <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="v2-link">{item.link.text}</a>}{item.text}
        </li>
      ))}
    </ul>
  </section>


  <!-- SERVICES: one orbital scene per service (canvas 2D) -->
  <ServicesV2 />

  <!-- STATEMENT: same place as on the live home, between services and why us -->
  <section class="v2-section v2-container">
    <V2ScrollFill
      as="p"
      class="v2-display-l v2-statement"
      text="Take your business to new heights quickly. Let us handle the technology."
    />
  </section>

  <!-- 03 WHY SPACEDEV -->
  <section class="v2-section v2-container" id="why">
    <div class="v2-head">
      <div>
        <h2 class="v2-display-l">Why Partner with a Blockchain Development Company Like SpaceDev</h2>
      </div>
      <p class="v2-lead">
        There are many development agencies. Fewer have deep blockchain engineering depth. Even fewer combine that with Web2 product experience, a security practice, and a track record across 200+ projects in DeFi, NFT infrastructure, fintech, and enterprise blockchain.
      </p>
    </div>
    <div class="v2-reasons">
      {homeReasons.map((reason) => (
        <div class="v2-reasons__item">
          <p class="v2-reasons__n">{reason.n}</p>
          <h3 class="v2-display-s">{reason.title}</h3>
          <p class="v2-body mt-3">{reason.desc}</p>
        </div>
      ))}
    </div>
    <div class="v2-actions"><V2Button href="/contact">Partner with us</V2Button></div>
  </section>

  <!-- 04 INDUSTRIES: an index, not a card wall -->
  <section class="v2-section v2-container" id="industries">
    <div class="v2-head">
      <h2 class="v2-display-l">Blockchain Development for Fintech, DeFi & Web3 Startups</h2>
    </div>
    <ul class="v2-index">
      {homeIndustries.map((industry) => {
        const summary = industry.desc.split("\n")[0];
        const inner = (
          <>
            <span class="v2-index__name">{industry.name}</span>
            <span class="v2-index__desc">{summary}</span>
            <span class="v2-index__arrow">{industry.linked !== false && <V2Arrow />}</span>
          </>
        );
        return (
          <li>
            {industry.linked === false ? (
              <div class="v2-index__row">{inner}</div>
            ) : (
              <a href={`/blockchain-development-services/industry/${industry.slug}`} class="v2-index__row v2-index__row--link">{inner}</a>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <!-- 05 WORK -->
  <section class="v2-section v2-container" id="work">
    <div class="v2-head">
      <div>
        <h2 class="v2-display-l">Web3 and Web2 Development Case Studies</h2>
      </div>
      <p class="v2-lead">
        Every product tells a story: one of collaboration, innovation, and measurable results. SpaceDev not only delivers projects; we support businesses' growth with the kind of technology that earns trust, scales with users, and stands the test of time.
      </p>
    </div>
    <!-- Same cards as the live site (dark veil, cursor spotlight on the
         project image), arranged in the v2 asymmetric grid. -->
    <div class="v2-work">
      {featured.map((study, index) => (
        <div class:list={["v2-work__cell", { "v2-work__cell--lead": index === 0 }]}>
          <CaseStudyCard caseStudy={study} />
        </div>
      ))}
    </div>
    <div class="v2-actions">
      <V2Button href="/our-work">See all work</V2Button>
      <p class="v2-body">
        Eager to create your own success story? <a href={MEETING_URL} target="_blank" rel="noopener noreferrer" class="v2-link">Book a call</a>.
      </p>
    </div>
  </section>

  <!-- 06 ENGAGEMENT MODELS: dark stage -->
  <section class="v2-engage" id="engagement" data-nav-theme="dark">
    <div class="v2-stage v2-stage--dark v2-on-dark">
      <div class="v2-container v2-section">
        <div class="v2-head">
          <h2 class="v2-display-l">There are two ways to work with us.<br />Pick what suits you!</h2>
        </div>
        <div class="v2-engage__models">
          {homeEngagementModels.map((model) => (
            <div class="v2-engage__model">
              <h3 class="v2-display-m">{model.title}</h3>
              <p class="v2-body mt-3 max-w-[40ch]">{model.subtitle}</p>
              <ol class="v2-engage__steps">
                {model.steps.map((step, index) => (
                  <li><span class="v2-engage__n">{pad(index + 1)}</span>{step}</li>
                ))}
              </ol>
              <p class="v2-body text-sm">{model.note}</p>
            </div>
          ))}
        </div>
        <div class="v2-engage__cta">
          <div>
            <p class="v2-display-s">Still not sure which option you need?</p>
            <p class="v2-body mt-2">No worries, we're here to help you find the best fit!</p>
          </div>
          <V2Button href="/contact" tone="light">Get in touch</V2Button>
        </div>
      </div>
      <img src="/images/brand/v2/luna_violeta.webp" alt="" loading="lazy" decoding="async" class="v2-engage__moon" />
    </div>
  </section>

  <!-- 07 TESTIMONIALS: hairline columns -->
  <section class="v2-section v2-container" id="clients">
    <div class="v2-head">
      <div>
        <h2 class="v2-display-l">Over <span class="v2-accent">50 perfect 5-star ratings</span> from happy customers</h2>
      </div>
      <p class="v2-lead">
        Clients choose SpaceDev for reliability, communication, and technical depth, and stay for the results. Every partnership reflects our belief that success is built on trust, collaboration, and a shared vision.
      </p>
    </div>
    <div class="v2-columns">
      {homeTestimonials.map((review) => (
        <a href={review.href} target="_blank" rel="noopener noreferrer" class="v2-columns__item v2-quote">
          <div class="v2-quote__head">
            <img src="/images/Clutch-sm.svg" alt="Clutch" width="71" height="80" class="h-6 w-auto" />
            <span class="v2-quote__rating">5.0 <span aria-hidden="true">★★★★★</span></span>
          </div>
          <blockquote class="v2-quote__text">{review.quote}</blockquote>
          <div class="v2-quote__meta">
            <p class="v2-quote__company">{review.company}</p>
            <p>{review.location}</p>
            <p>{review.period}</p>
          </div>
        </a>
      ))}
    </div>
    <div class="v2-actions"><a href="https://clutch.co/profile/spacedev" target="_blank" rel="noopener noreferrer" class="v2-link inline-flex items-center gap-2">See our Clutch profile <V2Arrow size={12} diagonal /></a></div>
  </section>

  <!-- 08 RECOGNITION -->
  <section class="v2-section--tight v2-container" id="recognition">
    <div class="v2-head">
      <div>
        <h2 class="v2-display-m">Highly reviewed by</h2>
      </div>
      <p class="v2-body">AWS lists us as a Partner and Marketplace seller, Forbes named us to its Technology Council, and Clutch, GoodFirms, and Upwork have each recognized us among the top blockchain development companies.</p>
    </div>
    <div class="v2-tiles v2-tiles--awards">
      {homeAwards.map((badge) => (
        <a href={badge.href} target="_blank" rel="noopener noreferrer" class="v2-tiles__tile">
          <img src={badge.src} alt={badge.alt} loading="lazy" width={badge.w} height={badge.h} class:list={["v2-tiles__img", { "v2-tiles__img--compact": badge.compact }]} />
        </a>
      ))}
    </div>
    <h2 class="v2-display-s v2-subhead">We support</h2>
    <div class="v2-tiles v2-tiles--community mt-6">
      {homeCommunities.map((community) => (
        <a href={community.href} target="_blank" rel="noopener noreferrer" class="v2-tiles__tile">
          <img src={community.src} alt={community.alt} loading="lazy" width={community.w} height={community.h} class="v2-tiles__img v2-tiles__img--compact" />
        </a>
      ))}
    </div>
  </section>

  <!-- 09 FAQ -->
  <section class="v2-section v2-container v2-faq" id="faq">
    <div class="v2-faq__head">
      <h2 class="v2-display-l">Frequently Asked Questions</h2>
    </div>
    <div class="v2-faq__list">
      {homeFaqs.map((faq) => (
        <details class="v2-faq__item">
          <summary class="v2-faq__q">
            <span>{faq.question}</span>
            <span class="v2-faq__icon" aria-hidden="true"></span>
          </summary>
          <p class="v2-body v2-faq__a">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 10 BLOG: hairline columns, date first (Joby news) -->
  <section class="v2-section v2-container" id="blog">
    <div class="v2-head">
      <h2 class="v2-display-m">Check out some related articles from our blog!</h2>
    </div>
    <div class="v2-columns v2-columns--3">
      {recentPosts.map((post) => {
        const author = getAuthor(post.data.author);
        return (
          <article class="v2-columns__item v2-post">
            <p class="v2-label">
              <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
              <span aria-hidden="true">/</span>
              <span>{post.data.readTime} min read</span>
            </p>
            <a href={`/blog/${post.id}`} class="v2-post__link">
              <h3 class="v2-display-s mt-4">{post.data.title}</h3>
              <div class="v2-post__media">
                {post.data.cover && <img src={post.data.cover} alt={post.data.title} loading="lazy" decoding="async" width="1280" height="800" class="v2-post__img" />}
              </div>
            </a>
            {author && (
              <a href={`/author/${author.slug}`} class="inline-flex mt-5">
                <AuthorAvatar author={author} size="sm" showRole tone="light" />
              </a>
            )}
          </article>
        );
      })}
    </div>
    <div class="v2-actions"><V2Button href="/blog">View all posts</V2Button></div>
  </section>

  <!-- 11 FINAL CTA: apertura stage -->
  <section class="v2-final" id="next-step" data-nav-theme="dark">
    <div class="v2-stage v2-stage--apertura v2-on-dark v2-final__stage">
      <div class="v2-container v2-final__content">
        <h2 class="v2-display-xl">Ready to build the future with SpaceDev?</h2>
        <div class="v2-final__copy">
          <p class="v2-lead">Your next big idea deserves a partner who understands both innovation and execution.</p>
          <p class="v2-lead">SpaceDev combines web3 development services, blockchain expertise, and global engineering talent to help you move from vision to reality with speed and precision.</p>
          <p class="v2-lead">Let's turn your concept into a product that scales, engages, and endures.</p>
        </div>
        <div class="mt-10"><V2Button href={MEETING_URL} tone="light" external>Schedule a call</V2Button></div>
      </div>
      <img src="/images/brand/v2/apreton_violeta.webp" alt="" loading="lazy" decoding="async" class="v2-final__art" />
    </div>
  </section>
</div>


<style>
  /* ── Takeaways ───────────────────────────────────── */
  .v2-takeaways { padding-block: 56px 24px; }
  .v2-takeaways__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--v2-line);
  }
  .v2-takeaways__item {
    padding: 22px 24px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--v2-ink-2);
  }
  .v2-takeaways__item + .v2-takeaways__item { padding-left: 24px; border-left: 1px solid var(--v2-line); }
  .v2-takeaways__item strong { color: var(--v2-ink); font-weight: 700; }

  .v2-statement { max-width: 20ch; margin-inline: auto; text-align: center; }
  .v2-accent { color: var(--v2-violet-mid); }

  /* ── Section heads: centred, generous measure ─── */
  .v2-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 920px;
    margin: 0 auto clamp(40px, 5vw, 64px);
    text-align: center;
  }
  .v2-head h2 { max-width: 24ch; }
  .v2-head p { max-width: 62ch; }
  .v2-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 32px;
    margin-top: clamp(40px, 4vw, 56px);
  }

  /* ── Reasons ─────────────────────────────────────── */
  .v2-reasons {
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 32px;
  }
  .v2-reasons__item {
    padding: 28px 0 40px;
    border-top: 1px solid var(--v2-line);
  }
  .v2-reasons__n {
    font-family: "Open Sans", Arial, sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--v2-accent);
    margin-bottom: 28px;
  }

  /* ── Industries index ───────────────────────────── */
  .v2-index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--v2-ink); }
  .v2-index__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) 40px;
    gap: 24px;
    align-items: center;
    padding: 24px 12px;
    border-bottom: 1px solid var(--v2-line);
    background: linear-gradient(var(--v2-lilac-light), var(--v2-lilac-light)) no-repeat 0 100% / 100% 0;
    transition: background-size 0.5s var(--v2-ease);
  }
  .v2-index__row--link:hover { background-size: 100% 100%; }
  .v2-index__n { font-family: "Open Sans", Arial, sans-serif; font-weight: 600; font-size: 12px; letter-spacing: 0.1em; color: var(--v2-ink-2); }
  .v2-index__name { font-family: "Open Sans", Arial, sans-serif; font-weight: 600; font-size: clamp(19px, 1.7vw, 26px); letter-spacing: -0.02em; color: var(--v2-ink); }
  .v2-index__desc { font-size: 15px; line-height: 1.5; color: var(--v2-ink-2); }
  .v2-index__arrow { justify-self: end; color: var(--v2-violet-mid); transition: transform 0.45s var(--v2-ease); }
  .v2-index__row--link:hover .v2-index__arrow { transform: translateX(6px); }

  /* ── Work ───────────────────────────────────────── */
  .v2-work {
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: 330px;
    gap: 18px;
  }
  .v2-work__cell { grid-column: span 5; }
  .v2-work__cell--lead { grid-column: span 7; grid-row: span 2; }
  /* The live card fixes its height inline and rounds its corners; in the v2
     grid it fills its cell and stays square like the rest of v2. */
  .v2-work__cell :global(.spotlight-card) { height: 100% !important; border-radius: 0; }
  .v2-work__cell--lead :global(.card-title) { font-size: clamp(34px, 3.4vw, 52px) !important; }

  /* ── Engagement ─────────────────────────────────── */
  .v2-engage__models {
    margin-top: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .v2-engage__model { padding-right: 48px; }
  .v2-engage__model + .v2-engage__model { padding: 0 0 0 48px; border-left: 1px solid rgba(255, 255, 255, 0.16); }
  .v2-engage__steps {
    list-style: none;
    margin: 32px 0 24px;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .v2-engage__steps li {
    display: flex;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    font-family: "Open Sans", Arial, sans-serif;
    font-weight: 600;
    font-size: 17px;
  }
  .v2-engage__n { color: var(--v2-lilac); font-size: 12px; letter-spacing: 0.1em; padding-top: 4px; }
  .v2-engage__cta {
    position: relative;
    z-index: 1;
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .v2-engage__moon {
    position: absolute;
    right: -6%;
    bottom: -32%;
    width: min(46vw, 640px);
    height: auto;
    opacity: 0.55;
    z-index: -1;
    pointer-events: none;
  }

  /* ── Hairline columns (testimonials, blog) ─────── */
  .v2-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--v2-line);
  }
  .v2-columns--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .v2-columns__item { padding: 28px 28px 8px 0; }
  .v2-columns__item + .v2-columns__item { padding-left: 28px; border-left: 1px solid var(--v2-line); }

  .v2-quote { display: flex; flex-direction: column; }
  .v2-quote__head { display: flex; align-items: center; justify-content: space-between; }
  .v2-quote__rating { font-family: "Open Sans", Arial, sans-serif; font-weight: 600; font-size: 13px; color: var(--v2-ink); }
  .v2-quote__rating span { color: var(--v2-violet-mid); letter-spacing: 0.08em; }
  .v2-quote__text {
    flex: 1;
    margin: 36px 0 40px;
    font-family: "Open Sans", Arial, sans-serif;
    font-weight: 400;
    font-size: clamp(19px, 1.5vw, 23px);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--v2-ink);
    transition: color 0.35s var(--v2-ease);
  }
  .v2-quote:hover .v2-quote__text { color: var(--v2-violet-mid); }
  .v2-quote__meta { font-size: 13px; line-height: 1.5; color: var(--v2-ink-2); }
  .v2-quote__company { color: var(--v2-ink); font-weight: 700; }

  .v2-post__link { display: block; }
  .v2-post__link:hover h3 { color: var(--v2-violet-mid); }
  .v2-post__media {
    margin-top: 24px;
    aspect-ratio: 4 / 3;
    border-radius: 0;
    overflow: hidden;
    background: var(--v2-lilac-light);
  }
  .v2-post__img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--v2-ease); }
  .v2-post__link:hover .v2-post__img { transform: scale(1.035); }
  .v2-post .v2-label { gap: 8px; }

  /* ── Logo tiles ─────────────────────────────────── */
  .v2-subhead { margin: clamp(56px, 6vw, 88px) 0 24px; text-align: center; }
  .v2-tiles {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--v2-line);
    border-left: 1px solid var(--v2-line);
  }
  .v2-tiles--community { grid-template-columns: repeat(9, minmax(0, 1fr)); }
  .v2-tiles__tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 152px;
    padding: 20px;
    border-right: 1px solid var(--v2-line);
    border-bottom: 1px solid var(--v2-line);
    transition: background-color 0.35s var(--v2-ease);
  }
  .v2-tiles--community .v2-tiles__tile { height: 104px; }
  .v2-tiles__tile:hover { background: #ffffff; }
  .v2-tiles__img {
    max-height: 92px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter 0.4s var(--v2-ease), opacity 0.4s var(--v2-ease);
  }
  .v2-tiles__img--compact { max-height: 40px; }
  .v2-tiles__tile:hover .v2-tiles__img { filter: none; opacity: 1; }

  /* ── FAQ ─────────────────────────────────────────── */
  .v2-faq {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 32px;
    align-items: start;
  }
  .v2-faq__head { grid-column: 1 / span 5; position: sticky; top: 112px; }
  .v2-faq__list { grid-column: 7 / span 6; border-top: 1px solid var(--v2-ink); }
  .v2-faq__item { border-bottom: 1px solid var(--v2-line); }
  .v2-faq__item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.45s var(--v2-ease), content-visibility 0.45s allow-discrete;
  }
  .v2-faq__item[open]::details-content { block-size: auto; }
  .v2-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    list-style: none;
    cursor: pointer;
    font-family: "Open Sans", Arial, sans-serif;
    font-weight: 600;
    font-size: clamp(17px, 1.4vw, 20px);
    letter-spacing: -0.012em;
  }
  .v2-faq__q::-webkit-details-marker { display: none; }
  .v2-faq__icon {
    position: relative;
