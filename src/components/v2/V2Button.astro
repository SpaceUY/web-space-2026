---
import V2Arrow from "./V2Arrow.astro";

interface Props {
  href: string;
  tone?: "dark" | "light";
  size?: "md" | "sm";
  external?: boolean;
  class?: string;
}

const { href, tone = "dark", size = "md", external = false, class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={["v2-btn", { "v2-btn--light": tone === "light", "v2-btn--sm": size === "sm" }, className]}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span class="v2-btn__label"><slot /></span>
  <span class="v2-btn__chip"><V2Arrow diagonal={external} /></span>
</a>
