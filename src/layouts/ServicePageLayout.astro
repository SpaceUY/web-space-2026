---
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import FAQ from "../components/ui/FAQ.astro";
import CTA from "../components/ui/CTA.astro";
import CaseStudyCard from "../components/ui/CaseStudyCard.astro";
import { type ServicePageData, getCaseStudies } from "../data/services";
import QuoteReveal from "../components/ui/QuoteReveal.astro";
import FeatureCard from "../components/ui/FeatureCard.astro";

const techIconMap: Record<string, { label: string; img: string }> = {
  // Web3
  ethereum:     { label: "Ethereum / EVM", img: "/images/icons/icon-ethEVM.svg" },
  solana:       { label: "Solana",         img: "/images/icons/icon-solana.svg" },
  solidity:     { label: "Solidity",       img: "/images/icons/icon-solidity.svg" },
  rust:         { label: "Rust",           img: "/images/icons/icon-rust.svg" },
  wagmi:        { label: "Wagmi",          img: "/images/icons/icon-wagmi.svg" },
  hardhat:      { label: "Hardhat",        img: "/images/icons/icon-hardhat.svg" },
  ethers:       { label: "Ethers.js",      img: "/images/icons/icon-ethersjs.svg" },
  openzeppelin: { label: "OpenZeppelin",   img: "/images/icons/icon-openzeppelin.svg" },
  // Web2
  react:        { label: "React",          img: "/images/icons/icon-react.svg" },
  nodejs:       { label: "Node.js",        img: "/images/icons/icon-nodejs.svg" },
  reactnative:  { label: "React Native",   img: "/images/icons/icon-reactnative.svg" },
  aws:          { label: "AWS",            img: "/images/icons/icon-aws.svg" },
  python:       { label: "Python",         img: "/images/icons/icon-python.svg" },
  typescript:   { label: "TypeScript",     img: "/images/icons/icon-typescript.svg" },
  nestjs:       { label: "NestJS",         img: "/images/icons/icon-nestjs.svg" },
  golang:       { label: "Go",             img: "/images/icons/icon-golang.svg" },
  nextjs:       { label: "Next.js",        img: "/images/icons/icon-nextjs.svg" },
};
import { SITE } from "../lib/seo";

interface Props {
  data: ServicePageData;
}

const { data } = Astro.props;
const featured = data.caseStudySlugs ? getCaseStudies(data.caseStudySlugs) : [];

const relatedPosts = data.relatedTags && data.relatedTags.length > 0
  ? (await getCollection("blog", ({ data: p }) => !p.draft))
      .filter((p) => p.data.tags.some((t: string) => data.relatedTags!.includes(t)))
      .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
      .slice(0, 3)
  : [];

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: data.title,
  description: data.description,
  provider: { "@type": "Organization", name: SITE.name, url: SITE.url },
  areaServed: "Worldwide",
};
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  jsonLd={serviceJsonLd}
  footerMarquee={data.footerMarquee}
  footerMarqueeTheme={data.footerMarqueeTheme}
  breadcrumbTone={data.heroVariant === "light" ? "light" : "dark"}
>
  <!-- HERO -->
  {data.heroVariant === "light" ? (
    <section class="relative overflow-hidden min-h-[80vh]" style="background: var(--sd-light); background-image: radial-gradient(ellipse at 80% 50%, rgba(103,58,228,0.08) 0%, transparent 60%);">
      <div class="relative sd-container pt-36 pb-16 md:pt-40 md:pb-20">
        <div class={data.heroImage ? "grid lg:grid-cols-[1.2fr_1fr] gap-12 items-center" : ""}>
          <div class="max-w-4xl" data-animate>
            {data.titleHtml ? (
              <h1 class={data.compactHeroTitle ? "text-3xl md:text-4xl lg:text-5xl text-sd-text-dark" : "text-4xl md:text-6xl lg:text-7xl text-sd-text-dark"} set:html={data.titleHtml} />
            ) : (
              <h1 class={data.compactHeroTitle ? "text-3xl md:text-4xl lg:text-5xl text-sd-text-dark" : "text-4xl md:text-6xl lg:text-7xl text-sd-text-dark"}>{data.title}</h1>
            )}
            <p class="mt-8 text-lg md:text-xl text-sd-text-gray max-w-3xl leading-relaxed">{data.description}</p>
            {(data.primaryCta || data.secondaryCta) && (
              <div class="mt-10 space-y-4">
                <div class="flex flex-wrap gap-4 items-center">
                  {data.primaryCta && (
                    <Button href={data.primaryCta.href} variant="primary" size="lg" external={data.primaryCta.external}>
                      {data.primaryCta.label}
                    </Button>
                  )}
                  {data.secondaryCta && (
                    <Button href={data.secondaryCta.href} variant="outline-dark" size="lg" external={data.secondaryCta.external}>
                      {data.secondaryCta.label}
                    </Button>
                  )}
                </div>
                <p class="text-sm text-sd-text-gray">Or subscribe to our newsletter</p>
                <form class="flex gap-3 max-w-md" onsubmit="return false;">
                  <input
                    type="email"
                    placeholder="Your email"
                    class="flex-1 rounded-full px-5 py-3 text-sm bg-white border border-sd-gray-border text-sd-text-dark placeholder:text-sd-text-gray focus:outline-none focus:border-sd-text-dark"
                  />
                  <button
                    type="submit"
                    class="rounded-full px-6 py-3 text-sm font-medium bg-sd-text-dark text-white hover:bg-sd-dark-2 transition-colors shrink-0"
                  >
                    Sign up!
                  </button>
                </form>
              </div>
            )}
          </div>
          {data.heroImage && (
            <div class="relative" data-animate>
              <div class="rounded-3xl overflow-hidden border border-sd-gray-border aspect-square flex items-center justify-center p-6">
                <img
                  src={data.heroImage.src}
                  alt={data.heroImage.alt}
                  width={data.heroImage.width ?? 800}
                  height={data.heroImage.height ?? 800}
                  loading="eager"
                  class="w-full h-full object-contain"
                />
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  ) : (
  <section class="relative overflow-hidden min-h-[80vh]" style="background: var(--sd-gradient-hero);">
    <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 20% 30%, var(--sd-purple), transparent 50%), radial-gradient(circle at 80% 70%, var(--sd-purple-300), transparent 40%);"></div>
    <div class="relative sd-container pt-36 pb-16 md:pt-40 md:pb-20">
      <div class={data.heroImage ? "grid lg:grid-cols-[1.2fr_1fr] gap-12 items-center" : ""}>
        <div class="max-w-4xl" data-animate>
          {data.titleHtml ? (
            <h1 class={data.compactHeroTitle ? "text-3xl md:text-4xl lg:text-5xl text-white" : "text-4xl md:text-6xl lg:text-7xl text-white"} set:html={data.titleHtml} />
          ) : (
            <h1 class={data.compactHeroTitle ? "text-3xl md:text-4xl lg:text-5xl text-white" : "text-4xl md:text-6xl lg:text-7xl text-white"}>{data.title}</h1>
          )}
          <p class="mt-8 text-lg md:text-xl text-sd-text-muted max-w-3xl leading-relaxed">{data.description}</p>
          {(data.primaryCta || data.secondaryCta) && (
            <div class="mt-10 space-y-4">
              <div class="flex flex-wrap gap-4 items-center">
                {data.primaryCta && (
                  <Button href={data.primaryCta.href} variant="primary" size="lg" external={data.primaryCta.external}>
                    {data.primaryCta.label}
                  </Button>
                )}
                {data.secondaryCta && (
                  <Button href={data.secondaryCta.href} variant="outline-light" size="lg" external={data.secondaryCta.external}>
                    {data.secondaryCta.label}
                  </Button>
                )}
              </div>
              <!-- Newsletter subscribe -->
              <p class="text-sm text-sd-text-muted">Or subscribe to our newsletter</p>
              <form
                action="https://api.hsforms.com/submissions/v3/integration/submit/22632737/acdc5149-7c32-48f4-9137-ab4212538377"
                method="POST"
                class="flex gap-3 max-w-md"
                onsubmit="return false;"
              >
                <input
                  type="email"
                  name="email"
                  placeholder="Your email"
                  required
                  class="flex-1 rounded-full px-5 py-3 text-sm bg-white/10 border border-white/20 text-white placeholder:text-sd-text-muted focus:outline-none focus:border-white/40 backdrop-blur-sm"
                />
                <button
                  type="submit"
                  class="rounded-full px-6 py-3 text-sm font-medium bg-white text-sd-text-dark hover:bg-white/90 transition-colors shrink-0"
                >
                  Sign up!
                </button>
              </form>
            </div>
          )}
        </div>
        {data.heroImage && (
          <div class="relative" data-animate>
            <div class="rounded-3xl overflow-hidden border border-white/10 bg-white/5 aspect-square flex items-center justify-center p-6">
              <img
                src={data.heroImage.src}
                alt={data.heroImage.alt}
                width={data.heroImage.width ?? 800}
                height={data.heroImage.height ?? 800}
                loading="eager"
                class="w-full h-full object-contain"
              />
            </div>
          </div>
        )}
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 pointer-events-none" aria-hidden="true">
      <span class="text-xs font-ui uppercase tracking-widest text-white/40">Scroll</span>
      <svg class="sd-scroll-bounce" width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M5 7.5l5 5 5-5" stroke="white" stroke-opacity="0.4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </section>
  )}

  <!-- Named slot: inject content between hero and process -->
  <slot name="pre-process" />

  <!-- PROCESS (numbered steps) -->

  {data.process && (
    data.process.variant === "sticky-light" ? (
      <section class="bg-white py-20 md:py-32 border-b border-sd-gray-border">
        <div class="sd-container">
          <div class="grid md:grid-cols-[2fr_3fr] gap-12 md:gap-20 items-start">
            <div class="md:sticky md:top-32" data-animate>
              <h2 class="section-title text-sd-text-dark mb-6">
                {data.process.title}
              </h2>
              {data.process.description && (
                <p class="text-sd-text-gray leading-relaxed">{data.process.description}</p>
              )}
            </div>
            <ol class="flex flex-col gap-6">
              {data.process.items.map((step) => (
                <li>
                  <FeatureCard
                    number={step.number}
                    title={step.title}
                    description={step.description}
                    tone="light"
                  />
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    ) : data.process.variant === "sticky-dark" ? (
      <section class="py-20 md:py-32 border-b border-white/5" style="background: var(--sd-purple-deep);">
        <div class="sd-container">
          <div class="grid md:grid-cols-[2fr_3fr] gap-12 md:gap-20 items-start">
            <div class="md:sticky md:top-32" data-animate>
              <h2 class="section-title text-white mb-6">
                {data.process.title}
              </h2>
              {data.process.description && (
                <p class="text-sd-text-muted leading-relaxed">{data.process.description}</p>
              )}
            </div>
            <ol class="flex flex-col gap-6">
              {data.process.items.map((step) => (
                <li>
                  <FeatureCard
                    number={step.number}
                    title={step.title}
                    description={step.description}
                    tone="dark"
                  />
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    ) : (
      <section class="bg-sd-dark py-20 md:py-28 border-b border-white/5">
        <div class="sd-container">
          <SectionHeading
            title={data.process.title}
            description={data.process.description}
            align="center"
            class="mb-14"
          />
          <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {data.process.items.map((step) => (
              <li class="relative rounded-2xl border border-white/10 bg-sd-dark-2 p-6" data-animate>
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-sd-purple/15 text-sd-purple-300 font-display text-lg mb-5">
                  {step.number}
                </span>
                <h3 class="text-lg text-white mb-2">{step.title}</h3>
                <p class="text-sm text-sd-text-muted leading-relaxed">{step.description}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  )}

  <!-- Named slot: inject content between process and offers -->
  <slot name="post-process" />

  <!-- OFFERS (what we build) -->
  {data.offers && (
    <section class={`py-20 md:py-28 ${data.offers.style === "light-cards" ? "bg-sd-light border-b border-sd-gray-border" : data.offers.style === "dark-cards" ? "bg-sd-dark border-t border-white/10" : "bg-sd-dark"}`}>
      <div class="sd-container">
        <SectionHeading
          title={data.offers.title}
          description={data.offers.description}
          tone={data.offers.style === "light-cards" ? "dark" : "light"}
          class="mb-14"
        />
        {data.offersIllustration && (
          <div class="mb-14 flex justify-center" data-animate>
            <img
              src={data.offersIllustration.src}
              alt={data.offersIllustration.alt}
              loading="lazy"
              class="max-w-full h-auto max-h-64 object-contain opacity-90"
            />
          </div>
        )}
        {data.offers.style === "cards" ? (
          <div id="cards-cursor-zone" class="relative grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <!-- Custom cursor -->
            <div id="cards-cursor" class="pointer-events-none fixed z-50 w-16 h-16 rounded-full opacity-0 transition-opacity duration-200" style="background: var(--sd-purple); transform: translate(-50%, -50%); will-change: transform;" />
            {data.offers.items.map((o) => (
              <a
                href={o.href ?? "#"}
                class="service-card group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-sd-dark-2 p-6 min-h-[160px] transition-all duration-300"
                data-animate
              >
                {/* Purple gradient bg — visible on hover */}
                <div class="service-card-bg absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%);" />

                {/* Arrow icon in bordered box */}
                <div class="relative z-10 inline-flex items-center justify-center w-9 h-9 rounded-md border border-white/20 group-hover:border-white/40 transition-colors shrink-0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-white">
                    <path d="M7 17L17 7M17 7H7M17 7v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>

                {/* Title — bottom */}
                <h3 class="relative z-10 text-xl md:text-2xl text-white font-display leading-snug mt-auto group-hover:underline underline-offset-4">{o.title}</h3>
              </a>
            ))}
          </div>
        ) : data.offers.style === "light-cards" ? (
          <div id="cards-cursor-zone" class="relative grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <!-- Custom cursor (same violet circle as blockchain What We Build) -->
            <div id="cards-cursor" class="pointer-events-none fixed z-50 w-16 h-16 rounded-full opacity-0 transition-opacity duration-200" style="background: var(--sd-purple); transform: translate(-50%, -50%); will-change: transform;" />
            {data.offers.items.map((o) => (
              <div class="group rounded-2xl p-7 bg-sd-light-2 transition-colors duration-300 hover:bg-sd-purple/15" data-animate>
                <p class="text-2xl font-display text-sd-text-dark mb-4 group-hover:text-sd-purple transition-colors duration-300">{o.number}</p>
                <h3 class="text-base font-display font-semibold text-sd-text-dark mb-3">{o.title}</h3>
                <p class="text-sm text-sd-text-gray leading-relaxed">{o.description}</p>
              </div>
            ))}
          </div>
        ) : data.offers.style === "dark-cards" ? (
          <div id="cards-cursor-zone" class="relative grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            <div id="cards-cursor" class="pointer-events-none fixed z-50 w-16 h-16 rounded-full opacity-0 transition-opacity duration-200" style="background: var(--sd-purple); transform: translate(-50%, -50%); will-change: transform;" />
            {data.offers.items.map((o) => (
              <div class="group rounded-2xl p-7 bg-white/5 transition-colors duration-300 hover:bg-sd-purple/25" data-animate>
                <p class="text-2xl font-display text-sd-purple-300 mb-4 group-hover:text-sd-purple-200 transition-colors duration-300">{o.number}</p>
                <h3 class="text-base font-display font-semibold text-white mb-3">{o.title}</h3>
                <p class="text-sm text-sd-text-muted leading-relaxed">{o.description}</p>
              </div>
            ))}
          </div>
        ) : (
          <div class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
            {data.offers.items.map((o) => (
              <div class="group" data-animate>
                <p class="text-xs font-medium text-sd-purple-300 mb-3 tracking-widest">{o.number}</p>
                <h3 class="text-lg text-white mb-3 group-hover:text-sd-purple-300 transition-colors">{o.title}</h3>
                <p class="text-sm text-sd-text-muted leading-relaxed">{o.description}</p>
              </div>
            ))}
          </div>
        )}
        {data.offers.ctaButton && (
          <div class="flex justify-start mt-10" data-animate>
            <Button href={data.offers.ctaButton.href} variant="primary" external={data.offers.ctaButton.external}>
              {data.offers.ctaButton.label}
            </Button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Named slot: inject content after offers section -->
  <slot name="post-offers" />

  <!-- TECH STACK -->
  {data.techStack && (
    <section class={`relative py-20 md:py-28 overflow-hidden ${data.techStack.tone === "light" ? "bg-sd-light border-t border-b border-sd-gray-border" : "bg-sd-dark border-t border-b border-white/5"}`}>
      <div class={`absolute inset-0 ${data.techStack.tone === "light" ? "sd-dot-grid-light" : "sd-dot-grid"}`}></div>
      <div class="relative sd-container">
        <div class="text-center max-w-2xl mx-auto mb-16" data-animate>
          <h2 class={`section-title mb-5 ${data.techStack.tone === "light" ? "text-sd-text-dark" : "text-white"}`}>{data.techStack.title}</h2>
          <p class={`text-base md:text-lg leading-relaxed ${data.techStack.tone === "light" ? "text-sd-text-gray" : "text-sd-text-muted"}`}>{data.techStack.subtitle}</p>
        </div>
        <div class="flex flex-col items-center gap-8 md:gap-10 mb-14">
          {[data.techStack.tools.slice(0, 5), data.techStack.tools.slice(5)].map((row) => (
            <div class="flex flex-wrap justify-center gap-6 md:gap-10">
              {row.map((tool, i) => {
                const item = techIconMap[tool];
                if (!item) return null;
                const floatClass = ["sd-float-1","sd-float-2","sd-float-3","sd-float-4","sd-float-2","sd-float-3","sd-float-1","sd-float-4"][i % 8];
                return (
                  <div class={`flex flex-col items-center gap-3 ${floatClass}`}>
                    <img
                      src={item.img}
                      alt={item.label}
                      width={80}
                      height={80}
                      class="w-16 h-16 md:w-20 md:h-20"
                    />
                    <span class={`text-xs font-ui uppercase tracking-widest text-center leading-tight ${data.techStack!.tone === "light" ? "text-sd-text-gray" : "text-sd-text-muted"}`}>{item.label}</span>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
        {data.techStack.ctaButton && (
          <div class="flex justify-center mt-4" data-animate>
            <Button
              href={data.techStack.ctaButton.href}
              variant="primary"
              external={data.techStack.ctaButton.external}
            >
              {data.techStack.ctaButton.label}
            </Button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Named slot: inject content after tech stack, before case studies -->
  <slot name="post-techstack" />

  <!-- CASE STUDIES -->
  {featured.length > 0 && (
    <section class={`py-20 md:py-28 ${data.caseStudiesTone === "light" ? "border-t border-sd-gray-border" : ""}`} style={data.caseStudiesTone === "light" ? "background: #EDEDED;" : "background: var(--sd-purple-deep);"}>
      <div class="sd-container">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
          <div>
            <SectionHeading
              title={data.caseStudiesTitle ?? "Our Work in Action"}
              description={data.caseStudiesLink ? undefined : (data.caseStudiesDescription ?? "Take a closer look at how our services have helped teams ship at scale.")}
              tone={data.caseStudiesTone === "light" ? "dark" : "light"}
            />
            {data.caseStudiesLink && (
              <p class={`mt-5 text-base md:text-lg leading-relaxed max-w-3xl ${data.caseStudiesTone === "light" ? "text-sd-text-gray" : "text-sd-text-muted"}`}>
                {data.caseStudiesDescription}{" "}
                <a
                  href={data.caseStudiesLink.href}
                  class={`font-medium hover:underline hover:underline-offset-4 transition-colors ${data.caseStudiesTone === "light" ? "text-sd-text-dark hover:text-sd-purple" : "text-white/70 hover:text-white"}`}
                >
                  {data.caseStudiesLink.text}
                </a>
              </p>
            )}
          </div>
          {!data.caseStudiesLink && (
            <Button href="/our-work" variant={data.caseStudiesTone === "light" ? "outline-dark" : "outline-light"}>See all work</Button>
          )}
        </div>
        <div id="case-studies-zone" class="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <!-- Custom cursor: rotating text ring -->
          <div id="case-studies-cursor" class="pointer-events-none fixed z-50 opacity-0 transition-opacity duration-200" style="transform: translate(-50%, -50%); will-change: transform; width: 120px; height: 120px;">
            <svg viewBox="0 0 120 120" width="120" height="120" aria-hidden="true">
              <circle cx="60" cy="60" r="58" fill="white"/>
              <defs>
                <path id="cs-text-path" d="M60,60 m-42,0 a42,42 0 1,1 84,0 a42,42 0 1,1-84,0"/>
              </defs>
              <text class="cs-spin-text" font-size="14" letter-spacing="0.8" fill="black" font-family="Saira, sans-serif">
                <textPath href="#cs-text-path" textLength="264" lengthAdjust="spacing">VIEW PROJECT &#x2009;&#x2009;•&#x2009;&#x2009; VIEW PROJECT &#x2009;&#x2009;•&#x2009;&#x2009;</textPath>
              </text>
            </svg>
          </div>
          {featured.map((c) => (
            <CaseStudyCard caseStudy={c} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- MID CTA (between case studies and benefits) -->
  {data.midCta && (
    <section class={`pb-14 md:pb-20 ${data.caseStudiesTone === "light" ? "" : "bg-sd-dark"}`} style={data.caseStudiesTone === "light" ? "background: #EDEDED;" : ""}>
      <div class="sd-container">
        <div class="relative overflow-hidden rounded-3xl px-10 py-12 md:px-16 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-8"
             style="background: var(--sd-gradient-purple-dark);">
          <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 70% 50%, #7c3aed, transparent 60%);"></div>
          <p class="relative text-2xl md:text-3xl lg:text-4xl text-white font-display leading-snug max-w-xl">{data.midCta.title}</p>
          <a
            href={data.midCta.buttonHref}
            target={data.midCta.external ? "_blank" : undefined}
            rel={data.midCta.external ? "noopener noreferrer" : undefined}
            class="relative shrink-0 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 text-sm text-white font-medium hover:bg-white/20 transition-colors backdrop-blur-sm"
          >
            {data.midCta.buttonLabel}
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Named slot: inject content between case studies/midCTA and benefits -->
  <slot name="pre-benefits" />

  <!-- BENEFITS -->
  {data.benefits && (
    <section class={`py-20 md:py-28 ${data.caseStudiesTone === "light" ? "bg-sd-light border-t border-sd-gray-border" : "bg-sd-dark"}`}>
      <div class="sd-container">
        <SectionHeading
          title={data.benefits.title}
          description={data.benefits.description}
          tone={data.caseStudiesTone === "light" ? "dark" : "light"}
          align={data.benefits.titleAlign ?? "left"}
          class="mb-14"
        />
        {data.benefits.layout === "4col" ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {data.benefits.items.map((b) => (
              <FeatureCard title={b.title} description={b.description} icon={b.icon} tone={data.caseStudiesTone === "light" ? "light" : "dark"} />
            ))}
          </div>
        ) : data.benefits.layout === "4-3" ? (
          <>
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mb-6">
              {data.benefits.items.slice(0, 4).map((b) => (
                <FeatureCard title={b.title} description={b.description} icon={b.icon} tone={data.caseStudiesTone === "light" ? "light" : "dark"} />
              ))}
            </div>
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {data.benefits.items.slice(4).map((b) => (
                <FeatureCard title={b.title} description={b.description} icon={b.icon} tone={data.caseStudiesTone === "light" ? "light" : "dark"} />
              ))}
            </div>
          </>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {data.benefits.items.map((b) => (
              <FeatureCard title={b.title} description={b.description} icon={b.icon} tone={data.caseStudiesTone === "light" ? "light" : "dark"} />
            ))}
          </div>
        )}
      </div>
    </section>
  )}


  <!-- QUOTE -->
  {data.quote && (
    <QuoteReveal
      text={data.quote.text}
      authors={{ name: data.quote.author, role: data.quote.role, photo: data.quote.photo, linkedin: data.quote.linkedin }}
      tone="dark"
    />
  )}

  <!-- WHY US -->
  {data.whyUs && (
    <section
      class={`py-20 md:py-28 ${data.caseStudiesTone === "light" ? "border-t border-sd-gray-border" : "border-t border-white/5"}`}
      style={data.whyUs?.tone === "dark" ? "background: var(--sd-dark);" : data.caseStudiesTone === "light" ? "background: #EDEDED;" : "background: var(--sd-purple-deep);"}
    >
      <div class="sd-container">
        {data.whyUs.style === "4col" ? (
          <>
            <SectionHeading
              title={data.whyUs.title}
              description={data.whyUs.description}
              tone={data.caseStudiesTone === "light" ? "dark" : "light"}
              class="mb-14"
            />
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
              {data.whyUs.items.map((w) => (
                <FeatureCard
                  title={w.title}
                  description={w.description}
                  icon={w.icon}
                  tone={data.caseStudiesTone === "light" ? "light" : "dark"}
                />
              ))}
            </div>
          </>
        ) : (
          <>
            <SectionHeading
              title={data.whyUs.title}
              description={data.whyUs.description}
              tone={data.caseStudiesTone === "light" ? "dark" : "light"}
              class="mb-14"
            />
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {data.whyUs.items.map((w) => (
                <FeatureCard
                  title={w.title}
                  description={w.description}
                  icon={w.icon}
                  tone={data.caseStudiesTone === "light" ? "light" : "dark"}
                />
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )}

  <!-- Named slot: inject content after Why Us and before FAQ / Final CTA -->
  <slot name="post-whyus" />

  <!-- RELATED ARTICLES FROM BLOG -->
  <!-- FAQ -->
  {data.faqs && data.faqs.length > 0 && (
    <section class={`py-20 md:py-32 ${data.caseStudiesTone === "light" ? "bg-sd-light border-t border-sd-gray-border" : "bg-sd-dark border-t border-white/5"}`}>
      <div class="sd-container">
        <div class="grid md:grid-cols-[2fr_3fr] gap-12 md:gap-20 items-start">
          <h2 class={`section-title md:sticky md:top-32 ${data.caseStudiesTone === "light" ? "text-sd-text-dark" : "text-white"}`}>
            Frequently Asked Questions
          </h2>
          <div class={`rounded-2xl overflow-hidden px-6 md:px-8 ${data.caseStudiesTone === "light" ? "bg-[#f2f2f2]" : "bg-white/5"}`}>
            <FAQ items={data.faqs} tone={data.caseStudiesTone === "light" ? "light" : "dark"} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- RELATED ARTICLES FROM BLOG -->
  {relatedPosts.length > 0 && (
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
          <SectionHeading
            eyebrow="From Our Blog"
            title="Related Reading"
            tone="light"
          />
          <Button href="/blog" variant="outline-light">See all articles</Button>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {relatedPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col rounded-2xl overflow-hidden bg-sd-dark-2 border border-white/10 hover:border-sd-purple/40 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(103,58,228,0.15)] transition-all duration-300"
              data-animate
            >
              {post.data.cover && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={post.data.cover}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                </div>
              )}
              {!post.data.cover && (
                <div class="aspect-[16/9] bg-gradient-to-br from-sd-purple-mid to-sd-purple-deep"></div>
              )}
              <div class="flex flex-col flex-1 p-5">
                <div class="flex items-center gap-2 text-xs text-sd-text-muted mb-3">
                  <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{post.data.readTime} min read</span>
                </div>
                <h3 class="font-display text-lg text-white group-hover:text-sd-purple-300 transition-colors leading-snug mb-2">
                  {post.data.title}
                </h3>
                <p class="text-sm text-sd-text-muted leading-relaxed line-clamp-2 mt-auto pt-2">{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA -->
  {data.finalCta && (
    <CTA
      eyebrow={data.finalCta.eyebrow}
      title={data.finalCta.title}
      description={data.finalCta.description}
      buttons={[
        { label: data.finalCta.buttonLabel, href: data.finalCta.buttonHref, external: data.finalCta.external },
      ]}
    />
  )}

  <!-- MARQUEE TEXT BANNER -->
  {data.marqueeText && (
    <section class="bg-sd-dark py-8 border-t border-white/5 overflow-hidden">
      <div class="sd-marquee-wrapper">
        <div class="sd-marquee flex items-center whitespace-nowrap" style="animation-duration: 30s">
          {[...Array(6)].map(() => (
            <span
              class="text-5xl md:text-7xl lg:text-8xl font-display font-semibold tracking-tight mr-16 select-none"
              style="background: linear-gradient(90deg, #673ae4 0%, #44cdf3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
            >
              {data.marqueeText} &nbsp;
            </span>
          ))}
        </div>
      </div>
    </section>
  )}

  <slot />
</BaseLayout>

<style>
  /* sd-dot-grid and sd-dot-grid-light are defined in global.css */
  /* sd-float-* keyframes and classes are defined in global.css */

  #cards-cursor-zone,
  #cards-cursor-zone * { cursor: none; }

  #case-studies-zone,
  #case-studies-zone *,
  #case-studies-zone a,
  #case-studies-zone a:hover { cursor: none !important; }

  .cs-spin-text {
    animation: cs-spin 9s linear infinite;
    transform-origin: 60px 60px;
  }
  @keyframes cs-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>

<script>
  // Case studies custom cursor
  const csZone   = document.getElementById("case-studies-zone");
  const csCursor = document.getElementById("case-studies-cursor");
  if (csZone && csCursor) {
    let csRaf: number;
    window.addEventListener("mousemove", (e: MouseEvent) => {
      cancelAnimationFrame(csRaf);
      csRaf = requestAnimationFrame(() => {
        csCursor.style.left = e.clientX + "px";
        csCursor.style.top  = e.clientY + "px";
        const rect   = csZone.getBoundingClientRect();
        const inside = e.clientX >= rect.left && e.clientX <= rect.right &&
                       e.clientY >= rect.top  && e.clientY <= rect.bottom;
        csCursor.style.opacity        = inside ? "1" : "0";
        document.body.style.cursor    = inside ? "none" : "";
      });
    });
  }

  // What we build custom cursor
  const zone   = document.getElementById("cards-cursor-zone");
  const cursor = document.getElementById("cards-cursor");

  if (zone && cursor) {
    let visible = false;
    let rafId: number;
    let mouseX = 0, mouseY = 0;

    const move = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        cursor.style.left = mouseX + "px";
        cursor.style.top  = mouseY + "px";
      });
    };

    zone.addEventListener("mouseenter", () => {
      visible = true;
      cursor.style.opacity = "1";
      document.body.style.cursor = "none";
    });
    zone.addEventListener("mouseleave", () => {
      visible = false;
      cursor.style.opacity = "0";
      document.body.style.cursor = "";
    });
    window.addEventListener("mousemove", move);
  }
</script>
