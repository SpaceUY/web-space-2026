---
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import JsonLD from "../components/seo/JsonLD.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { organizationJsonLd, SITE } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  publishedTime?: string;
  authorName?: string;
  articleSection?: string;
  footerMarquee?: string;
  footerMarqueeTheme?: "light" | "dark";
  /** Pass false to suppress breadcrumbs, or an array to override with custom items */
  breadcrumbs?: false | Array<{ label: string; href?: string }>;
  /** "dark" (default) = white text for dark heroes. "light" = dark text for light heroes */
  breadcrumbTone?: "dark" | "light";
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  ogImage,
  ogType = "website",
  noindex = false,
  jsonLd,
  publishedTime,
  authorName,
  articleSection,
  footerMarquee,
  footerMarqueeTheme,
  breadcrumbs: breadcrumbsProp,
  breadcrumbTone = "dark",
} = Astro.props;

// Custom items take priority; otherwise auto-generate from URL path
// Small words that stay lowercase in an auto-generated breadcrumb label
// unless they open it (e.g. "finance-and-fintech" -> "Finance and Fintech").
const BREADCRUMB_LOWERCASE_WORDS = new Set(["and", "of", "the", "for", "in"]);
// Set of real static routes, so auto-breadcrumbs never link an
// intermediate segment that has no page of its own (e.g. /blog/tag).
// Built at compile time from the pages directory; dynamic routes ([...])
// are excluded since they are always leaf pages, never intermediate crumbs.
const pageFiles = import.meta.glob("/src/pages/**/*.astro");
const realRoutes = new Set(
  Object.keys(pageFiles)
    .filter((p) => !p.includes("["))
    .map((p) =>
      p.replace("/src/pages", "").replace(/\/index\.astro$/, "").replace(/\.astro$/, "")
    )
    .map((p) => (p === "" ? "/" : p))
);

const autoCrumbs: Array<{ label: string; href?: string }> = [];
if (Array.isArray(breadcrumbsProp)) {
  autoCrumbs.push(...breadcrumbsProp);
} else if (breadcrumbsProp !== false) {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  if (segments.length > 0) {
    autoCrumbs.push({ label: "Home", href: "/" });
    let acc = "";
    for (let i = 0; i < segments.length; i++) {
      const seg = segments[i];
      acc += "/" + seg;
      const label = seg
        .split("-")
        .map((w, idx) =>
          idx > 0 && BREADCRUMB_LOWERCASE_WORDS.has(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)
        )
        .join(" ");
      // Only link an intermediate crumb when its path is a real page;
      // the last crumb is never linked.
      const isLast = i === segments.length - 1;
      const linkable = !isLast && realRoutes.has(acc);
      autoCrumbs.push(linkable ? { label, href: acc } : { label });
      // A dead intermediate segment (no real page, not the last segment,
      // e.g. "tag" in /blog/tag/compliance) means every segment after it
      // is a leaf value the page's own heading already shows — stop
      // instead of repeating it as a redundant final crumb.
      if (!linkable && !isLast) break;
    }
  }
}
const showAutoBreadcrumbs = autoCrumbs.length > 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#191429" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" type="image/png" href="/images/logo/favicon.png" />
    <link rel="apple-touch-icon" href="/images/logo/favicon.png" />
    <!-- manifest removed to prevent PWA install banner on mobile -->

    <link rel="preload" href="/fonts/saira/saira-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans/open-sans-variable-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Preconnect: only googletagmanager.com, which serves gtag.js and is the
         one third party still loading during the initial render. Clarity and
         Apollo are both deferred until after load, so an early connection to
         either would sit unused. */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="SpaceDev Blog" href="/rss.xml" />

    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      authorName={authorName}
      articleSection={articleSection}
    />

    <JsonLD data={organizationJsonLd} />
    {jsonLd && <JsonLD data={jsonLd} />}

    {/* Measurement lives here, in the repo, on purpose.
         The GTM container GTM-WKM5KGV used to sit in this spot and load GA4 on
         our behalf. It was removed in September 2026: nobody on the team had
         access to it, and reading its public source showed it was 97% dead
         weight. Of its 29 event tags, 23 fired on CSS classes from the
         pre-Framer site that appear nowhere in the 181 pages this site builds,
         4 were Google Ads conversions with no campaigns behind them, and its
         one HubSpot listener waited for a form iframe this site does not embed.
         The two things it genuinely did, loading GA4 and injecting Apollo, are
         both below, in twenty lines that can be read and reviewed.

         The trade-off is deliberate: adding a new tag is now a pull request
         rather than a change in a console. That is the right shape for a static
         site that deploys often, and it is what the container's own history
         argues for, since the duplicate GA4 load and the dead triggers both
         came from changes nobody could see. */}

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J43N5T0K82"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-J43N5T0K82');

      /* Single entry point for conversion tracking. Every form and CTA on the
         site calls this and nothing else, so there is one place to look when a
         conversion goes missing. It is a global rather than a module because
         the forms live on six different pages: importing a shared module from
         several entry points makes Astro emit a shared chunk that the page then
         has to fetch on a second round trip, which is the exact regression
         4731879 removed from the home page. */
      window.sdTrack = function (event, params) {
        params = params || {};
        window.dataLayer.push(Object.assign({ event: event }, params));
        gtag('event', event, params);
      };
    </script>

    {/* Apollo website tracker — deferred.
         Sales uses this to see which companies visit the site. It was injected
         by the GTM container; it is here now so it is visible in the repo. It
         identifies a visit from the page and the IP, so it loses nothing by
         starting after load instead of competing with the hero for the main
         thread. Bounces shorter than the idle callback go unrecorded, and those
         are not leads. */}
    <script is:inline>
      (function () {
        function loadApollo() {
          var cacheBust = Math.random().toString(36).substring(7);
          var s = document.createElement("script");
          s.src = "https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache=" + cacheBust;
          s.async = true;
          s.defer = true;
          s.onload = function () {
            if (window.trackingFunctions) {
              window.trackingFunctions.onLoad({ appId: "66350bcafd19fc01c7bf1761" });
            }
          };
          document.head.appendChild(s);
        }
        function whenIdle() {
          if ("requestIdleCallback" in window) requestIdleCallback(loadApollo, { timeout: 3000 });
          else setTimeout(loadApollo, 1500);
        }
        if (document.readyState === "complete") whenIdle();
        else window.addEventListener("load", whenIdle, { once: true });
      })();
    </script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
    </script>

    {/* HotJar (account 5330235) used to load here. It came across with the Framer
         migration, nobody on the team was using its recordings, and it was by far
         the most expensive third party on the page: 1814ms of CPU and 174 KB,
         served with no cache, against Clarity's 305ms and 25 KB for the same job.
         Removed rather than deferred. Do not re-add it without deciding what it
         gives you that Clarity does not. */}

    {/* Microsoft Clarity — deferred.
         Clarity records what a visitor does, so it has nothing to capture until
         the visitor has done something. Loading it in the head made it compete
         with the hero for the main thread during the initial render. The queue
         stub stays inline so any clarity() call made before the script arrives is
         buffered, and the script itself is fetched on the first interaction or
         once the page has loaded and the main thread is idle, whichever is first. */}
    <script is:inline>
      (function (c, l, a, r, i) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
        function load() {
          if (c[a].__loaded) return;
          c[a].__loaded = 1;
          var t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          l.head.appendChild(t);
        }
        ["pointerdown", "keydown", "scroll"].forEach(function (evt) {
          c.addEventListener(evt, load, { once: true, passive: true });
        });
        function whenIdle() {
          if ("requestIdleCallback" in c) c.requestIdleCallback(load, { timeout: 4000 });
          else setTimeout(load, 2000);
        }
        if (l.readyState === "complete") whenIdle();
        else c.addEventListener("load", whenIdle, { once: true });
      })(window, document, "clarity", "script", "y0nhczcekt");
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-sd-dark text-white antialiased">
    <Header />

    <main id="main-content" class="flex-1 relative">
      {showAutoBreadcrumbs && (
        <div class="absolute top-[72px] left-0 right-0 z-20 pointer-events-none">
          <div class="mx-auto max-w-[1440px] px-6 md:px-10 pt-5 pointer-events-auto">
            <Breadcrumbs items={autoCrumbs} visible={true} tone={breadcrumbTone} />
          </div>
        </div>
      )}
      <slot />
    </main>

    <Footer marqueeText={footerMarquee} marqueeTheme={footerMarqueeTheme} />

    <script>
      import { initScrollAnimations } from "../lib/animations";
      initScrollAnimations();
      document.addEventListener("astro:page-load", initScrollAnimations);
    </script>

    <!-- Conversion tracking: book_call_click -->
    <script is:inline>
      (function () {
        /* These are two different things and used to be reported as one event,
           which made the funnel unreadable: there was no way to tell a hundred
           clicks on the calendar from three meetings actually booked. The click
           is intent, the postMessage from HubSpot is the booking. */
        document.addEventListener("click", function (e) {
          var link = e.target.closest("a[href*='meetings.hubspot.com']");
          if (link) {
            window.sdTrack("book_call_click", {
              meeting_url: link.getAttribute("href") || "",
              page_path: location.pathname
            });
          }
        }, true);
        window.addEventListener("message", function (e) {
          if (e.data && e.data.meetingBookSucceeded) {
            window.sdTrack("meeting_booked", { page_path: location.pathname });
          }
        });
      })();
    </script>
  </body>
</html>
