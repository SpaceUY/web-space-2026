---
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import JsonLD from "../components/seo/JsonLD.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { organizationJsonLd, SITE } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  publishedTime?: string;
  authorName?: string;
  articleSection?: string;
  footerMarquee?: string;
  footerMarqueeTheme?: "light" | "dark";
  /** Pass false to suppress auto breadcrumbs (use on pages that render their own inside the hero) */
  breadcrumbs?: false;
  /** "dark" (default) = white text for dark heroes. "light" = dark text for light heroes */
  breadcrumbTone?: "dark" | "light";
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  ogImage,
  ogType = "website",
  noindex = false,
  jsonLd,
  publishedTime,
  authorName,
  articleSection,
  footerMarquee,
  footerMarqueeTheme,
  breadcrumbs: breadcrumbsProp,
  breadcrumbTone = "dark",
} = Astro.props;

// Auto-generate breadcrumb items from URL path (e.g. /our-work → Home > Our Work)
const autoCrumbs: Array<{ label: string; href?: string }> = [];
if (breadcrumbsProp !== false) {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  if (segments.length > 0) {
    autoCrumbs.push({ label: "Home", href: "/" });
    let acc = "";
    segments.forEach((seg, i) => {
      acc += "/" + seg;
      const label = seg
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join(" ");
      autoCrumbs.push(i < segments.length - 1 ? { label, href: acc } : { label });
    });
  }
}
const showAutoBreadcrumbs = autoCrumbs.length > 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#191429" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" type="image/png" href="/images/logo/favicon.png" />
    <link rel="apple-touch-icon" href="/images/logo/favicon.png" />
    <!-- manifest removed to prevent PWA install banner on mobile -->

    <link rel="preload" href="/fonts/geist/geist-600-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans/open-sans-300-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans/open-sans-500-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="SpaceDev Blog" href="/rss.xml" />

    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      authorName={authorName}
      articleSection={articleSection}
    />

    <JsonLD data={organizationJsonLd} />
    {jsonLd && <JsonLD data={jsonLd} />}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WKM5KGV');
    </script>

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-J43N5T0K82"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-J43N5T0K82');
    </script>

    <!-- HotJar -->
    <script is:inline>
      (function(c,s,q,u,a,r,e){
        c.hj=c.hj||function(){(c.hj.q=c.hj.q||[]).push(arguments)};
        c._hjSettings={hjid:a};
        r=s.getElementsByTagName('head')[0];
        e=s.createElement('script');e.async=true;
        e.src=q+c._hjSettings.hjid+u;
        r.appendChild(e);
      })(window,document,'https://static.hj.contentsquare.net/c/csq-','.js',5330235);
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-sd-dark text-white antialiased">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WKM5KGV"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <Header />

    <main id="main-content" class="flex-1 relative">
      {showAutoBreadcrumbs && (
        <div class="absolute top-[72px] left-0 right-0 z-20 pointer-events-none">
          <div class="mx-auto max-w-[1440px] px-6 md:px-10 pt-5 pointer-events-auto">
            <Breadcrumbs items={autoCrumbs} visible={true} tone={breadcrumbTone} />
          </div>
        </div>
      )}
      <slot />
    </main>

    <Footer marqueeText={footerMarquee} marqueeTheme={footerMarqueeTheme} />

    <script>
      import { initScrollAnimations } from "../lib/animations";
      initScrollAnimations();
      document.addEventListener("astro:page-load", initScrollAnimations);
    </script>
  </body>
</html>
