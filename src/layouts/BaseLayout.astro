---
import "../styles/global.css";
import SEOHead from "../components/seo/SEOHead.astro";
import JsonLD from "../components/seo/JsonLD.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { organizationJsonLd, SITE } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  publishedTime?: string;
  authorName?: string;
  articleSection?: string;
  footerMarquee?: string;
  footerMarqueeTheme?: "light" | "dark";
  /** Pass false to suppress breadcrumbs, or an array to override with custom items */
  breadcrumbs?: false | Array<{ label: string; href?: string }>;
  /** "dark" (default) = white text for dark heroes. "light" = dark text for light heroes */
  breadcrumbTone?: "dark" | "light";
}

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  canonical,
  ogImage,
  ogType = "website",
  noindex = false,
  jsonLd,
  publishedTime,
  authorName,
  articleSection,
  footerMarquee,
  footerMarqueeTheme,
  breadcrumbs: breadcrumbsProp,
  breadcrumbTone = "dark",
} = Astro.props;

// Custom items take priority; otherwise auto-generate from URL path
// Small words that stay lowercase in an auto-generated breadcrumb label
// unless they open it (e.g. "finance-and-fintech" -> "Finance and Fintech").
const BREADCRUMB_LOWERCASE_WORDS = new Set(["and", "of", "the", "for", "in"]);
// Set of real static routes, so auto-breadcrumbs never link an
// intermediate segment that has no page of its own (e.g. /blog/tag).
// Built at compile time from the pages directory; dynamic routes ([...])
// are excluded since they are always leaf pages, never intermediate crumbs.
const pageFiles = import.meta.glob("/src/pages/**/*.astro");
const realRoutes = new Set(
  Object.keys(pageFiles)
    .filter((p) => !p.includes("["))
    .map((p) =>
      p.replace("/src/pages", "").replace(/\/index\.astro$/, "").replace(/\.astro$/, "")
    )
    .map((p) => (p === "" ? "/" : p))
);

const autoCrumbs: Array<{ label: string; href?: string }> = [];
if (Array.isArray(breadcrumbsProp)) {
  autoCrumbs.push(...breadcrumbsProp);
} else if (breadcrumbsProp !== false) {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  if (segments.length > 0) {
    autoCrumbs.push({ label: "Home", href: "/" });
    let acc = "";
    for (let i = 0; i < segments.length; i++) {
      const seg = segments[i];
      acc += "/" + seg;
      const label = seg
        .split("-")
        .map((w, idx) =>
          idx > 0 && BREADCRUMB_LOWERCASE_WORDS.has(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)
        )
        .join(" ");
      // Only link an intermediate crumb when its path is a real page;
      // the last crumb is never linked.
      const isLast = i === segments.length - 1;
      const linkable = !isLast && realRoutes.has(acc);
      autoCrumbs.push(linkable ? { label, href: acc } : { label });
      // A dead intermediate segment (no real page, not the last segment,
      // e.g. "tag" in /blog/tag/compliance) means every segment after it
      // is a leaf value the page's own heading already shows — stop
      // instead of repeating it as a redundant final crumb.
      if (!linkable && !isLast) break;
    }
  }
}
const showAutoBreadcrumbs = autoCrumbs.length > 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content="#191429" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" type="image/png" href="/images/logo/favicon.png" />
    <link rel="apple-touch-icon" href="/images/logo/favicon.png" />
    <!-- manifest removed to prevent PWA install banner on mobile -->

    <link rel="preload" href="/fonts/saira/saira-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans/open-sans-variable-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preconnect: only GTM, which is the one third party that still loads during
         the initial render. Clarity is deferred until after load or first
         interaction, so an early connection to it would sit unused. HubSpot form
         domains are page-specific (contact page only) and are deliberately
         excluded to avoid wasting a connection on pages that never use them. -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="SpaceDev Blog" href="/rss.xml" />

    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      publishedTime={publishedTime}
      authorName={authorName}
      articleSection={articleSection}
    />

    <JsonLD data={organizationJsonLd} />
    {jsonLd && <JsonLD data={jsonLd} />}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-WKM5KGV');
    </script>

    <!-- Google Analytics 4 loads through the GTM container above, which fires
         gtag.js for G-J43N5T0K82 itself. A second standalone gtag.js snippet
         used to sit here and the production trace showed the same 177 KB file
         being downloaded twice per page load (354 KB and ~250ms of main-thread
         work), on top of the risk of double-counting pageviews. Do not re-add
         it: to change GA4 configuration, edit the tag inside GTM-WKM5KGV.
         Conversion events below push to dataLayer, so they still reach GA4. -->

    <!-- HotJar (account 5330235) used to load here. It came across with the Framer
         migration, nobody on the team was using its recordings, and it was by far
         the most expensive third party on the page: 1814ms of CPU and 174 KB,
         served with no cache, against Clarity's 305ms and 25 KB for the same job.
         Removed rather than deferred. Do not re-add it without deciding what it
         gives you that Clarity does not. -->

    <!-- Microsoft Clarity — deferred.
         Clarity records what a visitor does, so it has nothing to capture until
         the visitor has done something. Loading it in the head made it compete
         with the hero for the main thread during the initial render. The queue
         stub stays inline so any clarity() call made before the script arrives is
         buffered, and the script itself is fetched on the first interaction or
         once the page has loaded and the main thread is idle, whichever is first. -->
    <script is:inline>
      (function (c, l, a, r, i) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
        function load() {
          if (c[a].__loaded) return;
          c[a].__loaded = 1;
          var t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          l.head.appendChild(t);
        }
        ["pointerdown", "keydown", "scroll"].forEach(function (evt) {
          c.addEventListener(evt, load, { once: true, passive: true });
        });
        function whenIdle() {
          if ("requestIdleCallback" in c) c.requestIdleCallback(load, { timeout: 4000 });
          else setTimeout(load, 2000);
        }
        if (l.readyState === "complete") whenIdle();
        else c.addEventListener("load", whenIdle, { once: true });
      })(window, document, "clarity", "script", "y0nhczcekt");
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-sd-dark text-white antialiased">
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-WKM5KGV"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <Header />

    <main id="main-content" class="flex-1 relative">
      {showAutoBreadcrumbs && (
        <div class="absolute top-[72px] left-0 right-0 z-20 pointer-events-none">
          <div class="mx-auto max-w-[1440px] px-6 md:px-10 pt-5 pointer-events-auto">
            <Breadcrumbs items={autoCrumbs} visible={true} tone={breadcrumbTone} />
          </div>
        </div>
      )}
      <slot />
    </main>

    <Footer marqueeText={footerMarquee} marqueeTheme={footerMarqueeTheme} />

    <script>
      import { initScrollAnimations } from "../lib/animations";
      initScrollAnimations();
      document.addEventListener("astro:page-load", initScrollAnimations);
    </script>

    <!-- Conversion tracking: book_call_click -->
    <script is:inline>
      (function () {
        function trackBookCall(url) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "book_call_click", meeting_url: url || "" });
          if (typeof gtag === "function") {
            gtag("event", "book_call_click", url ? { meeting_url: url } : {});
          }
        }
        document.addEventListener("click", function (e) {
          var link = e.target.closest("a[href*='meetings.hubspot.com']");
          if (link) trackBookCall(link.getAttribute("href"));
        }, true);
        window.addEventListener("message", function (e) {
          if (e.data && e.data.meetingBookSucceeded) trackBookCall("");
        });
      })();
    </script>
  </body>
</html>
