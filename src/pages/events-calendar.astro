<style>
  @keyframes cal-cell-in {
    from { opacity: 0; transform: translateY(8px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)  scale(1); }
  }
  @keyframes cal-list-in {
    from { opacity: 0; transform: translateX(-12px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes cal-today-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(103,58,228,0.6); }
    50%       { box-shadow: 0 0 0 5px rgba(103,58,228,0); }
  }

  .cal-cell { animation: cal-cell-in 0.28s ease both; }

  .cal-event-pill {
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
  }
  .cal-event-pill:hover {
    transform: scale(1.04) translateY(-1px);
    filter: brightness(1.15);
    box-shadow: 0 3px 10px rgba(0,0,0,0.35);
    z-index: 1;
  }

  .cal-list-item {
    transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .cal-list-item:hover {
    background: rgba(103,58,228,0.15) !important;
    border-color: rgba(103,58,228,0.4) !important;
    transform: translateX(4px);
  }
  .cal-list-item.cal-list-animate {
    animation: cal-list-in 0.3s ease both;
  }

  .cal-today {
    animation: cal-today-pulse 2s ease-in-out infinite;
    background: rgba(103,58,228,0.18) !important;
    outline: 1.5px solid rgba(103,58,228,0.7);
    outline-offset: -1px;
  }
</style>

