---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Events Calendar | SpaceDev"
  description="Explore the international events shaping the tech, finance, innovation, blockchain, and AI industries every month."
>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-24 md:py-36">
      <div class="max-w-3xl" data-animate>
        <h1 class="font-display font-semibold text-5xl md:text-7xl text-white leading-[1.0]">
          Events Calendar
        </h1>
        <p class="mt-6 text-lg md:text-xl text-sd-text-muted max-w-xl leading-relaxed">
          Explore the international events shaping the tech, finance, innovation, blockchain, and AI industries every month.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href="/contact" variant="primary">Get in touch</Button>
          <span class="text-sd-text-muted text-sm">Or subscribe to our newsletter</span>
        </div>
        <form class="mt-4 flex gap-3 max-w-md" onsubmit="return false;">
          <input
            type="email"
            placeholder="Your email"
            class="flex-1 rounded-full px-5 py-3 bg-transparent border border-white/20 text-white placeholder:text-sd-text-muted text-sm focus:outline-none focus:border-white/50"
          />
          <button
            type="submit"
            class="rounded-full px-6 py-3 bg-white text-sd-text-dark font-semibold text-sm hover:bg-sd-light-2 transition-colors"
          >
            Sign up!
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- YEAR SECTION -->
  <section class="bg-sd-light py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <p class="font-display font-semibold text-[clamp(6rem,15vw,16rem)] text-sd-text-dark leading-none select-none">
        2025
      </p>
    </div>
  </section>
</BaseLayout>
