    <div class="text-center mb-8 select-none">
      <span class="year-display">2026</span>
    </div>

    <!-- Month pills -->
    <div class="flex flex-wrap justify-center gap-2 mb-12">
      {monthsMeta.map(m => (
        <button
          data-month={m.num}
          class="month-pill px-4 py-1.5 rounded-full text-sm font-ui border border-sd-gray-border text-sd-text-gray hover:border-sd-purple hover:text-sd-text-dark transition-all duration-200"
        >
          {m.short}
        </button>
      ))}
    </div>

    <!-- Slide container -->
    <div id="slide-container" class="relative overflow-hidden">
      {monthData.map(({ num, label, allEvts }) => (
        <div class="month-slide" data-month={num} style="display:none;">

          <!-- Month heading -->
          <p class="text-xs uppercase tracking-[0.2em] text-sd-text-muted font-ui mb-6">{label} 2026 &mdash; {allEvts.length} events</p>

          <!-- Event rows -->
          <div class="divide-y divide-sd-gray-border">
            {allEvts.length === 0 && (
              <p class="py-12 text-center text-sd-text-muted font-body">No events this month.</p>
            )}
            {allEvts.map((evt, i) => (
              <a
                href={evt.website}
                target="_blank"
                rel="noopener noreferrer"
                data-category={evt.category}
                class="cal-event cal-row group flex items-center justify-between py-6 gap-4"
                style={`animation-delay:${i * 40}ms`}
              >
                <div class="flex-1 min-w-0">
                  <p class="text-xs text-sd-text-muted font-body mb-1">{evt.date}, 2026</p>
                  <p class="cal-row-title font-display text-2xl md:text-3xl text-sd-text-dark transition-colors duration-200 leading-snug">
                    {evt.name}
                  </p>
                  <p class="text-sm text-sd-text-gray font-body mt-1">{evt.country}</p>
                </div>
                <span class="cal-know-more shrink-0 text-xs uppercase tracking-widest font-ui text-sd-text-dark">
                  Know more
                </span>
              </a>
            ))}
          </div>

        </div>
      ))}

      <!-- TBD slot -->
      <div class="month-slide" data-month="0" style="display:none;">
        <p class="text-xs uppercase tracking-[0.2em] text-sd-text-muted font-ui mb-6">Date TBD &mdash; {tbdEvents.length} events</p>
        <div class="divide-y divide-sd-gray-border">
          {tbdEvents.map((evt, i) => (
            <a
              href={evt.website}
              target="_blank"
              rel="noopener noreferrer"
              data-category={evt.category}
              class="cal-event cal-row group flex items-center justify-between py-6 gap-4"
              style={`animation-delay:${i * 40}ms`}
            >
              <div class="flex-1 min-w-0">
                <p class="text-xs text-sd-text-muted font-body mb-1">TBD, 2026</p>
                <p class="cal-row-title font-display text-2xl md:text-3xl text-sd-text-dark transition-colors duration-200 leading-snug">
                  {evt.name}
                </p>
                <p class="text-sm text-sd-text-gray font-body mt-1">{evt.country}</p>
              </div>
              <span class="cal-know-more shrink-0 text-xs uppercase tracking-widest font-ui text-sd-text-dark">
                Know more
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- TBD link -->
    <div class="mt-12 text-center border-t border-sd-gray-border pt-8">
      <button id="tbd-btn" class="text-sm text-sd-text-muted hover:text-sd-text-dark font-ui transition-colors">
        + {tbdEvents.length} events with date TBD
      </button>
    </div>

  </div>
</div>

<!-- ── CTA ────────────────────────────────────────────────────────────────── -->
<section class="py-16 md:py-20" style="background: var(--sd-gradient-hero);">
  <div class="mx-auto max-w-[1440px] px-6 md:px-16 text-center">
    <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 font-ui mb-4">Meet us in person</p>
    <h2 class="font-display text-3xl md:text-5xl text-white mb-4">Are you attending any of these?</h2>
    <p class="text-white/60 max-w-lg mx-auto mb-8 leading-relaxed">We attend blockchain and tech conferences throughout the year. If you spot us, let's talk.</p>
    <Button href="/contact" variant="primary">Get in touch</Button>
  </div>
</section>

</BaseLayout>

<script>
  const LABELS = ["January","February","March","April","May","June",
                  "July","August","September","October","November","December"];

  let currentMonth = 5;

  const slideContainer = document.getElementById("slide-container")!;
  const monthPills     = document.querySelectorAll<HTMLElement>(".month-pill");
  const tbdBtn         = document.getElementById("tbd-btn")!;

  function showMonth(num: number, dir: "left"|"right"|"none" = "none") {
    const incoming = document.querySelector<HTMLElement>(`.month-slide[data-month="${num}"]`);
    const outgoing = document.querySelector<HTMLElement>(`.month-slide[data-month="${currentMonth}"]`);
    if (!incoming) return;

    currentMonth = num;

    // Update pills
    monthPills.forEach(pill => {
      const active = parseInt(pill.dataset.month ?? "0") === num;
      pill.style.background   = active ? "#673ae4" : "";
      pill.style.color        = active ? "#ffffff" : "";
      pill.style.borderColor  = active ? "#673ae4" : "";
    });

    // Slide animation
    if (outgoing && outgoing !== incoming && dir !== "none") {
      const fromX = dir === "left" ? "-60px" : "60px";
      const toX   = dir === "left" ? "60px"  : "-60px";

      outgoing.style.transition = "none";
      outgoing.style.display    = "block";

      incoming.style.transition = "none";
      incoming.style.opacity    = "0";
      incoming.style.transform  = `translateX(${fromX})`;
      incoming.style.display    = "block";

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          outgoing!.style.transition = "opacity 0.2s ease";
          outgoing!.style.opacity    = "0";

          incoming.style.transition  = "opacity 0.25s ease, transform 0.25s ease";
          incoming.style.opacity     = "1";
          incoming.style.transform   = "translateX(0)";

          setTimeout(() => {
            if (outgoing) { outgoing.style.display = "none"; outgoing.style.opacity = "1"; outgoing.style.transition = ""; }
            incoming.style.transition = "";
            animateRows(incoming);
          }, 260);
        });
      });
    } else {
      if (outgoing) outgoing.style.display = "none";
      incoming.style.display   = "block";
      incoming.style.opacity   = "1";
      incoming.style.transform = "";
      animateRows(incoming);
    }
  }

  function animateRows(slide: HTMLElement) {
    const rows = slide.querySelectorAll<HTMLElement>(".cal-row");
    rows.forEach((row, i) => {
      row.style.animation = "none";
      void row.offsetHeight;
      row.style.animation = "";
      row.style.animationDelay = `${i * 35}ms`;
    });
  }

  // Month pill clicks
  monthPills.forEach(pill => {
    pill.addEventListener("click", () => {
      const n = parseInt(pill.dataset.month ?? "1");
      showMonth(n, n > currentMonth ? "left" : "right");
    });
  });

  // TBD
  tbdBtn.addEventListener("click", () => showMonth(0, "none"));

  // Touch swipe
  let touchStartX = 0;
  slideContainer.addEventListener("touchstart", e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  slideContainer.addEventListener("touchend", e => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      if (diff > 0 && currentMonth < 12) showMonth(currentMonth + 1, "left");
      if (diff < 0 && currentMonth > 1)  showMonth(currentMonth - 1, "right");
    }
  }, { passive: true });

  // Init — start on current month
  const nowMonth = new Date().getMonth() + 1;
  showMonth(nowMonth <= 12 ? nowMonth : 5, "none");
</script>
