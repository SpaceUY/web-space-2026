  { num: 11, label: "November",  short: "Nov" },
  { num: 12, label: "December",  short: "Dec" },
];

// Category styles — solid, high contrast
const CAT: Record<string, { bg: string; text: string; label: string }> = {
  blockchain: { bg: "#673ae4", text: "#ffffff", label: "Blockchain & Crypto" },
  ai:         { bg: "#44cdf3", text: "#0d1117", label: "AI" },
  fintech:    { bg: "#00ffb2", text: "#0d1117", label: "FinTech" },
  product:    { bg: "#8572bc", text: "#ffffff", label: "Product & Tech" },
};

const monthData = monthsMeta.map(({ num, label, short }) => {
  const byDay: Record<number, CalEvent[]> = {};
  events.filter(e => e.month === num).forEach(evt => {
    const d = parseDay(evt.date);
    if (d > 0) { if (!byDay[d]) byDay[d] = []; byDay[d].push(evt); }
  });
  const allEvts = events.filter(e => e.month === num);
  return { num, label, short, byDay, allEvts, cells: getCalendarCells(num) };
});

const tbdEvents  = events.filter(e => e.month === 0);
const totalCount = events.filter(e => e.month > 0).length;
const weekDays   = ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
