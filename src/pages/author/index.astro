---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { authors } from "../../data/authors";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import { getCollection } from "astro:content";
import { SITE } from "../../lib/seo";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

const authorsWithCount = authors.map((author) => ({
  ...author,
  postCount: allPosts.filter((p) => p.data.author === author.slug).length,
}));
---

<BaseLayout
  title="Our Authors | SpaceDev Blog"
  description="Meet the SpaceDev team — blockchain engineers, product strategists, and Web3 experts sharing what they build and learn."
>
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1100px] px-6 md:px-10 pt-28 pb-20 md:pt-36 md:pb-28">
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 font-ui mb-4">Our Authors</p>
      <h1 class="font-display font-semibold text-4xl md:text-6xl text-white max-w-3xl leading-tight">
        The people behind the posts
      </h1>
      <p class="mt-6 text-lg text-sd-text-muted max-w-2xl leading-relaxed">
        Engineers, founders, and strategists at SpaceDev sharing hands-on insights from building blockchain products.
      </p>
    </div>
  </section>

  <section class="bg-sd-dark py-20 md:py-28">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <div class="grid gap-6 md:grid-cols-3">
        {authorsWithCount.map((author) => (
          <a
            href={`/author/${author.slug}`}
            class="group flex flex-col rounded-2xl overflow-hidden border border-white/10 bg-white/[0.04] hover:border-sd-purple/50 hover:-translate-y-1 transition-all duration-200"
          >
            <div class="h-48 overflow-hidden bg-sd-dark-2 shrink-0">
              {author.coverImage ? (
                <img
                  src={author.coverImage}
                  alt={author.name}
                  loading="lazy"
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700"
                />
              ) : (
                <div class={`w-full h-full flex items-center justify-center bg-gradient-to-br ${author.avatarGradient}`}>
                  <span class="text-white text-4xl font-display font-semibold">{author.initials}</span>
                </div>
              )}
            </div>
            <div class="p-6">
              <p class="text-[10px] uppercase tracking-[0.18em] text-sd-purple-300 font-ui mb-1">{author.role}</p>
              <h2 class="font-display font-semibold text-xl text-white mb-3 group-hover:text-sd-purple-300 transition-colors">
                {author.name}
              </h2>
              <p class="text-sm text-sd-text-muted leading-relaxed line-clamp-3">{author.bio}</p>
              <p class="mt-4 text-xs text-sd-text-muted">
                {author.postCount} {author.postCount === 1 ? "article" : "articles"}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
