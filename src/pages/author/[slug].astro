---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import { authors } from "../../data/authors";
import { SITE } from "../../lib/seo";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";

export async function getStaticPaths() {
  return authors.map((author) => ({ params: { slug: author.slug }, props: { author } }));
}

const { author } = Astro.props;
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts
  .filter((p) => p.data.author === author.slug)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: author.name,
  jobTitle: author.role,
  description: author.bio,
  url: `${SITE.url}/author/${author.slug}`,
  worksFor: { "@type": "Organization", name: SITE.name, url: SITE.url },
  ...(author.social?.linkedin && { sameAs: [author.social.linkedin] }),
};
---

<BaseLayout
  breadcrumbs={false}
  title={`${author.name} | ${author.role} at SpaceDev`}
  description={author.bio.slice(0, 155)}
  jsonLd={personJsonLd}
>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1100px] px-6 md:px-10 py-20 md:py-28">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog", href: "/blog" }, { label: author.name }]} visible={true} class="mb-8" />
      <div class="grid gap-10 md:grid-cols-[auto_1fr] md:items-center">
        {author.coverImage ? (
          <img
            src={author.coverImage}
            alt={`${author.name}, ${author.role} at SpaceDev.`}
            width="320"
            height="320"
            loading="eager"
            class="w-40 md:w-64 h-40 md:h-64 rounded-2xl object-cover border border-white/10 shrink-0"
          />
        ) : (
          <AuthorAvatar author={author} size="lg" showName={false} />
        )}
        <div>
          <Badge tone="purple" class="mb-3">{author.role}</Badge>
          <h1 class="text-4xl md:text-6xl text-white">{author.name}</h1>
          <p class="mt-6 text-lg text-sd-text-muted max-w-2xl leading-relaxed">{author.bio}</p>
          {author.social?.linkedin && (
            <a
              href={author.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 text-sm text-sd-purple-300 hover:text-sd-purple-300"
            >
              Connect on LinkedIn
              <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 3h6m0 0v6m0-6L3 9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>


  <!-- POSTS BY AUTHOR -->
  <section class="bg-sd-dark py-16 md:py-24">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <h2 class="text-2xl md:text-3xl text-white mb-10">Posts by {author.name}</h2>
      {posts.length === 0 ? (
        <p class="text-sd-text-muted">No published posts yet. Check back soon.</p>
      ) : (
        <>
          {/* --- Featured top 3 --- */}
          <div class="grid gap-6 md:grid-cols-3 mb-12">
            {posts.slice(0, 3).map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col rounded-2xl overflow-hidden border border-white/10 bg-white/[0.04] hover:border-sd-purple/50 transition-colors duration-200"
              >
                <div class="h-[180px] overflow-hidden bg-sd-dark-2 shrink-0">
                  {post.data.cover ? (
                    <img
                      src={post.data.cover}
                      alt={post.data.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                  ) : (
                    <div class="w-full h-full" style="background: linear-gradient(135deg, #312652, #191429);"></div>
                  )}
                </div>
                <div class="flex flex-col flex-1 p-5">
                  <p class="text-[10px] uppercase tracking-[0.15em] text-sd-purple-300 mb-2">{post.data.category}</p>
                  <h3 class="text-white text-base font-semibold leading-snug line-clamp-2 group-hover:text-sd-purple-300 transition-colors flex-1">
                    {post.data.title}
                  </h3>
                  <p class="mt-3 text-xs text-sd-text-muted">
                    <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
                    <span class="mx-1.5" aria-hidden="true">·</span>
                    {post.data.readTime} min read
                  </p>
                </div>
              </a>
            ))}
          </div>

          {/* --- Rest as list --- */}
          {posts.length > 3 && (
            <ul class="divide-y divide-white/10">
              {posts.slice(3).map((post) => (
                <li>
                  <a href={`/blog/${post.id}`} class="group flex flex-col md:flex-row md:items-center md:justify-between gap-3 py-5">
                    <div class="md:max-w-2xl">
                      <p class="text-[10px] uppercase tracking-[0.15em] text-sd-purple-300 mb-1.5">{post.data.category}</p>
                      <h3 class="text-base md:text-lg text-white group-hover:text-sd-purple-300 transition-colors leading-snug">{post.data.title}</h3>
                      <p class="mt-1 text-sm text-sd-text-muted line-clamp-1">{post.data.description}</p>
                    </div>
                    <p class="text-xs text-sd-text-muted shrink-0 flex items-center gap-2">
                      <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
                      <span aria-hidden="true">·</span>
                      {post.data.readTime} min
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </>
      )}
    </div>
  </section>
</BaseLayout>
