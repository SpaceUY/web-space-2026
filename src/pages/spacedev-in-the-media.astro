---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import { mediaItems } from "../data/media-items";
import { SITE } from "../lib/seo";

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "SpaceDev in the Media",
  description: "Explore SpaceDev's journey from hackathons to keynote speeches at global events.",
  url: `${SITE.url}/spacedev-in-the-media`,
};
---

<BaseLayout
  title="SpaceDev in the Media: Events, Press & Speaking"
  description="Explore SpaceDev's journey from hackathons to keynote speeches at global events. Discover the milestones that shaped our path and join us for what's next!"
  jsonLd={pageJsonLd}
>
  <!-- HERO -->
  <section class="relative overflow-hidden min-h-[80vh] flex flex-col justify-center" style="background-color: var(--sd-dark-hero);">
    <img
      src="/images/content/fO7SfBQPl5ZyUbWpE80AgCxQ9Co.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(10,6,20,0.88) 25%, rgba(50,30,90,0.45) 65%, rgba(10,6,20,0.75) 100%), linear-gradient(to bottom, rgba(10,6,20,0.2) 0%, rgba(10,6,20,0.85) 100%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-36 pb-16 md:pt-40 md:pb-20 w-full">
      <div class="max-w-3xl" data-animate>
        <h1 class="text-4xl md:text-6xl lg:text-7xl text-white font-display leading-[1.05]">
          SpaceDev in the Media
        </h1>
        <p class="mt-4 text-xl md:text-2xl text-white/60 font-display font-light">
          Curious about the events we've been part of?
        </p>
        <p class="mt-6 text-lg md:text-xl text-white/70 max-w-2xl leading-relaxed font-body">
          Navigate with us through the different paths the universe has led us on: from hackathons and press releases to keynote speeches at international events. We did it all, and we want to share it with you!
        </p>
      </div>
    </div>
  </section>

  <!-- MEDIA GRID -->
  <section class="bg-sd-light py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {mediaItems.map((item) => (
          <article
            class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-sd-gray-border shadow-sm hover:shadow-[0_8px_32px_rgba(103,58,228,0.12)] hover:border-sd-purple/30 hover:-translate-y-1 transition-all duration-300"
            data-animate
          >
            <a href={`/spacedev-in-the-media/${item.slug}`} class="block overflow-hidden">
              <div class="relative aspect-[16/10] bg-sd-dark-2">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
              </div>
            </a>
            <div class="flex flex-col flex-1 p-6">
              <div class="flex flex-wrap gap-2 mb-4">
                {item.tags.map((tag) => (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] uppercase tracking-wider font-ui bg-sd-light-2 text-sd-purple border border-sd-purple/20">
                    {tag}
                  </span>
                ))}
              </div>
              <a href={`/spacedev-in-the-media/${item.slug}`} class="flex flex-col flex-1">
                <h2 class="font-display text-xl text-sd-text-dark group-hover:text-sd-purple transition-colors leading-snug mb-3">
                  {item.title}
                </h2>
                <p class="text-sm text-sd-text-gray font-body leading-relaxed flex-1">
                  {item.highlight}
                </p>
              </a>
              <div class="mt-6 pt-4 border-t border-sd-gray-border flex items-center justify-between">
                <div class="text-xs text-sd-text-gray font-body">
                  <time datetime={item.date.toISOString()}>{dateFmt.format(item.date)}</time>
                  <span class="mx-1.5" aria-hidden="true">·</span>
                  <span>{item.location}</span>
                </div>
                <a href={`/spacedev-in-the-media/${item.slug}`} class="text-xs text-sd-purple font-ui hover:underline">
                  Read more →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white py-16 md:py-20 border-t border-sd-gray-border">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10 text-center" data-animate>
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple font-ui mb-4">Get Involved</p>
      <h2 class="font-display text-3xl md:text-5xl text-sd-text-dark mb-6">Hey you!</h2>
      <p class="text-lg text-sd-text-gray font-body max-w-xl mx-auto mb-8">
        Hosting an event and want SpaceDev involved? Email us and we'll reply ASAP!
      </p>
      <Button href="mailto:marketing@spacedev.io" variant="primary" size="lg">
        marketing@spacedev.io
      </Button>
    </div>
  </section>
</BaseLayout>
