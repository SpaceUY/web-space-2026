---
import ServicePageLayout from "../../layouts/ServicePageLayout.astro";
import Button from "../../components/ui/Button.astro";
import FeatureCard from "../../components/ui/FeatureCard.astro";
import { decentralizedIdentityData } from "../../data/services";

const whatYouGet = [
  { title: "A complete identity product — UX flows, credential issuance, verification, and lifecycle management", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><rect x="3" y="4" width="18" height="16" rx="2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 9h8M8 13h5" stroke="white" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="9" r="0" fill="white"/></svg>` },
  { title: "Practical architecture that balances privacy, security, and usability", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17l10 5 10-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12l10 5 10-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
  { title: "Enterprise-friendly delivery — APIs, admin tooling, monitoring, and documentation", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
  { title: "Security-driven engineering, with optional deeper validation via BlockAudit", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
];

const enables = [
  {
    title: "Faster Onboarding With Fewer Passwords",
    description: "Reduce account friction using wallet-based or credential-based flows.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: "Selective Disclosure and Privacy by Design",
    description: "Users can prove what they need to prove, without exposing everything.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" stroke="white" stroke-width="1.5"/><path d="M3 3l18 18" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  },
  {
    title: "Reusable Credentials Across Experiences",
    description: "Issue once, verify many times — across partners, apps, and environments.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><polyline points="16 6 12 2 8 6" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="2" x2="12" y2="15" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  },
  {
    title: "Stronger Fraud Resistance",
    description: "Add cryptographic verification and better control over credential integrity.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
];

const solutions = [
  { number: "01", title: "DID-Based Onboarding and Account Verification", description: "Identity flows that replace fragile 'upload, wait, approve' experiences with verifiable proofs — while maintaining a clean UX." },
  { number: "02", title: "Verifiable Credentials Issuance and Verification", description: "Systems that issue credentials, manage revocation, and verify claims — designed for high-volume environments and clear auditability." },
  { number: "03", title: "Wallet and Identity Experiences Users Actually Complete", description: "Credential storage, recovery patterns, session management, and user journeys that keep drop-off low without compromising security." },
  { number: "04", title: "APIs and Integrations for Existing Systems", description: "We integrate with existing user databases, CRM, IAM, KYC providers, and internal services through robust APIs and event-driven patterns." },
];

const architecture = [
  { title: "Choosing DID Methods and Credential Formats", description: "We help you select approaches that fit your ecosystem, interoperability goals, and user experience expectations.", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><circle cx="11" cy="11" r="8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 21l-4.35-4.35" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
  { title: "Privacy, Data Minimization, and Storage Patterns", description: "We design the split between on-chain anchors, off-chain data, and encrypted storage so sensitive information is handled responsibly.", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><ellipse cx="12" cy="5" rx="9" ry="3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
  { title: "Scalability and Reliability", description: "We build for performance, monitoring, and operational readiness — including CI/CD, environments, logging, and incident response planning.", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M3 3v16a2 2 0 0 0 2 2h16" stroke="white" stroke-width="1.5" stroke-linecap="round"/><path d="M7 16l4-6 4 3 4-8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
  { title: "Security-First Delivery With BlockAudit Support", description: "Identity systems are high-trust infrastructure. We implement secure patterns across authentication flows, key handling, and verification logic.", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
];

const engagementModels = [
  { title: "End-to-End Product Delivery", description: "We own architecture, development, QA, and launch — acting as your full delivery partner from discovery to production." },
  { title: "Team Augmentation", description: "Embed decentralized identity specialists into your existing team to accelerate delivery and close capability gaps." },
  { title: "Architecture and Advisory", description: "Strategic support for in-house teams navigating DID method selection, credential design, and integration patterns." },
];
---

<ServicePageLayout data={decentralizedIdentityData}>
  <div slot="pre-process">

    <!-- ① Overview -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-3xl mx-auto" data-animate>
          <h2 class="section-title text-white mb-6">Decentralized Identity, Built for Real Products and Real Compliance</h2>
          <p class="text-sd-text-muted leading-relaxed mb-4">
            DID programs fail when they're run like research projects. We build identity products that support everyday workflows, stakeholder needs, and operational realities — with a strong focus on the USA market.
          </p>
          <p class="text-sd-text-muted leading-relaxed mb-8">
            From verifiable credential issuance to wallet-based onboarding, we combine web2-grade product engineering with web3 capabilities to deliver identity systems you can actually ship.
          </p>
          <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="primary" external>Book a call</Button>
        </div>
      </div>
    </section>

    <!-- ② What You Get With SpaceDev -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-10" data-animate>
          <h2 class="section-title text-white mb-4">What You Get With SpaceDev</h2>
          <p class="text-sd-text-muted">A complete identity product — not a prototype.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {whatYouGet.map((item) => (
            <div class="flex items-center gap-4 rounded-2xl p-5 bg-white/5 border border-white/10 hover:border-sd-purple/60 transition-colors duration-300" data-animate>
              <div class="w-12 h-12 rounded-xl flex items-center justify-center p-3 shrink-0" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%)">
                <Fragment set:html={item.icon} />
              </div>
              <p class="text-white font-display font-semibold text-sm leading-snug">{item.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ③ What Decentralized Identity Enables -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-4">What Decentralized Identity Enables</h2>
          <p class="text-sd-text-muted leading-relaxed">The outcomes your users and your team will actually feel.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-12 gap-y-12">
          {enables.map((item) => (
            <div class="flex flex-col gap-4" data-animate>
              <div class="w-12 h-12 rounded-xl flex items-center justify-center p-3" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%)">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-lg font-display font-semibold text-white leading-snug">{item.title}</h3>
              <p class="text-sd-text-muted text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ④ Solutions We Build -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-4">Solutions We Build for Decentralized Identity</h2>
          <p class="text-sd-text-muted leading-relaxed">End-to-end delivery across the full identity stack.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {solutions.map((s) => (
            <div class="group rounded-2xl p-7 bg-white/5 transition-colors duration-300 hover:bg-sd-purple/25" data-animate>
              <p class="text-2xl font-display text-sd-purple-300 mb-4 group-hover:text-sd-purple-200 transition-colors duration-300">{s.number}</p>
              <h3 class="text-base font-display font-semibold text-white mb-3">{s.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑤ Architecture Choices -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-10" data-animate>
          <h2 class="section-title text-white mb-4">Architecture Choices, Made Practical</h2>
          <p class="text-sd-text-muted leading-relaxed">We help you make the right decisions early — so they don't become constraints later.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {architecture.map((item) => (
            <div class="flex gap-4 rounded-2xl p-6 bg-white/5 border border-white/10 hover:border-sd-purple/60 transition-colors duration-300" data-animate>
              <div class="w-12 h-12 rounded-xl flex items-center justify-center p-3 shrink-0" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%)">
                <Fragment set:html={item.icon} />
              </div>
              <div>
                <h3 class="text-base font-display font-semibold text-white mb-1 leading-snug">{item.title}</h3>
                <p class="text-sm text-sd-text-muted leading-relaxed">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑥ Delivery Approach -->
    <section class="py-20 md:py-32 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="grid md:grid-cols-[2fr_3fr] gap-12 md:gap-20 items-start">
          <div class="md:sticky md:top-32" data-animate>
            <h2 class="section-title text-white mb-6">Delivery Approach</h2>
            <p class="text-sd-text-muted leading-relaxed">A structured path from idea to production — without the research-project risk.</p>
          </div>
          <ol class="flex flex-col gap-6">
            {[
              { number: "01", title: "Discovery Sprint", description: "Define the identity use case, trust model, stakeholder flows, constraints, and success metrics. Output: a blueprint you can execute against." },
              { number: "02", title: "Build, Launch, and Iterate", description: "Milestone-based delivery with demos, QA gates, monitoring readiness, and post-launch support for continuous improvement." },
            ].map((step) => (
              <li>
                <FeatureCard number={step.number} title={step.title} description={step.description} tone="dark" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ⑦ Engagement Models -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-10" data-animate>
          <h2 class="section-title text-white">Engagement Models</h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {engagementModels.map((model, i) => (
            <div class="group rounded-2xl p-7 bg-white/5 transition-colors duration-300 hover:bg-sd-purple/25" data-animate>
              <p class="text-2xl font-display text-sd-purple-300 mb-4 group-hover:text-sd-purple-200 transition-colors duration-300">
                {String(i + 1).padStart(2, "0")}
              </p>
              <h3 class="text-base font-display font-semibold text-white mb-2 leading-snug">{model.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{model.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</ServicePageLayout>
