---
import ServicePageLayout from "../../layouts/ServicePageLayout.astro";
import { dappData } from "../../data/services";
---
<ServicePageLayout data={dappData}>
  <!-- Stack & ecosystem visual -->
  <section class="bg-sd-dark py-16 border-t border-white/5">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 grid gap-10 md:grid-cols-2 items-center">
      <img
        src="/images/content/jVjpSMjZrf5oElDSftRW9skwpaw.svg"
        alt="Multi-chain dApp architecture, illustrating EVM and non-EVM networks."
        loading="lazy"
        class="w-full h-auto max-h-72 object-contain"
      />
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-3 mb-4">Multi-chain by default</p>
        <h2 class="text-2xl md:text-3xl text-white font-display leading-tight">
          Built on the chains your users are already on.
        </h2>
        <p class="mt-4 text-sm text-sd-text-muted leading-relaxed">
          Ethereum, Aptos, Solana, Polygon, Arbitrum, Optimism, Base — and bridges between them where it makes sense. We pick the stack that fits the product, not the other way around.
        </p>
      </div>
    </div>
  </section>
</ServicePageLayout>
