---
import ServicePageLayout from "../../../../layouts/ServicePageLayout.astro";
import Button from "../../../../components/ui/Button.astro";
import FeatureCard from "../../../../components/ui/FeatureCard.astro";
import { lendingProtocolsData } from "../../../../data/services";

const requirements = [
  { number: "01", title: "Lending and borrowing contracts", description: "Supply, borrow, repay, and withdraw logic with precise share and debt accounting." },
  { number: "02", title: "Interest rate models", description: "Utilization-based curves, fixed-rate and fixed-term options, and adaptive models tuned to each asset." },
  { number: "03", title: "Collateral and risk parameters", description: "Loan-to-value ratios, liquidation thresholds, supply and borrow caps, and isolation or efficiency modes." },
  { number: "04", title: "Liquidation engine", description: "Partial liquidations, auction mechanisms, keeper incentives, and bad debt handling." },
  { number: "05", title: "Oracle architecture", description: "Primary and fallback price feeds, deviation checks, and protection against manipulation." },
  { number: "06", title: "Reserves and backstops", description: "Protocol reserves, insurance or safety modules, and clear procedures for socializing losses." },
  { number: "07", title: "Governance and parameter management", description: "Timelocked parameter updates, risk curator roles, and emergency pause controls." },
  { number: "08", title: "Lender and borrower interfaces", description: "Dashboards for positions, health factors, liquidation alerts, and analytics for risk teams." },
];

const strategyChoices = [
  { title: "Build a Custom Lending Protocol", description: `The right choice when you need <strong class="text-white">novel collateral types, custom liquidation logic, or a lending design</strong> existing protocols cannot support, for example on a new chain, for a specific asset class, or with compliance requirements built into the core contracts.` },
  { title: "Launch Isolated Markets on an Existing Primitive", description: `Modular protocols now let teams create isolated markets and curated vaults on battle-tested infrastructure. You define the collateral, oracle, and risk parameters, and <strong class="text-white">inherit audited core contracts</strong> instead of writing them from scratch.` },
  { title: "Embed DeFi Lending into a Fintech Product", description: "Fintech apps and exchanges can offer crypto-backed loans or on-chain savings by routing users into existing lending markets behind their own interface. Coinbase's USDC lending, built on a curated Morpho vault, is the reference model. We build the integration, the risk monitoring, and the user experience." },
];

const platformTypes = [
  { title: "Pooled Money Markets", description: "Multi-asset lending pools with shared liquidity, governance-managed risk parameters, and efficiency modes for correlated assets such as stablecoins or liquid staking tokens." },
  { title: "Isolated Lending Markets", description: `Single collateral and single loan asset markets where <strong class="text-white">risk stays contained</strong>, so a failure in a long-tail asset cannot drain the rest of the protocol.` },
  { title: "RWA and Private Credit Lending", description: "Permissioned lending pools and credit platforms for tokenized treasuries, private credit, invoices, and fixed income, with KYC-gated participation and off-chain legal enforceability." },
  { title: "Fixed-Rate and Fixed-Term Lending", description: "Lending products with predictable rates and maturities for institutional borrowers and treasury teams that cannot manage variable-rate exposure." },
  { title: "NFT and Long-Tail Collateral Lending", description: "Peer-to-pool and peer-to-peer lending against NFTs, tokenized collectibles, and illiquid assets, with valuation oracles and auction-based liquidations." },
  { title: "Collateralized Debt Positions", description: `Overcollateralized lending that mints a stablecoin against deposited collateral, with stability fees, liquidation auctions, and peg management. See our <a href="/blockchain-development-services/industry/finance-and-fintech/stablecoins" class="underline hover:text-white">stablecoin development</a> service.` },
];

const riskMechanics = [
  { title: "Interest Rate Model Design", description: `Rates must pull liquidity in when utilization is high and keep borrowing attractive when it is low. We model <strong class="text-white">utilization curves per asset</strong> and stress-test them against liquidity crunches and bank-run scenarios.` },
  { title: "Liquidation Engine Design", description: "A liquidation engine has to work on the worst day of the year, when gas spikes and prices gap. We design partial liquidations, keeper incentives, and auction mechanics so positions close before they create bad debt." },
  { title: "Oracle Design and Manipulation Resistance", description: "Oracle failures cause some of the largest lending losses in DeFi, including the $114 million Mango Markets manipulation in 2022. We combine decentralized feeds, fallback sources, and deviation limits, and never price collateral on a spot price a flash loan can move." },
  { title: "Bad Debt and Backstops", description: "When liquidations fail, someone absorbs the loss. We define reserves, safety modules, and loss socialization rules in advance, so lenders know exactly how the protocol behaves in a shortfall." },
];

const techStack = [
  { category: "Smart Contracts", items: "Solidity, Rust (Anchor), Foundry, Hardhat, OpenZeppelin, ERC-4626 for lending vaults" },
  { category: "Networks", items: "Ethereum, Arbitrum, Base, Optimism, Polygon, Avalanche, BNB Chain, Solana" },
  { category: "Oracles", items: "Chainlink, Pyth, RedStone, TWAP fallbacks, custom valuation oracles for RWA and NFT collateral" },
  { category: "Liquidations and Automation", items: "Custom keeper networks, Chainlink Automation, Gelato, Flashbots for MEV-aware execution" },
  { category: "Testing and Risk", items: "Foundry fuzzing and invariant tests, Slither, agent-based economic simulations" },
  { category: "Integrations", items: "Aave, Morpho, Compound, Euler, Sumsub and Chainalysis for permissioned pools" },
];

const deliverySteps = [
  { number: "01", title: "Market and Risk Discovery", description: `We define target assets, borrower profiles, lending model, and compliance requirements. Our <a href="/product-discovery" class="underline hover:text-white">Product Discovery</a> service covers this as a standalone engagement.` },
  { number: "02", title: "Economic Design and Simulation", description: "We set interest rate models, collateral parameters, and liquidation incentives, then simulate them against historical volatility and stress events." },
  { number: "03", title: "Smart Contract Development", description: "We build the lending, liquidation, oracle, and governance contracts with upgrade paths and emergency controls designed in." },
  { number: "04", title: "Testing and Security Review", description: "Unit, fuzz, and invariant testing, economic attack simulations, and independent auditing before any funds are at risk." },
  { number: "05", title: "Interfaces and Risk Monitoring", description: "We ship lender and borrower dashboards, liquidation alerts, and internal monitoring for utilization, health factors, and oracle deviations." },
  { number: "06", title: "Guarded Launch and Scaling", description: "We launch with conservative supply and borrow caps, then raise limits as the protocol proves itself under real market conditions." },
];

const engagementModels = [
  { title: "End-to-End Protocol Development", description: "One team owns economic design, contracts, oracles, liquidations, and interfaces." },
  { title: "Team Augmentation", description: `Senior Solidity and Rust engineers join your protocol team through <a href="/staff-augmentation" class="underline hover:text-white">IT Staff Augmentation</a>.` },
  { title: "Risk and Security Review", description: "For live or forked protocols, we review parameters, liquidation design, and accounting logic before you raise caps or list new assets." },
];

const relatedServices = [
  { title: "DeFi Development Services", description: "Protocols, DEXs, and financial infrastructure for Web3 fintech", href: "/blockchain-development-services/industry/finance-and-fintech" },
  { title: "Stablecoin Development", description: "Stablecoins and CDP systems backed by on-chain collateral", href: "/blockchain-development-services/industry/finance-and-fintech/stablecoins" },
  { title: "Yield Farming Development", description: "Vaults and incentive programs that bring liquidity to your markets", href: "/blockchain-development-services/industry/finance-and-fintech/yield-farming" },
  { title: "Crypto Trading Bot Development", description: "Automated strategies that monitor rates and liquidation risk", href: "/blockchain-development-services/industry/finance-and-fintech/trading-bots" },
  { title: "Bond Tokenization", description: "On-chain fixed income that can serve as lending collateral", href: "/blockchain-development-services/asset-tokenization/bonds" },
];
---

<ServicePageLayout data={{ ...lendingProtocolsData, seo: lendingProtocolsData.seo }}>
  <div slot="pre-process">

    <!-- ① Overview -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-3xl mx-auto" data-animate>
          <h2 class="section-title text-white mb-6">DeFi Lending Protocol Development Services for Money Markets, Isolated Markets, and On-Chain Credit</h2>
          <p class="text-sd-text-muted leading-relaxed mb-8" set:html={`SpaceDev designs and builds DeFi lending protocols and borrowing platforms for protocol teams, fintech companies, and credit funds that need <strong class="text-white">risk parameters that hold up under stress</strong>, not a Compound fork with new branding. We cover the full stack: lending contracts, interest rate models, liquidation engines, oracle design, and the interfaces your lenders and borrowers use.`} />
          <Button href="/our-work" variant="primary">See our work</Button>
        </div>
      </div>
    </section>

    <!-- ② What We Build -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-4">What a DeFi Lending Protocol Requires, and What We Build</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {requirements.map((s) => (
            <div class="group rounded-2xl p-7 bg-white/5 transition-colors duration-300 hover:bg-sd-purple/25" data-animate>
              <p class="text-2xl font-display text-sd-purple-300 mb-4 group-hover:text-sd-purple-200 transition-colors duration-300">{s.number}</p>
              <h3 class="text-base font-display font-semibold text-white mb-3 leading-snug">{s.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ③ Build vs Launch vs Embed -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-3xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Build, Launch Markets, or Embed: Choosing Your Lending Strategy</h2>
          <p class="text-sd-text-muted leading-relaxed">Not every team needs a new lending protocol. The right path depends on your users, your capital, and how much risk you want to own.</p>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          {strategyChoices.map((item) => (
            <div class="rounded-2xl p-7 bg-white/5 border border-white/10" data-animate>
              <h3 class="text-base font-display font-semibold text-white mb-3 leading-snug">{item.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed" set:html={item.description} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ④ Types of Lending Platforms -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-4">Types of Lending Platforms We Develop</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
          {platformTypes.map((item) => (
            <div class="flex flex-col gap-3" data-animate>
              <h3 class="text-lg font-display font-semibold text-white leading-snug">{item.title}</h3>
              <p class="text-sd-text-muted text-sm leading-relaxed" set:html={item.description} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑤ Risk Mechanics -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-4">The Risk Mechanics That Make or Break a Lending Protocol</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2">
          {riskMechanics.map((item) => (
            <div class="rounded-2xl p-7 bg-white/5 border border-white/10" data-animate>
              <h3 class="text-base font-display font-semibold text-white mb-3 leading-snug">{item.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed" set:html={item.description} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑥ Security -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-3xl" data-animate>
          <h2 class="section-title text-white mb-6">Security for Lending Protocols</h2>
          <p class="text-sd-text-muted leading-relaxed mb-4">Lending contracts pool large amounts of user capital, and attackers study every fork. The Euler exploit in 2023 cost around $197 million, and empty-market rounding attacks have repeatedly hit Compound v2 forks.</p>
          <p class="text-sd-text-muted leading-relaxed" set:html={`We secure lending protocols with <strong class="text-white">invariant and fuzz testing on debt and share accounting</strong>, economic simulations of liquidation cascades, careful handling of new and empty markets, timelocks on parameter changes, and emergency pause controls. Every release goes through structured internal review, with <a href="/blockaudit-smart-contract-and-blockchain-security" class="underline hover:text-white">BlockAudit</a> available for independent audits before mainnet.`} />
        </div>
      </div>
    </section>

    <!-- ⑦ Compliance -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-3xl" data-animate>
          <h2 class="section-title text-white mb-6">Compliance for Lending and Credit Platforms</h2>
          <p class="text-sd-text-muted leading-relaxed mb-4">Permissionless lending protocols, permissioned RWA credit pools, and consumer lending products in fintech apps face very different obligations. Platforms serving US users may need KYC/AML controls, lending or money transmission licensing, and securities analysis for tokenized credit instruments.</p>
          <p class="text-sd-text-muted leading-relaxed">We build the controls your legal team defines: KYC-gated pools, jurisdictional restrictions, sanctions screening, and audit trails for every loan event. We do not provide legal or regulatory advice.</p>
        </div>
      </div>
    </section>

    <!-- ⑧ Tech Stack -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Lending Protocol Tech Stack</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {techStack.map((item) => (
            <div class="rounded-2xl p-6 bg-white/5 border border-white/10" data-animate>
              <p class="text-xs font-ui uppercase tracking-widest text-sd-purple-300 mb-3">{item.category}</p>
              <p class="text-sm text-sd-text-muted leading-relaxed">{item.items}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑨ Security & Audit -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div
          class="relative overflow-hidden rounded-3xl px-10 py-12 md:px-16 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-8"
          style="background: var(--sd-gradient-purple-dark);"
          data-animate
        >
          <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 70% 50%, #7c3aed, transparent 60%);"></div>
          <div class="relative max-w-xl">
            <p class="text-xs font-ui uppercase tracking-widest text-sd-purple-300 mb-3">Independent Security Review</p>
            <p class="text-2xl md:text-3xl lg:text-4xl text-white font-display leading-snug">BlockAudit: Blockchain Security</p>
            <p class="text-sd-text-muted mt-3 leading-relaxed">Lending contracts pool large amounts of user capital. BlockAudit (SpaceDev's dedicated security division) provides full smart contract audits and pre-launch hardening before any lending protocol reaches production.</p>
          </div>
          <a
            href="/blockaudit-smart-contract-and-blockchain-security"
            class="relative shrink-0 inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 text-sm text-white font-medium hover:bg-white/20 transition-colors backdrop-blur-sm"
          >
            Learn more
          </a>
        </div>
      </div>
    </section>

    <!-- ⑩ Delivery Process -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="grid md:grid-cols-2 gap-16 items-start">
          <div class="md:sticky md:top-32">
            <h2 class="section-title text-white mb-4" data-animate>How We Build Lending Protocols</h2>
          </div>
          <div class="flex flex-col gap-4">
            {deliverySteps.map((s) => (
              <FeatureCard number={s.number} title={s.title} description={s.description} tone="dark" />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ⑪ Engagement Models -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Engagement Models</h2>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          {engagementModels.map((item) => (
            <div class="rounded-2xl p-7 bg-white/5 border border-white/10 hover:border-sd-purple/60 transition-colors duration-300" data-animate>
              <h3 class="text-base font-display font-semibold text-white mb-3 leading-snug">{item.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed" set:html={item.description} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑫ Related Services -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Related Services for Lending Protocol Projects</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {relatedServices.map((item) => (
            <a
              href={item.href}
              class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-sd-dark-2 p-6 min-h-[140px] hover:bg-sd-purple/20 hover:border-sd-purple/40 transition-all duration-300"
              data-animate
            >
              <div class="inline-flex items-center justify-center w-9 h-9 rounded-md border border-white/20 group-hover:border-white/40 transition-colors shrink-0 mb-4">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="text-white">
                  <path d="M7 17L17 7M17 7H7M17 7v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-display font-semibold text-white leading-snug mb-1 group-hover:underline underline-offset-4">
                  {item.title}
                </h3>
                <p class="text-sm text-sd-text-muted leading-relaxed">{item.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</ServicePageLayout>
