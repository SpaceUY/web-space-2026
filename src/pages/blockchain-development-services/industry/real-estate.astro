---
import ServicePageLayout from "../../../layouts/ServicePageLayout.astro";
import Button from "../../../components/ui/Button.astro";
import { realEstateData } from "../../../data/services";

const useCases = [
  { useCase: "Property tokenization platforms",   solves: "Fractional ownership, digital issuance, secondary market access" },
  { useCase: "Smart contract-based transactions", solves: "Automated closings, escrow logic, title transfer without intermediaries" },
  { useCase: "On-chain property registries",      solves: "Tamper-proof title records, ownership history, dispute reduction" },
  { useCase: "Tokenized debt and mortgage positions", solves: "Private credit instruments, bridge financing on-chain" },
  { useCase: "KYC/AML and compliance infrastructure", solves: "Accreditation checks, transfer restrictions enforced at contract level" },
  { useCase: "Investor portals and cap table management", solves: "Real-time ownership dashboards, distribution automation" },
  { useCase: "DeFi integration for real estate",  solves: "Liquidity pools, yield mechanisms, protocol-level lending" },
];

const benefits = [
  {
    title: "Transparent Title Management and Ownership Records",
    body: "On-chain property registries eliminate disputes over ownership history. Every transfer is recorded, timestamped, and auditable without relying on a central authority.",
  },
  {
    title: "Smart Contracts That Replace Intermediaries in Property Transactions",
    body: "Escrow, title transfer, rental agreements, and closing conditions can be codified in audited smart contracts that execute automatically when predefined conditions are met, cutting legal overhead and settlement time.",
  },
  {
    title: "Fractional Investment and Liquidity for Illiquid Assets",
    body: "Real estate has historically been inaccessible to smaller investors. Property tokenization opens fractional ownership, secondary trading, and global investor access for assets that were previously locked to high-net-worth participants.",
  },
  {
    title: "Automated Compliance at the Contract Level",
    body: "Accreditation checks, jurisdictional transfer restrictions, and investor allowlists enforced directly in the smart contract, not as a front-end suggestion that can be bypassed.",
  },
];

const techStack = [
  { layer: "Token Standards",               items: "ERC-1400, ERC-3643 (T-REX), ERC-20, ERC-721" },
  { layer: "Networks",                      items: "Ethereum, Polygon, Avalanche, Private / Permissioned Chains" },
  { layer: "Smart Contract Infrastructure", items: "Solidity, Hardhat, Foundry, OpenZeppelin" },
  { layer: "Compliance and Identity",       items: "Chainlink, on-chain KYC integrations, allowlist enforcement engines" },
  { layer: "Payment Rails",                 items: "Stablecoin settlement (USDC, USDT), fiat on-ramp integrations, custodial wallet support" },
];

const process = [
  { number: "01", title: "Discovery Sprint", body: "We define the platform scope, token model, compliance requirements, and architecture before a single line of code is written. Our Product Discovery process gives your legal, operations, and investment teams a blueprint they can approve." },
  { number: "02", title: "Build and QA",     body: "Milestone-based delivery with working demos, QA gates, and embedded security review at each stage. No monolith delivered at the end of a six-month engagement." },
  { number: "03", title: "Launch and Post-Production", body: "Ongoing engineering, monitoring, and iteration as your platform scales and regulatory requirements evolve." },
];

const related = [
  { title: "Smart Contract Development",  description: "The on-chain layer governing token behavior and transaction logic",       href: "/blockchain-development-services/smart-contract-development" },
  { title: "dApp Development",            description: "Investor portals, issuer consoles, and property dashboards",              href: "/blockchain-development-services/dapp-development" },
  { title: "Real Estate Tokenization",    description: "Fractional ownership platforms and security token issuance",              href: "/blockchain-development-services/asset-tokenization/real-estate" },
  { title: "BlockAudit: Blockchain Security", description: "Smart contract audits before any platform goes live",                href: "/blockaudit-smart-contract-and-blockchain-security" },
  { title: "Asset Tokenization",          description: "Tokenization beyond real estate across asset classes",                    href: "/blockchain-development-services/asset-tokenization" },
];
---

<ServicePageLayout data={realEstateData}>
  <div slot="pre-process">

    <!-- ① Use Cases -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Blockchain Use Cases We Build for the Real Estate Industry</h2>
          <p class="text-sd-text-muted leading-relaxed">The real estate sector has specific operational problems that blockchain solves at the infrastructure level. These are the use cases we deliver in production.</p>
        </div>

        <!-- Desktop table -->
        <div class="hidden md:block overflow-x-auto" data-animate>
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-white/10">
                <th class="text-left text-xs font-ui uppercase tracking-widest text-sd-purple-300 pb-4 pr-8 w-2/5">Use Case</th>
                <th class="text-left text-xs font-ui uppercase tracking-widest text-sd-purple-300 pb-4 w-3/5">What It Solves</th>
              </tr>
            </thead>
            <tbody>
              {useCases.map((row, i) => (
                <tr class={`border-b border-white/5 ${i % 2 !== 0 ? "bg-white/[0.02]" : ""}`}>
                  <td class="py-5 pr-8 font-display font-semibold text-white text-sm leading-snug align-top">{row.useCase}</td>
                  <td class="py-5 text-sd-text-muted leading-relaxed align-top">{row.solves}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Mobile cards -->
        <div class="flex flex-col gap-4 md:hidden">
          {useCases.map((row) => (
            <div class="rounded-2xl p-6 bg-white/5 border border-white/10" data-animate>
              <h3 class="text-base font-display font-semibold text-white mb-2">{row.useCase}</h3>
              <p class="text-sm text-sd-text-muted">{row.solves}</p>
            </div>
          ))}
        </div>

        <p class="mt-10 text-sm text-sd-text-muted" data-animate>
          Already know you need a tokenization platform specifically? See our dedicated{" "}
          <a href="/blockchain-development-services/asset-tokenization/real-estate" class="text-sd-purple-300 hover:text-white transition-colors">Real Estate Tokenization</a> service.
        </p>
      </div>
    </section>

    <!-- ② Benefits -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">What Blockchain Brings to Real Estate Operations</h2>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
          {benefits.map((b) => (
            <div class="rounded-2xl p-8 bg-white/5 border border-white/10 hover:border-sd-purple/50 transition-colors duration-300" data-animate>
              <h3 class="text-base font-display font-semibold text-white mb-3 leading-snug">{b.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{b.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ③ Tech Stack -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Blockchain Technologies We Use for Real Estate Platforms</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-animate>
          {techStack.map((t) => (
            <div class="rounded-2xl p-6 bg-white/5 border border-white/10">
              <p class="text-xs font-ui uppercase tracking-widest text-sd-purple-300 mb-3">{t.layer}</p>
              <p class="text-sm text-white leading-relaxed">{t.items}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ④ Process -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">How We Deliver Real Estate Blockchain Projects</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {process.map((step) => (
            <div class="rounded-2xl p-8 bg-white/5 border border-white/10" data-animate>
              <p class="text-3xl font-display text-sd-purple-300 mb-4">{step.number}</p>
              <h3 class="text-base font-display font-semibold text-white mb-3">{step.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑤ Related Services -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-12" data-animate>
          <h2 class="section-title text-white mb-4">Related Blockchain Services for Real Estate Platforms</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {related.map((r) => (
            <a href={r.href} class="group rounded-2xl p-6 bg-white/5 border border-white/10 hover:border-sd-purple/50 hover:bg-sd-purple/10 transition-all duration-300" data-animate>
              <h3 class="text-base font-display font-semibold text-white mb-2 group-hover:text-sd-purple-200 transition-colors">{r.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{r.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Case Studies CTA -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container flex flex-col items-start gap-6" data-animate>
        <div class="max-w-2xl">
          <h2 class="section-title text-white mb-4">Real Work, Real Results</h2>
          <p class="text-sd-text-muted leading-relaxed">
            Explore our portfolio to see the engineering behind the platforms we've shipped.
          </p>
        </div>
        <Button href="/our-work" variant="outline-light" size="lg">See Our Work</Button>
      </div>
    </section>

  </div>
</ServicePageLayout>
