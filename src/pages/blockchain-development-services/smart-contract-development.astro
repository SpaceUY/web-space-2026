---
import ServicePageLayout from "../../layouts/ServicePageLayout.astro";
import { smartContractData } from "../../data/services";
---
<ServicePageLayout data={smartContractData}>
  <!-- Audit pipeline visual -->
  <section class="bg-sd-dark py-16 border-t border-white/5">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 grid gap-10 md:grid-cols-2 items-center">
      <img
        src="/images/content/L5mZDwRMP1XtyYGb0P8kuICAtEs.svg"
        alt="Smart contract review pipeline: static analysis, fuzzing, formal verification, manual review."
        loading="lazy"
        class="w-full h-auto max-h-72 object-contain"
      />
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 mb-4">Audit-grade pipeline</p>
        <h2 class="text-2xl md:text-3xl text-white font-display leading-tight">
          Every contract goes through the same gauntlet.
        </h2>
        <p class="mt-4 text-sm text-sd-text-muted leading-relaxed">
          Slither, Echidna, Foundry-based fuzzing, and (where it makes sense) formal verification — followed by peer review and an optional independent BlockAudit before mainnet.
        </p>
      </div>
    </div>
  </section>
</ServicePageLayout>
