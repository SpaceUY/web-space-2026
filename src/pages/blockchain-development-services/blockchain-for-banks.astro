---
import ServicePageLayout from "../../layouts/ServicePageLayout.astro";
import EditorialSection from "../../components/ui/EditorialSection.astro";
import { banksData } from "../../data/services";
---
<ServicePageLayout data={banksData}>
  <EditorialSection
    image="/images/content/jVjpSMjZrf5oElDSftRW9skwpaw.svg"
    imageAlt="Compliance, custody, and settlement layers working together for regulated financial institutions."
    imagePosition="right"
    eyebrow="Bank-grade controls"
    heading="Compliance and settlement, native to the protocol."
    body="Our reference architectures combine MPC custody, on-chain KYC, travel-rule integrations, and HSM-backed signing — so regulators, auditors, and risk teams stay aligned."
  />

  <!-- Reference architecture diagram -->
  <section class="bg-sd-dark py-16 border-t border-white/5">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 text-center">
      <img
        src="/images/content/4EnN0joO3tVJiGxfaLXZnG7Nb0.png"
        alt="Reference architecture for a regulated blockchain platform serving banks and asset managers."
        loading="lazy"
        width="1200"
        height="900"
        class="mx-auto w-full max-w-3xl h-auto rounded-2xl border border-white/10"
      />
    </div>
  </section>
</ServicePageLayout>
