---
import ServicePageLayout from "../../layouts/ServicePageLayout.astro";
import Button from "../../components/ui/Button.astro";
import FeatureCard from "../../components/ui/FeatureCard.astro";
import { banksData } from "../../data/services";

const challenges = [
  {
    title: "Security risks (custody, key management)",
    description: "Managing private keys and digital assets at institutional scale requires infrastructure most banks don't have in-house.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 8v4" stroke="white" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="15" r="0.5" fill="white" stroke="white" stroke-width="1"/></svg>`,
  },
  {
    title: "Regulatory uncertainty",
    description: "Evolving frameworks across jurisdictions make it hard to know which rules apply — and how to build compliant systems around them.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: "Complex integrations",
    description: "Connecting blockchain infrastructure to core banking systems, KYC providers, and payment rails introduces significant technical complexity.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: "Lack of in-house expertise",
    description: "Deep blockchain engineering talent is scarce and expensive, creating a gap most financial institutions can't close quickly on their own.",
    icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="7" r="4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
];

const completeSolution = [
  { title: "Custody & Wallet Infrastructure", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><rect x="2" y="5" width="20" height="14" rx="2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 12a2 2 0 1 0 4 0 2 2 0 0 0-4 0z" stroke="white" stroke-width="1.5"/><path d="M2 10h20" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>` },
  { title: "Blockchain Integration (Ethereum, etc.)", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><rect x="3" y="3" width="7" height="7" rx="1" stroke="white" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="white" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="white" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="white" stroke-width="1.5"/></svg>` },
  { title: "Tokenization Platforms", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><path d="M12 2a5 5 0 1 0 0 10A5 5 0 0 0 12 2z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 20c0-3.31 3.58-6 8-6s8 2.69 8 6" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 8l2 2-2 2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
  { title: "Payments & Transfers", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><rect x="5" y="2" width="14" height="20" rx="2" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 7h6M9 11h6M9 15h4" stroke="white" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="11" r="0" stroke="white"/><path d="M12 7v2m0 4v2" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>` },
  { title: "Compliance & Monitoring", icon: `<svg viewBox="0 0 24 24" fill="none" style="width:100%;height:100%"><circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>` },
];

const deploymentProcess = [
  { number: "01", title: "Discovery & Strategy", description: "We align with stakeholders to define objectives, constraints, and a clear roadmap that turns blockchain capabilities into actionable opportunities." },
  { number: "02", title: "Architecture Design", description: "We design secure, scalable architectures tailored to each institution, ensuring interoperability and long-term adaptability." },
  { number: "03", title: "Development", description: "We build production-ready solutions focused on performance, reliability, and maintainability across smart contracts and systems." },
  { number: "04", title: "Integration with existing systems", description: "We integrate blockchain infrastructure with existing systems and APIs, enabling new capabilities with minimal disruption." },
  { number: "05", title: "Ongoing support", description: "We provide continuous support and optimization to keep systems secure, compliant, and aligned with evolving needs." },
];

const techRow1 = [
  { label: "Ethereum & EVM-compatible chains", img: "/images/networks/ethereum-dark.svg", float: "sd-float-1" },
  { label: "Solana",                           img: "/images/networks/solana-dark.svg",   float: "sd-float-2" },
  { label: "Polygon",                          img: "/images/networks/polygon-dark.svg",  float: "sd-float-3" },
];
const techRow2 = [
  { label: "APIs & Integrations",  img: "/images/networks/layer2-dark.svg", float: "sd-float-4" },
  { label: "Smart contracts",      img: "/images/networks/BNB-dark.svg",    float: "sd-float-2" },
  { label: "Custody Solutions",    img: "/images/networks/layer2-dark.svg", float: "sd-float-1" },
];

const securityApproach = [
  { number: "01", title: "Key management best practices", description: "We implement secure key management strategies to protect digital assets and minimize exposure to operational risks." },
  { number: "02", title: "Infrastructure hardening", description: "Our infrastructure is designed and configured to resist threats, ensuring stability and resilience in critical environments." },
  { number: "03", title: "Compliance-aware development", description: "We build solutions aligned with regulatory requirements, enabling institutions to operate within evolving compliance frameworks." },
  { number: "04", title: "Audits & testing", description: "Our agile development process ensures your app moves from idea to release quickly, without losing quality or stability." },
];

const whyChoose = [
  "Proven expertise in Web2 + Web3 development",
  "End-to-end delivery: strategy, development, security, and scaling",
  "Flexible engagement models (project-based or staff augmentation)",
  "Experience working with startups and enterprises in the US market",
  "Strong focus on scalability, security, and long-term success",
];

---

<ServicePageLayout data={banksData}>

  <div slot="pre-process">

    <!-- Section 2: The challenge of entering digital assets -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white">The challenge of entering digital assets</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-12 gap-y-12">
          {challenges.map((item) => (
            <div class="flex flex-col gap-4" data-animate>
              <div class="w-12 h-12 rounded-xl flex items-center justify-center p-3" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%)">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-lg font-display font-semibold text-white leading-snug">{item.title}</h3>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 3: A complete blockchain solution for financial institutions -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-3">A complete blockchain solution for financial institutions</h2>
          <p class="text-sd-text-muted">From strategy to deployment</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {completeSolution.map((item) => (
            <div class="flex items-center gap-4 rounded-2xl p-5 bg-white/5 border border-white/10 hover:border-sd-purple/60 transition-colors duration-300" data-animate>
              <div class="w-12 h-12 rounded-xl flex items-center justify-center p-3 shrink-0" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%)">
                <Fragment set:html={item.icon} />
              </div>
              <p class="text-white font-display font-semibold text-sm leading-snug">{item.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 4: Built for real-world deployment -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="grid md:grid-cols-[2fr_3fr] gap-12 md:gap-20 items-start">
          <div class="md:sticky md:top-32" data-animate>
            <h2 class="section-title text-white mb-6">Built for real-world deployment</h2>
            <p class="text-sd-text-muted leading-relaxed">We partner with financial institutions across every stage of their blockchain journey — from early exploration and strategic definition to full-scale implementation and long-term evolution — ensuring each solution is aligned with real business, regulatory, and technical constraints.</p>
          </div>
          <ol class="flex flex-col gap-6">
            {deploymentProcess.map((step) => (
              <li>
                <FeatureCard number={step.number} title={step.title} description={step.description} tone="dark" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Section 5: Technology we work with -->
    <section class="relative bg-sd-dark py-20 md:py-28 border-t border-white/5 overflow-hidden">
      <div class="absolute inset-0 sd-dot-grid"></div>
      <div class="relative sd-container">
        <div class="text-center max-w-2xl mx-auto mb-16" data-animate>
          <h2 class="section-title text-white mb-4">Technology we work with</h2>
          <p class="text-sd-text-muted leading-relaxed">We use proven technologies and infrastructure to ensure security, compliance, and seamless integration in financial environments.</p>
        </div>
        <div class="flex flex-col items-center gap-10">
          <div class="flex justify-center gap-12 md:gap-16">
            {techRow1.map((n) => (
              <div class={`flex flex-col items-center gap-3 ${n.float}`}>
                <img src={n.img} alt={n.label} width={80} height={80} class="w-16 h-16 md:w-20 md:h-20" />
                <span class="text-xs font-ui uppercase tracking-widest text-sd-text-muted text-center leading-tight max-w-[120px]">{n.label}</span>
              </div>
            ))}
          </div>
          <div class="flex justify-center gap-12 md:gap-16">
            {techRow2.map((n) => (
              <div class={`flex flex-col items-center gap-3 ${n.float}`}>
                <img src={n.img} alt={n.label} width={80} height={80} class="w-16 h-16 md:w-20 md:h-20" />
                <span class="text-xs font-ui uppercase tracking-widest text-sd-text-muted text-center leading-tight max-w-[120px]">{n.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Section 6: Security-first approach -->
    <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
      <div class="sd-container">
        <div class="max-w-2xl mb-14" data-animate>
          <h2 class="section-title text-white mb-4">Security-first approach</h2>
          <p class="text-sd-text-muted leading-relaxed">We build with security at the core, protecting assets, systems, and operations at every stage.</p>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {securityApproach.map((item) => (
            <div class="group rounded-2xl p-7 bg-white/5 border border-white/10 transition-colors duration-300 hover:bg-sd-purple/25" data-animate>
              <p class="text-2xl font-display text-sd-purple-300 mb-4 group-hover:text-sd-purple-200 transition-colors duration-300">{item.number}</p>
              <h3 class="text-base font-display font-semibold text-white mb-3 leading-snug">{item.title}</h3>
              <p class="text-sm text-sd-text-muted leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 7: Why choose SpaceDev -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container">
        <div class="max-w-3xl mb-14" data-animate>
          <h2 class="section-title text-white">Why choose SpaceDev as your Core Banking Blockchain Integration company?</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-10">
          {whyChoose.map((item) => (
            <div class="rounded-2xl p-7 bg-white/5 border border-white/10 hover:border-sd-purple/60 transition-colors duration-300" data-animate>
              <h3 class="text-base font-display font-semibold text-white leading-snug">{item}</h3>
            </div>
          ))}
        </div>
        <p class="text-sd-text-muted leading-relaxed" data-animate>
          We don't just deliver code—we help you build <strong class="text-white font-semibold">production-grade decentralized products</strong>.
        </p>
      </div>
    </section>

    <!-- Case Studies CTA -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="sd-container flex flex-col items-start gap-6" data-animate>
        <div class="max-w-2xl">
          <h2 class="section-title text-white mb-4">Real Work, Real Results</h2>
          <p class="text-sd-text-muted leading-relaxed">
            Explore our portfolio to see the engineering behind the platforms we've shipped.
          </p>
        </div>
        <Button href="/our-work" variant="outline-light" size="lg">See Our Work</Button>
      </div>
    </section>

  </div>


</ServicePageLayout>
