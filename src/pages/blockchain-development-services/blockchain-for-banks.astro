---
import ServicePageLayout from "../../layouts/ServicePageLayout.astro";
import { banksData } from "../../data/services";
---
<ServicePageLayout data={banksData}>
  <!-- Compliance / settlement visual -->
  <section class="bg-sd-dark py-16 border-t border-white/5">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 grid gap-10 md:grid-cols-2 items-center">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-3 mb-4">Bank-grade controls</p>
        <h2 class="text-2xl md:text-3xl text-white font-display leading-tight">
          Compliance and settlement, native to the protocol.
        </h2>
        <p class="mt-4 text-sm text-sd-text-muted leading-relaxed">
          Our reference architectures combine MPC custody, on-chain KYC, travel-rule integrations, and HSM-backed signing — so regulators, auditors, and risk teams stay aligned.
        </p>
      </div>
      <img
        src="/images/content/jVjpSMjZrf5oElDSftRW9skwpaw.svg"
        alt="Compliance, custody, and settlement layers working together for regulated financial institutions."
        loading="lazy"
        class="w-full h-auto max-h-72 object-contain"
      />
    </div>
  </section>

  <!-- Reference architecture image -->
  <section class="bg-sd-dark py-16 border-t border-white/5">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 text-center">
      <img
        src="/images/content/4EnN0joO3tVJiGxfaLXZnG7Nb0.png"
        alt="Reference architecture for a regulated blockchain platform serving banks and asset managers."
        loading="lazy"
        width="1200"
        height="900"
        class="mx-auto w-full max-w-3xl h-auto rounded-2xl border border-white/10"
      />
    </div>
  </section>
</ServicePageLayout>
