---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const faqs = [
  {
    number: "01",
    question: "Do you offer free consultation?",
    answer:
      'Yes, we offer a free 30-minute consultation to understand your needs and how we can support your project. Just click <a href="/contact">Get in Touch</a> to book your call.',
  },
  {
    number: "02",
    question: "What are your rates?",
    answer:
      "We offer time & materials, fixed-scope, and dedicated-team pricing. Rates vary by role and engagement; most engagements land in the $60–120/hr range for staff augmentation, and project pricing depends on scope. We share specifics on the first call.",
  },
  {
    number: "03",
    question: "What kind of services do you offer?",
    answer:
      'Five core services: <a href="/blockchain-development-services">Blockchain Development</a>, <a href="/innovative-web-and-mobile-solutions">Web & Mobile Development</a>, <a href="/staff-augmentation">IT Staff Augmentation</a>, <a href="/product-discovery">Product Discovery</a>, and <a href="/blockaudit-smart-contract-and-blockchain-security">BlockAudit</a> (smart contract security). All under one roof, with the same team across discovery, build, and run.',
  },
  {
    number: "04",
    question: "What technologies do you work with? (Techs for Full-Stack Development)",
    answer:
      "TypeScript, React, Next.js, Node.js, Python, Go, React Native, Flutter, PostgreSQL, Redis, and the major cloud providers (AWS, GCP, Vercel). For mobile we ship both React Native and native iOS/Android.",
  },
  {
    number: "05",
    question: "Which Blockchain Tech-Stack do we use?",
    answer:
      'Solidity (EVM ecosystems including Ethereum, Polygon, Arbitrum, Base, Optimism), Rust (Solana, Aptos), and Move (Aptos, Sui). Tooling: Foundry, Hardhat, OpenZeppelin, The Graph, OpenZeppelin Defender for monitoring. See our <a href="/blockchain-development-services/smart-contract-development">smart contract development</a> page for the full process.',
  },
  {
    number: "06",
    question: "What is an MVP?",
    answer:
      'An MVP (Minimum Viable Product) is the smallest version of your product that delivers real value to a real user. It\'s not a prototype, not a demo: it\'s a shippable product designed to learn from market feedback as fast and cheaply as possible. Our <a href="/product-discovery">Product Discovery</a> engagement is where we scope an MVP before writing production code.',
  },
  {
    number: "07",
    question: "In simple words, what does the Discovery Sprint include?",
    answer:
      'A structured 1–4 week engagement where we validate the business case, define the scope, design the user experience, choose the tech stack, and produce a prioritized roadmap, all before writing production code. The output is a build-ready plan. Full breakdown on our <a href="/product-discovery">Product Discovery</a> page.',
  },
  {
    number: "08",
    question: "In simple words, what's the difference between IT Staff Augmentation vs. Consulting and Development Services.",
    answer:
      'Staff Augmentation embeds engineers into your team, processes, and codebase; you manage the work and own everything they ship. Consulting / Development Services means SpaceDev owns the project end-to-end: discovery, design, build, ship, and support. Different models for different stages of a company\'s needs. See how our <a href="/staff-augmentation">IT Staff Augmentation</a> model works.',
  },
];

const stripHtml = (html: string) => html.replace(/<[^>]+>/g, "");

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: stripHtml(item.answer) },
  })),
};

const engagementModels = [
  {
    title: "MVP Builder",
    subtitle: "Build a high-tech team for a speedy, top-tier MVP",
    tagline: "Perfect for clients needing to swiftly launch a top-quality MVP.",
    steps: [
      { number: "1", label: "Discovery Phase" },
      { number: "2", label: "Proposal Phase" },
      { number: "3", label: "MVP Build" },
      { number: "4", label: "Product Growth and Support" },
    ],
  },
  {
    title: "IT Staff Augmentation",
    subtitle: "Optimize your team with flexible IT talent support without permanent commitments.",
    tagline: "Perfect for clients needing to swiftly launch a top-quality MVP.",
    steps: [
      { number: "1", label: "Identify Your Needs" },
      { number: "2", label: "Candidate Screening Process" },
      { number: "3", label: "Welcome Aboard!" },
      { number: "4", label: "Management & Scaling" },
    ],
  },
];
---

<BaseLayout
  title="FAQs: Blockchain & Web3 Development, Common Questions"
  description="Answers to common questions about SpaceDev's blockchain and software development services, rates, processes, and how we work with clients worldwide."
  jsonLd={faqJsonLd}
>
  <!-- HERO -->
  <section class="relative overflow-hidden min-h-[80vh] flex flex-col justify-center" style="background-color: var(--sd-dark-hero);">
    <img
      src="/images/content/fO7SfBQPl5ZyUbWpE80AgCxQ9Co.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(10,6,20,0.88) 25%, rgba(50,30,90,0.45) 65%, rgba(10,6,20,0.75) 100%), linear-gradient(to bottom, rgba(10,6,20,0.2) 0%, rgba(10,6,20,0.85) 100%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-36 pb-16 md:pt-40 md:pb-20 w-full">
      <div class="max-w-3xl" data-animate>
        <h1 class="text-4xl md:text-6xl lg:text-7xl text-white font-display leading-[1.05]">
          Frequently Asked Questions!
        </h1>
        <p class="mt-6 text-lg md:text-xl text-white/70 max-w-2xl leading-relaxed">
          To simplify your life, we've crafted this straightforward FAQ page to address some of the questions you might be wondering about...
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ ACCORDION -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="divide-y divide-sd-gray-border border-t border-sd-gray-border" id="faq-list">
        {faqs.map((item) => (
          <div class="sd-faq-item" data-open="false">
            <h2 class="m-0">
              <button
                type="button"
                class="w-full flex items-start gap-6 py-8 text-left group"
                aria-expanded="false"
              >
                <span class="shrink-0 font-display text-4xl md:text-5xl text-sd-text-dark leading-none w-16">
                  {item.number}
                </span>
                <span class="flex-1 font-display text-xl md:text-2xl text-sd-text-dark leading-snug pt-1">
                  {item.question}
                </span>
                <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full border border-sd-gray-border text-sd-text-dark group-hover:border-sd-text-dark transition-colors mt-1 sd-faq-icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2 5L8 11L14 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </h2>
            <div class="sd-faq-answer overflow-hidden max-h-0 transition-all duration-300">
              <p
                class="pb-8 pl-22 text-base md:text-lg text-sd-text-gray leading-relaxed max-w-[800px] [&_a]:text-sd-purple [&_a]:underline [&_a]:hover:no-underline"
                style="padding-left: 5.5rem;"
                set:html={item.answer}
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT MODELS -->
  <section class="bg-sd-light py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <h2 class="font-display text-3xl md:text-4xl text-sd-text-dark mb-8 text-center" data-animate>
        There are two ways to work with us, pick what suits you!
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        {engagementModels.map((model) => (
          <div class="bg-white rounded-2xl p-8 md:p-10">
            <h3 class="font-display text-2xl md:text-3xl text-sd-text-dark mb-2">
              {model.title}
            </h3>
            <p class="font-body text-sd-text-gray text-sm mb-8 leading-relaxed">{model.subtitle}</p>
            <div class="space-y-0">
              {model.steps.map((step) => (
                <div class="flex items-center gap-5 py-5 border-b border-sd-gray-border last:border-b-0">
                  <span class="font-display text-3xl md:text-4xl text-sd-text-dark leading-none w-12 shrink-0">
                    {step.number}
                  </span>
                  <span class="font-display text-lg md:text-xl text-sd-text-dark">
                    {step.label}
                  </span>
                </div>
              ))}
            </div>
            <p class="font-body text-sd-text-gray text-sm mt-6 italic">{model.tagline}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STILL NOT SURE CTA -->
  <section class="relative overflow-hidden bg-[#f5f5f5]">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10 py-20 md:py-28 text-center">
      <div data-animate>
        <h2 class="text-3xl md:text-5xl lg:text-6xl text-sd-text-dark max-w-3xl mx-auto font-display">
          Still not sure which option you need?
        </h2>
        <p class="mt-6 text-base md:text-lg text-sd-text-gray max-w-2xl mx-auto leading-relaxed">
          No worries! We're here to help you find the best fit!
        </p>
        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <Button href="/contact" variant="dark" size="lg">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const items = document.querySelectorAll<HTMLElement>(".sd-faq-item");

  items.forEach((item) => {
    const btn = item.querySelector("button")!;
    const answer = item.querySelector<HTMLElement>(".sd-faq-answer")!;
    const icon = item.querySelector<HTMLElement>(".sd-faq-icon svg path")!;

    btn.addEventListener("click", () => {
      const isOpen = item.dataset.open === "true";

      // Close all others
      items.forEach((other) => {
        if (other !== item) {
          other.dataset.open = "false";
          const otherAnswer = other.querySelector<HTMLElement>(".sd-faq-answer")!;
          const otherBtn = other.querySelector("button")!;
          const otherIcon = other.querySelector<HTMLElement>(".sd-faq-icon svg path")!;
          otherAnswer.style.maxHeight = "0";
          otherBtn.setAttribute("aria-expanded", "false");
          if (otherIcon) otherIcon.setAttribute("d", "M2 5L8 11L14 5");
        }
      });

      // Toggle this one
      if (isOpen) {
        item.dataset.open = "false";
        answer.style.maxHeight = "0";
        btn.setAttribute("aria-expanded", "false");
        if (icon) icon.setAttribute("d", "M2 5L8 11L14 5");
      } else {
        item.dataset.open = "true";
        answer.style.maxHeight = answer.scrollHeight + "px";
        btn.setAttribute("aria-expanded", "true");
        if (icon) icon.setAttribute("d", "M2 11L8 5L14 11");
      }
    });
  });
</script>
