---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="404 — Lost in space | SpaceDev"
  description="The page you're looking for has drifted off into the void. Let's get you back to mission control."
  noindex
>
  <section class="relative overflow-hidden min-h-[80vh] flex items-center" style="background: var(--sd-gradient-hero);">
    <div class="absolute inset-0 opacity-30">
      <div class="absolute top-[10%] left-[15%] w-2 h-2 rounded-full bg-white animate-pulse"></div>
      <div class="absolute top-[25%] right-[20%] w-1 h-1 rounded-full bg-sd-cyan animate-pulse" style="animation-delay: 0.4s"></div>
      <div class="absolute top-[60%] left-[30%] w-1.5 h-1.5 rounded-full bg-sd-green animate-pulse" style="animation-delay: 0.8s"></div>
      <div class="absolute top-[40%] right-[35%] w-1 h-1 rounded-full bg-white animate-pulse" style="animation-delay: 1.2s"></div>
      <div class="absolute top-[80%] right-[15%] w-2 h-2 rounded-full bg-sd-purple-3 animate-pulse" style="animation-delay: 1.6s"></div>
      <div class="absolute top-[15%] right-[10%] w-1 h-1 rounded-full bg-white animate-pulse" style="animation-delay: 0.6s"></div>
    </div>
    <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 50%, transparent 0%, transparent 30%, rgba(25,20,41,0.5) 100%);"></div>

    <div class="relative mx-auto max-w-[900px] px-6 md:px-10 py-20 text-center" data-animate>
      <p class="text-[8rem] md:text-[12rem] leading-none font-display text-white tracking-tight">
        <span class="text-sd-cyan">4</span>0<span class="text-sd-green">4</span>
      </p>
      <h1 class="mt-2 text-3xl md:text-5xl text-white">Lost in space</h1>
      <p class="mt-6 text-lg text-sd-text-muted max-w-xl mx-auto leading-relaxed">
        The page you're looking for has drifted off into the void. No space-faring member of ours
        will be stranded — let's get you back to mission control.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href="/" variant="primary" size="lg">Back to home</Button>
        <Button href="/our-work" variant="outline-light" size="lg">See our work</Button>
      </div>

      <div class="mt-16 pt-8 border-t border-white/10">
        <p class="text-xs uppercase tracking-[0.2em] text-sd-text-muted mb-6">Or jump to</p>
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
          <a href="/blockchain-development-services" class="text-white hover:text-sd-cyan transition-colors">Blockchain</a>
          <a href="/innovative-web-and-mobile-solutions" class="text-white hover:text-sd-cyan transition-colors">Web & Mobile</a>
          <a href="/staff-augmentation" class="text-white hover:text-sd-cyan transition-colors">Staff Augmentation</a>
          <a href="/blog" class="text-white hover:text-sd-cyan transition-colors">Blog</a>
          <a href="/contact" class="text-white hover:text-sd-cyan transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
