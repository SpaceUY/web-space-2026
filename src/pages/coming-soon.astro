---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
---

<BaseLayout
  title="Coming Soon | SpaceDev"
  description="We're building something new. Check back soon."
  noindex
  breadcrumbs={false}
>
  <section class="bg-sd-dark relative overflow-hidden min-h-screen -mt-[72px] flex items-center">
    <!-- Same radial glow as home hero -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 62% 55%, rgba(103,58,228,0.18) 0%, transparent 65%);"></div>

    <!-- Stars / dots — all white or light gray -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-[8%]  left-[12%]  w-2   h-2   rounded-full bg-white/60  animate-pulse" style="animation-delay: 0s"></div>
      <div class="absolute top-[18%] right-[18%] w-1   h-1   rounded-full bg-white/40  animate-pulse" style="animation-delay: 0.3s"></div>
      <div class="absolute top-[28%] left-[45%]  w-1   h-1   rounded-full bg-white/30  animate-pulse" style="animation-delay: 0.7s"></div>
      <div class="absolute top-[35%] left-[8%]   w-1.5 h-1.5 rounded-full bg-white/50  animate-pulse" style="animation-delay: 1.1s"></div>
      <div class="absolute top-[42%] right-[10%] w-1   h-1   rounded-full bg-white/35  animate-pulse" style="animation-delay: 0.5s"></div>
      <div class="absolute top-[55%] left-[25%]  w-1.5 h-1.5 rounded-full bg-white/45  animate-pulse" style="animation-delay: 1.4s"></div>
      <div class="absolute top-[60%] right-[30%] w-1   h-1   rounded-full bg-white/30  animate-pulse" style="animation-delay: 0.9s"></div>
      <div class="absolute top-[70%] left-[60%]  w-2   h-2   rounded-full bg-white/55  animate-pulse" style="animation-delay: 0.2s"></div>
      <div class="absolute top-[75%] right-[12%] w-1   h-1   rounded-full bg-white/40  animate-pulse" style="animation-delay: 1.8s"></div>
      <div class="absolute top-[85%] left-[18%]  w-1.5 h-1.5 rounded-full bg-white/35  animate-pulse" style="animation-delay: 0.6s"></div>
      <div class="absolute top-[20%] left-[75%]  w-1   h-1   rounded-full bg-white/25  animate-pulse" style="animation-delay: 1.3s"></div>
      <div class="absolute top-[50%] left-[80%]  w-1.5 h-1.5 rounded-full bg-white/40  animate-pulse" style="animation-delay: 2.0s"></div>
      <div class="absolute top-[90%] right-[40%] w-1   h-1   rounded-full bg-white/30  animate-pulse" style="animation-delay: 0.4s"></div>
      <div class="absolute top-[12%] left-[55%]  w-1   h-1   rounded-full bg-white/20  animate-pulse" style="animation-delay: 1.6s"></div>
    </div>

    <div class="relative mx-auto max-w-[900px] px-6 md:px-10 py-32 text-center" data-animate>
      <h1 class="text-5xl md:text-7xl font-display text-white leading-tight tracking-tight">Coming Soon</h1>
      <p class="mt-4 text-xl text-white/60 font-display">This page is still in orbit.</p>
      <p class="mt-6 text-lg text-white/50 max-w-xl mx-auto leading-relaxed">
        Our team is building something new. Check back soon, or head back to mission control while we finish the launch.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href="/" variant="primary" size="lg">Back to home</Button>
        <Button href="/our-work" variant="outline-light" size="lg">See our work</Button>
      </div>

      <div class="mt-16 pt-8 border-t border-white/10">
        <p class="text-xs uppercase tracking-[0.2em] text-white/40 mb-6">Or jump to</p>
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
          <a href="/blockchain-development-services" class="text-white/70 font-medium hover:text-white hover:underline hover:underline-offset-4 transition-colors">Blockchain</a>
          <a href="/innovative-web-and-mobile-solutions" class="text-white/70 font-medium hover:text-white hover:underline hover:underline-offset-4 transition-colors">Web & Mobile</a>
          <a href="/staff-augmentation" class="text-white/70 font-medium hover:text-white hover:underline hover:underline-offset-4 transition-colors">Staff Augmentation</a>
          <a href="/contact" class="text-white/70 font-medium hover:text-white hover:underline hover:underline-offset-4 transition-colors">Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
