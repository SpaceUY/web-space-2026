---
import ServicePageLayout from "../layouts/ServicePageLayout.astro";
import Button from "../components/ui/Button.astro";
import { webMobileData } from "../data/services";
---

<ServicePageLayout data={{ ...webMobileData, seo: { title: "Custom Web & Mobile App Development Services | SpaceDev", description: "Custom software, web, and mobile app development engineered for scale. React, Next.js, React Native, and Python experts. Design, ship, and iterate." } }}>
  <!-- ENGINEERING WHAT USERS LOVE — right after hero -->
  <div slot="pre-process">
    <section class="bg-sd-light-2 py-20 md:py-28 border-b border-sd-gray-border">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10">
        <div class="max-w-3xl" data-animate>
          <h2 class="font-display text-3xl md:text-4xl text-sd-text-dark leading-snug mb-6">
            Engineering What Users Love
          </h2>
          <p class="text-sd-text-gray leading-relaxed mb-4">
            Building a great product is about understanding users, solving real problems, and creating intuitive
            experiences. At SpaceDev, we connect design, strategy, and engineering to drive measurable business results.
          </p>
          <p class="text-sd-text-gray leading-relaxed mb-8">
            Each project is designed around your goals. Scalability, security, and performance are ensured through
            agile processes and modern frameworks. Our teams work as an extension of yours, focusing on long-term value.
          </p>
          <Button href="https://meetings.hubspot.com/federico-sendra/web-meetings-calendar" variant="primary" external>Book a call</Button>
        </div>
      </div>
    </section>
  </div>
</ServicePageLayout>
