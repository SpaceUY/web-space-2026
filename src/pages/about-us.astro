---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedCounter from "../components/ui/AnimatedCounter.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";

// Client logos — same as homepage marquee
const clientLogos = [
  { src: "/images/clients/apple.png",         alt: "Apple",        w: 62,  h: 74,  full: false },
  { src: "/images/clients/acton_academy.png", alt: "Acton Academy",w: 118, h: 44,  full: false },
  { src: "/images/clients/microsoft.svg",     alt: "Microsoft",    w: 174, h: 174, full: true  },
  { src: "/images/clients/drata.svg",         alt: "Drata",        w: 174, h: 174, full: true  },
  { src: "/images/clients/prose.svg",         alt: "prose",        w: 174, h: 174, full: true  },
  { src: "/images/clients/ulta.svg",          alt: "ULTA Beauty",  w: 174, h: 174, full: true  },
  { src: "/images/clients/scotia.svg",        alt: "Scotiabank",   w: 174, h: 174, full: true  },
  { src: "/images/clients/utec.svg",          alt: "UTEC",         w: 174, h: 174, full: true  },
  { src: "/images/clients/samsonite.svg",     alt: "Samsonite",    w: 174, h: 174, full: true  },
  { src: "/images/clients/blockus.svg",       alt: "Blockus",      w: 174, h: 174, full: true  },
  { src: "/images/clients/ute.png",           alt: "UTE",          w: 110, h: 50,  full: false },
  { src: "/images/clients/orange.svg",        alt: "Orange",       w: 174, h: 174, full: true  },
  { src: "/images/clients/d_local.svg",       alt: "dLocal",       w: 174, h: 174, full: true  },
  { src: "/images/clients/schwarzkopf.svg",   alt: "Schwarzkopf",  w: 174, h: 174, full: true  },
  { src: "/images/clients/rarible.svg",       alt: "Rarible",      w: 133, h: 31,  full: false },
  { src: "/images/clients/ufc.svg",           alt: "UFC Strike",   w: 145, h: 22,  full: false },
];

const team = [
  {
    name: "Federico Sendra",
    role: "CEO & Co-founder",
    tag: "10+ yrs Web3 & AI",
    avatar: "/images/content/DOT9ldmLAaVJejBjOexpqu1bDjs.png",
    bio: "Tech strategist turning complexity into clarity. Helps companies grow with AI, Blockchain, and Cybersecurity. Believes great technology should always be human-first.",
    linkedin: "https://www.linkedin.com/in/federicosendra/",
  },
  {
    name: "Juan Manuel Sobral",
    role: "CTO & Co-founder",
    tag: "12+ yrs Web3 & secure systems",
    avatar: "/images/content/eHISRLFUhgnDA3fOxfapqrM7m0.jpg",
    bio: "Architects the tech, teams, and execution frameworks that unlock scale. From blockchain protocols to AI platforms, he shapes products that matter and gets them to market fast.",
    linkedin: "https://www.linkedin.com/in/jmsobral/",
  },
  {
    name: "Diego Priliac",
    role: "COO",
    tag: "Operations & culture",
    avatar: "/images/content/Ase2If5CJXH4BrNWxKF0JciqjUE.png",
    bio: "Builds the system that keeps SpaceDev human, transparent, and outcome-driven. It's how we ship memorable products globally and remain the team clients want to build with again.",
    linkedin: "https://www.linkedin.com/in/diegopriliac/",
  },
];

const howWeWork = [
  {
    n: "01",
    title: "Architecture first, code second",
    desc: "We design the system before writing a single line. Solid foundations prevent the rewrites that sink projects.",
  },
  {
    n: "02",
    title: "Security embedded, not added",
    desc: "Audits, static analysis, and threat modeling are part of every sprint, not a final checklist.",
  },
  {
    n: "03",
    title: "Rapid MVPs with production guardrails",
    desc: "We move fast without cutting corners. Every prototype is built to survive contact with real users.",
  },
  {
    n: "04",
    title: "Outcome-driven delivery",
    desc: "We measure success by your metrics, not ours. Shipping is the beginning, not the end.",
  },
];

---

<BaseLayout
  breadcrumbs={false}
  title="About Us | SpaceDev — Engineering-first Blockchain Development Partner"
  description="SpaceDev helps startups and enterprises ship secure, scalable blockchain products without costly rewrites or architectural risks. 70+ engineers, 160+ products shipped."
>

  <!-- ── HERO: phrase first → video expands on scroll ─────────────────────
       Scroll 0–50vh  : phrase fades out
       Scroll 40–100vh: video pill expands to full-bleed
  ──────────────────────────────────────────────────────────────────────── -->
  <div class="hero-scroll-track">
    <div class="hero-sticky">
      <div class="absolute top-24 left-0 right-0 z-10 mx-auto max-w-[1440px] px-6 md:px-10 pointer-events-none">
        <div class="pointer-events-auto inline-block">
          <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About Us" }]} visible={true} />
        </div>
      </div>

      <!-- Video — starts hidden as small pill, expands after phrase fades -->
      <video autoplay muted loop playsinline class="hero-video">
        <source src="/videos/hero-about.mp4" type="video/mp4" />
      </video>

      <!-- Phrase cover — dark overlay, words illuminate on scroll then fades -->
      <div class="hero-phrase-cover">
        <div class="mx-auto max-w-[1100px] px-6 md:px-10">
          <p class="text-[10px] uppercase tracking-[0.22em] text-sd-purple-300 font-ui mb-6">Why SpaceDev</p>
          <h1 id="hero-illuminate-text" class="font-display font-light text-4xl md:text-5xl lg:text-6xl leading-[1.1] max-w-4xl">
            We help startups and enterprises ship secure, scalable blockchain products without costly rewrites, delays, or architectural risks.
          </h1>
        </div>
      </div>
    </div>
  </div>

  <!-- ── PROBLEM ─────────────────────────────────────────────────────────── -->
  <section class="bg-sd-dark py-24 md:py-32">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10" data-animate>
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 font-ui mb-8">The real problem</p>
      <p class="font-display font-light text-3xl md:text-4xl lg:text-5xl text-white leading-[1.15] mb-8 max-w-3xl">
        Most blockchain projects fail not because of lack of ideas, but due to technical debt, insecure contracts, and architecture that cannot scale.
      </p>
      <p class="text-lg text-white/60 leading-relaxed max-w-2xl">
        SpaceDev was founded to eliminate those risks. We combine deep engineering discipline with real-world blockchain experience to deliver outcomes, not just code.
      </p>
    </div>
  </section>

  <!-- ── WHO WE SERVE ────────────────────────────────────────────────────── -->
  <section class="bg-[#f5f5f5] py-24 md:py-32">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple font-ui mb-8" data-animate>Who we partner with</p>
      <div class="grid gap-5 md:grid-cols-3 mb-10">
        {[
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
            title: "Founders building Web3 protocols",
            desc: "From token architecture to smart contract deployment. We help you go from whitepaper to working protocol.",
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>`,
            title: "CTOs needing secure smart contract delivery",
            desc: "You own the roadmap, we own the execution. Embedded security and audit-ready code from day one.",
          },
          {
            icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10v11M20 10v11M8 14v3m4-3v3m4-3v3"/></svg>`,
            title: "Enterprises adopting blockchain reliably",
            desc: "Integration over disruption. We bring blockchain into your stack without betting the business on it.",
          },
        ].map((card) => (
          <div class="rounded-2xl bg-white border border-sd-gray-border p-8 flex flex-col gap-5" data-animate>
            <div class="text-sd-purple w-10 h-10 flex items-center justify-center rounded-xl bg-sd-purple/8">
              <Fragment set:html={card.icon} />
            </div>
            <div>
              <h3 class="font-display font-semibold text-base text-sd-text-dark mb-2 leading-snug">{card.title}</h3>
              <p class="text-sm text-sd-text-gray leading-relaxed">{card.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <!-- Not for -->
      <p class="text-sm text-sd-text-gray border-l-2 border-sd-gray-border pl-4 max-w-xl" data-animate>
        <span class="font-semibold text-sd-text-dark">Not the right fit:</span> hobby projects without real traction or undefined token-only experimentation without a clear product path.
      </p>
    </div>
  </section>

  <!-- ── HOW WE WORK ─────────────────────────────────────────────────────── -->
  <section class="bg-sd-dark py-24 md:py-32">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 font-ui mb-3" data-animate>How we work</p>
      <h2 class="font-display font-light text-4xl md:text-5xl text-white leading-[1.1] mb-14" data-animate>
        Engineering-first. Security-validated. Outcome-driven.
      </h2>
      <div class="grid gap-8 md:grid-cols-2">
        {howWeWork.map((item) => (
          <div class="flex gap-6" data-animate>
            <span class="font-display text-4xl font-light text-white/15 leading-none shrink-0 select-none">{item.n}</span>
            <div>
              <h3 class="font-display font-semibold text-white text-base mb-2">{item.title}</h3>
              <p class="text-sm text-white/55 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PROOF: STATS ────────────────────────────────────────────────────── -->
  <section class="bg-sd-dark border-t border-white/10">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-20 md:py-24">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-6">
        <AnimatedCounter value={70}  suffix="+" label="Engineers across 5 countries" />
        <AnimatedCounter value={160} suffix="+" label="Products shipped" />
        <AnimatedCounter value={40}  suffix="+" label="Five-star Clutch reviews" />
        <AnimatedCounter value={7}   suffix="+" label="Years in the market" />
      </div>
    </div>
  </section>

  <!-- ── PROOF: TESTIMONIALS ─────────────────────────────────────────────── -->
  <section class="bg-sd-dark border-t border-white/10">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-20 md:py-24">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10" data-animate>
        <div class="flex items-center gap-3">
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg width="18" height="18" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-white font-semibold">40+ five-star reviews on Clutch</p>
        </div>
        <a
          href="https://clutch.co/profile/spacedev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-sd-purple hover:text-sd-purple-300 transition-colors"
        >
          See all reviews
          <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="grid sm:grid-cols-2 gap-5" data-animate>
        <blockquote class="bg-white/[0.04] rounded-2xl p-7 border border-white/10 flex flex-col">
          <div class="flex gap-0.5 mb-5">
            {[1,2,3,4,5].map(() => (
              <svg width="13" height="13" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-white/75 leading-relaxed italic mb-5 flex-1">
            "It's like Silicon Valley standard but in Uruguay. They are very flexible, allowing us to adjust our needs to the market conditions and business needs."
          </p>
          <footer class="text-xs text-sd-text-muted">
            <span class="text-white/60 font-medium">Executive, Blockchain Company</span><br/>
            Web3 Platform Development · San Francisco, CA · Feb 2023
          </footer>
        </blockquote>
        <blockquote class="bg-white/[0.04] rounded-2xl p-7 border border-white/10 flex flex-col">
          <div class="flex gap-0.5 mb-5">
            {[1,2,3,4,5].map(() => (
              <svg width="13" height="13" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-white/75 leading-relaxed italic mb-5 flex-1">
            "SpaceDev have vast knowledge in the area of Web3 development. They understood our requirements clearly and efficiently. The work provided by SpaceDev has been exemplary."
          </p>
          <footer class="text-xs text-sd-text-muted">
            <span class="text-white/60 font-medium">Monzoor Ullah, COO — Byrrgis</span><br/>
            Crypto Trading Platform Development · Costa Rica · Oct 2025
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ── CLIENT LOGOS MARQUEE ────────────────────────────────────────────── -->
  <section class="bg-sd-light overflow-hidden">
    <div class="sd-marquee-wrapper">
      <div class="sd-marquee">
        <div class="sd-marquee-set">
          {clientLogos.map((c) => c.full
            ? <img src={c.src} alt={c.alt} width={c.w} height={c.h} loading="eager" class="shrink-0 block" />
            : <div class="w-[174px] h-[174px] flex items-center justify-center shrink-0 bg-sd-light">
                <img src={c.src} alt={c.alt} width={c.w} height={c.h} loading="eager" class="block" />
              </div>
          )}
        </div>
        <div class="sd-marquee-set" aria-hidden="true">
          {clientLogos.map((c) => c.full
            ? <img src={c.src} alt="" width={c.w} height={c.h} loading="lazy" class="shrink-0 block" />
            : <div class="w-[174px] h-[174px] flex items-center justify-center shrink-0 bg-sd-light">
                <img src={c.src} alt="" width={c.w} height={c.h} loading="lazy" class="block" />
              </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── TEAM (unified: mosaic + leadership) ───────────────────────────── -->
  <section class="bg-[#f5f5f5]">

    <!-- Section header -->
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 pt-24 md:pt-32 pb-10" data-animate>
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple font-ui mb-4">The team</p>
      <h2 class="font-display font-light text-4xl md:text-5xl text-sd-text-dark leading-[1.1]">
        The people behind the products
      </h2>
    </div>

    <!-- Photo mosaic — 3 cols × 2 rows, same pattern as original about-us -->
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 pb-6">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {[
          { src: "/images/content/M5jQkkI9kNiJ1FOqaF68Hyqhw.jpg",          alt: "SpaceDev full team at annual retreat" },
          { src: "/images/content/9ZaBNdgUPn2Ft2zVORBykfjZRsg.jpg",         alt: "Team members at a company event" },
          { src: "/images/content/QPCMxqD1lS3XmxVU348dOJ5hlo8.jpg",         alt: "Team gathering with mate" },
          { src: "/images/content/lkdG8nylwlZilyk9wstv0caDb8g.jpg",         alt: "SpaceDev at Ethereum Argentina" },
          { src: "/images/content/WB7HgzsFFgoV0rIo7ufy14HW5fM.jpg",         alt: "Team activity outdoors" },
          { src: "/images/content/WSgg2vvLbwIDpUqEcgfpoHmXa4.jpg",          alt: "SpaceDev engineers at an event" },
        ].map((photo) => (
          <div class="rounded-2xl overflow-hidden aspect-[4/3]" data-animate>
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              width="600"
              height="450"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Founders -->
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 pt-6 pb-24 md:pb-32">
      <div class="grid gap-8 md:grid-cols-3">
        {team.map((person) => (
          <div class="rounded-2xl bg-white border border-sd-gray-border" data-animate>
            <div class="pt-8 pb-2 flex justify-center">
              <div class="w-28 h-28 rounded-full overflow-hidden ring-4 ring-sd-purple/10 shrink-0">
                <img
                  src={person.avatar}
                  alt={`${person.name}, ${person.role} at SpaceDev`}
                  loading="lazy"
                  width="112"
                  height="112"
                  class="w-full h-full object-cover"
                />
              </div>
            </div>
            <div class="p-7 pt-4 text-center">
              <p class="text-[10px] uppercase tracking-[0.18em] text-sd-purple font-ui mb-1">{person.role}</p>
              <h3 class="font-display font-semibold text-lg text-sd-text-dark mb-1">{person.name}</h3>
              <p class="text-xs text-sd-text-muted font-ui mb-4">{person.tag}</p>
              <p class="text-sm text-sd-text-gray leading-relaxed mb-5 text-left">{person.bio}</p>
              <a
                href={person.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.15em] text-sd-purple hover:text-sd-purple-2 transition-colors font-ui mx-auto"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
                LinkedIn
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── WHY WE EXIST ────────────────────────────────────────────────────── -->
  <section class="bg-sd-dark py-24 md:py-32">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10" data-animate>
      <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 font-ui mb-8">Why we exist</p>
      <blockquote class="font-display font-light text-3xl md:text-4xl lg:text-5xl text-white leading-[1.15] mb-10 max-w-4xl">
        Blockchain changed what's possible. But between the whitepaper and a working product, most teams accumulate debt, cut security corners, and build on architectures that cannot scale. SpaceDev exists to close that gap.
      </blockquote>
      <p class="text-lg text-white/60 leading-relaxed max-w-2xl mb-14">
        Blockchain products that actually work require more than ambition. They require engineering clarity, embedded security, and a partner who stays accountable to real outcomes.
      </p>
      <p class="font-display font-light text-2xl text-white mb-6">
        Ready to de-risk your blockchain initiative?
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-sd-purple text-white text-sm font-ui font-semibold hover:bg-sd-purple-2 transition-colors"
        >
          Schedule a technical discovery
        </a>
        <a
          href="/our-work"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full border border-white/25 text-white text-sm font-ui font-semibold hover:bg-white/10 transition-colors"
        >
          See our work
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero: sticky scroll-driven expand ── */
  .hero-scroll-track {
    height: 750vh;
    background: #000;
  }

  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: #000;
  }

  /* Video — JS-driven; fallback (no JS): fully visible */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 1;
    clip-path: inset(0% 0% round 0px);
    will-change: opacity, clip-path;
  }

  /* Phrase cover — JS-driven; fallback (no JS): hidden so video shows */
  .hero-phrase-cover {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: #0d0c17;
    display: flex;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    will-change: opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video        { opacity: 1 !important; clip-path: inset(0% 0% round 0px) !important; }
    .hero-phrase-cover { opacity: 0 !important; pointer-events: none !important; }
  }
</style>

<script>
  // ── Hero: illuminate phrase → then reveal video ──────────────────────────
  const phraseEl   = document.getElementById("hero-illuminate-text") as HTMLElement | null;
  const cover      = document.querySelector<HTMLElement>(".hero-phrase-cover");
  const video      = document.querySelector<HTMLElement>(".hero-video");

  if (phraseEl && cover && video && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {

    // 1. Split text into word spans, all starting dim
    const raw = phraseEl.textContent?.trim() ?? "";
    phraseEl.innerHTML = raw
      .split(/\s+/)
      .map((w) => `<span class="hw" style="color:rgba(255,255,255,0.15);transition:color 0.25s ease">${w}</span>`)
      .join(" ");
    const words = Array.from(phraseEl.querySelectorAll<HTMLElement>(".hw"));

    // 2. Show the phrase cover immediately
    cover.style.opacity = "1";
    cover.style.pointerEvents = "auto";

    // 3. Video starts hidden as a small pill
    video.style.opacity = "0";
    video.style.clipPath = "inset(40% 38% round 20px)";
    video.style.transition = "opacity 0.05s, clip-path 0.05s";

    const vh = window.innerHeight;
    // Scroll track = 750vh → max scrollY within hero ≈ 6.5 * vh
    // Timing (scroll-px from page top):
    //  illuminate : 0   → 1.6vh
    //  phrase fade: 1.6 → 2.2vh
    //  video reveal: 2.6 → 4.0vh  (video fully expanded)
    //  hold on full video: 4.0 → 6.5vh  (user "rests" on the video)
    const ILLUM_END   = vh * 1.6;
    const FADE_START  = vh * 1.6;
    const FADE_END    = vh * 2.2;
    const VID_START   = vh * 2.6;
    const VID_END     = vh * 4.0;

    function clamp(v: number, lo: number, hi: number) { return Math.max(lo, Math.min(hi, v)); }
    function norm(v: number, a: number, b: number)    { return clamp((v - a) / (b - a), 0, 1); }

    let raf = false;
    function update() {
      const sy = window.scrollY;

      // Illuminate words
      const illumProg = norm(sy, 0, ILLUM_END);
      const litCount  = Math.round(illumProg * words.length);
      words.forEach((w, i) => {
        w.style.color = i < litCount ? "#ffffff" : "rgba(255,255,255,0.15)";
      });

      // Fade phrase cover out
      const fadeProg = norm(sy, FADE_START, FADE_END);
      cover!.style.opacity = String(1 - fadeProg);
      cover!.style.pointerEvents = fadeProg > 0.5 ? "none" : "auto";

      // Video: fade in + expand pill
      const vidProg = norm(sy, VID_START, VID_END);
      video!.style.opacity = String(vidProg);
      const inset  = 40 * (1 - vidProg);
      const insetH = 38 * (1 - vidProg);
      const radius = 20 * (1 - vidProg);
      video!.style.clipPath = `inset(${inset.toFixed(1)}% ${insetH.toFixed(1)}% round ${radius.toFixed(1)}px)`;

      raf = false;
    }

    window.addEventListener("scroll", () => {
      if (!raf) { raf = true; requestAnimationFrame(update); }
    }, { passive: true });

    update(); // run once on load
  }
</script>
