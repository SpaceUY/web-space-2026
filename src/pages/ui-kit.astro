                  class="text-5xl md:text-7xl lg:text-8xl font-display font-semibold tracking-tight mr-20"
                  style="background: linear-gradient(90deg, #673ae4 0%, #44cdf3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
                >
                  Smart contract audits that protect your future. &nbsp;
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Usage notes -->
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 pb-20">
        <p class="text-xs text-sd-text-muted uppercase tracking-widest mb-5">Usage</p>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="bg-white/5 border border-white/10 rounded-xl p-5">
            <p class="text-xs text-sd-purple-300 font-mono mb-3">Footer marquee (per-page theming)</p>
            <pre class="text-xs text-sd-text-muted leading-relaxed overflow-x-auto">{`// services.ts
export const blockAuditData: ServicePageData = {
  footerMarquee: "Smart contract audits...",
  footerMarqueeTheme: "dark",  // omit = "light"
  ...
}`}</pre>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-xl p-5">
            <p class="text-xs text-sd-purple-300 font-mono mb-3">In-page marquee (optional mid-page band)</p>
            <pre class="text-xs text-sd-text-muted leading-relaxed overflow-x-auto">{`// services.ts — renders between finalCta
// and the footer; always dark bg + gradient text
export const someData: ServicePageData = {
  marqueeText: "Blockchain. Web3. DeFi.",
  ...
}`}</pre>
          </div>
        </div>
      </div>
    </section>

  </main>

  </div>{/* end sidebar + content layout */}

<style>
  /* Active nav link */
  .sd-nav-link.is-active {
    color: white;
    background: rgba(255,255,255,0.07);
  }
  .sd-nav-link.is-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 1rem;
    background: var(--sd-purple);
    border-radius: 2px;
  }
  .sd-nav-link { position: relative; }

  /* Pulsing dot to demo animation duration */
  @keyframes sd-pulse { 0%,100% { transform: scale(1); opacity:1 } 50% { transform: scale(1.8); opacity:.5 } }
  .sd-anim-dot { animation: sd-pulse var(--dur, 250ms) var(--sd-ease-smooth, ease) infinite; }

  /* Sliding bar to demo easing */
  @keyframes sd-slide { 0% { left:0 } 50% { left: calc(100% - 8px) } 100% { left:0 } }
  .sd-ease-bar { animation: sd-slide 2s var(--ease, ease) infinite; }
</style>

<script>
  // Scroll spy — highlights the nav link whose section is in view
  const links = document.querySelectorAll<HTMLAnchorElement>(".sd-nav-link");
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("section[id]")
  );

  const activate = (id: string) => {
    links.forEach(l => {
      l.classList.toggle("is-active", l.dataset.section === id);
    });
  };

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(e => {
        if (e.isIntersecting) activate(e.target.id);
      });
    },
    { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
  );

  sections.forEach(s => observer.observe(s));

  // Activate first section on load
  if (sections[0]) activate(sections[0].id);
</script>

</body>
</html>
