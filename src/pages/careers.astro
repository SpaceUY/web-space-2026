---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";

const positions = [
  { title: "Full Stack Web3 Developer", mode: "100% Remote", href: "https://spacedev.peopleforce.io/careers/v/67321-full-stack-web3-developer" },
  { title: "Backend Web3 Developer", mode: "100% Remote", href: "https://spacedev.peopleforce.io/careers/v/66894-backend-web3-developer" },
  { title: "Frontend React Web3 Developer", mode: "100% Remote", href: "https://spacedev.peopleforce.io/careers/v/66895-frontend-react-web3-developer" },
  { title: "React Native Developer", mode: "100% Remote", href: "https://spacedev.peopleforce.io/careers/v/65975-react-native-developer" },
  { title: "Blockchain Developer", mode: "100% Remote", href: "https://spacedev.peopleforce.io/careers/v/65974-blockchain-developer" },
];

const benefits = [
  { title: "Flexible vacation time", description: "You decide when it's time for a break! At Space, we offer flexible vacation scheduling to ensure a perfect work-life balance." },
  { title: "Monetary perks", description: "Space offers training and access to international certifications, promoting ongoing learning for our talent." },
  { title: "Professional mentorship", description: "At Space, new talent benefits from our mentorship program, designed to unlock their full professional potential." },
  { title: "Well-being program", description: "Excellence in your job goes beyond technical expertise; it encompasses personal well-being. At Space, we provide diverse options for holistic mind-body care." },
  { title: "100% Remote work", description: "Though we value face-to-face interactions to nurture healthy relationships, we embrace flexible schedules and remote work, enabling our team to achieve a healthy work-life balance." },
  { title: "Team building", description: "At Space, we prioritize team well-being and positive relationships. We host after-work socials, bonding events, and annual retreats in exciting locations worldwide." },
];

const peopleTeam = [
  { name: "Valentina Restrepo", role: "HR Business Partner",      linkedin: "https://www.linkedin.com/in/valentina-restrepo-duque/", avatar: "/images/content/valentina.png" },
  { name: "Victoria Perdomo",   role: "Talent & People Care",     linkedin: "https://www.linkedin.com/in/victoria-perdomo-curi/",    avatar: "/images/content/victoria.png"  },
  { name: "Florencia Suarez",   role: "People & Talent Analyst",  linkedin: "https://www.linkedin.com/in/suarezflorencia/",          avatar: "/images/content/florencia.png" },
];

const galleryPhotos = [
  { src: "/images/careers/DSC03394.jpg",          alt: "SpaceDev team" },
  { src: "/images/careers/DSC03446.jpg",          alt: "SpaceDev team" },
  { src: "/images/careers/IMG_6300.jpg",          alt: "SpaceDev team" },
  { src: "/images/careers/IMG_6732 (1).jpg",      alt: "SpaceDev team" },
  { src: "/images/careers/QPCMxqD1lS3XmxVU348dOJ5hlo8.jpg", alt: "Team members writing Post Its in a bonding activity" },
  { src: "/images/careers/K9DVq6Pi6ANOgwO60jV8cg44kdg.jpg", alt: "Team members sharing ideas during a board meeting" },
  { src: "/images/careers/6G0QRicYBjDBVHa40ePGoUGugk.png",  alt: "SpaceDev team" },
  { src: "/images/careers/UBM39geSOJEWaiFFFUAZwrnaZs.jpg",  alt: "SpaceDev team" },
];

const jobPostingsJsonLd = {
  "@context": "https://schema.org",
  "@graph": positions.map((p) => ({
    "@type": "JobPosting",
    title: p.title,
    description: `${p.title} role at SpaceDev, ${p.mode}.`,
    employmentType: "FULL_TIME",
    hiringOrganization: { "@type": "Organization", name: "SpaceDev", sameAs: "https://spacedev.io" },
    jobLocationType: "TELECOMMUTE",
    applicantLocationRequirements: { "@type": "Country", name: "Worldwide" },
  })),
};
---

<BaseLayout
  breadcrumbs={false}
  title="Careers at SpaceDev: Join our remote engineering team"
  description="Join SpaceDev, a top-5 Clutch blockchain company. Open remote roles in Web3, full-stack, and mobile engineering with global mentorship and benefits."
  jsonLd={jobPostingsJsonLd}
>
  <!-- HERO: team photo as full-height bg with dark overlay, text at bottom-left -->
  <section class="relative overflow-hidden min-h-[80vh] flex flex-col justify-center" style="background-color: var(--sd-dark-hero);">
    <img
      src="/images/content/fO7SfBQPl5ZyUbWpE80AgCxQ9Co.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(10,6,20,0.88) 25%, rgba(50,30,90,0.45) 65%, rgba(10,6,20,0.75) 100%), linear-gradient(to bottom, rgba(10,6,20,0.2) 0%, rgba(10,6,20,0.85) 100%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-28 md:pt-36 pb-16 md:pb-20 w-full">
      <div class="max-w-3xl" data-animate>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Careers" }]} visible={true} class="mb-8" />
        <h1 class="text-4xl md:text-6xl lg:text-7xl text-white font-display leading-[1.05]">
          Check out our latest IT Job Openings
        </h1>
        <p class="mt-6 text-xl md:text-2xl text-white/80 max-w-2xl leading-snug font-display font-light">
          Join the SpaceDev team and be part of something special!
        </p>
      </div>
    </div>
  </section>

  <!-- CULTURE TEXT + GALLERY -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <p class="font-body text-sd-text-dark text-2xl md:text-3xl lg:text-4xl leading-relaxed mb-14 text-center max-w-4xl mx-auto" data-animate>
        At SpaceDev, our team culture is everything. We're proud to have a talented, multidisciplinary crew,
        but above all, we value great people. If you're looking for a professional, fun, and dynamic place
        to work, SpaceDev is the place for you!
      </p>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
        {galleryPhotos.map((photo, i) => (
          <div class={`rounded-2xl overflow-hidden${i === 1 ? " row-span-2" : ""}`} data-animate>
            <img
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class={`w-full object-cover${i === 1 ? " h-full" : " h-48 md:h-64"}`}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS / PERKS -->
  <section class="bg-[#f5f5f5] py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <h2 class="font-body font-normal text-4xl md:text-5xl text-sd-text-dark mb-14" data-animate>
        SpaceDev Perks!
      </h2>
      <div class="grid gap-x-12 gap-y-12 md:grid-cols-3">
        {benefits.map((b) => (
          <div data-animate>
            <div class="flex items-baseline gap-3 mb-3">
              <span class="text-sd-text-gray text-lg leading-none shrink-0" aria-hidden="true">→</span>
              <h3 class="font-body font-normal text-2xl md:text-3xl text-sd-text-dark leading-snug">{b.title}</h3>
            </div>
            <p class="font-body text-sd-text-gray text-sm leading-relaxed">{b.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OPEN POSITIONS: grid of cards, no nested anchors -->
  <section id="open-positions" class="bg-white py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="mb-12 max-w-3xl" data-animate>
        <h2 class="text-3xl md:text-5xl text-sd-text-dark font-display">
          Seeking a new opportunity to advance your career?
        </h2>
        <p class="mt-4 text-lg md:text-xl text-sd-text-gray">
          Look no further! Explore our open positions and join us on this exciting journey.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {positions.map((p) => (
          <article
            class="flex flex-col justify-between gap-6 bg-[#f5f5f5] rounded-2xl p-6 md:p-8"
            data-animate
          >
            <div>
              <h3 class="text-lg text-sd-text-dark font-display font-semibold leading-snug mb-2">{p.title}</h3>
              <p class="text-sm text-sd-text-gray">
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-sd-purple inline-block shrink-0" aria-hidden="true"></span>
                  {p.mode}
                </span>
              </p>
            </div>
            <div>
              <Button href={p.href} variant="dark" external>Apply now</Button>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-12 text-center" data-animate>
        <Button href="https://spacedev.peopleforce.io/careers" variant="primary" size="lg" external>Explore Our Job Openings!</Button>
      </div>
    </div>
  </section>

  <!-- PEOPLE TEAM -->
  <section class="py-20 md:py-28 bg-white border-t border-sd-gray-border">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <figure data-animate>
        <blockquote class="text-2xl md:text-3xl lg:text-4xl text-sd-text-dark leading-relaxed font-body text-center max-w-4xl mx-auto mb-4">
          "As SpaceDev's People team, we're committed to maintaining a high-performance culture
          with strong human values. Join us to be part of a top-tier team where your growth,
          well-being and work-life balance are prioritized. Apply now!"
        </blockquote>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-text-muted font-ui text-center mb-10">People team</p>
        <figcaption class="flex flex-wrap justify-center gap-10">
          {peopleTeam.map((person) => (
            <a
              href={person.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center gap-3 hover:opacity-80 transition-opacity"
            >
              <div class="w-16 h-16 rounded-full overflow-hidden ring-2 ring-sd-gray-border shrink-0">
                <img
                  src={person.avatar}
                  alt={person.name}
                  loading="lazy"
                  width="64"
                  height="64"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="text-center">
                <p class="text-sd-text-dark font-display font-medium text-sm">{person.name}</p>
                <p class="text-sd-text-muted text-xs mt-0.5">{person.role}</p>
              </div>
            </a>
          ))}
        </figcaption>
      </figure>
    </div>
  </section>

</BaseLayout>
