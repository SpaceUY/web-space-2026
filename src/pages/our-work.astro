---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/ui/CaseStudyCard.astro";
import CTA from "../components/ui/CTA.astro";
import { caseStudies } from "../data/case-studies";

// Pull featured case studies from content collection (rich data: metrics, clutch, hero)
const allEntries = await getCollection("case-studies");
const featuredSlugs = ["rarible", "drata", "ndax-canada", "blockus"];
const featuredEntries = featuredSlugs
  .map((slug) => allEntries.find((e) => e.id === slug))
  .filter((e): e is NonNullable<typeof e> => !!e);

// Grid: the 16 remaining entries from the static data list
const gridStudies = caseStudies.filter((c) => !featuredSlugs.includes(c.slug));

const filters = [
  { label: "All", value: "all" },
  { label: "Web2", value: "Web2" },
  { label: "Web3", value: "Web3" },
];

const accentGradients: Record<string, string> = {
  purple: "from-sd-purple to-sd-purple-2",
  cyan:   "from-sd-purple-300 to-sd-purple",
  green:  "from-sd-green to-sd-purple-300",
  mixed:  "from-sd-purple via-sd-purple-400 to-sd-green",
};
---

<BaseLayout
  title="Our Work | SpaceDev — Selected case studies in Web3 and SaaS"
  description="Explore 20+ case studies from SpaceDev: blockchain platforms, NFT marketplaces, fintech, gaming, and enterprise SaaS shipped with our clients."
>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-24 md:py-36">
      <div class="max-w-4xl" data-animate>
        <h1 class="text-5xl md:text-7xl lg:text-8xl text-white font-display font-semibold leading-[1.0]">
          Explore some of our<br />amazing success stories!
        </h1>
        <p class="mt-8 text-lg md:text-xl text-sd-text-muted max-w-2xl leading-relaxed">
          Find inspiration and take your business to the next level.
        </p>
      </div>
    </div>
  </section>

  <!-- SUPPORTING TEXT -->
  <section class="bg-[#141414] py-20 md:py-28">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10" data-animate>
      <p class="font-display font-semibold text-2xl md:text-3xl lg:text-4xl text-white leading-snug">
        We are here to support you every step of the way, whether you are seeking to disrupt your industry or stay ahead of the competition. By leveraging our up-to-date expertise,
        <span class="text-sd-text-muted"> you can turn your vision into a reality and reach new heights.</span>
      </p>
    </div>
  </section>

  <!-- ─── FEATURED CASE STUDIES ─── -->
  <section class="bg-sd-dark py-20 md:py-32 border-t border-white/5">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">

      <!-- Section heading -->
      <div class="mb-16 md:mb-24" data-animate>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-purple mb-3">Selected Work</p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl text-white font-display font-semibold leading-tight max-w-xl">
          Our most impactful partnerships
        </h2>
      </div>

      <!-- Editorial rows -->
      <div class="space-y-28 md:space-y-36">
        {featuredEntries.map((entry, idx) => {
          const gradient = accentGradients[entry.data.accent ?? "purple"];
          const isReversed = idx % 2 === 1;
          return (
            <article class="grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-16 items-center" data-animate>

              <!-- Image -->
              <div class={`relative rounded-2xl overflow-hidden${isReversed ? " sm:order-2" : ""}`}>
                {entry.data.heroImage ? (
                  <img
                    src={entry.data.heroImage}
                    alt={`${entry.data.name} — featured visual`}
                    loading="lazy"
                    class="w-full aspect-[16/10] object-cover block"
                  />
                ) : (
                  <div class={`w-full aspect-[16/10] bg-gradient-to-br ${gradient}`}></div>
                )}
                {/* Category badge */}
                <span class="absolute top-4 left-4 inline-flex items-center px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-md text-[10px] uppercase tracking-wider text-white border border-white/20">
                  {entry.data.category}
                </span>
              </div>

              <!-- Content -->
              <div class={isReversed ? "sm:order-1" : ""}>
                {entry.data.industry && (
                  <p class="text-xs uppercase tracking-[0.15em] text-sd-text-muted mb-4">{entry.data.industry}</p>
                )}
                <h3 class="text-3xl md:text-4xl lg:text-5xl text-white font-display font-semibold leading-tight mb-4">
                  {entry.data.name}
                </h3>
                <p class="text-lg text-sd-text-muted leading-relaxed mb-6">
                  {entry.data.tagline}
                </p>
                {entry.data.summary && (
                  <p class="text-sm text-white/55 leading-relaxed mb-8 line-clamp-3">
                    {entry.data.summary}
                  </p>
                )}

                {/* Metrics mini-band */}
                {entry.data.metrics && entry.data.metrics.length > 0 && (
                  <div class="grid grid-cols-2 gap-x-6 gap-y-4 py-6 border-t border-white/10 mb-8">
                    {entry.data.metrics.slice(0, 4).map((m) => (
                      <div>
                        <p class="text-xl md:text-2xl font-display font-semibold text-white">{m.value}</p>
                        <p class="text-xs text-sd-text-muted mt-0.5">{m.label}</p>
                      </div>
                    ))}
                  </div>
                )}

                <a
                  href={`/case-study/${entry.id}`}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-sd-purple hover:text-sd-purple-300 transition-colors group"
                >
                  Read case study
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="group-hover:translate-x-1 transition-transform">
                    <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ─── CLUTCH SOCIAL PROOF ─── -->
  <section class="bg-[#0d0d10] border-t border-white/5 py-16 md:py-20">
    <div class="mx-auto max-w-[1200px] px-6 md:px-10">
      <!-- Header row -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-10" data-animate>
        <div class="flex items-center gap-3">
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg width="18" height="18" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-white font-semibold">40+ five-star reviews</p>
        </div>
        <a
          href="https://clutch.co/profile/spacedev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-sd-purple hover:text-sd-purple-300 font-semibold transition-colors"
        >
          See all reviews on Clutch
          <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Two quotes -->
      <div class="grid sm:grid-cols-2 gap-5" data-animate>
        <blockquote class="bg-white/[0.03] rounded-2xl p-7 border border-white/10">
          <div class="flex gap-0.5 mb-5">
            {[1,2,3,4,5].map(() => (
              <svg width="14" height="14" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-white/75 leading-relaxed italic mb-5">
            "SpaceDev delivered exceptional work consistently. Their deep technical expertise and communication made them feel like a true extension of our team."
          </p>
          <footer class="text-xs text-sd-text-muted">— Verified Clutch Review</footer>
        </blockquote>
        <blockquote class="bg-white/[0.03] rounded-2xl p-7 border border-white/10">
          <div class="flex gap-0.5 mb-5">
            {[1,2,3,4,5].map(() => (
              <svg width="14" height="14" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-sm text-white/75 leading-relaxed italic mb-5">
            "From discovery to delivery, SpaceDev brought structure and senior talent to every stage. We launched on time, within scope, and the code quality was exceptional."
          </p>
          <footer class="text-xs text-sd-text-muted">— Verified Clutch Review</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ─── MORE CASE STUDIES (filtered grid) ─── -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="mb-10" data-animate>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-purple mb-3">All Projects</p>
        <h2 class="font-display font-semibold text-3xl md:text-4xl lg:text-5xl text-sd-text-dark leading-tight">
          More success stories
        </h2>
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-10" role="tablist" aria-label="Filter case studies">
        {filters.map((f, i) => (
          <button
            type="button"
            class={`sd-filter-btn px-5 py-2 rounded-full text-sm border transition-colors ${i === 0 ? "bg-sd-text-dark border-sd-text-dark text-white" : "border-sd-gray-border text-sd-text-gray hover:text-sd-text-dark hover:border-sd-text-dark"}`}
            data-filter={f.value}
            role="tab"
            aria-selected={i === 0}
          >
            {f.label}
          </button>
        ))}
      </div>

      <div id="sd-case-grid" class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
        {gridStudies.map((c) => (
          <CaseStudyCard caseStudy={c} />
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Have a project in mind?"
    description="From a one-week discovery sprint to a multi-year partnership — let's see how we can help."
    buttons={[
      { label: "Start a project", href: "/contact" },
      { label: "Book a call", href: "https://meetings.hubspot.com/federico-sendra/meet-space", variant: "outline-light", external: true },
    ]}
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".sd-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>("#sd-case-grid > [data-category]");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-selected", String(active));
        b.classList.toggle("bg-sd-text-dark", active);
        b.classList.toggle("border-sd-text-dark", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("border-sd-gray-border", !active);
        b.classList.toggle("text-sd-text-gray", !active);
      });

      cards.forEach((card) => {
        const category = card.dataset.category;
        const show = filter === "all" || category === filter;
        card.style.display = show ? "" : "none";
      });
    });
  });
</script>
