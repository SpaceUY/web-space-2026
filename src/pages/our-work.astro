---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/ui/CaseStudyCard.astro";
import AnimatedCounter from "../components/ui/AnimatedCounter.astro";
import CTA from "../components/ui/CTA.astro";
import { caseStudies } from "../data/case-studies";

const industries = ["DeFi & Crypto", "NFT & Gaming", "SaaS & Products", "AI & Data", "Enterprise"] as const;

const filters = [
  { label: "All",            value: "all",            count: caseStudies.length },
  ...industries.map((ind) => ({
    label: ind,
    value: ind,
    count: caseStudies.filter((c) => c.industry === ind).length,
  })),
];

const logoStrip = [
  "Rarible", "Drata", "NDAX", "Blockus", "FightFI",
  "ApeBond", "Mostaza", "AthleteAI", "Bondi Finance", "Gallery",
];
---

<BaseLayout
  title="Our Work | SpaceDev — Selected case studies in Web3 and SaaS"
  description="Explore 20+ case studies from SpaceDev: blockchain platforms, NFT marketplaces, fintech, gaming, and enterprise SaaS shipped with our clients."
>

  <!-- ── HERO ── -->
  <section class="relative overflow-hidden bg-[#0d0c17] min-h-[68vh] flex items-end">

    <!-- Ambient glow — upper-center soft blob -->
    <div
      class="absolute top-[-10%] left-1/2 -translate-x-1/3 w-[900px] h-[560px] rounded-full pointer-events-none"
      style="background: radial-gradient(ellipse at center, rgba(103,58,228,0.28) 0%, rgba(74,57,124,0.12) 45%, transparent 72%);"
      aria-hidden="true"
    ></div>

    <div class="relative w-full mx-auto max-w-[1440px] px-6 md:px-10 pt-28 md:pt-36 pb-20 md:pb-28">

      <!-- Breadcrumb pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/15 bg-white/[0.05] text-[11px] text-white/50 tracking-[0.18em] uppercase mb-10 select-none">
        Home <span class="text-white/25 font-light">/</span> Our Work
      </div>

      <div class="max-w-4xl" data-animate>
        <h1 class="text-4xl md:text-6xl lg:text-7xl text-white font-display leading-[1.05]">
          Explore some of our amazing success stories!
        </h1>
        <p class="mt-8 text-lg md:text-xl text-sd-text-muted max-w-2xl leading-relaxed">
          Find inspiration and take your business to the next level.
        </p>
      </div>

    </div>
  </section>

  <!-- ── QUOTE + STATS + CLUTCH (dark authority block) ── -->
  <section class="bg-sd-dark">

    <!-- Big quote -->
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-20 md:py-28" data-animate>
      <p class="font-display font-semibold text-2xl md:text-3xl lg:text-4xl text-white leading-snug">
        We are here to support you every step of the way, whether you are seeking to disrupt your industry or stay ahead of the competition. By leveraging our up-to-date expertise,
        <span class="text-sd-text-muted"> you can turn your vision into a reality and reach new heights.</span>
      </p>
    </div>

    <!-- Stats strip -->
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-16 md:py-20">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-6">
          <AnimatedCounter value={160} suffix="+" label="Projects delivered" />
          <AnimatedCounter value={40}  suffix="+" label="Clutch reviews"     />
          <AnimatedCounter value={5}   suffix=".0" prefix="" label="Average Clutch rating ★★★★★" />
          <AnimatedCounter value={7}   suffix="+"  label="Years in the market" />
        </div>
      </div>
    </div>

    <!-- Clutch social proof -->
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-16 md:py-20">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10" data-animate>
          <div class="flex items-center gap-3">
            <div class="flex gap-0.5">
              {[1,2,3,4,5].map(() => (
                <svg width="18" height="18" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-white font-semibold">40+ five-star reviews on Clutch</p>
          </div>
          <a
            href="https://clutch.co/profile/spacedev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-sd-purple hover:text-sd-purple-300 transition-colors"
          >
            See all reviews
            <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <div class="grid sm:grid-cols-2 gap-5" data-animate>
          <blockquote class="bg-white/[0.04] rounded-2xl p-7 border border-white/10">
            <div class="flex gap-0.5 mb-5">
              {[1,2,3,4,5].map(() => (
                <svg width="13" height="13" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-sm text-white/75 leading-relaxed italic mb-5">
              "SpaceDev delivered exceptional work consistently. Their deep technical expertise and communication made them feel like a true extension of our team."
            </p>
            <footer class="text-xs text-sd-text-muted">— Verified Clutch Review</footer>
          </blockquote>

          <blockquote class="bg-white/[0.04] rounded-2xl p-7 border border-white/10">
            <div class="flex gap-0.5 mb-5">
              {[1,2,3,4,5].map(() => (
                <svg width="13" height="13" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-sm text-white/75 leading-relaxed italic mb-5">
              "From discovery to delivery, SpaceDev brought structure and senior talent to every stage. We launched on time, within scope, and the code quality was exceptional."
            </p>
            <footer class="text-xs text-sd-text-muted">— Verified Clutch Review</footer>
          </blockquote>
        </div>
      </div>
    </div>

  </section>

  <!-- ── CASE STUDIES (light, cards breathe) ── -->
  <section class="bg-sd-light-2 py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">

      <!-- Heading -->
      <div class="mb-10" data-animate>
        <p class="text-xs uppercase tracking-[0.2em] text-sd-purple mb-3">Case Studies</p>
        <h2 class="font-display font-semibold text-4xl md:text-5xl lg:text-6xl text-sd-text-dark leading-[1.1]">
          Our work
        </h2>
      </div>

      <!-- Client logo strip -->
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mb-12 pb-12 border-b border-sd-gray-border" data-animate>
        <span class="text-xs uppercase tracking-[0.18em] text-sd-text-gray shrink-0">Featured clients</span>
        {logoStrip.map((name) => (
          <span class="text-sm font-semibold text-sd-text-gray/60 hover:text-sd-text-dark transition-colors cursor-default">
            {name}
          </span>
        ))}
      </div>

      <!-- Filter bar with counts -->
      <div class="flex flex-wrap items-center gap-2 mb-12" role="tablist" aria-label="Filter case studies">
        {filters.map((f, i) => (
          <button
            type="button"
            class={`sd-filter-btn inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm border transition-all ${
              i === 0
                ? "bg-sd-text-dark border-sd-text-dark text-white"
                : "border-sd-gray-border text-sd-text-gray hover:text-sd-text-dark hover:border-sd-text-dark bg-white"
            }`}
            data-filter={f.value}
            role="tab"
            aria-selected={i === 0}
          >
            {f.label}
            <span class={`text-[11px] px-1.5 py-0.5 rounded-full ${
              i === 0 ? "bg-white/20 text-white" : "bg-sd-light-2 text-sd-text-gray"
            }`}>
              {f.count}
            </span>
          </button>
        ))}

        <span id="sd-count" class="ml-auto text-sm text-sd-text-gray hidden sm:block">
          {caseStudies.length} projects
        </span>
      </div>

      <!-- Mixed rhythm grid — 1 featured (full-width) + 3 small, repeating -->
      <div id="sd-case-grid" class="grid gap-10 grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
        {caseStudies.map((c, idx) => (
          <>
            {/* Mid-page CTA — injected before the 4th group (index 12) */}
            {idx === 12 && (
              <div class="sm:col-span-2 md:col-span-3 rounded-xl overflow-hidden" style="background: var(--sd-purple-deep);">
                <div class="px-8 py-12 md:px-14 md:py-16 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-8">
                  <div class="max-w-xl">
                    <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 mb-3">Ready to be next?</p>
                    <h3 class="text-2xl md:text-3xl lg:text-4xl text-white font-display font-semibold leading-tight mb-4">
                      You've seen what we build.<br />Let's talk about what you need.
                    </h3>
                    <p class="text-sd-text-muted text-sm md:text-base leading-relaxed">
                      From a one-week discovery sprint to a multi-year engineering partnership — we'll find the fastest path to your goals.
                    </p>
                  </div>
                  <div class="flex flex-col sm:flex-row gap-3 shrink-0">
                    <a
                      href="/contact"
                      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-sd-purple text-white text-sm font-semibold hover:bg-sd-purple-2 transition-colors"
                    >
                      Start a project
                    </a>
                    <a
                      href="https://meetings.hubspot.com/federico-sendra/meet-space"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-white/25 text-white text-sm font-semibold hover:bg-white/10 transition-colors"
                    >
                      Book a call
                    </a>
                  </div>
                </div>
              </div>
            )}
            <CaseStudyCard caseStudy={c} featured={idx % 4 === 0} />
          </>
        ))}
      </div>

    </div>
  </section>

  <CTA
    title="Have a project in mind?"
    description="From a one-week discovery sprint to a multi-year partnership — let's see how we can help."
    buttons={[
      { label: "Start a project", href: "/contact" },
      { label: "Book a call", href: "https://meetings.hubspot.com/federico-sendra/meet-space", variant: "outline-light", external: true },
    ]}
  />

</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".sd-filter-btn");
  const cards   = document.querySelectorAll<HTMLElement>("#sd-case-grid > [data-category]");
  const countEl = document.getElementById("sd-count");

  function updateCount(filter: string) {
    if (!countEl) return;
    const n = filter === "all"
      ? cards.length
      : [...cards].filter((c) => c.dataset.category === filter).length;
    countEl.textContent = `${n} project${n !== 1 ? "s" : ""}`;
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-selected", String(active));
        b.classList.toggle("bg-sd-text-dark",       active);
        b.classList.toggle("border-sd-text-dark",   active);
        b.classList.toggle("text-white",            active);
        b.classList.toggle("bg-white",             !active);
        b.classList.toggle("border-sd-gray-border",!active);
        b.classList.toggle("text-sd-text-gray",    !active);
        // Update the count badge inside each button
        const badge = b.querySelector("span");
        if (badge) {
          badge.className = active
            ? "text-[11px] px-1.5 py-0.5 rounded-full bg-white/20 text-white"
            : "text-[11px] px-1.5 py-0.5 rounded-full bg-sd-light-2 text-sd-text-gray";
        }
      });

      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.style.display = show ? "" : "none";
      });

      updateCount(filter);
    });
  });
</script>
