---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseStudyCard from "../components/ui/CaseStudyCard.astro";
import CTA from "../components/ui/CTA.astro";
import { caseStudies } from "../data/case-studies";

const filters = [
  { label: "All", value: "all" },
  { label: "Web2", value: "Web2" },
  { label: "Web3", value: "Web3" },
];
---

<BaseLayout
  title="Our Work | SpaceDev — Selected case studies in Web3 and SaaS"
  description="Explore 20+ case studies from SpaceDev: blockchain platforms, NFT marketplaces, fintech, gaming, and enterprise SaaS shipped with our clients."
>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-24 md:py-36">
      <div class="max-w-4xl" data-animate>
        <h1 class="text-5xl md:text-7xl lg:text-8xl text-white font-display font-semibold leading-[1.0]">
          Explore some of our<br />amazing success stories!
        </h1>
        <p class="mt-8 text-lg md:text-xl text-sd-text-muted max-w-2xl leading-relaxed">
          Find inspiration and take your business to the next level.
        </p>
      </div>
    </div>
  </section>

  <!-- SUPPORTING TEXT -->
  <section class="bg-[#141414] py-20 md:py-28">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10" data-animate>
      <p class="font-display font-semibold text-2xl md:text-3xl lg:text-4xl text-white leading-snug">
        We are here to support you every step of the way, whether you are seeking to disrupt your industry or stay ahead of the competition. By leveraging our up-to-date expertise,
        <span class="text-sd-text-muted"> you can turn your vision into a reality and reach new heights.</span>
      </p>
    </div>
  </section>

  <!-- ── CASE STUDIES ── -->
  <section class="bg-white py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">

      <!-- Section heading + Clutch inline badge -->
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10" data-animate>
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-sd-purple mb-3">Case Studies</p>
          <h2 class="font-display font-semibold text-4xl md:text-5xl lg:text-6xl text-sd-text-dark leading-[1.1]">
            Our work
          </h2>
        </div>

        <!-- Compact Clutch badge -->
        <a
          href="https://clutch.co/profile/spacedev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-4 py-3 rounded-xl bg-sd-light-2 border border-sd-gray-border hover:border-sd-purple/40 transition-colors group self-start sm:self-auto"
          aria-label="SpaceDev on Clutch — 40+ five-star reviews"
        >
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg width="14" height="14" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="text-xs text-sd-text-gray group-hover:text-sd-text-dark transition-colors">
            40+ reviews on <strong class="text-sd-text-dark">Clutch</strong>
          </span>
          <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true" class="text-sd-text-gray group-hover:text-sd-purple transition-colors">
            <path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Filter bar -->
      <div class="flex flex-wrap items-center gap-2 mb-10" role="tablist" aria-label="Filter case studies">
        {filters.map((f, i) => (
          <button
            type="button"
            class={`sd-filter-btn inline-flex items-center px-4 py-2 rounded-full text-sm border transition-colors ${
              i === 0
                ? "bg-sd-text-dark border-sd-text-dark text-white"
                : "border-sd-gray-border text-sd-text-gray hover:text-sd-text-dark hover:border-sd-text-dark bg-white"
            }`}
            data-filter={f.value}
            role="tab"
            aria-selected={i === 0}
          >
            {f.label}
          </button>
        ))}

        <!-- Count indicator -->
        <span id="sd-count" class="ml-auto text-sm text-sd-text-gray">
          {caseStudies.length} projects
        </span>
      </div>

      <!-- Mixed rhythm grid: every 4th card is full-width (1 big + 3 small) -->
      <div id="sd-case-grid" class="grid gap-5 sm:grid-cols-3">
        {caseStudies.map((c, idx) => (
          <CaseStudyCard caseStudy={c} featured={idx % 4 === 0} />
        ))}
      </div>

    </div>
  </section>

  <CTA
    title="Have a project in mind?"
    description="From a one-week discovery sprint to a multi-year partnership — let's see how we can help."
    buttons={[
      { label: "Start a project", href: "/contact" },
      { label: "Book a call", href: "https://meetings.hubspot.com/federico-sendra/meet-space", variant: "outline-light", external: true },
    ]}
  />
</BaseLayout>

<script>
  const buttons  = document.querySelectorAll<HTMLButtonElement>(".sd-filter-btn");
  const cards    = document.querySelectorAll<HTMLElement>("#sd-case-grid > [data-category]");
  const countEl  = document.getElementById("sd-count");

  function updateCount(filter: string) {
    if (!countEl) return;
    const visible = filter === "all"
      ? cards.length
      : [...cards].filter((c) => c.dataset.category === filter).length;
    countEl.textContent = `${visible} project${visible !== 1 ? "s" : ""}`;
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-selected", String(active));
        b.classList.toggle("bg-sd-text-dark",       active);
        b.classList.toggle("border-sd-text-dark",   active);
        b.classList.toggle("text-white",            active);
        b.classList.toggle("bg-white",              !active);
        b.classList.toggle("border-sd-gray-border", !active);
        b.classList.toggle("text-sd-text-gray",     !active);
      });

      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.style.display = show ? "" : "none";
      });

      updateCount(filter);
    });
  });
</script>
