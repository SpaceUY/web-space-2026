---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import Button from "../../components/ui/Button.astro";
import { mediaItems } from "../../data/media-items";
import { SITE } from "../../lib/seo";

export function getStaticPaths() {
  return mediaItems.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });

// Render body: bold, italic, blockquotes, bullet lists
function renderBody(text: string): string {
  return text
    .split("\n\n")
    .map((para) => {
      const inline = (s: string) =>
        s.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>").replace(/\*(.*?)\*/g, "<em>$1</em>");

      if (para.startsWith("> ")) {
        return `<blockquote class="border-l-4 border-sd-purple pl-6 my-8 text-sd-text-gray italic text-xl leading-relaxed">${inline(para.slice(2))}</blockquote>`;
      }
      if (para.startsWith("- ") || para.includes("\n- ")) {
        const listItems = para
          .split("\n")
          .filter((l) => l.startsWith("- "))
          .map((l) => `<li>${inline(l.slice(2))}</li>`)
          .join("");
        return `<ul class="list-disc pl-6 my-5 space-y-2 text-sd-text-gray">${listItems}</ul>`;
      }
      return `<p class="mb-5">${inline(para)}</p>`;
    })
    .join("");
}

// Split body into sections for interleaving images
// Images are inserted after paragraph 1 (for 2 imgs) or after paragraphs 1 and 3 (for 3-4 imgs)
const paragraphs = item.body.split("\n\n").filter(Boolean);
const imgs = item.bodyImages ?? [];

// Build content blocks for interleaving text and images
interface Block { text?: string; images?: string[] }
const blocks: Block[] = [];

if (imgs.length === 0) {
  blocks.push({ text: paragraphs.join("\n\n") });
} else if (imgs.length <= 2) {
  blocks.push({ text: paragraphs.slice(0, 1).join("\n\n") });
  blocks.push({ images: imgs });
  blocks.push({ text: paragraphs.slice(1).join("\n\n") });
} else {
  // 3-4 images: split into two image groups
  const mid = Math.ceil(paragraphs.length / 2);
  blocks.push({ text: paragraphs.slice(0, 1).join("\n\n") });
  blocks.push({ images: imgs.slice(0, 2) });
  blocks.push({ text: paragraphs.slice(1, mid).join("\n\n") });
  blocks.push({ images: imgs.slice(2) });
  blocks.push({ text: paragraphs.slice(mid).join("\n\n") });
}

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: item.title,
  image: `${SITE.url}${item.image}`,
  datePublished: item.date.toISOString(),
  author: { "@type": "Organization", name: SITE.name, url: SITE.url },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/spacedev-in-the-media/${item.slug}` },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Space in the Media", item: `${SITE.url}/spacedev-in-the-media` },
    { "@type": "ListItem", position: 3, name: item.title, item: `${SITE.url}/spacedev-in-the-media/${item.slug}` },
  ],
};
---

<BaseLayout
  breadcrumbs={false}
  title={`${item.title} — SpaceDev in the Media`}
  description={item.highlight}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <!-- HERO: text left + image right -->
  <section class="relative overflow-hidden" style="background-color: var(--sd-dark-hero);">
    <div class="absolute inset-0" style="background: linear-gradient(135deg, #191429 0%, #312652 100%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-28 md:pt-36 pb-12 md:pb-16 w-full">
      <div class="grid md:grid-cols-[1fr_420px] lg:grid-cols-[1fr_520px] gap-10 md:gap-16 items-center">

        <!-- LEFT: meta + title -->
        <div data-animate>
          <Breadcrumbs
            items={[
              { label: "Home", href: "/" },
              { label: "Space in the Media", href: "/spacedev-in-the-media" },
              { label: item.title },
            ]}
            visible={true}
            class="mb-6"
          />
          <div class="flex flex-wrap gap-2 mb-5">
            {item.tags.map((tag) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] uppercase tracking-wider font-ui bg-white/10 text-white/80 border border-white/15">
                {tag}
              </span>
            ))}
          </div>
          <h1 class="text-3xl md:text-5xl text-white font-display leading-tight mb-5">
            {item.title}
          </h1>
          <p class="text-sm text-white/50 font-body">
            <time datetime={item.date.toISOString()}>{dateFmt.format(item.date)}</time>
            <span class="mx-2" aria-hidden="true">·</span>
            {item.location}
          </p>
        </div>

        <!-- RIGHT: cover image -->
        <div class="hidden md:block rounded-2xl overflow-hidden shadow-2xl aspect-[4/3]" data-animate>
          <img
            src={item.image}
            alt={item.title}
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ARTICLE BODY -->
  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="max-w-[820px] font-body text-base md:text-lg text-sd-text-gray leading-relaxed">
        {blocks.map((block) => block.images ? (
          <div class={`my-10 grid gap-4 ${block.images.length === 1 ? "grid-cols-1" : "grid-cols-2"}`}>
            {block.images.map((src) => (
              <div class="rounded-2xl overflow-hidden bg-sd-light-2">
                <img
                  src={src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto object-cover"
                />
              </div>
            ))}
          </div>
        ) : (
          <div set:html={renderBody(block.text ?? "")} />
        ))}
      </div>
    </div>
  </section>

  <!-- BACK + CTA -->
  <section class="bg-sd-light py-12 md:py-16 border-t border-sd-gray-border">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-6">
      <Button href="/spacedev-in-the-media" variant="secondary">← Back to Space in the Media</Button>
      <div class="text-center md:text-right">
        <p class="text-sm text-sd-text-gray font-body mb-3">Want SpaceDev at your next event?</p>
        <Button href="mailto:marketing@spacedev.io" variant="primary">Contact us</Button>
      </div>
    </div>
  </section>
</BaseLayout>
