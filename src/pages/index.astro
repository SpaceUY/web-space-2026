<script>
  import { initScrollAnimations } from "../lib/animations";
  document.addEventListener("DOMContentLoaded", initScrollAnimations);

  // Rotating word — slide up from below
  const words = ["Fast", "Flexible", "Reliable"];
  let idx = 0;
  const el = document.getElementById("rotating-word");
  if (el) {
    const node = el;
    const SLIDE = "cubic-bezier(0.2, 0.7, 0.3, 1)";

    function nextWord() {
      idx = (idx + 1) % words.length;
      node.style.transition = `transform 0.28s ${SLIDE}, opacity 0.2s ease`;
      node.style.transform  = "translateY(-110%)";
      node.style.opacity    = "0";

      setTimeout(() => {
        node.textContent      = words[idx];
        node.style.transition = "none";
        node.style.transform  = "translateY(110%)";
        node.style.opacity    = "0";

        requestAnimationFrame(() => requestAnimationFrame(() => {
          node.style.transition = `transform 0.32s ${SLIDE}, opacity 0.22s ease`;
          node.style.transform  = "translateY(0)";
          node.style.opacity    = "1";
        }));
      }, 290);
    }

    setInterval(nextWord, 2400);
  }


</script>
