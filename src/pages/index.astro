---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/ui/FAQ.astro";
import QuoteReveal from "../components/ui/QuoteReveal.astro";
import CaseStudyCard from "../components/ui/CaseStudyCard.astro";
import AuthorAvatar from "../components/ui/AuthorAvatar.astro";
import { homeFaqs } from "../data/site-content";
import {
  clientLogosWhite,
  homeAwards,
  homeCommunities,
  homeEngagementModels,
  homeIndustries,
  homeReasons,
  homeServices,
  homeTakeaways,
  homeTestimonials,
} from "../data/home";
import { featuredCaseStudies } from "../data/case-studies";
import { getAuthor } from "../data/authors";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const accentByCategory: Record<string, string> = {
  "Blockchain Trends": "from-sd-purple to-sd-purple-2",
  "Web2 Trends": "from-sd-purple-300 to-sd-purple",
  "Product Development": "from-sd-green to-sd-purple-300",
  "AI": "from-sd-purple-300 to-sd-purple-300",
  "Augmented Reality": "from-sd-purple-300 to-sd-green",
  "Techy Trends": "from-sd-purple to-sd-purple-300",
};

---

<BaseLayout
  title="SpaceDev | Blockchain Development Company & Web3 Experts"
  description="Blockchain development company building Web3, web, and mobile products, with nearshore IT staff augmentation from LATAM. Let's build your product."
>
  <!-- HERO (dark) -->
  <!-- Stops short of the full viewport so the next section peeks and invites scrolling
       (NN/g: avoid full-screen hero content). Bottom-aligned on mobile to avoid dead
       space above the title, centred from 1000px where there's more room. -->
  <section class="bg-sd-dark min-h-[84vh] min-h-[84dvh] sm:min-h-[92vh] sm:min-h-[92dvh] -mt-[72px] pt-[160px] flex flex-col justify-end sm:justify-center items-start relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 62% 55%, rgba(103,58,228,0.18) 0%, transparent 65%);"></div>

    <div class="sd-container relative pb-14 sm:pb-16">
      <h1>
        <div class="hero-line hero-line-1 text-[clamp(34px,9.4vw,64px)] text-white font-display leading-[1.08] tracking-tight">
          <span class="whitespace-nowrap">Finally: Your&#160;<span class="word-rotator"><span class="word-rotator-track" id="rotating-track"><span>Flexible</span><span aria-hidden="true">Reliable</span><span aria-hidden="true">Fast</span><span aria-hidden="true">Flexible</span></span></span></span><br/>
          Tech Partner.
        </div>
        <div class="hero-line hero-line-2 mt-10 sm:mt-14 text-lg sm:text-xl md:text-2xl text-white/75 font-body font-normal tracking-[-0.02em]">
          Blockchain Development Company & Web3 Software Partner
        </div>
      </h1>
      <p class="hero-line hero-line-3 mt-6 text-[15px] sm:text-base md:text-lg text-white/80 max-w-2xl leading-relaxed font-body font-light">
        SpaceDev builds custom <strong class="font-semibold text-white">Web3</strong> and <strong class="font-semibold text-white">blockchain</strong> solutions, from <strong class="font-semibold text-white">dApps</strong> and <strong class="font-semibold text-white">smart contracts</strong> to <strong class="font-semibold text-white">DeFi</strong> and token infrastructure, for startups, fintechs and enterprises that need a technical partner with real depth.
      </p>

      <!-- Trusted-by strip: inside the hero so there's no light/dark seam at the fold.
           Matches the white logo strip on agentic-ai-development.astro. -->
      <div class="hero-line hero-line-4 mt-28 sm:mt-40">
        <p class="text-xs font-ui uppercase tracking-[0.18em] text-sd-text-muted/70 mb-5">
          Trusted by
        </p>
        <div class="sd-marquee-wrapper hero-marquee-wrapper">
          <div class="sd-marquee">
            <div class="sd-marquee-set">
              {clientLogosWhite.map((c) => (
                <img src={c.src} alt={c.alt} loading="eager" width={Math.round(28 * (c.scale ?? 1) * c.ratio)} height={Math.round(28 * (c.scale ?? 1))} style={`height:${28 * (c.scale ?? 1)}px`} class="w-auto object-contain opacity-85 shrink-0" />
              ))}
            </div>
            <div class="sd-marquee-set" aria-hidden="true">
              {clientLogosWhite.map((c) => (
                <img src={c.src} alt="" loading="lazy" width={Math.round(28 * (c.scale ?? 1) * c.ratio)} height={Math.round(28 * (c.scale ?? 1))} style={`height:${28 * (c.scale ?? 1)}px`} class="w-auto object-contain opacity-85 shrink-0" />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    /* No filter: blur() here. It used to animate from blur(10px) to blur(0),
       which PageSpeed flagged on exactly these three elements as non-composited
       animations: blur cannot run on the compositor, so each frame repainted on
       the main thread. Three large elements doing that, staggered to finish at
       2.75s, sat right on top of the LCP window on a throttled mid-range phone,
       where mobile measured 2,350ms of element render delay against desktop's
       98. opacity and transform both composite, so the entrance still reads
       without holding up the paint of the headline beside it. */
    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(48px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    /* hero-line-1 (the title) is deliberately excluded from the entrance
       animation: it is the LCP element, and the animation starts from
       opacity 0, so the browser only counts it as painted once the 1.4s fade
       finishes. That alone put a floor of ~2s on desktop LCP and ~3.4s on
       throttled mobile. The rest of the hero keeps the staggered effect. */
    .hero-line-2,
    .hero-line-3,
    .hero-line-4 {
      animation: hero-rise 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-line-2 { animation-delay: 0.65s; }
    .hero-line-3 { animation-delay: 1.0s; }
    .hero-line-4 { animation-delay: 1.35s; }

    @media (prefers-reduced-motion: reduce) {
      .hero-line { animation: none; }
    }

    /* Rotating word. All four slides ship in the server-rendered HTML and the
       rotation only moves the track with transform, so nothing new is ever
       painted inside the h1. Rewriting textContent here (the previous
       approach) registered a fresh LCP candidate every 2.4s and pushed the
       measured LCP out to ~10.6s no matter how late the rotation started.
       The track's last slide repeats the first one so the loop can snap back
       to the top with the transition off, without a visible rewind.

       Every slide after the first carries aria-hidden. Shipping all four in the
       DOM put all four in the accessibility tree, so the h1's accessible name
       became "Finally: Your Flexible Reliable Fast Flexible Tech Partner." That
       is what a screen reader announced and what Lighthouse reported as the LCP
       element's text. Exposing only the first slide gives the heading one
       stable, sensible name; a name that changed every 2.4s would be worse than
       a fixed one, since the rotation is decorative. */
    .word-rotator {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      height: 1.05em;
      line-height: 1.05;
    }
    .word-rotator-track {
      display: flex;
      flex-direction: column;
      will-change: transform;
    }
    .word-rotator-track > span {
      height: 1.05em;
      line-height: 1.05;
    }
    .word-rotator-track.is-animating {
      transition: transform 0.42s cubic-bezier(0.2, 0.7, 0.3, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      .word-rotator-track.is-animating { transition: none; }
    }

    /* Tighter spacing on mobile: 40px between logos eats 10% of a 375px viewport */
    .hero-marquee-wrapper .sd-marquee-set,
    .hero-marquee-wrapper .sd-marquee { gap: 1.5rem; }
    @media (min-width: 1000px) {
      .hero-marquee-wrapper .sd-marquee-set,
      .hero-marquee-wrapper .sd-marquee { gap: 2.5rem; }
    }
    /* 32s keeps the strip at ~79px/s, inside the 40-80px/s legible range */
    .hero-marquee-wrapper .sd-marquee { animation-duration: 32s; }
  </style>

  <!-- KEY TAKEAWAYS (light): concise summary block for scanability and AI extraction -->
  <section class="bg-sd-light py-14 border-b border-sd-gray-border">
    <div class="sd-container">
      <h2 class="text-xs font-ui uppercase tracking-widest text-sd-text-gray mb-5">Key Takeaways</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 list-none">
        {homeTakeaways.map((item) => (
          <li class="text-sm text-sd-text-dark leading-relaxed"><strong class="font-semibold">{item.label}</strong> {item.link && <a href={item.link.href} target="_blank" rel="noopener noreferrer" class="text-sd-purple underline underline-offset-4">{item.link.text}</a>}{item.text}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CORE SERVICES (light) -->
  <section class="bg-sd-light py-20 md:py-32">
    <div class="sd-container">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Our Web2 and Web3 Development Services</h2>
        <p class="mt-6 text-base text-sd-text-gray leading-relaxed max-w-xl">
          We build the infrastructure that decentralized products run on. Whether you need a full-stack dApp, a custom blockchain protocol, or a secure smart contract system, our teams work across EVM-compatible chains (Ethereum and networks that share its Ethereum Virtual Machine), Solana, and Layer 2 networks.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {homeServices.map(s => (
          <a href={s.href} class="group block bg-sd-light-2 rounded-2xl p-7 hover:bg-sd-light-2 transition-colors border border-sd-gray-border hover:border-sd-gray-border">
            <!-- Arrow icon — matches Framer original ↓ -->
            <div class="mb-6">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-sd-text-dark">
                <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="text-lg text-sd-text-dark font-display mb-3 group-hover:text-sd-purple transition-colors">{s.title}</h3>
            <p class="text-sm text-sd-text-gray leading-relaxed">{s.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-12">
        <p class="text-base text-sd-text-gray mb-5">Reach out and we'll find the right services, tailored just for you.</p>
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-sd-dark text-white text-sm font-medium hover:bg-sd-dark-2 transition-colors">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- QUOTE REVEAL — between Core Services and Why SpaceDev -->
  <QuoteReveal
    text="Take your business to new heights quickly. Let us handle the technology."
    tone="dark"
    maxWidth="max-w-[720px]"
    padding="py-36 md:py-56"
  />

  <!-- WHY SPACEDEV (light) -->
  <section class="bg-sd-light py-20 md:py-32">
    <div class="sd-container">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Why Partner with a Blockchain Development Company Like SpaceDev</h2>
        <p class="mt-6 text-base text-sd-text-gray leading-relaxed">
          There are many development agencies. Fewer have deep blockchain engineering depth. Even fewer combine that with Web2 product experience, a security practice, and a track record across 200+ projects in DeFi, NFT infrastructure, fintech, and enterprise blockchain.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mb-12">
        {homeReasons.map(w => (
          <div class="group rounded-2xl p-7 bg-sd-light-2 transition-colors duration-300 hover:bg-sd-purple/15" data-animate>
            <p class="text-2xl font-display text-sd-text-dark mb-4 group-hover:text-sd-purple transition-colors duration-300">{w.n}</p>
            <h3 class="text-base font-display font-semibold text-sd-text-dark mb-3">{w.title}</h3>
            <p class="text-sm text-sd-text-gray leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
      <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-sd-dark text-white text-sm font-medium hover:bg-sd-dark-2 transition-colors">
        Partner with us
      </a>
    </div>
  </section>

  <!-- INDUSTRIES (light) -->
  <section class="bg-sd-light py-20 md:py-32 border-t border-sd-gray-border">
    <div class="sd-container">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Blockchain Development for Fintech, DeFi & Web3 Startups</h2>
      </div>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {homeIndustries.map(ind => {
          const cardClass = "group block bg-sd-light-2 rounded-2xl p-7 border border-sd-gray-border transition-colors duration-300";
          const content = (
            <>
              <div class="w-12 h-12 rounded-full flex items-center justify-center mb-5 p-3" style="background: linear-gradient(135deg, #4a397c 17%, #191429 105%)">
                <Fragment set:html={ind.icon} />
              </div>
              <h3 class="text-base font-display text-sd-text-dark mb-2 group-hover:text-sd-purple transition-colors">{ind.name}</h3>
              <p class="text-sm text-sd-text-gray leading-relaxed whitespace-pre-line">{ind.desc}</p>
            </>
          );
          return ind.linked === false ? (
            <div class={cardClass} data-animate>{content}</div>
          ) : (
            <a href={`/blockchain-development-services/industry/${ind.slug}`} class={`${cardClass} hover:border-sd-purple/30 hover:bg-sd-purple/5`} data-animate>{content}</a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES (light) -->
  <section class="bg-sd-light py-20 md:py-32 border-t border-sd-gray-border">
    <div class="sd-container">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Web3 and Web2 Development Case Studies</h2>
        <p class="mt-6 text-base text-sd-text-gray leading-relaxed">
          Every product tells a story: one of collaboration, innovation, and measurable results. SpaceDev not only delivers projects; we support businesses' growth with the kind of technology that earns trust, scales with users, and stands the test of time.
        </p>
      </div>
      <div class="grid gap-[18px] grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
        {featuredCaseStudies.slice(0, 3).map((c) => (
          <CaseStudyCard caseStudy={c} />
        ))}
      </div>
      <div class="mt-10 flex flex-col gap-8 items-start">
        <a href="/our-work" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-sd-dark text-white text-sm font-medium hover:bg-sd-dark-2 transition-colors">
          See all work
        </a>
        <p class="text-xl text-sd-text-gray">
          Eager to create your own success story?
          <a href="https://meetings.hubspot.com/federico-sendra/meet-space" target="_blank" rel="noopener noreferrer"
            class="text-sd-text-dark hover:underline hover:underline-offset-4 hover:text-sd-purple transition-colors font-medium">
            Book a call
          </a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ENGAGEMENT MODELS (light) -->
  <section class="bg-[#ededed] py-20 md:py-32 border-t border-sd-gray-border">
    <div class="sd-container">
      <div class="max-w-2xl mb-14">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">
          There are two ways to work with us.<br/>Pick what suits you!
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 mb-10">
        <!-- MVP Builder -->
        <div class="bg-white rounded-2xl border border-sd-gray-border p-8 md:p-10">
          <h3 class="text-2xl font-display text-sd-text-dark mb-2">MVP Builder</h3>
          <p class="text-sm text-sd-text-gray mb-8">Build a high-tech team for a speedy, top-tier MVP</p>
          <hr class="border-sd-gray-border mb-8" />
          <ol class="space-y-5 mb-8">
            {homeEngagementModels[0].steps.map((step, i) => (
              <li class="flex items-center gap-4">
                <span class="flex-shrink-0 w-7 h-7 rounded-full bg-sd-dark text-white text-xs font-semibold flex items-center justify-center">
                  {i + 1}
                </span>
                <span class="text-sm text-sd-text-dark font-medium">{step}</span>
              </li>
            ))}
          </ol>
          <hr class="border-sd-gray-border mb-6" />
          <p class="text-sm text-sd-text-gray">Perfect for clients needing to swiftly launch a top-quality MVP. Most MVPs are production-ready in 8 to 12 weeks.</p>
        </div>
        <!-- IT Staff Augmentation -->
        <div class="bg-white rounded-2xl border border-sd-gray-border p-8 md:p-10">
          <h3 class="text-2xl font-display text-sd-text-dark mb-2">IT Staff Augmentation</h3>
          <p class="text-sm text-sd-text-gray mb-8">Optimize your team with flexible IT talent support without permanent commitments.</p>
          <hr class="border-sd-gray-border mb-8" />
          <ol class="space-y-5 mb-8">
            {homeEngagementModels[1].steps.map((step, i) => (
              <li class="flex items-center gap-4">
                <span class="flex-shrink-0 w-7 h-7 rounded-full bg-sd-dark text-white text-xs font-semibold flex items-center justify-center">
                  {i + 1}
                </span>
                <span class="text-sm text-sd-text-dark font-medium">{step}</span>
              </li>
            ))}
          </ol>
          <hr class="border-sd-gray-border mb-6" />
          <p class="text-sm text-sd-text-gray">Ideal for rapidly scaling team capacity with on-demand expert IT talent. Most engineers are ready to start within 1 to 2 weeks.</p>
        </div>
      </div>
      <div
        class="relative overflow-hidden rounded-3xl px-10 py-12 md:px-16 md:py-14 flex flex-col md:flex-row md:items-center md:justify-between gap-8"
        style="background: var(--sd-gradient-purple-dark);"
      >
        <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 70% 50%, #7c3aed, transparent 60%);"></div>
        <div class="relative">
          <p class="text-2xl md:text-3xl text-white font-display leading-snug">Still not sure which option you need?</p>
          <p class="text-sd-text-muted mt-2 leading-relaxed">No worries, we're here to help you find the best fit!</p>
        </div>
        <a href="/contact" class="relative shrink-0 inline-flex items-center justify-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 text-sm text-white font-medium hover:bg-white/20 transition-colors backdrop-blur-sm whitespace-nowrap">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS — 4 Clutch review cards (light) -->
  <section class="bg-[#fafafa] py-20 md:py-32">
    <div class="sd-container">
      <div class="max-w-2xl mb-14">
        <h2 class="text-4xl md:text-5xl text-sd-text-dark font-display leading-tight tracking-tight">
          Over <span style="background: linear-gradient(90deg, #3b2080 0%, #673ae4 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">50 perfect 5-star ratings</span> from happy customers
        </h2>
        <p class="mt-5 text-base text-sd-text-gray leading-relaxed">
          Clients choose SpaceDev for reliability, communication, and technical depth, and stay for the results. Every partnership reflects our belief that success is built on trust, collaboration, and a shared vision.
        </p>
      </div>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {homeTestimonials.map(t => (
          <a href={t.href} target="_blank" rel="noopener noreferrer" class="group bg-[#e8e8e8] rounded-2xl p-6 flex flex-col hover:bg-[#e0e0e0] transition-colors" data-animate>
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-[#d0d0d0]">
              <img src="/images/Clutch-sm.svg" alt="Clutch" width="71" height="80" class="h-7 w-auto" />
              <div class="flex items-center gap-2">
                <span class="text-sd-text-dark font-semibold text-sm">5.0</span>
                <span class="text-[#FF3D2E] text-sm leading-none">★★★★★</span>
              </div>
            </div>
            <blockquote class="text-[22px] text-sd-text-dark leading-snug font-body font-normal flex-1 mb-6">
              {t.quote}
            </blockquote>
            <div>
              <p class="text-sm text-sd-text-gray">{t.company}</p>
              <p class="text-xs text-sd-text-muted mt-0.5">{t.location}</p>
              <p class="text-xs text-sd-text-muted mt-0.5">{t.period}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10">
        <a href="https://clutch.co/profile/spacedev" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sd-text-dark text-sm font-medium hover:text-sd-purple hover:underline hover:underline-offset-4 transition-colors">
          See our Clutch profile →
        </a>
      </div>
    </div>
  </section>

  <!-- AWARDS & RECOGNITION (light) -->
  <section class="bg-sd-light py-20 md:py-28 border-t border-sd-gray-border">
    <div class="sd-container">
      <h2 class="text-3xl md:text-4xl text-sd-text-dark font-display leading-tight tracking-tight mb-4">Highly reviewed by</h2>
      <p class="text-sm text-sd-text-gray mb-10 max-w-2xl">AWS lists us as a Partner and Marketplace seller, Forbes named us to its Technology Council, and Clutch, GoodFirms, and Upwork have each recognized us among the top blockchain development companies.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 lg:grid-cols-8 gap-x-6 gap-y-10 items-center justify-items-center">
        {homeAwards.map((b) => (
          <a href={b.href} target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70">
            <img src={b.src} alt={b.alt} loading="lazy" width={b.w} height={b.h} class={b.compact ? "h-11 md:h-12 w-auto object-contain" : "h-24 md:h-28 w-auto object-contain"} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WE SUPPORT (light) — communities & conferences -->
  <section class="bg-sd-light py-20 md:py-24 border-t border-sd-gray-border">
    <div class="sd-container">
      <h2 class="text-3xl md:text-4xl text-sd-text-dark font-display leading-tight tracking-tight mb-14">We support</h2>
      <div class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-9 gap-x-6 gap-y-8 items-center justify-items-center">
        {homeCommunities.map((c) => (
          <a href={c.href} target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-70">
            <img src={c.src} alt={c.alt} loading="lazy" width={c.w} height={c.h} class="h-12 md:h-14 w-auto object-contain" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ (light, 2-col) -->
  <section class="bg-sd-light py-20 md:py-32 border-t border-sd-gray-border">
    <div class="sd-container">
      <div class="grid md:grid-cols-[2fr_3fr] gap-12 md:gap-20 items-start">
