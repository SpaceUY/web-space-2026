<script>
  // Scroll animations are initialised by BaseLayout, which calls
  // initScrollAnimations() on load and again on astro:page-load. Importing the
  // module here as well made it a second entry point, so Astro emitted it as a
  // shared chunk that BaseLayout's own script had to fetch after parsing:
  // a second round trip for 467 bytes, sitting on the critical path.

  // Rotating word — slide the track up one slide at a time.
  // Every slide is already in the HTML, so this only ever sets a transform.
  // It must stay that way: this span lives inside the hero h1, which is the
  // LCP element, and painting new text inside it registers a fresh LCP
  // candidate. The earlier version rewrote textContent every 2.4s, which kept
  // moving the measured LCP out to ~10.6s however late the rotation started.
  const trackEl = document.getElementById("rotating-track");
  if (trackEl) {
    const track = trackEl;
    // The last slide is a copy of the first, so `slides` is the real count.
    const slides = track.children.length - 1;
    let idx = 0;

    function nextWord() {
      idx += 1;
      track.classList.add("is-animating");
      track.style.transform = `translateY(-${idx * 1.05}em)`;

      // Landed on the duplicate: jump back to the real first slide with the
      // transition off, so the loop reads as continuous.
      if (idx === slides) {
        setTimeout(() => {
          track.classList.remove("is-animating");
          idx = 0;
          track.style.transform = "translateY(0)";
        }, 430);
      }
    }

    setInterval(nextWord, 2400);
  }


</script>
