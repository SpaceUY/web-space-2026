---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/ui/FAQ.astro";
import CaseStudyCard from "../components/ui/CaseStudyCard.astro";
import { homeFaqs } from "../data/site-content";
import { featuredCaseStudies } from "../data/case-studies";
import { websiteJsonLd } from "../lib/seo";
import { getCollection } from "astro:content";

const recentPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4);

// Client logos — exact pixel dimensions from spacedev.io Framer CSS
// full174: SVGs are 174×174 with FAFAFA background baked in (render as-is)
// natural: rendered at exact pixel dimensions inside a 174px cell
const clientLogos = [
  { src: "/images/clients/apple.png",         alt: "Apple",        w: 62,  h: 74,  full: false },
  { src: "/images/clients/acton_academy.png", alt: "Acton Academy",w: 118, h: 44,  full: false },
  { src: "/images/clients/microsoft.svg",     alt: "Microsoft",    w: 174, h: 174, full: true  },
  { src: "/images/clients/drata.svg",         alt: "Drata",        w: 174, h: 174, full: true  },
  { src: "/images/clients/prose.svg",         alt: "prose",        w: 174, h: 174, full: true  },
  { src: "/images/clients/ulta.svg",          alt: "ULTA Beauty",  w: 174, h: 174, full: true  },
  { src: "/images/clients/scotia.svg",        alt: "Scotiabank",   w: 174, h: 174, full: true  },
  { src: "/images/clients/utec.svg",          alt: "UTEC",         w: 174, h: 174, full: true  },
  { src: "/images/clients/samsonite.svg",     alt: "Samsonite",    w: 174, h: 174, full: true  },
  { src: "/images/clients/blockus.svg",       alt: "Blockus",      w: 174, h: 174, full: true  },
  { src: "/images/clients/ute.png",           alt: "UTE",          w: 110, h: 50,  full: false },
  { src: "/images/clients/orange.svg",        alt: "Orange",       w: 174, h: 174, full: true  },
  { src: "/images/clients/d_local.svg",       alt: "dLocal",       w: 174, h: 174, full: true  },
  { src: "/images/clients/schwarzkopf.svg",   alt: "Schwarzkopf",  w: 174, h: 174, full: true  },
  { src: "/images/clients/rarible.svg",       alt: "Rarible",      w: 133, h: 31,  full: false },
  { src: "/images/clients/ufc.svg",           alt: "UFC Strike",   w: 145, h: 22,  full: false },
] as const;

// Industry SVG icons — white stroke, for use on purple bg circles
const I_BUILDING = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 9 18 L 9 0.75 C 9 0.473 8.847 0.219 8.604 0.089 C 8.36 -0.042 8.064 -0.027 7.834 0.126 L 0.334 5.126 C 0.125 5.265 0 5.5 0 5.751 L 0 18" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(3.75 2.25)"/><path d="M 0 0 L 6.75 0 C 7.164 0 7.5 0.336 7.5 0.75 L 7.5 12" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(12.75 8.25)"/><path d="M 0 0 L 21 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(1.5 20.25)"/><path d="M 0 0 L 0 1.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(9.75 10.5)"/><path d="M 0 0 L 0 1.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(6.75 10.5)"/><path d="M 0 0 L 0 1.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(6.75 15.75)"/><path d="M 0 0 L 0 1.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(9.75 15.75)"/></svg>`;
const I_CHAT = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 0 0 L 2.25 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(14.25 9.75)"/><path d="M 0 0 L 3 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(6.75 9.75)"/><path d="M 0 0 L 0 3" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(8.25 8.25)"/><path d="M 8.429 9.75 L 4.481 14.231 C 3.671 15.041 2.429 15.232 1.413 14.703 C 0.397 14.174 -0.159 13.047 0.04 11.919 L 1.574 4.031 C 1.983 1.704 4.002 0.005 6.364 0 L 14.625 0 C 17.317 0 19.5 2.183 19.5 4.875 C 19.5 7.567 17.317 9.75 14.625 9.75 Z" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(1.5 4.5)"/><path d="M 0 5.719 L 3.948 10.2 C 4.758 11.01 6 11.201 7.016 10.672 C 8.032 10.143 8.587 9.016 8.389 7.888 L 6.855 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(14.071 8.531)"/></svg>`;
const I_HEART = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 0 2.25 L 3.75 2.25 L 5.25 0 L 8.25 4.5 L 9.75 2.25 L 12 2.25" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(3 10.5)"/><path d="M 0 5.25 C 0 5.187 0 5.125 0 5.063 C 0 2.267 2.267 0 5.063 0 C 7.18 0 8.994 1.154 9.75 3 C 10.506 1.154 12.32 0 14.438 0 C 17.233 0 19.5 2.267 19.5 5.063 C 19.5 11.25 9.75 16.5 9.75 16.5 C 9.75 16.5 5.813 14.381 2.946 11.25" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(2.25 4.5)"/></svg>`;
const I_TRUCK = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 0 0 L 3.992 0 C 4.298 0 4.573 0.185 4.688 0.469 L 6 3.75" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(17.25 7.5)"/><path d="M 0 0 L 15 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(2.25 13.5)"/><path d="M 0 2.25 C 0 1.007 1.007 0 2.25 0 C 3.493 0 4.5 1.007 4.5 2.25 C 4.5 3.493 3.493 4.5 2.25 4.5 C 1.007 4.5 0 3.493 0 2.25 Z" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(15.75 15.75)"/><path d="M 0 2.25 C 0 1.007 1.007 0 2.25 0 C 3.493 0 4.5 1.007 4.5 2.25 C 4.5 3.493 3.493 4.5 2.25 4.5 C 1.007 4.5 0 3.493 0 2.25 Z" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(5.25 15.75)"/><path d="M 6 0 L 0 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(9.75 18)"/><path d="M 0 0 L 6 0 L 6 6 C 6 6.414 5.664 6.75 5.25 6.75 L 3 6.75" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(17.25 11.25)"/><path d="M 3 12 L 0.75 12 C 0.336 12 0 11.664 0 11.25 L 0 0.75 C 0 0.336 0.336 0 0.75 0 L 15 0 L 15 9.878" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(2.25 6)"/></svg>`;
const I_GRADUATION = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 0 0 L 0 7.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(3 6)"/><path d="M 0 3.75 C 1.472 1.493 3.854 0 6.75 0 C 9.646 0 12.028 1.493 13.5 3.75" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(5.25 16.5)"/><path d="M 18 3 L 9 6 L 0 3 L 9 0 Z" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(3 3)"/><path d="M 9.126 0 C 11.04 2.095 10.943 5.333 8.906 7.309 C 6.869 9.286 3.631 9.286 1.594 7.309 C -0.443 5.333 -0.54 2.095 1.374 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(6.75 7.708)"/></svg>`;
const I_ENERGY = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 0 0 L 3 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(14.25 12.75)"/><path d="M 0 0 L 0 3" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(15.75 11.25)"/><path d="M 0 0 L 3 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(6.75 12.75)"/><path d="M 0.75 10.5 C 0.336 10.5 0 10.164 0 9.75 L 0 0.75 C 0 0.336 0.336 0 0.75 0 L 18.75 0 C 19.164 0 19.5 0.336 19.5 0.75 L 19.5 9.75 C 19.5 10.164 19.164 10.5 18.75 10.5 Z" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(2.25 7.5)"/><path d="M 0 3 L 0 0.75 C 0 0.336 0.336 0 0.75 0 L 3.75 0 C 4.164 0 4.5 0.336 4.5 0.75 L 4.5 3" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(5.25 4.5)"/><path d="M 0 3 L 0 0.75 C 0 0.336 0.336 0 0.75 0 L 3.75 0 C 4.164 0 4.5 0.336 4.5 0.75 L 4.5 3" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(14.25 4.5)"/></svg>`;
const I_ROCKET = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" style="width:100%;height:100%"><path d="M 10.417 6.833 C 12.667 4.583 12.807 1.907 12.737 0.713 C 12.713 0.337 12.413 0.037 12.037 0.013 C 10.843 -0.057 8.168 0.082 5.917 2.333 L 0 8.25 L 4.5 12.75 Z" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(7.5 3.75)"/><path d="M 9.749 0 L 3.969 0 C 3.77 0 3.58 0.079 3.439 0.219 L 0.219 3.44 C 0.019 3.641 -0.051 3.938 0.039 4.207 C 0.129 4.476 0.363 4.672 0.644 4.712 L 4.499 5.25" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(3.001 6.75)"/><path d="M 5.25 0 L 5.25 5.78 C 5.25 5.978 5.171 6.169 5.031 6.309 L 1.81 9.53 C 1.609 9.73 1.312 9.8 1.043 9.71 C 0.774 9.62 0.578 9.386 0.538 9.105 L 0 5.25" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(12 11.25)"/><path d="M 5.115 2.473 C 4.752 3.269 3.53 5.115 0 5.115 C 0 1.585 1.846 0.363 2.642 0" stroke="white" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" transform="translate(3.75 15.135)"/></svg>`;

const industries = [
  { name: "Finance and Fintech", icon: I_BUILDING, desc: "SpaceDev helps financial institutions and fintech startups build secure, scalable products that enhance transparency and automation.\nFrom DeFi platforms and payment gateways to traditional fintech systems, tokenized assets, and digital wallets, we simplify complexity and drive financial innovation." },
  { name: "Gaming and NFTs", icon: I_CHAT, desc: "Our team builds NFT ecosystems, web3 gaming platforms, and play-to-earn models that merge creativity with blockchain-backed ownership.\nWe deliver immersive experiences with secure smart contracts and scalable infrastructure." },
  { name: "Healthcare and Life Sciences", icon: I_HEART, desc: "We help healthcare providers ensure data integrity, secure patient identity management, and traceable medical supply chains.\nOur solutions prioritize compliance, security, and seamless interoperability." },
  { name: "Supply Chain and Logistics", icon: I_TRUCK, desc: "We build solutions that bring real-time visibility, tracking, and trust to global logistics.\nOur systems reduce fraud, enhance traceability, and simplify auditing at every stage." },
  { name: "Real Estate and PropTech", icon: I_BUILDING, desc: "We can create tokenized property solutions, automated contract workflows, and secure ownership records that streamline property transactions and investment management." },
  { name: "Education and EdTech", icon: I_GRADUATION, desc: "SpaceDev supports educational platforms with digital learning systems, decentralized certification, and blockchain credentials that enhance authenticity and accessibility." },
  { name: "Energy", icon: I_ENERGY, desc: "We help leading energy companies enhance data integrity, collaboration, and operational visibility. Our solutions support exploration and production through automated reporting, streamlined joint ventures, and improved efficiency across the oil and gas value chain." },
  { name: "Startups and Emerging Ventures", icon: I_ROCKET, desc: "We help founders turn ideas into products through Product Discovery, MVP development, and rapid prototyping.\nWhether entering Web3 or scaling a SaaS, our team delivers the strategy, speed, and structure to grow." },
];
---

<BaseLayout
  title="SpaceDev | Web3 Development Services & Custom Software Solutions"
  description="SpaceDev is a blockchain development company offering web and mobile app development, and IT staff augmentation services for scalable growth."
  jsonLd={websiteJsonLd}
>
  <!-- HERO (dark) -->
  <section class="bg-sd-dark h-screen flex flex-col justify-end relative overflow-hidden">
    <!-- Background illustration (Framer original hero asset) -->
    <img
      src="/images/content/fO7SfBQPl5ZyUbWpE80AgCxQ9Co.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      width="2882"
      height="1622"
      class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-screen pointer-events-none"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-sd-dark via-sd-dark/80 to-transparent"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 60% 50%, rgba(103,58,228,0.15) 0%, transparent 70%);"></div>
    <div class="relative px-6 pb-10">
      <h1 class="text-5xl md:text-[80px] text-white font-display leading-none tracking-tight">
        Finally:<br/>Your <span id="rotating-word" class="text-white">Flexible</span><br/>Tech Partner.
      </h1>
      <p class="mt-6 text-base md:text-lg text-white/60 max-w-2xl leading-relaxed font-body font-light">
        SpaceDev is a blockchain development company that transforms complex ideas into scalable digital products. We build web3, blockchain, and custom software solutions with deep engineering expertise and startup agility. Our mission: help businesses launch, scale, and innovate through technology that performs.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="https://meetings.hubspot.com/federico-sendra/meet-space" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-sd-dark text-white text-sm font-medium border border-white/20 hover:bg-white/10 transition-colors">
          Book a call
        </a>
        <a href="/our-work"
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-full text-white/70 text-sm hover:text-white transition-colors">
          See our work →
        </a>
      </div>
    </div>
  </section>

  <!-- CLIENT LOGOS MARQUEE — exact pixel sizes from spacedev.io Framer CSS -->
  <section class="bg-sd-light overflow-hidden">
    <div class="sd-marquee-wrapper">
      <div class="sd-marquee flex items-center whitespace-nowrap">
        {clientLogos.map((c) => c.full
          ? <img src={c.src} alt={c.alt} width={c.w} height={c.h} loading="lazy" class="shrink-0 block" />
          : <div class="w-[174px] h-[174px] flex items-center justify-center shrink-0 bg-sd-light">
              <img src={c.src} alt={c.alt} width={c.w} height={c.h} loading="lazy" class="block" />
            </div>
        )}
        {/* duplicate set for seamless loop — aria-hidden */}
        {clientLogos.map((c) => c.full
          ? <img src={c.src} alt="" width={c.w} height={c.h} loading="lazy" class="shrink-0 block" aria-hidden="true" />
          : <div class="w-[174px] h-[174px] flex items-center justify-center shrink-0 bg-sd-light" aria-hidden="true">
              <img src={c.src} alt="" width={c.w} height={c.h} loading="lazy" class="block" />
            </div>
        )}
      </div>
    </div>
  </section>

  <!-- CORE SERVICES (light) -->
  <section class="bg-sd-light py-20 md:py-32">
    <div class="mx-auto max-w-[1440px] px-6 md:px-16">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Core Services</h2>
        <p class="mt-6 text-base text-sd-text-gray leading-relaxed max-w-xl">
          We help businesses transform ideas into products through a mix of next-generation web3 engineering and traditional software development. Each service is designed to help you build smarter, move faster, and scale with confidence.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {[
          { title: "Blockchain Software Development", href: "/blockchain-development-services", desc: "We turn complex ideas into reliable decentralized applications. Our blockchain development services deliver scalable, transparent infrastructure built to grow with your business." },
          { title: "Web and Mobile App Development", href: "/innovative-web-and-mobile-solutions", desc: "From web platforms to mobile apps, we build high-performance digital products that users actually enjoy. Design thinking, agile development, and scalable architecture: all under one team." },
          { title: "IT Staff Augmentation", href: "/staff-augmentation", desc: "Connect with skilled developers, designers, and engineers who fit your workflow from day one. You get the expertise without the overhead, faster and fully managed." },
          { title: "Product Discovery", href: "/product-discovery", desc: "We help you validate ideas, define priorities, and design a roadmap before writing a single line of code. Business goals, user needs, and technical scope, aligned from day one." },
          { title: "BlockAudit: Blockchain Security", href: "/blockaudit-smart-contract-and-blockchain-security", desc: "We audit your smart contracts and blockchain systems to catch vulnerabilities before they become risks. Secure, compliant, and performance-optimized from the start." },
        ].map(s => (
          <a href={s.href} class="group block bg-sd-light-4 rounded-2xl p-7 hover:bg-sd-light-3 transition-colors border border-sd-gray-border hover:border-sd-gray-border2">
            <h3 class="text-lg text-sd-text-dark font-body font-semibold mb-3 group-hover:text-sd-purple transition-colors">{s.title}</h3>
            <p class="text-sm text-sd-text-gray leading-relaxed">{s.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-12">
        <p class="text-base text-sd-text-gray mb-5">Reach out and we'll find the right services, tailored just for you.</p>
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-sd-dark text-white text-sm font-medium hover:bg-sd-dark-2 transition-colors">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- DARK CTA SECTION -->
  <section class="bg-sd-dark py-32 md:py-48 text-center relative overflow-hidden">
    <img
      src="/images/content/1Uy3PMGUKlW32ZDPRO9od3Ww7k.png"
      alt=""
      aria-hidden="true"
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover opacity-15 pointer-events-none"
    />
    <div class="relative mx-auto max-w-4xl px-6 md:px-16">
      <h2 class="text-5xl md:text-7xl lg:text-8xl text-white font-display leading-tight tracking-tight">
        Take your business to<br/>new heights quickly—let<br/>us handle the technology
      </h2>
    </div>
  </section>

  <!-- WHY SPACEDEV (light) -->
  <section class="bg-sd-light py-20 md:py-32">
    <div class="mx-auto max-w-[1440px] px-6 md:px-16">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Why SpaceDev</h2>
        <p class="mt-6 text-base text-sd-text-gray leading-relaxed">
          Choosing the right technology partner can define the success of your product. SpaceDev combines the agility of a startup, the precision of an engineering powerhouse, and the reliability of a global team.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 mb-12">
        {[
          { n: "01", title: "Full-Cycle Product Ownership", desc: "We take ownership of your product lifecycle from ideation to scale, ensuring market readiness through transparent communication and accountability." },
          { n: "02", title: "Web2 & Mobile Expertise", desc: "Build high-performance custom software and mobile applications using modern frameworks like React and Node.js for scalable, user-centric digital products." },
          { n: "03", title: "Web3 & Blockchain Expertise", desc: "Leverage deep expertise in smart contracts and decentralized protocols to deploy secure solutions across major ecosystems like Ethereum, Aptos, or Solana." },
          { n: "04", title: "Flexible Team Models", desc: "Scale your team instantly with our IT staff augmentation services or choose a dedicated team for end-to-end project execution." },
          { n: "05", title: "Proven Track Record", desc: "Rely on a proven history of delivering high-impact Web2 and Web3 products, backed by our perfect 5-star client ratings." },
          { n: "06", title: "Global Presence with Local Agility", desc: "Benefit from nearshore collaboration with top talent in your time zone, operating seamlessly from the U.S. and Latin America." },
        ].map(w => (
          <div class="why-card rounded-2xl border border-sd-gray-border p-7" style="opacity: 0.3; transition: opacity 0.6s ease;">
            <p class="text-2xl font-display text-sd-text-dark mb-4">{w.n}</p>
            <h3 class="text-base font-body font-semibold text-sd-text-dark mb-3">{w.title}</h3>
            <p class="text-sm text-sd-text-gray leading-relaxed">{w.desc}</p>
          </div>
        ))}
      </div>
      <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-sd-dark text-white text-sm font-medium hover:bg-sd-dark-2 transition-colors">
        Partner with us
      </a>
    </div>
  </section>

  <!-- INDUSTRIES (light) -->
  <section class="bg-sd-light py-20 md:py-32 border-t border-sd-gray-border">
    <div class="mx-auto max-w-[1440px] px-6 md:px-16">
      <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight mb-16">Industries We Serve</h2>
      <div class="grid gap-12 md:grid-cols-2">
        {industries.map(ind => (
          <div class="flex gap-5" data-animate>
            <div class="shrink-0 w-12 h-12 rounded-full bg-sd-purple flex items-center justify-center p-2.5">
              <Fragment set:html={ind.icon} />
            </div>
            <div>
              <h3 class="text-base font-body font-semibold text-sd-text-dark mb-2">{ind.name}</h3>
              <p class="text-sm text-sd-text-gray leading-relaxed whitespace-pre-line">{ind.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDIES (light) -->
  <section class="bg-sd-light py-20 md:py-32 border-t border-sd-gray-border">
    <div class="mx-auto max-w-[1440px] px-6 md:px-16">
      <div class="max-w-2xl mb-16">
        <h2 class="text-4xl md:text-6xl text-sd-text-dark font-display leading-tight tracking-tight">Check out some of our success stories!</h2>
        <p class="mt-6 text-base text-sd-text-gray leading-relaxed">
          Every product tells a story: one of collaboration, innovation, and measurable results. SpaceDev not only delivers projects; we support businesses' growth with the kind of technology that earns trust, scales with users, and stands the test of time.
        </p>
