<script>
  import { initScrollAnimations } from "../lib/animations";
  document.addEventListener("DOMContentLoaded", initScrollAnimations);

  // Rotating word — slide up from below
  const words = ["Fast", "Flexible", "Reliable"];
  let idx = 0;
  const el = document.getElementById("rotating-word");
  if (el) {
    const SLIDE = "cubic-bezier(0.2, 0.7, 0.3, 1)";

    function nextWord() {
      idx = (idx + 1) % words.length;

      // Exit: slide up and fade out
      el.style.transition = `transform 0.28s ${SLIDE}, opacity 0.2s ease`;
      el.style.transform  = "translateY(-110%)";
      el.style.opacity    = "0";

      setTimeout(() => {
        // Swap word and position it below
        el.textContent      = words[idx];
        el.style.transition = "none";
        el.style.transform  = "translateY(110%)";
        el.style.opacity    = "0";

        requestAnimationFrame(() => requestAnimationFrame(() => {
          // Enter: slide up into place
          el.style.transition = `transform 0.32s ${SLIDE}, opacity 0.22s ease`;
          el.style.transform  = "translateY(0)";
          el.style.opacity    = "1";
        }));
      }, 290);
    }

    setInterval(nextWord, 2400);
  }

  // Case studies — spinning VIEW PROJECT cursor
  const csZone   = document.getElementById("home-cs-zone");
  const csCursor = document.getElementById("home-cs-cursor");
  if (csZone && csCursor) {
    let csRaf: number;
    window.addEventListener("mousemove", (e: MouseEvent) => {
      cancelAnimationFrame(csRaf);
      csRaf = requestAnimationFrame(() => {
        csCursor.style.left = e.clientX + "px";
        csCursor.style.top  = e.clientY + "px";
        const rect   = csZone.getBoundingClientRect();
        const inside = e.clientX >= rect.left && e.clientX <= rect.right &&
                       e.clientY >= rect.top  && e.clientY <= rect.bottom;
        csCursor.style.opacity     = inside ? "1" : "0";
        document.body.style.cursor = inside ? "none" : "";
      });
    });
  }

</script>

