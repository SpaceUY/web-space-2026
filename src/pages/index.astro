<script>
  import { initScrollAnimations } from "../lib/animations";
  document.addEventListener("DOMContentLoaded", initScrollAnimations);

  // Rotating word animation
  const words = ["Fast", "Flexible", "Reliable"];
  let idx = 0;
  const el = document.getElementById("rotating-word");
  if (el) {
    setInterval(() => {
      idx = (idx + 1) % words.length;
      el.style.opacity = "0";
      setTimeout(() => {
        if (el) {
          el.textContent = words[idx];
          el.style.opacity = "1";
        }
      }, 200);
    }, 2000);
    el.style.transition = "opacity 0.2s ease";
  }

  // Why SpaceDev cards — fade in when entering viewport
  const whyCards = document.querySelectorAll<HTMLElement>(".why-card");
  const whyObs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).style.opacity = "1";
          whyObs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  whyCards.forEach((card) => whyObs.observe(card));
</script>
