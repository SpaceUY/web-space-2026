---
import ServicePageLayout from "../layouts/ServicePageLayout.astro";
import { staffAugData } from "../data/services";
import Card from "../components/ui/Card.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";

const industries = [
  { title: "Fintech & Banking", description: "Strengthen digital banking and trading platforms with secure code and blockchain-powered payment systems." },
  { title: "Healthcare & MedTech", description: "Build compliant, secure patient experiences that improve care while meeting global standards." },
  { title: "E-commerce & Retail", description: "Create fast, intuitive shopping experiences that maximize engagement from browsing to checkout." },
  { title: "SaaS & Startups", description: "Accelerate product launches and scale MVPs with agile teams designed for rapid growth." },
  { title: "Gaming & Media", description: "Develop high-performance multiplayer environments and AR experiences that are interactive and immersive." },
  { title: "Education & Enterprise IT", description: "Modernize infrastructure and automate workflows for large enterprises and educational platforms." },
  { title: "Automotive & Mobility", description: "Build connected mobility solutions, from smart navigation to IoT fleet management systems." },
  { title: "Energy & Utilities", description: "Implement data-driven dashboards and blockchain systems for transparent resource management." },
  { title: "Telecommunications & Networking", description: "Improve connectivity with advanced communication frameworks and network automation tools." },
];
---

<ServicePageLayout data={staffAugData}>
  <!-- INTRO BLOCK with image -->
  <section class="bg-sd-light-4 py-20 md:py-28">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="grid gap-12 md:grid-cols-2 items-center">
        <div data-animate>
          <SectionHeading
            eyebrow="Top IT talent without long hiring cycles"
            title="Pre-vetted developers and designers, ready from day one"
            description="Finding skilled talent shouldn't slow you down. Our rigorous selection process ensures the right fit, helping you scale your MVP or enterprise platform efficiently, affordably, and without long-term commitments."
            tone="dark"
          />
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="primary" external>Book a call</Button>
            <Button href="/our-work" variant="ghost" class="text-sd-text-dark hover:bg-black/5">See our work</Button>
          </div>
        </div>
        <figure class="rounded-3xl overflow-hidden border border-sd-gray-border" data-animate>
          <img
            src="/images/content/A1l24ZnwZP0Wbpa3eFPCvO6NN1Y.png"
            alt="Distributed engineering team collaborating remotely"
            loading="lazy"
            class="w-full h-auto"
            width="900" height="600"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES served (9 cards) -->
  <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <SectionHeading
        eyebrow="Industries we serve"
        title="Innovation looks different in every sector"
        description="SpaceDev partners with businesses across many industries, providing the skill, speed, and technical depth needed to move ideas forward."
        align="center"
        class="mb-14"
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {industries.map((i) => (
          <div class="rounded-2xl border border-white/10 bg-sd-dark-2 p-6 hover:border-sd-purple/40 transition-colors" data-animate>
            <h3 class="text-lg text-white mb-3">{i.title}</h3>
            <p class="text-sm text-sd-text-muted leading-relaxed">{i.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Targeted hire CTAs (3 paths) -->
  <section class="py-20 md:py-28 border-t border-white/5" style="background: var(--sd-purple-deep);">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <SectionHeading
        eyebrow="Targeted hiring"
        title="What kind of talent do you need?"
        description="The interview process takes less than 2 weeks — most teams are ready to start within one to two."
        align="center"
        class="mb-12"
      />
      <div class="grid gap-6 md:grid-cols-3">
        <Card variant="dark">
          <h3 class="text-xl text-white mb-3">General team scaling</h3>
          <p class="text-sm text-sd-text-muted mb-6 leading-relaxed">
            Tell us your stack and timeline — we'll match you with vetted engineers ready to start.
          </p>
          <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="primary" external>Book a call</Button>
        </Card>
        <Card variant="dark">
          <h3 class="text-xl text-white mb-3">Hire blockchain developers</h3>
          <p class="text-sm text-sd-text-muted mb-6 leading-relaxed">
            Solidity, Rust, Move, full-stack Web3 — engineers who have shipped to mainnet.
          </p>
          <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="primary" external>Book a call</Button>
        </Card>
        <Card variant="dark">
          <h3 class="text-xl text-white mb-3">UX/UI, PMs, POs or QAs</h3>
          <p class="text-sm text-sd-text-muted mb-6 leading-relaxed">
            Designers, project managers, product owners, and testing engineers — embedded into your team.
          </p>
          <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="outline-light" external>Book a call</Button>
        </Card>
      </div>
    </div>
  </section>
</ServicePageLayout>
