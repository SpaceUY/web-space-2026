---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const contributions = [
  {
    title: "Why We Should Care About LATAM",
    image: "/images/content/uPH5998oYdW1lvvvcYZNNwQMj7w.png",
    href: "/digital-library/why-we-should-care-about-latam",
  },
];
---

<BaseLayout
  title="Resources | SpaceDev — Deep-Dive Insights"
  description="Explore SpaceDev's deep-dive insights: guides, whitepapers, and featured contributions on blockchain, fintech, and product strategy."
>
  <!-- HERO -->
  <section class="relative overflow-hidden min-h-[80vh] flex flex-col justify-center" style="background-color: #0d0a18;">
    <img
      src="/images/content/fO7SfBQPl5ZyUbWpE80AgCxQ9Co.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(10,6,20,0.88) 25%, rgba(50,30,90,0.45) 65%, rgba(10,6,20,0.75) 100%), linear-gradient(to bottom, rgba(10,6,20,0.2) 0%, rgba(10,6,20,0.85) 100%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-28 md:pt-36 pb-16 md:pb-20 w-full">
      <nav class="mb-6 text-sm text-white/50 font-body" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors uppercase tracking-widest text-xs">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white uppercase tracking-widest text-xs">Resources</span>
      </nav>
      <div class="max-w-3xl" data-animate>
        <h1 class="text-4xl md:text-6xl lg:text-7xl text-white font-display leading-[1.05]">
          Explore Our<br />Deep-Dive Insights
        </h1>
        <p class="mt-4 text-white/60 text-base font-body">Curious about the events we've been part of?</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button href="/contact" variant="dark">Get in touch</Button>
          <span class="text-white/60 text-sm font-body">Or subscribe to our newsletter</span>
        </div>
        <form class="mt-4 flex gap-3 max-w-md" onsubmit="return false;">
          <input
            type="email"
            placeholder="Your email"
            class="flex-1 rounded-full px-5 py-3 bg-transparent border border-white/20 text-white placeholder:text-white/40 text-sm focus:outline-none focus:border-white/50"
          />
          <button
            type="submit"
            class="rounded-full px-6 py-3 bg-white text-sd-text-dark font-body font-medium text-sm hover:bg-sd-light-2 transition-colors"
          >
            Sign up!
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- MISSION STATEMENT -->
  <section class="bg-[#141414] py-20 md:py-28">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10" data-animate>
      <p class="font-display text-2xl md:text-3xl lg:text-4xl text-white leading-snug">
        We believe that sharing plants seeds of innovation and connects curious minds everywhere. Together, we transform ideas into breakthroughs and build a future shaped by collaboration and creativity.
      </p>
    </div>
  </section>

  <!-- FEATURED CONTRIBUTIONS -->
  <section class="bg-[#0d0d0d] py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <h2 class="font-display text-3xl md:text-4xl text-white mb-8">
        Featured Contributions!
      </h2>
      <div class="divide-y divide-white/10 border-t border-white/10">
        {contributions.map((item) => (
          <div class="flex items-center gap-6 py-5" data-animate>
            <div class="shrink-0 w-24 h-16 rounded-xl overflow-hidden bg-sd-purple-mid">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="flex-1 font-display text-lg text-white">{item.title}</p>
            <a
              href={item.href}
              class="shrink-0 text-sm font-ui uppercase tracking-widest text-sd-text-muted hover:text-white transition-colors"
            >
              GET ACCESS
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
