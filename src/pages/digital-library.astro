---
import BaseLayout from "../layouts/BaseLayout.astro";
import Badge from "../components/ui/Badge.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Card from "../components/ui/Card.astro";
import CTA from "../components/ui/CTA.astro";

const resources = [
  {
    type: "Whitepaper",
    title: "The State of Smart Contract Security in 2026",
    description: "60+ pages on the most common vulnerabilities, audit patterns, and operational practices that separate breached protocols from secure ones.",
    cta: "Download PDF",
  },
  {
    type: "Playbook",
    title: "Web2 → Web3 Migration Playbook for Fintech",
    description: "A practical, regulator-friendly migration path. Phase-by-phase planning, compliance design, parallel deployment, and operating models.",
    cta: "Download PDF",
  },
  {
    type: "Guide",
    title: "Asset Tokenization: Architecture Patterns",
    description: "Reference architectures for tokenizing real estate, fixed income, and commodities — including custody, secondary markets, and compliance.",
    cta: "Download PDF",
  },
  {
    type: "Checklist",
    title: "Pre-Audit Checklist for Smart Contracts",
    description: "The same checklist we use at BlockAudit to cut audit time by 30–50%. Print it, run through it, ship cleaner code.",
    cta: "Get the checklist",
  },
  {
    type: "Template",
    title: "Discovery Sprint Brief Template",
    description: "The exact one-page brief we ask new clients to fill out before kicking off a Product Discovery Sprint.",
    cta: "Download template",
  },
  {
    type: "Report",
    title: "Annual Web3 Engineering Trends — 2026 Edition",
    description: "Stack choices, gas optimization patterns, monitoring practices, and team structures across 50+ Web3 teams we've worked with.",
    cta: "Download report",
  },
];
---

<BaseLayout
  title="Digital Library | SpaceDev — Whitepapers, guides and playbooks"
  description="Free engineering and strategy resources from the SpaceDev team — whitepapers, playbooks, checklists, and reference architectures for Web2 and Web3."
>
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-3xl" data-animate>
        <Badge tone="purple" withDot class="mb-6">Digital Library</Badge>
        <h1 class="text-4xl md:text-6xl text-white">Free resources from our engineers</h1>
        <p class="mt-6 text-lg text-sd-text-muted max-w-2xl leading-relaxed">
          Whitepapers, playbooks, and checklists distilled from the projects we've shipped.
          Free to download, no email gate (yes, really).
        </p>
      </div>
    </div>
  </section>

  <section class="bg-sd-dark py-16 md:py-24">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <SectionHeading eyebrow="Resources" title="What's available right now" class="mb-12" />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {resources.map((r) => (
          <Card variant="dark" hover={false}>
            <p class="text-xs uppercase tracking-[0.2em] text-sd-purple-300 mb-4">{r.type}</p>
            <h3 class="text-lg text-white mb-3">{r.title}</h3>
            <p class="text-sm text-sd-text-muted leading-relaxed mb-6">{r.description}</p>
            <a href="/contact" class="inline-flex items-center gap-1 text-sm text-sd-purple-300 hover:gap-2 transition-all">
              {r.cta}
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8m0 0L7.5 3.5M11 7L7.5 10.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Want a resource we haven't published yet?"
    description="Tell us what you're working on — if we have something useful, we'll send it over."
    buttons={[{ label: "Email us", href: "mailto:info@spacedev.io" }]}
    variant="dark"
  />
</BaseLayout>
