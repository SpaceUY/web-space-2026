---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";

const contributions = [
  {
    title: "Why We Should Care About LATAM",
    image: "/images/content/uPH5998oYdW1lvvvcYZNNwQMj7w.png",
    href: "/contact",
  },
];
---

<BaseLayout
  title="Resources | SpaceDev — Deep-Dive Insights"
  description="Explore SpaceDev's deep-dive insights: guides, whitepapers, and featured contributions on blockchain, fintech, and product strategy."
>
  <!-- HERO: dark purple gradient -->
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-24 md:py-36">
      <div class="max-w-3xl" data-animate>
        <h1 class="font-display font-semibold text-5xl md:text-7xl text-white leading-[1.0]">
          Explore Our<br />Deep-Dive Insights
        </h1>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <Button href="/contact" variant="primary">Get in touch</Button>
          <span class="text-sd-text-muted text-sm">Or subscribe to our newsletter</span>
        </div>
        <form class="mt-4 flex gap-3 max-w-md" onsubmit="return false;">
          <input
            type="email"
            placeholder="Your email"
            class="flex-1 rounded-full px-5 py-3 bg-transparent border border-white/20 text-white placeholder:text-sd-text-muted text-sm focus:outline-none focus:border-white/50"
          />
          <button
            type="submit"
            class="rounded-full px-6 py-3 bg-white text-sd-text-dark font-semibold text-sm hover:bg-sd-light-2 transition-colors"
          >
            Sign up!
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- MISSION STATEMENT -->
  <section class="bg-[#141414] py-20 md:py-28">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10" data-animate>
      <p class="font-display font-semibold text-2xl md:text-3xl lg:text-4xl text-white leading-snug">
        We believe that sharing plants seeds of innovation and connects curious minds everywhere. Together, we transform ideas into breakthroughs and build a future shaped by collaboration and creativity.
      </p>
    </div>
  </section>

  <!-- FEATURED CONTRIBUTIONS -->
  <section class="bg-[#0d0d0d] py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <h2 class="font-display font-semibold text-3xl md:text-4xl text-white mb-8">
        Featured Contributions!
      </h2>
      <div class="divide-y divide-white/10 border-t border-white/10">
        {contributions.map((item) => (
          <div class="flex items-center gap-6 py-5">
            <div class="shrink-0 w-24 h-16 rounded-xl overflow-hidden bg-sd-purple-mid">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <p class="flex-1 font-display font-semibold text-lg text-white">{item.title}</p>
            <a
              href={item.href}
              class="shrink-0 text-sm font-ui uppercase tracking-widest text-sd-text-muted hover:text-white transition-colors"
            >
              GET ACCESS
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
