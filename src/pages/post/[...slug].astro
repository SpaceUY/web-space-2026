---
// Catches every /post/<slug> URL not covered by an explicit slug-rename
// redirect in vercel.json. Old, still-indexed /post/ links used to 308 to
// /blog/<same-slug> unconditionally (via a vercel.json catch-all), which
// 404s for any post that was ever removed or renamed -- a redirect chain
// ending in a dead page instead of a clean signal that the content is gone.
// This checks the real content collection at request time instead, so a
// retired post can never again produce a broken redirect.
//
// A live post still 308s to its real URL. A retired one gets its 410 HERE,
// at the address that was actually requested, rather than a 308 to /gone.
// That redirect was wrong on two counts. A 308 asserts the content moved
// permanently to the target, and retired content did not move to /gone; it
// stopped existing. And because every dead URL answered from one address,
// every one of them reported as /gone in analytics and in logs, collapsing
// N distinct broken URLs into a single row that cannot say which URL was
// asked for. Answering in place is also what this site already does for
// 404s, so the two error paths now behave the same way.
export const prerender = false;

import { getCollection } from "astro:content";
import GoneScreen from "../../components/ui/GoneScreen.astro";

const { slug } = Astro.params;
const posts = await getCollection("blog", ({ data }) => !data.draft);
const match = slug && posts.some((p) => p.id === slug);

if (match) return Astro.redirect(`/blog/${slug}`, 308);

Astro.response.status = 410;
Astro.response.statusText = "Gone";
---

<GoneScreen />
