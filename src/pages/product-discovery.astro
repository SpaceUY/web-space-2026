---
import ServicePageLayout from "../layouts/ServicePageLayout.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import QuoteReveal from "../components/ui/QuoteReveal.astro";
import { productDiscoveryData } from "../data/services";

const packages = [
  {
    number: "01",
    title: "Product Strategy Sprint",
    objective: "Define the business model, develop hypotheses, test desirability, and forecast profitability.",
    deliverables: [
      "Detailed report with findings and recommendations",
      "Hypotheses validated or rejected based on data",
      "Business model and profitability projection",
    ],
  },
  {
    number: "02",
    title: "Brand Strategy Sprint",
    objective: "Establish a clear vision for the product's brand and create essential resources.",
    deliverables: [
      "Refined brand materials aligned with product vision",
      "Visual and written assets ready for marketing and next steps",
    ],
  },
  {
    number: "03",
    title: "MVP Discovery Sprint",
    objective: "Design the user experience (UX), navigation, content architecture, and style guide (UI).",
    deliverables: [
      "Product definition",
      "MVP Scope & Roadmap",
      "Critical App Flow",
      "Solution Architecture",
      "Tech Stack",
      "Technical Risk Mitigation",
      "Wireframing",
    ],
  },
  {
    number: "04",
    title: "Go-To-Market Package",
    objective: "Prepare the product for launch while the MVP is being developed.",
    deliverables: [
      "Clear launch strategy",
      "Marketing materials for app stores and social media",
      "Community-building assets to foster early traction",
    ],
  },
  {
    number: "05",
    title: "Continuous Discovery Sprint",
    objective: "Assess the product's current state and propose new functionalities or optimizations.",
    deliverables: [
      "Implementation plans for improvements",
      "Insights report with prioritized recommendations",
      "Roadmap for continuous iteration and growth",
    ],
  },
  {
    number: "06",
    title: "Scale Stage",
    objective: "Support mature products to scale and meet advanced needs.",
    deliverables: [
      "Advanced solutions for scaling",
      "Enhanced design systems to streamline development",
      "Dedicated resources for product growth and optimization",
    ],
  },
];
---

<ServicePageLayout data={productDiscoveryData}>
  <!-- INTRO: What is Product Discovery (BEFORE packages) -->
  <div slot="pre-process">
    <!-- What is + Why does it matter: dark bg, 2 stacked rows with image -->
    <section style="background: var(--sd-purple-deep);" class="py-20 md:py-28">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10 space-y-24">
        <!-- Row 1: What is -->
        <div class="grid gap-12 md:grid-cols-2 items-center">
          <figure class="rounded-3xl overflow-hidden" data-animate>
            <img
              src="/images/content/uPH5998oYdW1lvvvcYZNNwQMj7w.png"
              alt="Product strategy whiteboard session"
              loading="lazy"
              class="w-full h-auto"
              width="900" height="650"
            />
          </figure>
          <div data-animate>
            <h2 class="section-title text-white mb-6">What is a Product Discovery?</h2>
            <p class="font-body text-white text-xl md:text-2xl leading-relaxed">
              It helps deeply understand customer needs and business goals to build the right product, ensuring valuable,
              feasible, and strategic solutions through collaboration and alignment.
            </p>
          </div>
        </div>
        <!-- Row 2: Why does it matter -->
        <div class="grid gap-12 md:grid-cols-2 items-center">
          <figure class="rounded-3xl overflow-hidden" data-animate>
            <img
              src="/images/content/UkMPsipq5LUHrxToyzgDVfzgwc.png"
              alt="Product discovery validation — choosing the right idea"
              loading="lazy"
              class="w-full h-auto"
              width="900" height="650"
            />
          </figure>
          <div data-animate>
            <h2 class="section-title text-white mb-6">Why does it matter?</h2>
            <p class="font-body text-white text-xl md:text-2xl leading-relaxed">
              Over 60% of projects fail due to poor planning. Product Discovery ensures better alignment, the right products,
              and real market impact.
            </p>
          </div>
        </div>

        <!-- Row 3: Simply put -->
        <div class="grid gap-12 md:grid-cols-2 items-center">
          <figure class="rounded-3xl overflow-hidden" data-animate>
            <img
              src="/images/content/ytc9watZeKxb8fyoBqpKVL2bkc.png"
              alt="Product launch illustration"
              loading="lazy"
              class="w-full h-auto"
              width="900" height="650"
            />
          </figure>
          <div data-animate>
            <h2 class="section-title text-white mb-6">Simply put…</h2>
            <p class="font-body text-white text-xl md:text-2xl leading-relaxed">
              'It's about quickly separating the good ideas from the bad ones.'
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Product Discovery Suite + Key Benefits + Micro-packages — unified section -->
    <section class="bg-sd-light py-20 md:py-28 border-t border-sd-gray-border">
      <div class="sd-container">
        <!-- Intro -->
        <div class="mb-12" data-animate>
          <h2 class="section-title text-sd-text-dark mb-6">Product Discovery Suite</h2>
          <p class="font-body font-semibold text-sd-text-dark leading-relaxed mb-4">
            Access a flexible approach to transform your ideas into successful products.
          </p>
          <p class="font-body text-sd-text-gray leading-relaxed mb-8 max-w-2xl">
            You can choose the full service or tailored micro-packages, covering every stage from ideation to scaling.
          </p>
          <Badge tone="purple-dark" class="mb-4">Key Benefits</Badge>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sd-text-gray">
              <span class="mt-2 inline-block w-1.5 h-1.5 rounded-full bg-sd-purple shrink-0"></span>
              <span><strong class="text-sd-text-dark">Risk Reduction:</strong> Validate ideas before investing in development.</span>
            </li>
            <li class="flex items-start gap-3 text-sd-text-gray">
              <span class="mt-2 inline-block w-1.5 h-1.5 rounded-full bg-sd-purple shrink-0"></span>
              <span><strong class="text-sd-text-dark">Informed Decisions:</strong> Based on real data and metrics.</span>
            </li>
            <li class="flex items-start gap-3 text-sd-text-gray">
              <span class="mt-2 inline-block w-1.5 h-1.5 rounded-full bg-sd-purple shrink-0"></span>
              <span><strong class="text-sd-text-dark">Clear Strategy:</strong> For every stage of the product lifecycle.</span>
            </li>
          </ul>
        </div>

        <!-- Micro-packages heading -->
        <div class="mt-16 mb-10" data-animate>
          <Badge tone="purple-dark" class="mb-6">Your product, your pace</Badge>
          <h3 class="font-display text-4xl font-normal text-sd-text-dark mb-4">Micro-packages, on demand</h3>
          <p class="text-sd-text-gray leading-relaxed max-w-2xl">Six sprints covering every stage from ideation to scaling. Pick what fits your moment.</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {packages.map((pkg) => (
            <div class="bg-white rounded-2xl p-8 flex flex-col gap-6 shadow-md">
              <div class="flex items-center gap-4">
                <span class="font-display font-semibold text-4xl leading-none" style="color: var(--sd-purple);">{pkg.number}</span>
                <h3 class="font-display font-semibold text-lg text-sd-text-dark leading-snug">{pkg.title}</h3>
              </div>
              <div class="space-y-5 flex-1">
                <div>
                  <p class="text-xs uppercase tracking-[0.15em] text-sd-purple mb-2">Objective</p>
                  <p class="text-sm text-sd-text-gray leading-relaxed">{pkg.objective}</p>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-[0.15em] text-sd-purple mb-3">Deliverables</p>
                  <ul class="space-y-2">
                    {pkg.deliverables.map((d) => (
                      <li class="flex items-start gap-2.5 text-sm text-sd-text-gray leading-relaxed">
                        <span class="mt-1.5 inline-block w-1.5 h-1.5 rounded-full shrink-0" style="background: var(--sd-purple);"></span>
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-12">
          <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="primary" size="lg" external>Book a call</Button>
        </div>
      </div>
    </section>

    <!-- Data stats section -->
    <section class="bg-sd-light py-20 md:py-28 border-t border-sd-gray-border">
      <div class="sd-container">
        <h2 class="section-title text-sd-text-dark mb-6" data-animate>Data Backs Product Discovery Consulting</h2>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 h-[480px]">
          {[
            { stat: "28x", desc: "more savings with standardized project management practices", height: "100%", bg: "from-[#3a3a3a] to-[#252525]" },
            { stat: "78%", desc: "exceed budgets or face delays",                               height: "82%",  bg: "from-[#4a3585] to-[#2e1e60]" },
            { stat: "67%", desc: "of projects fail due to poor management",                     height: "65%",  bg: "from-[#5a3a90] to-[#3a2270]" },
            { stat: "37%", desc: "fail due to unclear or unrealistic goals",                    height: "48%",  bg: "from-[#3b2080] to-[#1e1040]" },
            { stat: "19%", desc: "fail due to communication breakdowns",                        height: "32%",  bg: "from-[#4a2888] to-[#2a1060]" },
          ].map((item) => (
            <div class="relative h-full rounded-2xl overflow-hidden bg-sd-gray-border/40" data-animate>
              <div class={`absolute bottom-0 left-0 right-0 bg-gradient-to-b ${item.bg} rounded-2xl p-6 flex flex-col justify-start`} style={`height: ${item.height}`}>
                <p class="font-display font-semibold text-white mb-3" style="font-size: clamp(2.5rem, 4.5vw, 4rem); line-height: 1;">{item.stat}</p>
                <p class="text-base text-white/80 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-6 text-sm text-sd-text-gray">Source: <a href="https://www.pmi.org/" target="_blank" rel="noopener noreferrer" class="font-semibold text-sd-text-dark hover:text-sd-purple transition-colors">Project Management Institute (PMI)</a></p>
      </div>
    </section>
  </div>

  <!-- QUOTE — injects before benefits -->
  <div slot="pre-benefits">
    <QuoteReveal
      tone="dark"
      text="Our approach not only speeds up innovation but also revolutionizes work patterns, making problem solving smarter and more effective. This allows you to save time and money while empowering your team to focus on what really matters: the health and quality of your project."
      authors={{ name: "Federico Sendra", role: "CEO & Co-founder", photo: "/images/federico-sendra.png", linkedin: "https://www.linkedin.com/in/fsendra/" }}
      startOffset={0.3}
    />
  </div>
</ServicePageLayout>


