---
import ServicePageLayout from "../layouts/ServicePageLayout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import { productDiscoveryData } from "../data/services";

const packages = [
  { number: "01", title: "Product Strategy Sprint", description: "Define your vision, validate your assumptions, and align stakeholders on a product strategy that's both ambitious and achievable. We map competitors, clarify your unique value proposition, and create a prioritized roadmap." },
  { number: "02", title: "Brand Strategy Sprint", description: "Craft a distinctive brand identity that resonates with your target audience. We develop your positioning, messaging framework, visual direction, and brand voice so you launch with clarity and confidence." },
  { number: "03", title: "MVP Discovery Sprint", description: "Scope and validate your Minimum Viable Product to reduce risk and accelerate time-to-market. We define the core feature set, success metrics, and technical architecture needed to test your riskiest assumptions with real users." },
  { number: "04", title: "Go-To-Market Package", description: "Launch with a plan that drives real traction. We build your GTM strategy covering customer segments, acquisition channels, pricing, and launch sequence — everything your team needs to execute on day one." },
  { number: "05", title: "Continuous Discovery Sprint", description: "Keep learning as you grow. Embed discovery habits into your existing team with recurring user interviews, experiment design, and insight synthesis. Ideal for post-launch teams who want to stay close to their customers." },
  { number: "06", title: "Scale Stage", description: "Prepare your product and organization for the next order of magnitude. We identify growth levers, platform scalability needs, team structure, and the metrics framework that will guide your next phase of expansion." },
];
---

<ServicePageLayout data={productDiscoveryData}>
  <!-- PACKAGES ACCORDION + INTRO BLOCK — injects before benefits -->
  <div slot="pre-benefits">

    <!-- 6 expandable packages -->
    <section class="bg-sd-dark py-20 md:py-28 border-t border-white/5">
      <div class="mx-auto max-w-[1100px] px-6 md:px-10">
        <SectionHeading
          eyebrow="Product Discovery Suite"
          title="Choose the full service or any micro-package"
          description="Six sprints covering every stage from ideation to scaling. Pick what fits your moment."
          align="center"
          class="mb-12"
        />
        <div class="divide-y divide-white/10 border-y border-white/10" id="packages-accordion">
          {packages.map((pkg, i) => (
            <div class="pkg-item" data-open={i === 0 ? "true" : "false"}>
              <button
                class="pkg-trigger w-full flex items-center justify-between gap-4 py-5 text-left group"
                aria-expanded={i === 0 ? "true" : "false"}
              >
                <div class="flex items-center gap-5">
                  <span class="shrink-0 font-ui text-xs text-sd-purple-300 tracking-widest">{pkg.number}</span>
                  <span class="font-display font-semibold text-lg md:text-xl text-white group-hover:text-sd-purple-300 transition-colors">
                    {pkg.title}
                  </span>
                </div>
                <svg class="pkg-icon shrink-0 w-5 h-5 text-sd-text-muted transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </button>
              <div class="pkg-body overflow-hidden">
                <div class="pb-6 pl-10">
                  <p class="text-sd-text-muted leading-relaxed">{pkg.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-10 flex flex-wrap gap-4 justify-center">
          <Button href="/contact" variant="primary" size="lg">Get started</Button>
          <Button href="https://meetings.hubspot.com/federico-sendra/meet-space" variant="outline-light" size="lg" external>Book a discovery call</Button>
        </div>
      </div>
    </section>

    <!-- "What is Product Discovery?" feature block (light) -->
    <section class="bg-sd-light-2 py-20 md:py-28">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10">
        <div class="grid gap-12 md:grid-cols-2 items-center">
          <figure class="rounded-3xl overflow-hidden border border-sd-gray-border" data-animate>
            <img
              src="/images/content/uPH5998oYdW1lvvvcYZNNwQMj7w.png"
              alt="Product strategy whiteboard session"
              loading="lazy"
              class="w-full h-auto"
              width="900" height="650"
            />
          </figure>
          <div data-animate>
            <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray mb-4">What is Product Discovery?</p>
            <h2 class="font-display font-semibold text-3xl md:text-4xl text-sd-text-dark leading-[1.1] mb-6">
              Quickly separate the good ideas from the bad ones
            </h2>
            <p class="font-body text-sd-text-gray leading-relaxed mb-6">
              Product Discovery helps you deeply understand customer needs and business goals to build the right product,
              ensuring valuable, feasible, and strategic solutions through collaboration and alignment.
            </p>
            <div class="flex items-start gap-3 rounded-xl bg-sd-purple/8 border border-sd-purple/20 p-4 mb-8">
              <span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full bg-sd-purple text-white text-xs font-bold">!</span>
              <p class="text-sd-text-gray text-sm leading-relaxed">
                <strong class="text-sd-text-dark">Over 60% of projects fail due to poor planning.</strong> Discovery ensures better alignment, the right products, and real market impact.
              </p>
            </div>
            <Button href="/contact" variant="primary">Get started</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Visual triplet -->
    <section class="bg-sd-light py-12">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10">
        <div class="grid gap-6 md:grid-cols-3" data-animate>
          <figure class="rounded-2xl overflow-hidden border border-sd-gray-border">
            <img src="/images/content/7aoMqJNgdronOCaAbHBE1eHs4.png" alt="User research interview notes" loading="lazy" class="w-full h-56 object-cover" width="600" height="400" />
          </figure>
          <figure class="rounded-2xl overflow-hidden border border-sd-gray-border">
            <img src="/images/content/R9MELislrGXHGw0lHS85a6QZWa8.png" alt="Wireframes and MVP scope" loading="lazy" class="w-full h-56 object-cover" width="600" height="400" />
          </figure>
          <figure class="rounded-2xl overflow-hidden border border-sd-gray-border">
            <img src="/images/content/UkMPsipq5LUHrxToyzgDVfzgwc.png" alt="Go-to-market roadmap planning" loading="lazy" class="w-full h-56 object-cover" width="600" height="400" />
          </figure>
        </div>
      </div>
    </section>

    <!-- Outcomes split -->
    <section class="bg-sd-light-2 py-16 md:py-20 border-t border-sd-gray-border">
      <div class="mx-auto max-w-[1100px] px-6 md:px-10">
        <SectionHeading
          eyebrow="Data backs Product Discovery"
          title="See how outcomes change with discovery"
          description="Source: Project Management Institute (PMI). Teams that invest in discovery save time, money, and ship products customers actually use."
          align="center"
          tone="dark"
          class="mb-10"
        />
        <div class="grid gap-6 md:grid-cols-2" data-animate>
          <div class="rounded-2xl bg-white border border-sd-gray-border p-8">
            <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray mb-3">Without discovery</p>
            <p class="text-3xl font-display font-semibold text-sd-text-dark mb-2">60% of projects fail</p>
            <p class="text-sd-text-gray text-sm leading-relaxed">Wasted budget, missed timelines, and products that miss the market.</p>
          </div>
          <div class="rounded-2xl bg-sd-purple p-8 text-white">
            <p class="text-xs uppercase tracking-[0.2em] text-white/70 mb-3">With discovery</p>
            <p class="text-3xl font-display font-semibold text-white mb-2">Validated, on-budget delivery</p>
            <p class="text-white/80 text-sm leading-relaxed">Aligned teams, validated bets, and roadmaps that ship.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</ServicePageLayout>

<script>
  const items = document.querySelectorAll<HTMLElement>(".pkg-item");
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".pkg-trigger");
    const body    = item.querySelector<HTMLElement>(".pkg-body");
    const icon    = item.querySelector<SVGElement>(".pkg-icon");

    // Set initial heights
    const isOpen = item.dataset.open === "true";
    if (body) body.style.maxHeight = isOpen ? body.scrollHeight + "px" : "0px";
    if (icon) icon.style.transform  = isOpen ? "rotate(180deg)" : "";

    trigger?.addEventListener("click", () => {
      const open = item.dataset.open === "true";
      // Close all
      items.forEach((it) => {
        it.dataset.open = "false";
        const b = it.querySelector<HTMLElement>(".pkg-body");
        const ic = it.querySelector<SVGElement>(".pkg-icon");
        if (b) b.style.maxHeight = "0px";
        if (ic) ic.style.transform = "";
        it.querySelector<HTMLButtonElement>(".pkg-trigger")?.setAttribute("aria-expanded", "false");
      });
      // Open clicked if was closed
      if (!open) {
        item.dataset.open = "true";
        if (body) body.style.maxHeight = body.scrollHeight + "px";
        if (icon) icon.style.transform = "rotate(180deg)";
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>

<style>
  .pkg-body {
    max-height: 0;
    transition: max-height 0.3s ease;
  }
  .pkg-icon {
    transition: transform 0.3s ease;
  }
</style>
