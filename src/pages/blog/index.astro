---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import Button from "../../components/ui/Button.astro";
import { getAuthor } from "../../data/authors";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";

const allPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = allPosts[0];

const allCategories = ["All", ...new Set(allPosts.map((p) => p.data.category))];
const countByCategory = (cat: string) =>
  cat === "All" ? allPosts.length - 1 : allPosts.slice(1).filter((p) => p.data.category === cat).length;

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });
const accentByCategory: Record<string, string> = {
  "Blockchain Trends": "from-sd-purple to-sd-purple-2",
  "Web2 Trends": "from-sd-purple-300 to-sd-purple",
  "Product Development": "from-sd-green to-sd-purple-300",
  "AI": "from-sd-purple-300 to-sd-purple-300",
  "Augmented Reality": "from-sd-purple-300 to-sd-green",
  "Techy Trends": "from-sd-purple to-sd-purple-300",
};

const featuredAuthor = getAuthor(featured.data.author);
---

<BaseLayout
  breadcrumbs={false}
  title="Blog | SpaceDev — Articles on Web3, blockchain, AI and product"
  description="Practical articles from the SpaceDev engineering team: blockchain trends, smart contract security, product discovery, and the technologies shaping Web3."
>
  <!-- HERO -->
  <section class="relative overflow-hidden min-h-[80vh] flex flex-col justify-center" style="background-color: var(--sd-dark-hero);">
    <img
      src="/images/content/fO7SfBQPl5ZyUbWpE80AgCxQ9Co.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to right, rgba(10,6,20,0.88) 25%, rgba(50,30,90,0.45) 65%, rgba(10,6,20,0.75) 100%), linear-gradient(to bottom, rgba(10,6,20,0.2) 0%, rgba(10,6,20,0.85) 100%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 pt-28 md:pt-36 pb-16 md:pb-20 w-full">
      <div class="max-w-3xl" data-animate>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Blog" }]} visible={true} class="mb-8" />
        <h1 class="text-4xl md:text-6xl lg:text-7xl text-white font-display leading-[1.05]">
          Practical articles from the engineering floor
        </h1>
        <p class="mt-6 text-lg md:text-xl text-white/70 max-w-2xl leading-relaxed font-body">
          Web3, blockchain security, product discovery, AI — written by the people shipping the code.
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURED POST -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray font-ui mb-6" data-animate>Latest post</p>
      <a href={`/blog/${featured.id}`} class="group block" data-animate>
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div class={`relative aspect-[16/10] rounded-2xl overflow-hidden bg-gradient-to-br ${accentByCategory[featured.data.category] ?? "from-sd-purple to-sd-purple-300"}`}>
            {featured.data.cover && (
              <img
                src={featured.data.cover}
                alt={featured.data.title}
                loading="eager"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
            <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full bg-black/50 backdrop-blur-md text-xs uppercase tracking-wider text-white border border-white/20">
              {featured.data.category}
            </span>
          </div>
          <div>
            <div class="flex items-center gap-2 text-sm text-sd-text-gray mb-4 font-body">
              <time datetime={featured.data.publishedAt.toISOString()}>{dateFmt.format(featured.data.publishedAt)}</time>
              <span aria-hidden="true">·</span>
              <span>{featured.data.readTime} min read</span>
            </div>
            <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-sd-text-dark leading-[1.1] mb-4 group-hover:text-sd-purple transition-colors">
              {featured.data.title}
            </h2>
            <p class="font-body text-sd-text-gray text-lg leading-relaxed mb-8 line-clamp-3">
              {featured.data.description}
            </p>
            {featuredAuthor && (
              <div class="flex items-center justify-between flex-wrap gap-4">
                <AuthorAvatar author={featuredAuthor} size="sm" showRole tone="light" />
                <Button href={`/blog/${featured.id}`} variant="dark">Read article →</Button>
              </div>
            )}
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- REST OF POSTS -->
  <section class="bg-sd-light py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-12">
        <h2 class="font-display text-2xl md:text-3xl text-sd-text-dark" data-animate>
          Keep exploring the latest articles!
        </h2>
        <div class="flex flex-wrap items-center gap-3" role="tablist" aria-label="Filter posts by category">
          {allCategories.map((cat, i) => (
            <button
              type="button"
              class={`sd-blog-filter inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm border transition-colors ${i === 0 ? 'bg-sd-purple border-sd-purple text-white' : 'border-sd-gray-border text-sd-text-gray hover:border-sd-purple/40 hover:text-sd-purple'}`}
              data-filter={cat}
              role="tab"
              aria-selected={i === 0}
            >
              {cat}
              <span class={`text-[11px] tabular-nums rounded-full px-1.5 py-0.5 ${i === 0 ? 'bg-white/20 text-white' : 'bg-sd-light-2 text-sd-text-gray'}`}>
                {countByCategory(cat)}
              </span>
            </button>
          ))}
        </div>
      </div>

      <div id="sd-blog-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {allPosts.slice(1).map((post) => {
          const author = getAuthor(post.data.author);
          const gradient = accentByCategory[post.data.category] ?? "from-sd-purple to-sd-purple-300";
          return (
            <article
              class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-sd-gray-border shadow-sm hover:shadow-[0_8px_32px_rgba(103,58,228,0.12)] hover:border-sd-purple/30 hover:-translate-y-1 transition-all duration-300"
              data-category={post.data.category}
              data-animate
            >
              <a href={`/blog/${post.id}`} class="block overflow-hidden">
                <div class={`relative aspect-[16/10] bg-gradient-to-br ${gradient}`}>
                  {post.data.cover && (
                    <img
                      src={post.data.cover}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  )}
                  <span class="absolute top-4 left-4 inline-flex items-center px-2.5 py-1 rounded-full bg-white/80 backdrop-blur-md text-[10px] uppercase tracking-wider text-sd-purple border border-sd-purple/20 font-ui">
                    {post.data.category}
                  </span>
                </div>
              </a>
              <div class="flex flex-col flex-1 p-5">
                <a href={`/blog/${post.id}`} class="flex flex-col flex-1">
                  <div class="flex items-center gap-2 text-xs text-sd-text-gray mb-3 font-body">
                    <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{post.data.readTime} min read</span>
                  </div>
                  <h3 class="font-display text-lg md:text-xl text-sd-text-dark group-hover:text-sd-purple transition-colors leading-snug">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 text-sm text-sd-text-gray leading-relaxed line-clamp-2 font-body">{post.data.description}</p>
                </a>
                {author && (
                  <div class="mt-5 pt-4 border-t border-sd-gray-border">
                    <a href={`/author/${author.slug}`} class="inline-flex">
                      <AuthorAvatar author={author} size="sm" showRole tone="light" />
                    </a>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".sd-blog-filter");
  const articles = document.querySelectorAll<HTMLElement>("#sd-blog-grid > [data-category]");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "All";
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-selected", String(active));
        b.classList.toggle("bg-sd-purple", active);
        b.classList.toggle("border-sd-purple", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("border-sd-gray-border", !active);
        b.classList.toggle("text-sd-text-gray", !active);
        // badge color
        const badge = b.querySelector("span");
        if (badge) {
          badge.classList.toggle("bg-white/20", active);
          badge.classList.toggle("text-white", active);
          badge.classList.toggle("bg-sd-light-2", !active);
          badge.classList.toggle("text-sd-text-gray", !active);
        }
      });
      articles.forEach((a) => {
        const show = filter === "All" || a.dataset.category === filter;
        a.style.display = show ? "" : "none";
      });
    });
  });
</script>
