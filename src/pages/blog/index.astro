---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import CTA from "../../components/ui/CTA.astro";
import { getAuthor } from "../../data/authors";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const allCategories = ["All", ...new Set(posts.map((p) => p.data.category))];

const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });
const accentByCategory: Record<string, string> = {
  "Blockchain Trends": "from-sd-purple to-sd-purple-2",
  "Web2 Trends": "from-sd-purple-300 to-sd-purple",
  "Product Development": "from-sd-green to-sd-purple-300",
  "AI": "from-sd-purple-300 to-sd-purple-300",
  "Augmented Reality": "from-sd-purple-300 to-sd-green",
  "Techy Trends": "from-sd-purple to-sd-purple-300",
};
---

<BaseLayout
  title="Blog | SpaceDev — Articles on Web3, blockchain, AI and product"
  description="Practical articles from the SpaceDev engineering team: blockchain trends, smart contract security, product discovery, and the technologies shaping Web3."
>
  <!-- HERO -->
  <section class="relative overflow-hidden" style="background: var(--sd-gradient-hero);">
    <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 30% 30%, var(--sd-purple), transparent 50%);"></div>
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10 py-20 md:py-28">
      <div class="max-w-3xl" data-animate>
        <Badge tone="purple" withDot class="mb-6">SpaceDev Blog</Badge>
        <h1 class="text-4xl md:text-6xl text-white">Practical articles from the engineering floor</h1>
        <p class="mt-6 text-lg text-sd-text-muted max-w-2xl leading-relaxed">
          Web3, blockchain security, product discovery, AI — written by the people shipping the code.
        </p>
      </div>
    </div>
  </section>

  <!-- FILTERS + GRID -->
  <section class="bg-sd-dark py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <div class="flex flex-wrap items-center gap-3 mb-12" role="tablist" aria-label="Filter posts by category">
        {allCategories.map((cat, i) => (
          <button
            type="button"
            class={`sd-blog-filter px-5 py-2 rounded-full text-sm border transition-colors ${i === 0 ? 'bg-sd-purple border-sd-purple text-white' : 'border-white/15 text-sd-text-muted hover:text-white hover:border-white/30'}`}
            data-filter={cat}
            role="tab"
            aria-selected={i === 0}
          >
            {cat}
          </button>
        ))}
      </div>

      <div id="sd-blog-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => {
          const author = getAuthor(post.data.author);
          const gradient = accentByCategory[post.data.category] ?? "from-sd-purple to-sd-purple-300";
          return (
            <article class="group" data-category={post.data.category} data-animate>
              <a href={`/blog/${post.id}`} class="block">
                <div class={`relative aspect-[16/10] rounded-2xl overflow-hidden bg-gradient-to-br ${gradient}`}>
                  {post.data.cover && (
                    <img
                      src={post.data.cover}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                  {!post.data.cover && (
                    <div class="absolute inset-0 opacity-30 mix-blend-overlay" style="background-image: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.4), transparent 60%);"></div>
                  )}
                  <span class="absolute top-4 left-4 inline-flex items-center px-2.5 py-1 rounded-full bg-black/40 backdrop-blur-md text-[10px] uppercase tracking-wider text-white border border-white/20">
                    {post.data.category}
                  </span>
                </div>
                <div class="mt-5">
                  <div class="flex items-center gap-2 text-xs text-sd-text-muted mb-3">
                    <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{post.data.readTime} min read</span>
                  </div>
                  <h2 class="text-lg md:text-xl text-white group-hover:text-sd-purple-300 transition-colors leading-snug">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-sd-text-muted leading-relaxed line-clamp-2">{post.data.description}</p>
                </div>
              </a>
              {author && (
                <div class="mt-5 pt-5 border-t border-white/10">
                  <a href={`/author/${author.slug}`} class="inline-flex">
                    <AuthorAvatar author={author} size="sm" showRole />
                  </a>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTA
    title="Want more like this?"
    description="Subscribe to occasional updates from the SpaceDev engineering team — no spam, no newsletters about newsletters."
    buttons={[{ label: "Subscribe", href: "/newsletter" }]}
    variant="dark"
  />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".sd-blog-filter");
  const articles = document.querySelectorAll<HTMLElement>("#sd-blog-grid > [data-category]");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "All";
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute("aria-selected", String(active));
        b.classList.toggle("bg-sd-purple", active);
        b.classList.toggle("border-sd-purple", active);
        b.classList.toggle("text-white", active);
        b.classList.toggle("border-white/15", !active);
        b.classList.toggle("text-sd-text-muted", !active);
      });
      articles.forEach((a) => {
        const show = filter === "All" || a.dataset.category === filter;
        a.style.display = show ? "" : "none";
      });
    });
  });
</script>
