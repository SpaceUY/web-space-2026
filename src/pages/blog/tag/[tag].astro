---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AuthorAvatar from "../../../components/ui/AuthorAvatar.astro";
import { blogTags, getBlogTag } from "../../../data/blog-tags";
import { getAuthor } from "../../../data/authors";
import { SITE } from "../../../lib/seo";

export async function getStaticPaths() {
  return blogTags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const tagPosts = allPosts
  .filter((p) => p.data.tags.includes(tag.slug))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const accentByCategory: Record<string, string> = {
  "Blockchain Trends": "from-sd-purple to-sd-purple-2",
  "Web2 Trends": "from-sd-purple-300 to-sd-purple",
  "Product Development": "from-sd-green to-sd-purple-300",
  "AI": "from-sd-purple-300 to-sd-purple-300",
  "Augmented Reality": "from-sd-purple-300 to-sd-green",
  "Techy Trends": "from-sd-purple to-sd-purple-300",
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog` },
    { "@type": "ListItem", position: 3, name: `#${tag.label}`, item: `${SITE.url}/blog/tag/${tag.slug}` },
  ],
};
---

<BaseLayout
  title={`${tag.label} Articles & Insights | SpaceDev Blog`}
  description={`Articles about ${tag.description.toLowerCase()}. Practical insights from the SpaceDev engineering team.`}
  jsonLd={breadcrumbJsonLd}
  noindex={true}
>
  <!-- HEADER -->
  <section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24" style="background: var(--sd-gradient-hero);">
    <div class="relative mx-auto max-w-[1440px] px-6 md:px-10">
      <h1 class="font-display text-4xl md:text-6xl text-white leading-tight mb-4" data-animate>
        #{tag.label}
      </h1>
      <p class="text-white/60 text-lg max-w-xl" data-animate>
        {tag.description}. {tagPosts.length} {tagPosts.length === 1 ? "article" : "articles"}
      </p>
    </div>
  </section>

  <!-- POSTS GRID -->
  <section class="bg-sd-light py-16 md:py-20">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      {tagPosts.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-sd-text-gray text-lg">No articles published yet for this topic.</p>
          <a href="/blog" class="mt-6 inline-block text-sd-purple hover:underline text-sm">← Back to all articles</a>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {tagPosts.map((post) => {
            const author = getAuthor(post.data.author);
            const gradient = accentByCategory[post.data.category] ?? "from-sd-purple to-sd-purple-300";
            return (
              <article
                class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-sd-gray-border shadow-sm hover:shadow-[0_8px_32px_rgba(103,58,228,0.12)] hover:border-sd-purple/30 hover:-translate-y-1 transition-all duration-300"
                data-animate
              >
                <a href={`/blog/${post.id}`} class="block overflow-hidden">
                  <div class={`relative aspect-[16/10] bg-gradient-to-br ${gradient}`}>
                    {post.data.cover && (
                      <img
                        src={post.data.cover}
                        alt={post.data.title}
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    )}
                    <span class="absolute top-4 left-4 inline-flex items-center px-2.5 py-1 rounded-full bg-white/80 backdrop-blur-md text-[10px] uppercase tracking-wider text-sd-purple border border-sd-purple/20 font-ui">
                      {post.data.category}
                    </span>
                  </div>
                </a>
                <div class="flex flex-col flex-1 p-5">
                  <a href={`/blog/${post.id}`} class="flex flex-col flex-1">
                    <div class="flex items-center gap-2 text-xs text-sd-text-gray mb-3 font-body">
                      <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
                      <span aria-hidden="true">·</span>
                      <span>{post.data.readTime} min read</span>
                    </div>
                    <h2 class="font-display text-lg md:text-xl text-sd-text-dark group-hover:text-sd-purple transition-colors leading-snug">
                      {post.data.title}
                    </h2>
                    <p class="mt-2 text-sm text-sd-text-gray leading-relaxed line-clamp-2 font-body">{post.data.description}</p>
                  </a>
                  {author && (
                    <div class="mt-5 pt-4 border-t border-sd-gray-border">
                      <a href={`/author/${author.slug}`} class="inline-flex">
                        <AuthorAvatar author={author} size="sm" showRole tone="light" />
                      </a>
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- OTHER TAGS -->
  <section class="bg-white py-12 border-t border-sd-gray-border">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray font-ui mb-5">Browse other topics</p>
      <div class="flex flex-wrap gap-2">
        {blogTags.filter((t) => t.slug !== tag.slug).map((t) => (
          <a
            href={`/blog/tag/${t.slug}`}
            class="inline-flex items-center px-4 py-1.5 rounded-full border border-sd-gray-border text-sm text-sd-text-gray hover:border-sd-purple/40 hover:text-sd-purple hover:bg-sd-purple/5 transition-colors"
          >
            #{t.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
