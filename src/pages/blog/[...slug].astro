---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/ui/Badge.astro";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import { getAuthor } from "../../data/authors";
import { SITE } from "../../lib/seo";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = getAuthor(post.data.author);
const dateFmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" });

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: post.data.title },
];

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: { "@type": "Person", name: author?.name ?? "SpaceDev", url: `${SITE.url}/author/${post.data.author}` },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    logo: { "@type": "ImageObject", url: `${SITE.url}/images/logo/spacedev-logo.svg` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${post.id}` },
};
---

<BaseLayout
  title={`${post.data.title} | SpaceDev Blog`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.cover}
  publishedTime={post.data.publishedAt.toISOString()}
  authorName={author?.name}
  articleSection={post.data.category}
  jsonLd={articleJsonLd}
>
  <!-- HERO + COVER (unified light) -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-6 md:px-10 pt-16 md:pt-24 pb-10">
      <div class="flex flex-col items-start gap-4 mb-8">
        <a href="/blog" class="inline-flex items-center gap-1 text-sm text-sd-text-gray hover:text-sd-text-dark transition-colors">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M11 7H3m0 0l3.5-3.5M3 7l3.5 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Back to blog
        </a>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs uppercase tracking-wider font-ui border border-sd-purple/30 text-sd-purple">
          {post.data.category}
        </span>
      </div>
      <h1 class="font-display text-3xl md:text-5xl lg:text-6xl text-sd-text-dark leading-tight">{post.data.title}</h1>
      <p class="mt-6 text-lg text-sd-text-gray leading-relaxed">{post.data.description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4 pb-10 border-b border-sd-gray-border">
        {author && (
          <a href={`/author/${author.slug}`} class="inline-flex">
            <AuthorAvatar author={author} size="md" showRole />
          </a>
        )}
        <div class="flex items-center gap-2 text-sm text-sd-text-gray">
          <span aria-hidden="true">·</span>
          <time datetime={post.data.publishedAt.toISOString()}>{dateFmt.format(post.data.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.readTime} min read</span>
        </div>
      </div>
    </div>

    {post.data.cover && (
      <div class="mx-auto max-w-3xl px-6 md:px-10 pt-8">
        <img
          src={post.data.cover}
          alt={post.data.title}
          loading="eager"
          class="w-full rounded-2xl aspect-[16/9] object-cover"
        />
      </div>
    )}
  </section>

  <!-- BODY -->
  <section class="bg-white py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-6 md:px-10">

      {(post.data.takeaways?.length ?? 0) > 0 && (
        <aside class="mb-10 rounded-2xl border border-sd-purple/20 bg-sd-purple/[0.04] px-7 py-6">
          <p class="text-xs uppercase tracking-[0.18em] text-sd-purple font-ui mb-4">Key takeaways</p>
          <ul class="space-y-2.5">
            {post.data.takeaways.map((point) => (
              <li class="flex items-start gap-3 text-sm text-sd-text-gray font-body leading-relaxed">
                <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-sd-purple"></span>
                {point}
              </li>
            ))}
          </ul>
        </aside>
      )}

      <article class="sd-prose mx-auto">
        <Content />
      </article>

      {(post.data.tags?.length ?? 0) > 0 && (
        <div class="mt-12 pt-8 border-t border-sd-gray-border flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="inline-flex items-center px-3 py-1 rounded-full border border-sd-gray-border text-xs text-sd-text-gray">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="bg-sd-light py-16 md:py-20 border-t border-sd-gray-border">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10">
        <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray font-ui mb-8">Keep reading</p>
        <div class="grid gap-6 md:grid-cols-3">
          {relatedPosts.map((related) => {
            const relatedAuthor = getAuthor(related.data.author);
            return (
              <a href={`/blog/${related.id}`} class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-sd-gray-border shadow-sm hover:shadow-[0_8px_32px_rgba(103,58,228,0.12)] hover:border-sd-purple/30 hover:-translate-y-1 transition-all duration-300">
                {related.data.cover && (
                  <div class="relative aspect-[16/9] overflow-hidden">
                    <img
                      src={related.data.cover}
                      alt=""
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <span class="absolute top-3 left-3 text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-full bg-white/80 backdrop-blur-md text-sd-purple border border-sd-purple/20 font-ui">
                      {related.data.category}
                    </span>
                  </div>
                )}
                <div class="flex flex-col flex-1 p-5">
                  <div class="flex items-center gap-2 text-xs text-sd-text-gray mb-2 font-body">
                    <time datetime={related.data.publishedAt.toISOString()}>{dateFmt.format(related.data.publishedAt)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{related.data.readTime} min read</span>
                  </div>
                  <h3 class="font-display text-base md:text-lg text-sd-text-dark group-hover:text-sd-purple transition-colors leading-snug">{related.data.title}</h3>
                  {relatedAuthor && (
                    <div class="mt-auto pt-4 border-t border-sd-gray-border">
                      <AuthorAvatar author={relatedAuthor} size="sm" showRole tone="light" />
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
        <div class="mt-10 pt-8 border-t border-sd-gray-border flex items-center justify-between flex-wrap gap-4">
          <p class="text-sm text-sd-text-gray font-body">Have a project in mind?</p>
          <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-sd-text-dark text-white text-sm font-ui hover:bg-sd-purple transition-colors">
            Get in touch →
          </a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
