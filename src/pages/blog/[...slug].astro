---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import NewsletterForm from "../../components/ui/NewsletterForm.astro";
import { getAuthor } from "../../data/authors";
import { getBlogTag } from "../../data/blog-tags";
import { SITE, organizationJsonLd } from "../../lib/seo";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const author = getAuthor(post.data.author);
const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
let currentTocParent: string | null = null;

// metatitle: use custom field if set, otherwise fall back to "title | SpaceDev Blog"
const pageTitle = post.data.metatitle ?? `${post.data.title} | SpaceDev Blog`;
// metadescription: SEO override (140-160 chars), falls back to the post description
const pageDescription = post.data.metadescription ?? post.data.description;

// Article's publisher must not carry a nested @context — that belongs
// at the root of the JSON-LD document, not on an embedded sub-entity.
const { "@context": _organizationContext, ...publisherJsonLd } = organizationJsonLd;

const wordCount = post.body
  ? post.body.replace(/```[\s\S]*?```/g, " ").split(/\s+/).filter(Boolean).length
  : undefined;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  articleSection: post.data.category,
  ...(wordCount && { wordCount }),
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: author?.name ?? "SpaceDev",
    url: `${SITE.url}/author/${post.data.author}`,
  },
  publisher: publisherJsonLd,
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${post.id}` },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["#article-title", "#article-summary", ...(post.data.takeaways?.length ? ["#key-takeaways"] : [])],
  },
  ...(post.data.cover && {
    image: {
      "@type": "ImageObject",
      url: post.data.cover.startsWith("http") ? post.data.cover : `${SITE.url}${post.data.cover}`,
    },
  }),
};

const faqJsonLd = post.data.faqs.length > 0 && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: post.data.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: `${SITE.url}/blog/${post.id}` },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogType="article"
  ogImage={post.data.cover}
  publishedTime={post.data.publishedAt.toISOString()}
  authorName={author?.name}
  articleSection={post.data.category}
  jsonLd={[articleJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])]}
  breadcrumbs={false}
>

  <!-- ─── ARTICLE LAYOUT ──────────────────────────────────────────────────
       Three columns, like Cloudflare's blog: a narrow far-left gutter, the
       article in the middle, sticky TOC + CTA on the right.
       FAR LEFT → tags, static, own column
       CENTER   → scrolls with page (back, title, meta, body)
       RIGHT    → sticky sidebar (TOC + CTA)
  ────────────────────────────────────────────────────────────────────── -->
  <div class="bg-white min-h-screen">
  <div class="flex max-w-[1360px] mx-auto">

    <!-- ── FAR LEFT COLUMN: tags (own column from md: up, matching the TOC's
         own breakpoint — below that there's no room for a 3rd column, so a
         fallback row renders above the title instead, mobile/tablet only) ── -->
    {(post.data.tags?.length ?? 0) > 0 && (
      <div
        class="hidden md:flex w-[180px] flex-shrink-0 flex-col gap-2 pt-10 pb-10 pl-6 self-start"
        style="position: sticky; top: 68px;"
        data-sidebar-sync
      >
        {post.data.tags!.map((tag) => {
          const tagData = getBlogTag(tag);
          return (
            <a
              href={`/blog/tag/${tag}`}
              class="inline-flex items-center px-3 py-1 rounded-full border border-sd-gray-border text-xs text-sd-text-gray whitespace-nowrap hover:border-sd-purple/40 hover:text-sd-purple hover:bg-sd-purple/5 transition-colors self-start"
            >
              #{tagData?.label ?? tag}
            </a>
          );
        })}
      </div>
    )}

    <!-- ── CENTER COLUMN: normal page scroll ───────────────────────────── -->
    <div class="flex-1 min-w-0 px-10 md:px-12 pt-10 pb-20">

      <!-- Header: breadcrumb · title · meta -->
      <div class="mb-7">
        <nav aria-label="Breadcrumb" class="mb-5 hidden sm:flex items-center gap-2 text-xs font-ui uppercase tracking-widest text-sd-text-gray/60">
          <a href="/" class="hover:text-sd-purple transition-colors">Home</a>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="opacity-30"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <a href="/blog" class="hover:text-sd-purple transition-colors">Blog</a>
        </nav>
        <a href="/blog" class="sm:hidden mb-4 inline-flex items-center gap-2 text-xs font-ui uppercase tracking-widest text-sd-text-gray/60 hover:text-sd-purple transition-colors">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Blog
        </a>


        <h1 id="article-title" class="font-display text-3xl md:text-4xl lg:text-5xl text-sd-text-dark leading-tight" style="font-weight: 400; letter-spacing: -0.02em;">
          {post.data.title}
        </h1>
        <p id="article-summary" class="mt-3 text-base md:text-lg text-sd-text-gray leading-relaxed">
          {post.data.description}
        </p>

        <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
          {author && (
            <a href={`/author/${author.slug}`} class="inline-flex">
              <AuthorAvatar author={author} size="sm" showRole tone="light" nameClass="text-base font-medium" roleClass="text-xs" avatarClass="w-[42px] h-[42px]" />
            </a>
          )}
          <div class="flex items-center gap-2 text-sm text-sd-text-gray">
            <span aria-hidden="true">·</span>
            <time datetime={post.data.publishedAt.toISOString()}>
              Published {dateFmt.format(post.data.publishedAt)}
            </time>
            {post.data.updatedAt && post.data.updatedAt.getTime() !== post.data.publishedAt.getTime() && (
              <>
                <span aria-hidden="true">·</span>
                <time datetime={post.data.updatedAt.toISOString()}>
                  Updated {dateFmt.format(post.data.updatedAt)}
                </time>
              </>
            )}
            <span aria-hidden="true">·</span>
            <span>{post.data.readTime} min read</span>
          </div>
        </div>
      </div>

      <!-- Separator -->
      <div class="h-px bg-sd-gray-border mb-10"></div>

      {(post.data.takeaways?.length ?? 0) > 0 && (
        <aside id="key-takeaways" class="mb-10 rounded-2xl border border-sd-purple/20 bg-sd-purple/[0.04] px-7 py-6">
          <p class="text-xs uppercase tracking-[0.18em] text-sd-purple font-ui mb-4">Key takeaways</p>
          <ul class="space-y-2.5">
            {post.data.takeaways!.map((point) => (
              <li class="flex items-start gap-3 text-sm text-sd-text-gray font-body leading-relaxed">
                <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-sd-purple"></span>
                {point}
              </li>
            ))}
          </ul>
        </aside>
      )}

      <article class="sd-prose">
        <Content />
      </article>

      {(post.data.tags?.length ?? 0) > 0 && (
        <div class="md:hidden mt-10 pt-8 border-t border-sd-gray-border flex flex-wrap gap-2">
          {post.data.tags!.map((tag) => {
            const tagData = getBlogTag(tag);
            return (
              <a
                href={`/blog/tag/${tag}`}
                class="inline-flex items-center px-3 py-1 rounded-full border border-sd-gray-border text-xs text-sd-text-gray hover:border-sd-purple/40 hover:text-sd-purple hover:bg-sd-purple/5 transition-colors"
              >
                #{tagData?.label ?? tag}
              </a>
            );
          })}
        </div>
      )}

    </div>

    <!-- ── RIGHT COLUMN: one static sticky block (TOC + CTA), exactly like
         before. Sub-items (depth > 2) are collapsed by default and only
         reveal for the section currently being read, so a post with many
         H3s (e.g. an FAQ block) never grows tall enough to push the CTA
         down — the CTA never moves, never disappears. ── -->
    {tocHeadings.length > 0 && (
      <aside
        class="hidden md:block w-[360px] flex-shrink-0 self-start"
        style="position: sticky; top: 68px;"
        aria-label="Article sidebar"
      >
        <div class="px-6 pt-10 pb-10 flex flex-col gap-6">
          <!-- TOC -->
          <div>
            <p class="text-[10px] uppercase tracking-[0.2em] font-ui text-sd-text-gray mb-4">
              In this article
            </p>
            <nav aria-label="Table of contents" class="relative">
              <div class="absolute left-0 top-0 bottom-0 w-px bg-sd-gray-border" aria-hidden="true"></div>
              <div
                id="sd-toc-progress"
                class="absolute left-0 top-0 w-px bg-sd-purple"
                style="height: 0px; transition: height 200ms ease, top 200ms ease;"
                aria-hidden="true"
              ></div>
              <ul id="sd-toc" class="flex flex-col gap-3 pl-4">
                {tocHeadings.map((h) => {
                  if (h.depth === 2) currentTocParent = h.slug;
                  const parent = h.depth === 2 ? null : currentTocParent;
                  return (
                    <li
                      data-parent={parent}
                      class={parent ? "hidden" : ""}
                      style={`padding-left: ${(h.depth - 2) * 12}px`}
                    >
                      <a
                        href={`#${h.slug}`}
                        class="sd-toc-link block text-[11px] leading-snug text-sd-text-gray hover:text-sd-purple transition-colors duration-150"
                        data-heading={h.slug}
                      >
                        {h.text}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </nav>
          </div>

          <!-- CTA -->
          <div class="rounded-2xl p-5" style="background: var(--sd-gradient-hero);">
            <p class="font-display text-white font-semibold text-[15px] leading-snug mb-4">
              Have a project in mind?
            </p>
            <a
              href="/contact"
              class="inline-flex items-center justify-center w-full px-4 py-2 rounded-full bg-white text-sd-text-dark text-xs font-ui font-medium hover:bg-sd-purple hover:text-white transition-colors duration-200"
            >
              Book a free call
            </a>
          </div>
        </div>
      </aside>
    )}

  </div>
  </div>

  <!-- ─── RELATED POSTS ────────────────────────────────────────────────── -->
  {relatedPosts.length > 0 && (
    <section class="bg-sd-light py-16 md:py-20">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10">
        <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray font-ui mb-8">Keep reading</p>
        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
          {relatedPosts.map((related) => {
            const relatedAuthor = getAuthor(related.data.author);
            return (
              <a
                href={`/blog/${related.id}`}
                class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-sd-gray-border shadow-sm hover:shadow-[0_8px_32px_rgba(103,58,228,0.12)] hover:border-sd-purple/30 hover:-translate-y-1 transition-all duration-300"
              >
                {related.data.cover && (
                  <div class="relative aspect-[16/9] overflow-hidden">
                    <img
                      src={related.data.cover}
                      alt={related.data.title}
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <span class="absolute top-3 left-3 text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-full bg-white/80 backdrop-blur-md text-sd-purple border border-sd-purple/20 font-ui">
                      {related.data.category}
                    </span>
                  </div>
                )}
                <div class="flex flex-col flex-1 p-5">
                  <div class="flex items-center gap-2 text-xs text-sd-text-gray mb-2 font-body">
                    <time datetime={related.data.publishedAt.toISOString()}>
                      {dateFmt.format(related.data.publishedAt)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{related.data.readTime} min read</span>
                  </div>
                  <h3 class="font-display text-base md:text-lg text-sd-text-dark group-hover:text-sd-purple transition-colors leading-snug">
                    {related.data.title}
                  </h3>
                  {relatedAuthor && (
                    <div class="mt-auto pt-4 border-t border-sd-gray-border">
                      <AuthorAvatar author={relatedAuthor} size="sm" showRole tone="light" />
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ─── NEWSLETTER ───────────────────────────────────────────────────── -->
  <section class="bg-sd-dark py-14 md:py-16">
    <div class="mx-auto max-w-[1440px] px-6 md:px-10">
      <h2 class="font-display text-2xl md:text-3xl text-white mb-6" style="font-weight: 400;">
        Get more like this in your inbox
      </h2>
      <div class="max-w-md">
        <NewsletterForm compact />
        <p class="mt-3 text-xs text-white/40">No spam. Unsubscribe in one click anytime.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // ── Wrap tables so wide ones scroll horizontally instead of overflowing ──
  document.querySelectorAll<HTMLTableElement>(".sd-prose table").forEach((table) => {
    const wrapper = document.createElement("div");
    wrapper.className = "sd-table-scroll";
    table.parentNode?.insertBefore(wrapper, table);
    wrapper.appendChild(table);
  });

  // ── Sidebar top offset follows the header's own hide-on-scroll (mirrors
  // Header.astro's THRESHOLD/lastY logic) so the sidebar's sticky offset
  // collapses to a small margin instead of leaving a gap where the now
  // hidden header used to be. ──
  const stickyColumns = document.querySelectorAll<HTMLElement>(
    'aside[aria-label="Article sidebar"], [data-sidebar-sync]'
  );
  if (stickyColumns.length) {
    let sidebarLastY = 0;
    const SIDEBAR_THRESHOLD = 80;
    stickyColumns.forEach((el) => { el.style.transition = "top 300ms ease"; });
    window.addEventListener(
      "scroll",
      () => {
        const currentY = window.scrollY;
        const headerHidden = currentY > SIDEBAR_THRESHOLD && currentY > sidebarLastY;
        stickyColumns.forEach((el) => { el.style.top = headerHidden ? "20px" : "68px"; });
        sidebarLastY = currentY;
      },
      { passive: true }
    );
  }

  // ── TOC active heading tracking (window scroll) ───────────────────────
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>("#sd-toc .sd-toc-link");
  const articleHeadings = Array.from(
    document.querySelectorAll<HTMLElement>(".sd-prose h2, .sd-prose h3, .sd-prose h4")
  );

  const tocProgress = document.getElementById("sd-toc-progress");
  const tocList = document.getElementById("sd-toc");

  const tocItems = document.querySelectorAll<HTMLLIElement>("#sd-toc li");

  if (tocLinks.length && articleHeadings.length) {
    let activeId = "";

    const activate = (id: string) => {
      if (id === activeId) return;
      activeId = id;

      const activeLink = Array.from(tocLinks).find((l) => l.dataset.heading === id);
      const activeLi = activeLink?.closest("li");
      // A top-level (depth 2) item has no data-parent, so its own id is the section; a
      // sub-item's section is whatever top-level heading it's nested under.
      const activeSection = activeLi?.dataset.parent ?? id;

      tocLinks.forEach((link) => {
        link.classList.toggle("!text-sd-purple", link.dataset.heading === id);
      });

      tocItems.forEach((li) => {
        const parent = li.dataset.parent;
        if (!parent) return; // top-level items always stay visible
        li.classList.toggle("hidden", parent !== activeSection);
      });

      if (activeLink && tocProgress && tocList) {
        const listTop = tocList.getBoundingClientRect().top;
        const linkRect = activeLink.getBoundingClientRect();
        const filledHeight = linkRect.top + linkRect.height / 2 - listTop;
        tocProgress.style.height = `${Math.max(filledHeight, 0)}px`;
      }
    };

    const getActiveId = (): string => {
      const threshold = 120;
      let active = articleHeadings[0]?.id ?? "";
      for (const h of articleHeadings) {
        if (h.getBoundingClientRect().top <= threshold) active = h.id;
        else break;
      }
      return active;
    };

    let rafPending = false;
    window.addEventListener("scroll", () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => { activate(getActiveId()); rafPending = false; });
    }, { passive: true });

    activate(getActiveId());

    // Smooth scroll to heading on TOC click
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const id = link.dataset.heading;
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          const top = target.getBoundingClientRect().top + window.scrollY - 96;
          window.scrollTo({ top, behavior: "smooth" });
          history.pushState(null, "", `#${id}`);
        }
      });
    });
  }
</script>
