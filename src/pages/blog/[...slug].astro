---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorAvatar from "../../components/ui/AuthorAvatar.astro";
import { getAuthor } from "../../data/authors";
import { getBlogTag } from "../../data/blog-tags";
import { SITE } from "../../lib/seo";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const author = getAuthor(post.data.author);
const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

// metatitle: use custom field if set, otherwise fall back to "title | SpaceDev Blog"
const pageTitle = post.data.metatitle ?? `${post.data.title} | SpaceDev Blog`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  author: {
    "@type": "Person",
    name: author?.name ?? "SpaceDev",
    url: `${SITE.url}/author/${post.data.author}`,
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    logo: { "@type": "ImageObject", url: `${SITE.url}/images/logo/spacedev-logo.svg` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE.url}/blog/${post.id}` },
  ...(post.data.cover && {
    image: {
      "@type": "ImageObject",
      url: post.data.cover.startsWith("http") ? post.data.cover : `${SITE.url}${post.data.cover}`,
    },
  }),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog` },
    { "@type": "ListItem", position: 3, name: post.data.title, item: `${SITE.url}/blog/${post.id}` },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.cover}
  publishedTime={post.data.publishedAt.toISOString()}
  authorName={author?.name}
  articleSection={post.data.category}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>

  <!-- ─── ARTICLE LAYOUT ──────────────────────────────────────────────────
       Normal page scroll — title visible from the top.
       LEFT  → scrolls with page (back, title, meta, body)
       RIGHT → sticky sidebar (TOC + CTA)
  ────────────────────────────────────────────────────────────────────── -->
  <div class="flex bg-white min-h-screen">

    <!-- ── LEFT COLUMN: normal page scroll ───────────────────────────── -->
    <div class="flex-1 min-w-0 px-10 md:px-16 pt-10 pb-20">

      <!-- Header: back · category · title · meta -->
      <div class="mb-7">
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 text-sm text-sd-text-gray hover:text-sd-text-dark transition-colors"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M11 7H3m0 0l3.5-3.5M3 7l3.5 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back to blog
          </a>
          <span class="inline-flex items-center px-3 py-0.5 rounded-full text-[11px] uppercase tracking-wider font-ui border border-sd-purple/30 text-sd-purple">
            {post.data.category}
          </span>
        </div>

        <h1 id="article-title" class="font-display text-3xl md:text-4xl lg:text-5xl text-sd-text-dark leading-tight" style="font-weight: 400; letter-spacing: -0.02em;">
          {post.data.title}
        </h1>
        <p class="mt-3 text-base md:text-lg text-sd-text-gray leading-relaxed">
          {post.data.description}
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          {author && (
            <a href={`/author/${author.slug}`} class="inline-flex">
              <AuthorAvatar author={author} size="sm" showRole tone="light" />
            </a>
          )}
          <div class="flex items-center gap-2 text-sm text-sd-text-gray">
            <span aria-hidden="true">·</span>
            <time datetime={post.data.publishedAt.toISOString()}>
              {dateFmt.format(post.data.publishedAt)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{post.data.readTime} min read</span>
          </div>
        </div>
      </div>

      <!-- Separator -->
      <div class="h-px bg-sd-gray-border mb-10"></div>

      {(post.data.takeaways?.length ?? 0) > 0 && (
        <aside class="mb-10 rounded-2xl border border-sd-purple/20 bg-sd-purple/[0.04] px-7 py-6">
          <p class="text-xs uppercase tracking-[0.18em] text-sd-purple font-ui mb-4">Key takeaways</p>
          <ul class="space-y-2.5">
            {post.data.takeaways!.map((point) => (
              <li class="flex items-start gap-3 text-sm text-sd-text-gray font-body leading-relaxed">
                <span class="mt-1.5 shrink-0 w-1.5 h-1.5 rounded-full bg-sd-purple"></span>
                {point}
              </li>
            ))}
          </ul>
        </aside>
      )}

      <article class="sd-prose">
        <Content />
      </article>

      {(post.data.tags?.length ?? 0) > 0 && (
        <div class="mt-12 pt-8 border-t border-sd-gray-border flex flex-wrap gap-2">
          {post.data.tags!.map((tag) => {
            const tagData = getBlogTag(tag);
            return (
              <a
                href={`/blog/tag/${tag}`}
                class="inline-flex items-center px-3 py-1 rounded-full border border-sd-gray-border text-xs text-sd-text-gray hover:border-sd-purple/40 hover:text-sd-purple hover:bg-sd-purple/5 transition-colors"
              >
                #{tagData?.label ?? tag}
              </a>
            );
          })}
        </div>
      )}

      <!-- CTA — at the end of the article, always reachable on scroll -->
      <div
        class="mt-12 rounded-2xl p-7 text-center"
        style="background: var(--sd-gradient-hero);"
      >
        <p class="font-display font-semibold text-white text-lg leading-snug mb-2">
          Ready to build something?
        </p>
        <p class="text-sm text-white/70 leading-relaxed mb-5">
          SpaceDev helps companies build Web3 and Web2 products from idea to launch.
        </p>
        <a
          href="/contact"
          class="inline-block px-7 py-2.5 rounded-full bg-white text-sd-text-dark text-sm font-ui font-medium hover:bg-sd-purple hover:text-white transition-colors"
        >
          Get in touch
        </a>
      </div>
    </div>

    <!-- ── RIGHT COLUMN: sticky TOC only ────────────────────────────── -->
    {tocHeadings.length > 0 && (
      <aside
        class="hidden md:flex flex-col w-[280px] flex-shrink-0"
        style="position: sticky; top: 68px; height: calc(100vh - 68px);"
        aria-label="Article sidebar"
      >
        <div class="px-6 pt-10">
          <div class="rounded-2xl bg-[#f7f7f8] p-5">
            <p class="text-[10px] uppercase tracking-[0.2em] font-ui text-sd-text-gray mb-4">
              In this article
            </p>
            <nav aria-label="Table of contents">
              <ul id="sd-toc" class="flex flex-col gap-0.5">
                {tocHeadings.map((h) => (
                  <li style={`padding-left: ${(h.depth - 2) * 10}px`}>
                    <a
                      href={`#${h.slug}`}
                      class="sd-toc-link flex items-center px-3 py-1.5 rounded-lg text-[13px] leading-snug text-sd-text-gray hover:text-sd-purple hover:bg-sd-purple/5 transition-colors duration-150"
                      data-heading={h.slug}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </div>
      </aside>
    )}

  </div>

  <!-- ─── RELATED POSTS ────────────────────────────────────────────────── -->
  {relatedPosts.length > 0 && (
    <section class="bg-sd-light py-16 md:py-20">
      <div class="mx-auto max-w-[1440px] px-6 md:px-10">
        <p class="text-xs uppercase tracking-[0.2em] text-sd-text-gray font-ui mb-8">Keep reading</p>
        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
          {relatedPosts.map((related) => {
            const relatedAuthor = getAuthor(related.data.author);
            return (
              <a
                href={`/blog/${related.id}`}
                class="group flex flex-col rounded-2xl overflow-hidden bg-white border border-sd-gray-border shadow-sm hover:shadow-[0_8px_32px_rgba(103,58,228,0.12)] hover:border-sd-purple/30 hover:-translate-y-1 transition-all duration-300"
              >
                {related.data.cover && (
                  <div class="relative aspect-[16/9] overflow-hidden">
                    <img
                      src={related.data.cover}
                      alt=""
                      loading="lazy"
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <span class="absolute top-3 left-3 text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-full bg-white/80 backdrop-blur-md text-sd-purple border border-sd-purple/20 font-ui">
                      {related.data.category}
                    </span>
                  </div>
                )}
                <div class="flex flex-col flex-1 p-5">
                  <div class="flex items-center gap-2 text-xs text-sd-text-gray mb-2 font-body">
                    <time datetime={related.data.publishedAt.toISOString()}>
                      {dateFmt.format(related.data.publishedAt)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{related.data.readTime} min read</span>
                  </div>
                  <h3 class="font-display text-base md:text-lg text-sd-text-dark group-hover:text-sd-purple transition-colors leading-snug">
                    {related.data.title}
                  </h3>
                  {relatedAuthor && (
                    <div class="mt-auto pt-4 border-t border-sd-gray-border">
                      <AuthorAvatar author={relatedAuthor} size="sm" showRole tone="light" />
                    </div>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  // ── TOC active heading tracking (window scroll) ───────────────────────
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>("#sd-toc .sd-toc-link");
  const articleHeadings = Array.from(
    document.querySelectorAll<HTMLElement>(".sd-prose h2, .sd-prose h3, .sd-prose h4")
  );

  if (tocLinks.length && articleHeadings.length) {
    let activeId = "";

    const activate = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      tocLinks.forEach((link) => {
        const active = link.dataset.heading === id;
        link.classList.toggle("!text-sd-purple", active);
        link.classList.toggle("!bg-sd-purple/5", active);
      });
    };

    const getActiveId = (): string => {
      const threshold = 120;
      let active = articleHeadings[0]?.id ?? "";
      for (const h of articleHeadings) {
        if (h.getBoundingClientRect().top <= threshold) active = h.id;
        else break;
      }
      return active;
    };

    let rafPending = false;
    window.addEventListener("scroll", () => {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => { activate(getActiveId()); rafPending = false; });
    }, { passive: true });

    activate(getActiveId());

    // Smooth scroll to heading on TOC click
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        const id = link.dataset.heading;
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          const top = target.getBoundingClientRect().top + window.scrollY - 96;
          window.scrollTo({ top, behavior: "smooth" });
          history.pushState(null, "", `#${id}`);
        }
      });
    });
  }
</script>
